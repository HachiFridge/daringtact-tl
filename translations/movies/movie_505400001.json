{
  "movie_id": 505400001,
  "subtitles": [
    {
      "index": 0,
      "start_time": 5.8,
      "end_time": 7.6,
      "text": "どんな方たちが来るのかしらね"
    },
    {
      "index": 1,
      "start_time": 8.5,
      "end_time": 10.0,
      "text": "わたし、楽しみ～"
    },
    {
      "index": 2,
      "start_time": 11.0,
      "end_time": 14.2,
      "text": "若い女性ばかり……珍しいわね"
    },
    {
      "index": 3,
      "start_time": 15.0,
      "end_time": 16.0,
      "text": "きっと皆さん"
    },
    {
      "index": 4,
      "start_time": 16.2,
      "end_time": 20.6,
      "text": "これからのランドソル経済を担う、商人の卵なのですわ"
    },
    {
      "index": 5,
      "start_time": 22.3,
      "end_time": 24.0,
      "text": "運命……"
    },
    {
      "index": 6,
      "start_time": 24.5,
      "end_time": 27.5,
      "text": "それは乙女たちが夢見る最高の出会い……"
    },
    {
      "index": 7,
      "start_time": 37.5,
      "end_time": 41.4,
      "text": "今宵……新たな愛を育む皆様を"
    },
    {
      "index": 8,
      "start_time": 41.6,
      "end_time": 46.0,
      "text": "わたくしローズメンが手助けいたします"
    },
    {
      "index": 9,
      "start_time": 46.4,
      "end_time": 48.6,
      "text": "それではご紹介しましょう！"
    },
    {
      "index": 10,
      "start_time": 49.2,
      "end_time": 53.5,
      "text": "彼らこそ未来のプリンスオブペガサスだ！"
    },
    {
      "index": 11,
      "start_time": 54.6,
      "end_time": 57.6,
      "text": "キャァーーーーーーーー！！"
    },
    {
      "index": 12,
      "start_time": 59.3,
      "end_time": 61.6,
      "text": "……どっ、どうもどうも～！"
    },
    {
      "index": 13,
      "start_time": 62.0,
      "end_time": 65.8,
      "text": "皆さんとクリスマスの恋をお送りすます……"
    },
    {
      "index": 14,
      "start_time": 66.0,
      "end_time": 67.6,
      "text": "なんちゃって～～～！"
    },
    {
      "index": 15,
      "start_time": 70.0,
      "end_time": 71.4,
      "text": "参加番号１番！"
    },
    {
      "index": 16,
      "start_time": 71.6,
      "end_time": 73.6,
      "text": "『うっちゃん』って呼んでくださ～い！"
    },
    {
      "index": 17,
      "start_time": 74.5,
      "end_time": 77.0,
      "text": "あ、あの…アキノさん"
    },
    {
      "index": 18,
      "start_time": 77.2,
      "end_time": 79.6,
      "text": "これ、本当に商談なのかしら？"
    },
    {
      "index": 19,
      "start_time": 80.3,
      "end_time": 82.0,
      "text": "これじゃまるで……"
    },
    {
      "index": 20,
      "start_time": 82.4,
      "end_time": 85.0,
      "text": "ま、まさかそんなわけありませんわ！"
    },
    {
      "index": 21,
      "start_time": 85.3,
      "end_time": 88.5,
      "text": "きっと昨今は商談の自己紹介ひとつとっても"
    },
    {
      "index": 22,
      "start_time": 88.7,
      "end_time": 90.5,
      "text": "演出が鍵なのですわ"
    },
    {
      "index": 23,
      "start_time": 91.3,
      "end_time": 95.0,
      "text": "印象的な自己アピールによって……"
    },
    {
      "index": 24,
      "start_time": 95.3,
      "end_time": 98.3,
      "text": "では、二人目のプリンスを紹介しましょう！"
    },
    {
      "index": 25,
      "start_time": 102.2,
      "end_time": 106.2,
      "text": "やれやれ……なんだかここは寒いな"
    },
    {
      "index": 26,
      "start_time": 107.3,
      "end_time": 112.6,
      "text": "ああ……きっと僕は独りなんだって気付いちゃったからだ……"
    },
    {
      "index": 27,
      "start_time": 113.6,
      "end_time": 116.0,
      "text": "でも、心配ないよね……"
    },
    {
      "index": 28,
      "start_time": 116.3,
      "end_time": 118.8,
      "text": "だって今夜は君が……"
    },
    {
      "index": 29,
      "start_time": 119.2,
      "end_time": 121.2,
      "text": "暖めてくれるから♪"
    },
    {
      "index": 30,
      "start_time": 121.8,
      "end_time": 123.2,
      "text": "..."
    },
    {
      "index": 31,
      "start_time": 124.3,
      "end_time": 126.6,
      "text": "（どうしよう……帰りたい……）"
    },
    {
      "index": 32,
      "start_time": 127.2,
      "end_time": 128.6,
      "text": "あの、アキノさん？"
    },
    {
      "index": 33,
      "start_time": 129.2,
      "end_time": 133.8,
      "text": "紹介の途中で席を外すなんて失礼かもしれないけど"
    },
    {
      "index": 34,
      "start_time": 134.2,
      "end_time": 136.0,
      "text": "さすがに今回は……"
    },
    {
      "index": 35,
      "start_time": 136.6,
      "end_time": 139.8,
      "text": "とっ、とりあえず最後まで見ていきませんこと？"
    },
    {
      "index": 36,
      "start_time": 140.2,
      "end_time": 142.5,
      "text": "も、もしかしたら光る原石が"
    },
    {
      "index": 37,
      "start_time": 142.7,
      "end_time": 144.8,
      "text": "転がっているかもしれませんし……"
    },
    {
      "index": 38,
      "start_time": 145.3,
      "end_time": 147.6,
      "text": "ハァ……分かったわ……"
    },
    {
      "index": 39,
      "start_time": 149.0,
      "end_time": 153.3,
      "text": "この中に前世からの恋人がいるって言われたんです……"
    },
    {
      "index": 40,
      "start_time": 153.6,
      "end_time": 155.0,
      "text": "ドクロの占いで"
    },
    {
      "index": 41,
      "start_time": 156.0,
      "end_time": 159.8,
      "text": "『魔法少女セリイちゃん』みたいな子と出会いたくて…………"
    },
    {
      "index": 42,
      "start_time": 160.0,
      "end_time": 161.0,
      "text": "デュフフフ……"
    },
    {
      "index": 43,
      "start_time": 161.2,
      "end_time": 163.6,
      "text": "イヒヒヒヒヒヒ…………"
    },
    {
      "index": 44,
      "start_time": 165.0,
      "end_time": 168.0,
      "text": "さあ、楽しい時間もあっという間"
    },
    {
      "index": 45,
      "start_time": 168.3,
      "end_time": 171.5,
      "text": "惜しくも次の紹介で50人目となります！"
    },
    {
      "index": 46,
      "start_time": 172.3,
      "end_time": 173.3,
      "text": "で、アキノさん"
    },
    {
      "index": 47,
      "start_time": 173.6,
      "end_time": 176.0,
      "text": "光る原石は見つかりました？"
    },
    {
      "index": 48,
      "start_time": 177.2,
      "end_time": 178.0,
      "text": "?!"
    },
    {
      "index": 49,
      "start_time": 178.5,
      "end_time": 181.0,
      "text": "（あのアキノさんがここまで……）"
    },
    {
      "index": 50,
      "start_time": 182.0,
      "end_time": 185.6,
      "text": "それでは最後のプリンスをご紹介しましょう！"
    },
    {
      "index": 51,
      "start_time": 188.0,
      "end_time": 189.0,
      "text": "Huh?!"
    },
    {
      "index": 52,
      "start_time": 192.1,
      "end_time": 194.6,
      "text": "ええええええ～～～～！？"
    },
    {
      "index": 53,
      "start_time": 197.0,
      "end_time": 198.0,
      "text": "...?"
    }
