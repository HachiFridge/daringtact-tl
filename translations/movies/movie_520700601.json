    {
      "index": 0,
      "start_time": 14.1,
      "end_time": 15.4,
      "text": "Why...?"
    },
    {
      "index": 1,
      "start_time": 16.1,
      "end_time": 18.9,
      "text": "So you... weren't lying"
    },
    {
      "index": 2,
      "start_time": 19.3,
      "end_time": 20.2,
      "text": "Huh?"
    },
    {
      "index": 3,
      "start_time": 20.9,
      "end_time": 22.0,
      "text": "The flowers..."
    },
    {
      "index": 4,
      "start_time": 22.4,
      "end_time": 25.2,
      "text": "They're blooming, see"
    },
    {
      "index": 5,
      "start_time": 26.3,
      "end_time": 28.0,
      "text": "Ah..."
    },
    {
      "index": 6,
      "start_time": 31.0,
      "end_time": 33.1,
      "text": "...Pretty, aren't they?"
    },
    {
      "index": 7,
      "start_time": 36.0,
      "end_time": 37.5,
      "text": "Fireworks..."
    },
    {
      "index": 8,
      "start_time": 38.1,
      "end_time": 40.3,
      "text": "What a beautiful sight"
    },
    {
      "index": 9,
      "start_time": 42.2,
      "end_time": 43.9,
      "text": "Um..."
    },
    {
      "index": 10,
      "start_time": 44.8,
      "end_time": 46.9,
      "text": "Thank you very much"
    },
    {
      "index": 11,
      "start_time": 49.0,
      "end_time": 51.3,
      "text": "...!"
    },
    {
      "index": 12,
      "start_time": 52.9,
      "end_time": 54.7,
      "text": "...Th-That's right!"
    },
    {
      "index": 13,
      "start_time": 55.2,
      "end_time": 57.4,
      "text": "I have to heal your wounds!"
    },
    {
      "index": 14,
      "start_time": 61.4,
      "end_time": 63.0,
      "text": "Huh?"
    },
    {
      "index": 15,
      "start_time": 66.4,
      "end_time": 68.3,
      "text": "...It's better this way"
    },
    {
      "index": 16,
      "start_time": 68.9,
      "end_time": 72.6,
      "text": "Um... Without magic... or anything like that..."
    },
    {
      "index": 17,
      "start_time": 76.0,
      "end_time": 77.5,
      "text": "Yes...♪"
    },
    {
      "index": 18,
      "start_time": 93.3,
      "end_time": 94.8,
      "text": "This is..."
    },
    {
      "index": 19,
      "start_time": 95.2,
      "end_time": 98.3,
      "text": "\"Matching\"... I believe it is called?"
    },
    {
      "index": 20,
      "start_time": 99.0,
      "end_time": 102.1,
      "text": "Yes. We're matching...♪"
    },
    {
      "index": 21,
      "start_time": 107.8,
      "end_time": 108.8,
      "text": "Wow...!"
    },
    {
      "index": 22,
