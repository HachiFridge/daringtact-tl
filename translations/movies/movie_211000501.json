      "text": "I'm always serious"
    },
    {
      "index": 8,
      "start_time": 48.4,
      "end_time": 49.6,
      "text": "You didn't know?"
    },
    {
      "index": 9,
      "start_time": 50.2,
      "end_time": 52.3,
      "text": "You call yourself my partner"
    },
    {
      "index": 10,
      "start_time": 54.1,
      "end_time": 55.3,
      "text": "...I see"
    },
    {
      "index": 11,
      "start_time": 56.2,
      "end_time": 57.4,
      "text": "In that case..."
    },
    {
      "index": 12,
      "start_time": 58.6,
      "end_time": 60.1,
      "text": "I'll beat the crap out of you!"
    },
    {
      "index": 13,
      "start_time": 60.6,
      "end_time": 62.6,
      "text": "I'll wake you up!"
    },
    {
      "index": 14,
      "start_time": 63.5,
      "end_time": 65.0,
      "text": "We're partners, after all!"
    },
    {
      "index": 15,
      "start_time": 66.6,
      "end_time": 67.6,
      "text": "Ahh!"
    },
    {
      "index": 16,
      "start_time": 68.1,
      "end_time": 70.0,
      "text": "Taaaaah"
    },
    {
      "index": 17,
      "start_time": 71.0,
      "end_time": 71.6,
      "text": "Whoops!"
    },
    {
      "index": 18,
      "start_time": 75.5,
      "end_time": 76.8,
      "text": "That's dangerous"
    },
    {
      "index": 19,
      "start_time": 77.0,
