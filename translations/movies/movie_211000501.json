    },
    {
      "index": 4,
      "start_time": 31.2,
      "end_time": 34.1,
      "text": "I'll beat them all to a pulp!!"
    },
    {
      "index": 5,
      "start_time": 38.1,
      "end_time": 39.1,
      "text": "Octo"
    },
    {
      "index": 6,
      "start_time": 42.5,
      "end_time": 45.0,
      "text": "...You're serious"
    },
    {
      "index": 7,
      "start_time": 46.0,
