{
  "movie_id": 510600201,
  "subtitles": [
    {
      "index": 0,
      "start_time": 3.7,
      "end_time": 4.9,
      "text": "What, what is it!?"
    },
    {
      "index": 1,
      "start_time": 5.2,
      "end_time": 6.2,
      "text": "...?"
    },
    {
      "index": 2,
      "start_time": 9.8,
      "end_time": 11.0,
      "text": "...!"
    },
    {
      "index": 3,
      "start_time": 11.8,
      "end_time": 13.5,
      "text": "天井から……"
    },
    {
      "index": 4,
      "start_time": 13.7,
      "end_time": 15.0,
      "text": "女の子……？"
    },
    {
      "index": 5,
      "start_time": 18.0,
      "end_time": 18.9,
      "text": "Ahh!"
    },
    {
      "index": 6,
      "start_time": 21.0,
      "end_time": 22.0,
      "text": "あーーーーーっ！"
    },
    {
      "index": 7,
      "start_time": 22.3,
      "end_time": 25.0,
      "text": "不出来な姉の面倒を見るのは"
    },
    {
      "index": 8,
      "start_time": 25.2,
      "end_time": 28.0,
      "text": "いつだって妹の役目ですからね"
    },
    {
      "index": 9,
      "start_time": 28.3,
      "end_time": 29.7,
      "text": "妹？"
    },
    {
      "index": 10,
      "start_time": 29.8,
      "end_time": 31.3,
      "text": "ひょっとしてラフィちゃんの？"
    },
    {
      "index": 11,
      "start_time": 31.8,
      "end_time": 33.1,
      "text": "かわいい～っ！"
    },
    {
      "index": 12,
      "start_time": 34.0,
      "end_time": 35.0,
      "text": "Whoa!"
    },
    {
      "index": 13,
      "start_time": 35.2,
      "end_time": 37.8,
      "text": "ちょっと！　いきなり何するんですか！"
    },
    {
      "index": 14,
      "start_time": 38.0,
      "end_time": 39.7,
      "text": "ぷにぷに～！"
    },
    {
      "index": 15,
      "start_time": 40.0,
      "end_time": 41.8,
      "text": "そうでしょう、そうでしょう"
    },
    {
      "index": 16,
      "start_time": 42.0,
      "end_time": 44.4,
      "text": "エミィはかわいい私の妹です"
    },
    {
      "index": 17,
      "start_time": 44.7,
      "end_time": 46.2,
      "text": "エミィちゃんって言うんだね"
    },
    {
      "index": 18,
      "start_time": 46.8,
      "end_time": 47.8,
      "text": "私はアカリ"
    },
    {
      "index": 19,
      "start_time": 48.0,
      "end_time": 51.6,
      "text": "それでこっちが私の自慢のかわいいお姉ちゃん♪"
    },
    {
      "index": 20,
      "start_time": 52.0,
      "end_time": 53.9,
      "text": "ヨ、ヨリよ。よろしく……"
    },
    {
      "index": 21,
      "start_time": 54.2,
      "end_time": 56.1,
      "text": "よろしくお願いします"
    },
    {
      "index": 22,
      "start_time": 56.8,
      "end_time": 59.0,
      "text": "じゃなくて！　おろしてくださ～い！"
    },
    {
      "index": 23,
      "start_time": 59.7,
      "end_time": 62.0,
      "text": "え～もうちょっとだけ～"
    },
    {
      "index": 24,
      "start_time": 62.7,
      "end_time": 65.8,
      "text": "ほらお姉ちゃんもエミィちゃんのほっぺ触ってみて！"
    },
    {
      "index": 25,
      "start_time": 66.0,
      "end_time": 68.1,
      "text": "やわらかくてかわいいよ～"
    },
    {
      "index": 26,
      "start_time": 68.4,
      "end_time": 69.9,
      "text": "い、いや私は……"
    },
    {
      "index": 27,
      "start_time": 70.1,
      "end_time": 71.9,
      "text": "遠慮することはありません"
    },
    {
      "index": 28,
      "start_time": 72.1,
      "end_time": 75.9,
      "text": "私の妹を思う存分かわいがってあげて下さい！"
    },
    {
      "index": 29,
      "start_time": 76.2,
      "end_time": 78.9,
      "text": "そ……そういうことなら……"
    },
    {
      "index": 30,
      "start_time": 80.8,
      "end_time": 83.2,
      "text": "あ、ほんとだ、ぷにぷにしてる"
    },
    {
      "index": 31,
      "start_time": 84.8,
      "end_time": 85.7,
      "text": "ジュンさんも！"
    },
    {
      "index": 32,
      "start_time": 86.0,
      "end_time": 89.1,
      "text": "私は鎧を着てるから。そんなことより……"
    },
    {
      "index": 33,
      "start_time": 90.0,
      "end_time": 92.7,
      "text": "キミはどうやってここに入ってきたんだい？"
    }
  ],
