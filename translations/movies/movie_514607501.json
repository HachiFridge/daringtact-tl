{
  "movie_id": 514607501,
  "subtitles": [
    {
      "index": 0,
      "start_time": 0.2,
      "end_time": 2.0,
      "text": "カフェ『ナッシュ・カッツェ』って知ってる？"
    },
    {
      "index": 1,
      "start_time": 2.6,
      "end_time": 4.1,
      "text": "タマキとモニカが開いた"
    },
    {
      "index": 2,
      "start_time": 4.3,
      "end_time": 7.9,
      "text": "駄菓子とたい焼きと、猫が自慢の喫茶店でさ"
    },
    {
      "index": 3,
      "start_time": 8.2,
      "end_time": 10.9,
      "text": "私もちょくちょく行くのよね～"
    },
    {
      "index": 4,
      "start_time": 11.5,
      "end_time": 14.1,
      "text": "そのオープン記念にアキノが持ってきたのが"
    },
    {
      "index": 5,
      "start_time": 14.5,
      "end_time": 16.2,
      "text": "この招き猫ってわけ"
    },
    {
      "index": 6,
      "start_time": 16.9,
      "end_time": 22.0,
      "text": "……招き猫って商売繁盛を願った縁起物のはずなんだけど……"
    },
    {
      "index": 7,
      "start_time": 22.8,
      "end_time": 25.0,
      "text": "いや見た目邪悪すぎない？"
    },
    {
      "index": 8,
      "start_time": 26.1,
      "end_time": 31.9,
      "text": "ま、それもそのはず。実はこの子は呪いの招き猫でさ"
    },
    {
      "index": 9,
      "start_time": 32.3,
      "end_time": 36.5,
      "text": "その不思議な力で、お客さんをどんどん招いちゃって……"
    },
    {
      "index": 10,
      "start_time": 36.8,
      "end_time": 38.8,
      "text": "しまいには魔物まで招いちゃって"
    },
    {
      "index": 11,
      "start_time": 39.1,
      "end_time": 41.9,
      "text": "かーなりヤバかったらしいのよね"
    },
    {
      "index": 12,
      "start_time": 42.7,
      "end_time": 44.2,
      "text": "そんな危なっかしい子だけど"
    },
    {
      "index": 13,
      "start_time": 44.4,
      "end_time": 47.8,
      "text": "タマキとモニカのおかげで落ち着きを取り戻してからは"
    },
    {
      "index": 14,
      "start_time": 48.0,
      "end_time": 50.9,
      "text": "お店の看板猫として立派にやってるわ"
    },
    {
      "index": 15,
      "start_time": 51.9,
      "end_time": 54.3,
      "text": "ちなみに『グランドリームパーク』では"
    },
    {
      "index": 16,
      "start_time": 54.7,
      "end_time": 57.8,
      "text": "お客さんを招く力は使ってないみたいよ"
    },
    {
      "index": 17,
      "start_time": 58.1,
      "end_time": 63.0,
      "text": "100％、クルルとマホの頑張りよね～、やるじゃない"
    },
    {
      "index": 18,
      "start_time": 63.8,
      "end_time": 67.0,
      "text": "そんなわけで、この招き猫に興味があったら"
    },
    {
      "index": 19,
      "start_time": 67.2,
      "end_time": 69.3,
      "text": "今度『ナッシュ・カッツェ』に行ってみたら～？"
    },
    {
      "index": 20,
      "start_time": 69.7,
      "end_time": 73.9,
      "text": "なーんかどっかで見たことあるような猫もいるし、さ♪"
    }
  ],
