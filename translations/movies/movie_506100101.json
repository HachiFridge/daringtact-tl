  "subtitles": [
    {
      "index": 0,
      "start_time": 1.0,
      "end_time": 2.8,
      "text": "Oh no! What should I do?!"
    },
    {
      "index": 1,
      "start_time": 3.0,
      "end_time": 4.8,
      "text": "The excitement is getting to me!"
    },
    {
      "index": 2,
      "start_time": 5.8,
      "end_time": 8.2,
      "text": "You don't have to be so nervous"
    },
    {
      "index": 3,
      "start_time": 8.9,
      "end_time": 10.4,
      "text": "Geez, no way!"
    },
    {
      "index": 4,
      "start_time": 10.6,
      "end_time": 12.8,
      "text": "It's not everyday I get to wear a gorgeous dress, you know?"
    },
    {
      "index": 5,
      "start_time": 13.0,
      "end_time": 16.0,
      "text": "Of course I'd be excited!"
    },
    {
      "index": 6,
      "start_time": 17.0,
      "end_time": 20.0,
      "text": "Can't say I really understand that feeling..."
    },
    {
      "index": 7,
      "start_time": 20.2,
      "end_time": 25.2,
      "text": "But playing the role of a fairytale witch, it does stir something in me"
    },
    {
      "index": 8,
      "start_time": 26.4,
      "end_time": 28.0,
      "text": "Let's begin, shall we?"
    },
    {
      "index": 9,
      "start_time": 54.4,
      "end_time": 57.2,
      "text": "Hmm, that's pretty good, if I do say so myself"
    },
    {
      "index": 10,
      "start_time": 58.0,
      "end_time": 60.2,
      "text": "Wow... Wow!"
    },
    {
      "index": 11,
      "start_time": 60.8,
      "end_time": 62.6,
      "text": "It's my ideal dress!"
    },
    {
      "index": 12,
      "start_time": 62.8,
      "end_time": 65.0,
      "text": "Neneka-chan, you're absolutely amazing!"
    }
  ],
