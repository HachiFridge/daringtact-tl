{
  "movie_id": 504800301,
  "subtitles": [
    {
      "index": 0,
      "start_time": 9.8,
      "end_time": 11.4,
      "text": "お待たせ～"
    },
    {
      "index": 1,
      "start_time": 13.6,
      "end_time": 16.0,
      "text": "今そこでスカウトの人にさあ……"
    },
    {
      "index": 2,
      "start_time": 16.2,
      "end_time": 19.8,
      "text": "えっと～ヒデサイの友達のあかりんだよね？"
    },
    {
      "index": 3,
      "start_time": 20.2,
      "end_time": 24.0,
      "text": "うちスズナっていうの！　よろしくっ！"
    },
    {
      "index": 4,
      "start_time": 24.2,
      "end_time": 27.5,
      "text": "（ほ、本物のスズナさんだ！　嘘でしょ！？）"
    },
    {
      "index": 5,
      "start_time": 27.7,
      "end_time": 30.0,
      "text": "（てっきり冗談だと思ったのに……）"
    },
    {
      "index": 6,
      "start_time": 30.6,
      "end_time": 32.6,
      "text": "あ、えっと、ヨリ"
    },
    {
      "index": 7,
      "start_time": 33.0,
      "end_time": 33.8,
      "text": "...!"
    },
    {
      "index": 8,
      "start_time": 34.0,
      "end_time": 35.2,
      "text": "じゃなくてアカリです"
    },
    {
      "index": 9,
      "start_time": 35.4,
      "end_time": 37.2,
      "text": "よ、よろしく……！"
    },
    {
      "index": 10,
      "start_time": 38.0,
      "end_time": 41.4,
      "text": "今日はいっぱい楽しもうね、あっかりん！"
    },
    {
      "index": 11,
      "start_time": 42.2,
      "end_time": 44.8,
      "text": "……そういえば、もう一人……"
    },
    {
      "index": 12,
      "start_time": 45.2,
      "end_time": 46.2,
      "text": "あ、来た来た！"
    },
    {
      "index": 13,
      "start_time": 46.4,
      "end_time": 48.4,
      "text": "ゆきぽんちょーす！"
    },
    {
      "index": 14,
      "start_time": 48.8,
      "end_time": 51.8,
      "text": "（また凄い子来ちゃった！）"
    },
    {
      "index": 15,
      "start_time": 52.0,
      "end_time": 53.8,
      "text": "（アカリってスズナさんだけじゃなくて）"
    },
    {
      "index": 16,
      "start_time": 54.0,
      "end_time": 57.0,
      "text": "（こんな子とも友達なの……！？）"
    },
    {
      "index": 17,
      "start_time": 58.6,
      "end_time": 61.2,
      "text": "フゥ……まったくまいっちゃうね"
    },
    {
      "index": 18,
      "start_time": 61.8,
      "end_time": 63.8,
      "text": "今そこの角のお店の前で……"
    },
    {
      "index": 19,
      "start_time": 64.0,
      "end_time": 67.0,
      "text": "あ、ゆきぽんもスカウトに捕まっちゃった系？"
    },
    {
      "index": 20,
      "start_time": 67.6,
      "end_time": 68.4,
      "text": "いやあ"
    },
    {
      "index": 21,
      "start_time": 68.6,
      "end_time": 70.0,
      "text": "ショウウィンドウに映ったボクが"
    },
    {
      "index": 22,
      "start_time": 70.2,
      "end_time": 73.8,
      "text": "あまりにかわいくて見とれちゃったよ"
    },
    {
      "index": 23,
      "start_time": 74.2,
      "end_time": 77.0,
      "text": "（あ、でも変な子だ……）"
    },
    {
      "index": 24,
      "start_time": 82.0,
      "end_time": 87.4,
      "text": "えーっと確か……特徴的な眼鏡の人、だったよね～"
    },
    {
      "index": 25,
      "start_time": 87.8,
      "end_time": 90.0,
      "text": "おっ、ヨリ殿ヨリ殿！"
    },
    {
      "index": 26,
      "start_time": 90.8,
      "end_time": 92.0,
      "text": "こっちこっち！"
    },
    {
      "index": 27,
      "start_time": 92.8,
      "end_time": 94.6,
      "text": "見～つけた♪"
    },
    {
      "index": 28,
      "start_time": 95.4,
      "end_time": 98.0,
      "text": "ナナカさんですよね？　こんにちは！"
    },
    {
      "index": 29,
      "start_time": 98.4,
      "end_time": 99.4,
      "text": "Huh?"
    },
    {
      "index": 30,
      "start_time": 99.6,
      "end_time": 100.8,
      "text": "あーうん"
    },
    {
      "index": 31,
      "start_time": 101.0,
      "end_time": 103.2,
      "text": "そうだよ、ナナカちゃんだよ！"
    },
    {
      "index": 32,
      "start_time": 103.4,
      "end_time": 107.0,
      "text": "にゃっはは、ちゃんと来れて良かったよ～"
    },
    {
      "index": 33,
      "start_time": 107.2,
      "end_time": 109.4,
      "text": "他のメンバーは初めましてになるから"
    },
    {
      "index": 34,
      "start_time": 109.6,
      "end_time": 112.0,
      "text": "自己紹介、出来るかにゃ？"
    },
    {
      "index": 35,
      "start_time": 113.2,
      "end_time": 117.0,
      "text": "（本当はナナカさんとも初対面なんだけどね♪）"
    },
    {
      "index": 36,
      "start_time": 117.8,
      "end_time": 119.6,
      "text": "はーい♪　アカリは……"
    },
    {
      "index": 37,
      "start_time": 119.8,
      "end_time": 120.6,
      "text": "...!"
    },
    {
      "index": 38,
      "start_time": 120.8,
      "end_time": 122.6,
      "text": "私はヨリだよ～"
    },
    {
      "index": 39,
      "start_time": 123.4,
      "end_time": 126.2,
      "text": "今日はよろしくお願いしま～す！"
    },
    {
      "index": 40,
      "start_time": 126.8,
      "end_time": 130.8,
      "text": "うん？　何だか前とキャラが違うような……"
    },
    {
      "index": 41,
      "start_time": 131.0,
      "end_time": 132.6,
      "text": "Could it be..."
    },
    {
      "index": 42,
      "start_time": 133.6,
      "end_time": 134.8,
      "text": "はは～ん"
    },
    {
      "index": 43,
      "start_time": 135.0,
      "end_time": 139.0,
      "text": "さてはこういうとこではキャラを作るタイプでござったか～"
    },
    {
      "index": 44,
      "start_time": 139.6,
      "end_time": 141.8,
      "text": "その気持ち、分かりますぞ～"
    },
    {
      "index": 45,
      "start_time": 142.0,
      "end_time": 145.0,
      "text": "そ、そうそう！　そうなんですよ"
    },
    {
      "index": 46,
      "start_time": 145.2,
      "end_time": 147.0,
      "text": "あはははは～"
    },
    {
      "index": 47,
      "start_time": 147.4,
      "end_time": 150.2,
      "text": "まあまあいいじゃん、早く始めようぜ"
    },
    {
      "index": 48,
      "start_time": 150.6,
      "end_time": 153.0,
      "text": "っと、そうでござった"
    },
    {
      "index": 49,
      "start_time": 154.4,
      "end_time": 157.0,
      "text": "では、不肖幹事のわたくしナナカが"
    },
    {
      "index": 50,
      "start_time": 157.2,
      "end_time": 160.0,
      "text": "開催の音頭を取らせていただきますよ"
    },
    {
      "index": 51,
      "start_time": 160.6,
      "end_time": 162.0,
      "text": "Everyone!"
    },
    {
      "index": 52,
      "start_time": 162.4,
      "end_time": 164.2,
      "text": "元気ですかーー！？"
    },
    {
      "index": 53,
      "start_time": 164.6,
      "end_time": 166.0,
      "text": "Ehehe♪"
    },
    {
      "index": 54,
      "start_time": 166.8,
      "end_time": 169.0,
      "text": "おろ、どうされましたかな？"
    },
    {
      "index": 55,
      "start_time": 169.2,
      "end_time": 172.8,
      "text": "だって、ナナカさんって面白い人なんだも～ん"
    },
    {
      "index": 56,
      "start_time": 173.0,
      "end_time": 177.0,
      "text": "そんな褒められたら照れちゃいますなあ……てへへ♪"
    },
    {
      "index": 57,
      "start_time": 178.0,
      "end_time": 180.8,
      "text": "それに、みなさん優しそうな人ばかりで"
    },
    {
      "index": 58,
      "start_time": 181.0,
      "end_time": 184.0,
      "text": "とっても楽しくなりそうだな～って♪"
    },
    {
      "index": 59,
      "start_time": 184.4,
      "end_time": 185.6,
      "text": "ま、まぶしい！"
    },
    {
      "index": 60,
      "start_time": 186.0,
      "end_time": 189.8,
      "text": "これは本心からそう思っている完全陽キャラオーラ！"
    },
    {
      "index": 61,
      "start_time": 190.0,
      "end_time": 193.0,
      "text": "こいつはとんだコミュニケーション強者じゃないの……"
    },
    {
      "index": 62,
      "start_time": 193.2,
      "end_time": 195.4,
      "text": "楽しくなってきやがったぜぇ"
    },
    {
      "index": 63,
      "start_time": 195.8,
      "end_time": 198.8,
      "text": "（えへへ……いい人ばかりで良かった）"
    },
    {
      "index": 64,
      "start_time": 199.2,
      "end_time": 202.0,
      "text": "（お兄ちゃんも早く来ればいいのに！）"
    }
  ],
