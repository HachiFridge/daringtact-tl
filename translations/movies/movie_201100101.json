{
  "movie_id": 201100101,
  "subtitles": [
    {
      "index": 0,
      "start_time": 0.7,
      "end_time": 3.3,
      "text": "Wahahahahahah!"
    },
    {
      "index": 1,
      "start_time": 6.0,
      "end_time": 6.8,
      "text": "Hiyahhhh!"
    },
    {
      "index": 2,
      "start_time": 7.0,
      "end_time": 9.3,
      "text": "Nguahh!"
    },
    {
      "index": 3,
      "start_time": 10.0,
      "end_time": 11.1,
      "text": "Hahahahah!"
    },
    {
      "index": 4,
      "start_time": 11.5,
      "end_time": 15.7,
      "text": "Bow before Novem, the world's greatest supervillain!"
    },
    {
      "index": 5,
      "start_time": 16.4,
      "end_time": 19.3,
      "text": "(Nice—that's all the Nightmare guards' attention on me!)"
    },
    {
      "index": 6,
      "start_time": 19.7,
      "end_time": 21.7,
      "text": "(Good luck in the palace, you guys!)"
    },
    {
      "index": 7,
      "start_time": 22.1,
      "end_time": 23.4,
      "text": "Hey! You there, girl!"
    },
    {
      "index": 8,
      "start_time": 23.6,
      "end_time": 24.2,
      "text": "Hm?"
    },
    {
      "index": 9,
      "start_time": 25.6,
      "end_time": 28.8,
      "text": "Stop this at once and surrender to the authorities!"
    },
    {
      "index": 10,
      "start_time": 29.0,
      "end_time": 31.1,
      "text": "Yeah, yeah! You can't wave that thing around!"
    },
    {
      "index": 11,
      "start_time": 31.5,
      "end_time": 34.5,
      "text": "What if you hurt the innocent people enjoying the festival?!"
    },
    {
      "index": 12,
      "start_time": 35.1,
      "end_time": 37.7,
      "text": "Whoa... You guys! It's been ages!"
    },
    {
      "index": 13,
      "start_time": 41.6,
      "end_time": 42.9,
      "text": "Someone you know?"
    },
    {
      "index": 14,
      "start_time": 43.2,
      "end_time": 43.9,
      "text": "N-no..."
    },
    {
      "index": 15,
      "start_time": 49.3,
      "end_time": 50.0,
      "text": "Urgh..."
    },
    {
      "index": 16,
      "start_time": 55.7,
      "end_time": 56.2,
      "text": "...!"
    },
    {
      "index": 17,
      "start_time": 60.0,
      "end_time": 60.9,
      "text": "Yui Kusano!"
    },
    {
      "index": 18,
      "start_time": 61.4,
      "end_time": 62.0,
      "text": "Huh?"
    },
    {
      "index": 19,
      "start_time": 62.6,
      "end_time": 63.5,
      "text": "Nghh...!"
    },
    {
      "index": 20,
      "start_time": 64.8,
      "end_time": 67.0,
      "text": "Every last bit of this is your fault!"
    },
    {
      "index": 21,
      "start_time": 67.2,
      "end_time": 69.8,
      "text": "If you hadn't granted a wish like that...!"
    },
    {
      "index": 22,
      "start_time": 70.0,
      "end_time": 70.6,
      "text": "Huh...?"
    },
    {
      "index": 23,
      "start_time": 70.8,
      "end_time": 73.6,
      "text": "Root of all evil... Your life ends here!"
    },
    {
      "index": 24,
      "start_time": 74.2,
      "end_time": 78.2,
      "text": "Maybe without you, this world will go right back to normal!"
    },
    {
      "index": 25,
      "start_time": 78.5,
      "end_time": 79.4,
      "text": "...!"
    },
    {
      "index": 26,
      "start_time": 79.9,
      "end_time": 81.1,
      "text": "Yui, get back!"
    },
    {
      "index": 27,
      "start_time": 81.5,
      "end_time": 84.6,
      "text": "I don't understand what she's saying, but that hostility is no joke!"
    },
    {
      "index": 28,
      "start_time": 85.3,
      "end_time": 88.1,
      "text": "Hahah... Up for a fight?"
    },
    {
      "index": 29,
      "start_time": 88.5,
      "end_time": 91.3,
      "text": "Then let's go all out, just like old times!"
    }
  ],
