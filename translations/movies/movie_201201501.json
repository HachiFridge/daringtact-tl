      "text": "Aaaahhhh!"
    },
    {
      "index": 1,
      "start_time": 9.4,
      "end_time": 11.0,
      "text": "This room is shaking like crazy!"
    },
    {
      "index": 2,
      "start_time": 11.9,
      "end_time": 14.2,
      "text": "Is the whole palace about to collapse?!"
    },
    {
      "index": 3,
      "start_time": 14.6,
      "end_time": 16.2,
      "text": "We should get to safety!"
    },
    {
      "index": 4,
      "start_time": 16.3,
      "end_time": 18.1,
      "text": "That won't be necessary."
    },
    {
      "index": 5,
      "start_time": 18.4,
      "end_time": 19.0,
      "text": "?!"
    },
    {
      "index": 6,
      "start_time": 19.5,
      "end_time": 21.6,
      "text": "You'll all be dead soon enough,"
    },
    {
      "index": 7,
      "start_time": 22.0,
      "end_time": 24.8,
      "text": "so why bother struggling like fools?"
    },
    {
      "index": 8,
      "start_time": 26.5,
      "end_time": 27.0,
      "text": "Ahh!"
    },
    {
      "index": 9,
      "start_time": 27.2,
      "end_time": 28.0,
      "text": "Look over there!"
    },
    {
      "index": 10,
      "start_time": 28.2,
      "end_time": 29.3,
      "text": "What is that thing?!"
    },
    {
      "index": 11,
      "start_time": 29.9,
      "end_time": 33.4,
      "text": "Is that the brainwashing apparatus that the others were dealing with?"
    },
    {
      "index": 12,
      "start_time": 34.4,
      "end_time": 36.4,
      "text": "The accursed contraption"
    },
    {
      "index": 13,
      "start_time": 36.7,
      "end_time": 38.9,
      "text": "that left Miss Karyl in this state..."
    },
    {
      "index": 14,
      "start_time": 39.3,
      "end_time": 41.0,
      "text": "It gives off a foul aura."
    },
    {
      "index": 15,
      "start_time": 41.3,
      "end_time": 43.1,
      "text": "Where are Rajraj and Daigo?"
    },
    {
      "index": 16,
      "start_time": 43.8,
      "end_time": 45.2,
      "text": "I cannot imagine those two would..."
    },
    {
      "index": 17,
      "start_time": 45.5,
      "end_time": 45.9,
      "text": "Ahh!"
    },
    {
      "index": 18,
      "start_time": 53.2,
      "end_time": 54.0,
      "text": "Buegh!"
    },
    {
      "index": 19,
      "start_time": 54.6,
      "end_time": 55.5,
      "text": "Mistress Neneka!"
    },
    {
      "index": 20,
      "start_time": 55.9,
      "end_time": 56.9,
      "text": "Mistress Neneka...!"
    },
    {
      "index": 21,
      "start_time": 58.5,
      "end_time": 60.6,
      "text": "Mistress Neneka! Are you all right?!"
    },
    {
      "index": 22,
      "start_time": 61.6,
      "end_time": 63.5,
      "text": "...Unhh... Masa... ki..."
    },
    {
      "index": 23,
      "start_time": 63.8,
      "end_time": 64.3,
      "text": "Ahh!"
    },
    {
      "index": 24,
      "start_time": 64.5,
      "end_time": 65.8,
      "text": "You utter fool!"
    },
    {
      "index": 25,
      "start_time": 65.9,
      "end_time": 67.2,
      "text": "Don't come a step closer!"
    },
    {
      "index": 26,
      "start_time": 67.5,
      "end_time": 70.0,
      "text": "Forget about me and just run for your--"
