{
  "movie_id": 211200801,
  "subtitles": [
    {
      "index": 0,
      "start_time": 9.5,
      "end_time": 10.5,
      "text": "Ngh!1"
    },
    {
      "index": 1,
      "start_time": 12.2,
      "end_time": 14.7,
      "text": "Nghhh... I swear..."
    },
    {
      "index": 2,
      "start_time": 15.0,
      "end_time": 18.3,
      "text": "I'll put you back on track. Producer ......!"
    },
    {
      "index": 3,
      "start_time": 30.3,
      "end_time": 31.3,
      "text": "*sigh*..."
    },
    {
      "index": 4,
      "start_time": 33.1,
      "end_time": 34.0,
      "text": "Ooooooh!!"
    },
    {
      "index": 5,
      "start_time": 34.2,
      "end_time": 35.0,
      "text": "?!"
    },
    {
      "index": 6,
      "start_time": 38.1,
      "end_time": 39.6,
      "text": "(He saw through my real body...!?)"
    },
    {
      "index": 7,
      "start_time": 41.3,
      "end_time": 44.3,
      "text": "The breath of my master cannot be mistaken!"
    },
    {
      "index": 8,
      "start_time": 46.3,
      "end_time": 47.5,
      "text": "Well done...!"
    },
    {
      "index": 9,
      "start_time": 48.0,
      "end_time": 50.0,
      "text": "Please don't think badly of me...!"
    },
    {
      "index": 10,
      "start_time": 59.0,
      "end_time": 60.0,
      "text": "Chika! Tsumugi!"
    },
    {
      "index": 11,
      "start_time": 61.6,
      "end_time": 62.6,
      "text": "I'm sorry!"
    },
    {
      "index": 12,
      "start_time": 65.3,
      "end_time": 67.0,
      "text": "Heh, this is..."
    },
    {
      "index": 13,
      "start_time": 69.0,
      "end_time": 70.2,
      "text": "Spirit of the wind."
    },
    {
      "index": 14,
      "start_time": 73.6,
      "end_time": 74.4,
      "text": "!"
    },
    {
      "index": 15,
      "start_time": 75.0,
      "end_time": 76.0,
      "text": "!"
    },
    {
      "index": 16,
      "start_time": 77.3,
      "end_time": 78.2,
      "text": "I did it!"
    },
    {
      "index": 17,
      "start_time": 78.5,
      "end_time": 79.1,
      "text": "Not yet!"
    },
    {
      "index": 18,
      "start_time": 79.3,
      "end_time": 82.5,
      "text": "Removing the mask shouldn’t be enough to undo the brainwashing...!"
    },
    {
      "index": 19,
      "start_time": 84.0,
      "end_time": 86.0,
      "text": "Yes! We've taken countermeasures!"
    },
    {
      "index": 20,
      "start_time": 86.5,
      "end_time": 87.6,
      "text": "Now! Daigo!"
    },
    {
      "index": 21,
      "start_time": 88.1,
      "end_time": 89.1,
      "text": "You got it!"
    },
    {
      "index": 22,
      "start_time": 89.3,
      "end_time": 93.0,
      "text": "Come out, my Super Ultra Barrier!!"
    },
    {
      "index": 23,
      "start_time": 93.3,
      "end_time": 94.1,
      "text": "Ultra?"
    },
    {
      "index": 24,
      "start_time": 94.6,
      "end_time": 98.6,
      "text": "Uooooooohhh!!!"
    },
    {
      "index": 25,
      "start_time": 107.6,
      "end_time": 112.2,
      "text": "Brainwashing magic can’t be removed unless the source of the mana is cut off"
    },
    {
      "index": 26,
      "start_time": 112.5,
      "end_time": 113.6,
      "text": "In that case"
    },
    {
      "index": 27,
      "start_time": 116.6,
      "end_time": 120.0,
      "text": "If you can cut off the magic power that flows in through a special barrier"
    },
    {
      "index": 28,
      "start_time": 120.2,
      "end_time": 123.2,
      "text": "Even if it was temporary, the brainwashing state would be removed"
    },
    {
      "index": 29,
      "start_time": 123.4,
      "end_time": 124.3,
      "text": "So that's how it is"
    }
  ],
