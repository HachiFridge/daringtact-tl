{
  "movie_id": 514400601,
  "subtitles": [
    {
      "index": 0,
      "start_time": 7.5,
      "end_time": 8.5,
      "text": "Ugh..."
    },
    {
      "index": 1,
      "start_time": 8.9,
      "end_time": 11.5,
      "text": "Please let go of Suzume-san right now!"
    },
    {
      "index": 2,
      "start_time": 12.0,
      "end_time": 13.1,
      "text": "I refuse"
    },
    {
      "index": 3,
      "start_time": 13.6,
      "end_time": 17.2,
      "text": "Make any odd moves, and this woman's life is forfeit!"
    },
    {
      "index": 4,
      "start_time": 17.5,
      "end_time": 20.6,
      "text": "Ugh... You're as dirty as ever!"
    },
    {
      "index": 5,
      "start_time": 21.0,
      "end_time": 23.1,
      "text": "Please don't worry about me!"
    },
    {
      "index": 6,
      "start_time": 23.3,
      "end_time": 26.6,
      "text": "If we don't stop him, the village will be in complete chaos!"
    },
    {
      "index": 7,
      "start_time": 27.1,
      "end_time": 30.6,
      "text": "But that doesn't mean it's okay for Suzume-san to be sacrificed!"
    },
    {
      "index": 8,
      "start_time": 31.0,
      "end_time": 32.6,
      "text": "Kuhahaha!"
    },
    {
      "index": 9,
      "start_time": 32.8,
      "end_time": 34.6,
      "text": "How touching, but..."
    },
    {
      "index": 10,
      "start_time": 35.1,
      "end_time": 37.6,
      "text": "I don't care! Crush them utterly!"
    },
    {
      "index": 11,
      "start_time": 46.0,
      "end_time": 47.0,
      "text": "Kya!"
    },
    {
      "index": 12,
      "start_time": 47.3,
      "end_time": 49.9,
      "text": "Ugh...!"
    },
    {
      "index": 13,
      "start_time": 54.6,
      "end_time": 56.2,
      "text": "... Kyouka-chan..."
    },
    {
      "index": 14,
      "start_time": 57.2,
      "end_time": 59.7,
      "text": "Please don't bully her!"
    },
    {
      "index": 15,
      "start_time": 60.3,
      "end_time": 61.2,
      "text": "What the!?"
    },
    {
      "index": 16,
      "start_time": 62.9,
      "end_time": 66.3,
      "text": "Yargh! ... W-w-w-whaaaa...."
    },
    {
      "index": 17,
      "start_time": 67.4,
      "end_time": 68.2,
      "text": "Ah!"
    },
    {
      "index": 18,
      "start_time": 69.5,
      "end_time": 71.0,
      "text": "～～"
    },
    {
      "index": 19,
      "start_time": 71.1,
      "end_time": 72.1,
      "text": "Ah!"
    },
    {
      "index": 20,
      "start_time": 72.6,
      "end_time": 76.5,
      "text": "..."
    },
    {
      "index": 21,
      "start_time": 85.4,
      "end_time": 87.3,
      "text": "...I-I won't forgive you!"
    },
    {
      "index": 22,
      "start_time": 88.3,
      "end_time": 90.0,
      "text": "How dare you do that to Suzume-san!"
    },
    {
      "index": 23,
      "start_time": 90.4,
      "end_time": 95.2,
      "text": "She worked as hard as she could for the Flower Festival!"
    },
    {
      "index": 24,
      "start_time": 95.6,
      "end_time": 98.8,
      "text": "What!?! No, no, she just fell on his own!"
    },
    {
      "index": 25,
      "start_time": 99.1,
      "end_time": 101.7,
      "text": "It's not my fault! Right?"
    },
    {
      "index": 26,
      "start_time": 101.9,
      "end_time": 104.2,
      "text": "*munch munch*..."
    },
    {
      "index": 27,
      "start_time": 104.6,
      "end_time": 106.5,
      "text": "..."
    },
    {
      "index": 28,
      "start_time": 106.8,
      "end_time": 112.0,
      "text": "The young lady was kind even to an outcast like me..."
    },
    {
      "index": 29,
      "start_time": 112.5,
      "end_time": 116.7,
      "text": "She gave me the opportunity to truly change! That's...!"
    },
    {
      "index": 30,
      "start_time": 117.0,
      "end_time": 119.7,
      "text": "It somehow seems like I did it, but I really didn't!"
    },
    {
      "index": 31,
      "start_time": 120.3,
      "end_time": 122.1,
      "text": "You were watching, weren't you, boy?!"
    },
    {
      "index": 32,
      "start_time": 122.3,
      "end_time": 123.6,
      "text": "Haaaaah~"
    },
    {
      "index": 33,
      "start_time": 123.8,
      "end_time": 125.6,
      "text": "Hey! Something's not right!"
    },
    {
      "index": 34,
      "start_time": 125.9,
      "end_time": 127.2,
      "text": "Are you trying to make excuses?"
    },
    {
      "index": 35,
      "start_time": 127.5,
      "end_time": 129.6,
      "text": "You are a suspicious creep!"
    },
    {
      "index": 36,
      "start_time": 130.3,
      "end_time": 132.2,
      "text": "Is this what adults do!?"
    },
    {
      "index": 37,
      "start_time": 132.4,
      "end_time": 133.8,
      "text": "Please reflect on your actions"
    },
    {
      "index": 38,
      "start_time": 134.0,
      "end_time": 135.7,
      "text": "I will take you to Nightmare."
    },
    {
      "index": 39,
      "start_time": 136.6,
      "end_time": 140.7,
      "text": "You guys are dirty, planning to blame me for her clumsiness!"
    },
    {
      "index": 40,
      "start_time": 141.2,
      "end_time": 144.4,
      "text": "That's enough, dispose of them all!"
    },
    {
      "index": 41,
      "start_time": 144.6,
      "end_time": 145.3,
      "text": "...Hm?"
    },
    {
      "index": 42,
      "start_time": 145.5,
      "end_time": 148.3,
      "text": "*glug glug glug*"
    },
    {
      "index": 43,
      "start_time": 149.0,
      "end_time": 152.3,
      "text": "Was it always this big?"
    },
    {
      "index": 44,
      "start_time": 152.6,
      "end_time": 154.6,
      "text": "*glug, glug*!"
    },
    {
      "index": 45,
      "start_time": 156.3,
      "end_time": 157.8,
      "text": "Eeeeeeeek!?"
    },
    {
      "index": 46,
      "start_time": 158.0,
      "end_time": 158.6,
      "text": "～～??"
    },
    {
      "index": 47,
      "start_time": 159.2,
      "end_time": 161.0,
      "text": "What the!?"
    },
    {
      "index": 48,
      "start_time": 165.3,
      "end_time": 166.5,
      "text": "Kyuu..."
    },
    {
      "index": 49,
      "start_time": 167.3,
      "end_time": 171.2,
      "text": "I forgot about the detergent..."
    },
    {
      "index": 50,
      "start_time": 172.0,
      "end_time": 173.3,
      "text": "...... Huh?"
    }
  ],
