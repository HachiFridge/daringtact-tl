{
  "movie_id": 511800501,
  "subtitles": [
    {
      "index": 0,
      "start_time": 7.4,
      "end_time": 8.1,
      "text": "?!"
    },
    {
      "index": 1,
      "start_time": 16.5,
      "end_time": 18.6,
      "text": "Amazing...! It's flying!"
    },
    {
      "index": 2,
      "start_time": 19.2,
      "end_time": 20.6,
      "text": "We're truly flying!"
    },
    {
      "index": 3,
      "start_time": 21.5,
      "end_time": 23.5,
      "text": "Yay!"
    },
    {
      "index": 4,
      "start_time": 24.6,
      "end_time": 26.6,
      "text": "Y-You're right..."
    },
    {
      "index": 5,
      "start_time": 27.0,
      "end_time": 30.2,
      "text": "Thank goodness, I thought we were done for..."
    },
    {
      "index": 6,
      "start_time": 31.0,
      "end_time": 32.0,
      "text": "Just kidding♪"
    },
    {
      "index": 7,
      "start_time": 32.3,
      "end_time": 36.1,
      "text": "I believed we could fly from the very start! Haha!"
    },
    {
      "index": 8,
      "start_time": 37.0,
      "end_time": 39.3,
      "text": "Alright! Let's go, then!"
    },
    {
      "index": 9,
      "start_time": 39.6,
      "end_time": 42.1,
      "text": "Full speed... Ahead!"
    },
    {
      "index": 10,
      "start_time": 70.6,
      "end_time": 72.1,
      "text": "...!"
    },
    {
      "index": 11,
      "start_time": 75.1,
      "end_time": 76.2,
      "text": "?"
    },
    {
      "index": 12,
      "start_time": 78.6,
      "end_time": 81.6,
      "text": "We're almost there! Vikala! Do-chan!"
    },
    {
      "index": 13,
      "start_time": 82.2,
      "end_time": 84.1,
      "text": "Get ready to land, okay!?"
    },
    {
      "index": 14,
      "start_time": 85.1,
      "end_time": 87.2,
      "text": "We're ready to give a proper welcome..."
    },
    {
      "index": 15,
      "start_time": 87.5,
      "end_time": 88.6,
      "text": "With a \"bang\", that is♪"
    },
    {
      "index": 16,
      "start_time": 91.2,
      "end_time": 92.0,
      "text": "Eh?"
    },
    {
      "index": 17,
      "start_time": 92.4,
      "end_time": 93.6,
      "text": "H-Huh?"
    },
    {
      "index": 18,
      "start_time": 94.3,
      "end_time": 96.6,
      "text": "Something's wrong with the magic stone all of a sudden...?"
    },
    {
      "index": 19,
      "start_time": 99.4,
      "end_time": 100.2,
      "text": "?!"
    },
    {
      "index": 20,
      "start_time": 100.5,
      "end_time": 102.1,
      "text": "D-Djeetaaaaa!"
    },
    {
      "index": 21,
      "start_time": 102.3,
      "end_time": 104.5,
      "text": "The propellers! The propeller's have stopped!"
    },
    {
      "index": 22,
      "start_time": 105.2,
      "end_time": 106.1,
      "text": "Whaaat?!"
    },
    {
      "index": 23,
      "start_time": 111.2,
      "end_time": 112.2,
      "text": "Huh?"
    },
    {
      "index": 24,
      "start_time": 115.1,
      "end_time": 117.8,
      "text": "Waaaaahhhh!"
    },
    {
      "index": 25,
      "start_time": 118.0,
      "end_time": 122.1,
      "text": "Grrr...! No, we can't dodge the manor anymore...!"
    },
    {
      "index": 26,
      "start_time": 122.6,
      "end_time": 124.6,
      "text": "Sorry! Prepare yourselves, you two!"
    },
    {
      "index": 27,
      "start_time": 125.1,
      "end_time": 126.1,
      "text": "Y-Yeah...!"
    },
    {
      "index": 28,
      "start_time": 148.5,
      "end_time": 150.2,
      "text": "U-Ugh..."
    },
    {
      "index": 29,
      "start_time": 150.4,
      "end_time": 153.1,
      "text": "Oops, no vomit, safe..."
    },
    {
      "index": 30,
      "start_time": 154.1,
      "end_time": 155.5,
      "text": "A-Are you ok?"
    },
    {
      "index": 31,
      "start_time": 155.7,
      "end_time": 157.3,
      "text": "Are we still alive?"
    },
    {
      "index": 32,
      "start_time": 157.6,
      "end_time": 161.0,
      "text": "Looks... like it. Ahaha..."
    },
    {
      "index": 33,
      "start_time": 162.3,
      "end_time": 163.2,
      "text": "Are you okay?"
    },
    {
      "index": 34,
      "start_time": 166.6,
      "end_time": 168.1,
      "text": "We're here to help!"
    },
    {
      "index": 35,
      "start_time": 168.5,
      "end_time": 169.8,
      "text": "...\"Bang\", I guess! ♪"
    }
  ],
