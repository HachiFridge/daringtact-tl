      "text": "..."
    },
    {
      "index": 5,
      "start_time": 31.0,
      "end_time": 32.2,
      "text": "Are you okay?"
    },
    {
      "index": 6,
      "start_time": 39.2,
      "end_time": 43.0,
      "text": "It's time for me to fulfill my role."
    },
    {
      "index": 7,
      "start_time": 44.0,
      "end_time": 45.8,
      "text": "Grim Burst!"
    },
    {
      "index": 8,
      "start_time": 49.0,
      "end_time": 51.0,
      "text": "Princess strike!"
    },
    {
      "index": 9,
      "start_time": 55.8,
      "end_time": 56.4,
      "text": "Did we do it!?"
    },
    {
      "index": 10,
      "start_time": 56.6,
      "end_time": 57.2,
      "text": "No, it's still-"
    },
    {
      "index": 11,
      "start_time": 57.4,
      "end_time": 58.4,
      "text": "?!"
    },
    {
      "index": 12,
      "start_time": 61.0,
      "end_time": 62.0,
      "text": "...!"
    },
    {
      "index": 13,
      "start_time": 68.0,
      "end_time": 69.8,
      "text": "Stand back, you two...!"
    },
    {
      "index": 14,
      "start_time": 70.0,
      "end_time": 70.8,
      "text": "...?"
    },
    {
      "index": 15,
      "start_time": 74.0,
      "end_time": 75.8,
      "text": "Eh..."
    },
    {
      "index": 16,
      "start_time": 76.6,
      "end_time": 80.0,
      "text": "Hey, it's dangerous, [i]you[/i] need to stand back!"
    },
    {
      "index": 17,
      "start_time": 81.0,
      "end_time": 84.0,
      "text": "No, I need to be the one to do this."
    },
    {
      "index": 18,
      "start_time": 84.8,
      "end_time": 85.8,
      "text": "?"
    },
    {
      "index": 19,
      "start_time": 86.0,
      "end_time": 89.6,
      "text": "This spirit is not rampaging out of its own\nfree will."
    },
    {
      "index": 20,
      "start_time": 91.8,
      "end_time": 94.6,
      "text": "We could not completely understand each\nother,"
    },
    {
      "index": 21,
      "start_time": 94.8,
      "end_time": 96.8,
      "text": "due to my immaturity."
    },
    {
      "index": 22,
      "start_time": 97.8,
      "end_time": 99.0,
      "text": "?!"
    },
    {
      "index": 23,
      "start_time": 104.8,
      "end_time": 107.0,
      "text": "But, that's not true anymore."
    },
    {
      "index": 24,
      "start_time": 107.8,
      "end_time": 112.0,
      "text": "Now, let us once again continue onward,\ntogether."
    },
    {
      "index": 25,
      "start_time": 112.8,
      "end_time": 115.8,
      "text": "Haaaa-"
    },
    {
