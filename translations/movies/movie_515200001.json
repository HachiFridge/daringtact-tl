{
  "movie_id": 515200001,
  "subtitles": [
    {
      "index": 0,
      "start_time": 1.2,
      "end_time": 3.6,
      "text": "What... is this place...?"
    },
    {
      "index": 1,
      "start_time": 5.3,
      "end_time": 7.5,
      "text": "Did that interference earlier cause this?"
    },
    {
      "index": 2,
      "start_time": 7.7,
      "end_time": 11.0,
      "text": "It seems something repainted this entire space..."
    },
    {
      "index": 3,
      "start_time": 11.2,
      "end_time": 12.9,
      "text": "Oh my, is this your home?"
    },
    {
      "index": 4,
      "start_time": 13.1,
      "end_time": 13.9,
      "text": "?!"
    },
    {
      "index": 5,
      "start_time": 14.1,
      "end_time": 17.2,
      "text": "Oh, sorry. I must have startled you"
    },
    {
      "index": 6,
      "start_time": 18.0,
      "end_time": 21.2,
      "text": "I'm having my castle overwritten onto this space"
    },
    {
      "index": 7,
      "start_time": 22.0,
      "end_time": 25.8,
      "text": "Worry not, it's not as if your tower is gone"
    },
    {
      "index": 8,
      "start_time": 26.3,
      "end_time": 29.0,
      "text": "Ah, it seems I haven't thanked you yet"
    },
    {
      "index": 9,
      "start_time": 29.8,
      "end_time": 31.8,
      "text": "...My deepest thanks for inviting me here"
    },
    {
      "index": 10,
      "start_time": 32.9,
      "end_time": 34.9,
      "text": "Who...are you?"
    },
    {
      "index": 11,
      "start_time": 36.0,
      "end_time": 40.7,
      "text": "I see. I haven't introduced myself yet. That was careless of me"
    },
    {
      "index": 12,
      "start_time": 43.3,
      "end_time": 48.4,
      "text": "My name is Echidna. I am a seeker of all knowledge"
    },
    {
      "index": 13,
      "start_time": 49.0,
      "end_time": 51.2,
      "text": "If I can learn more about the \"unknown\"..."
    },
    {
      "index": 14,
      "start_time": 51.5,
      "end_time": 55.3,
      "text": "Even different worlds will fall within my interest"
    },
    {
      "index": 15,
      "start_time": 56.2,
      "end_time": 62.1,
      "text": "In my original world, I'm known as the \"Witch of Greed\""
    }
  ],
