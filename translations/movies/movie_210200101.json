  "subtitles": [
    {
      "index": 0,
      "start_time": 14.0,
      "end_time": 17.3,
      "text": "I can't believe Yui is eating so much..."
    },
    {
      "index": 1,
      "start_time": 17.6,
      "end_time": 18.4,
      "text": "Yes..."
    },
    {
      "index": 2,
      "start_time": 18.9,
      "end_time": 20.8,
      "text": "This must be a first."
    },
    {
      "index": 3,
      "start_time": 21.5,
      "end_time": 24.6,
      "text": "Ahhh... It's so good! It's so good, but..."
    },
    {
      "index": 4,
      "start_time": 27.4,
      "end_time": 30.2,
      "text": "If I keep eating, I'll put on so much weight!"
    },
    {
      "index": 5,
      "start_time": 30.9,
      "end_time": 34.1,
      "text": "...'Course, for Pecorine, this is business as usual."
    },
    {
      "index": 6,
      "start_time": 38.4,
      "end_time": 39.7,
      "text": "Aaahhh!"
    },
    {
      "index": 7,
      "start_time": 40.4,
      "end_time": 41.7,
      "text": "That's not true at all!"
    },
    {
      "index": 8,
      "start_time": 42.1,
      "end_time": 46.0,
      "text": "This is the hungriest I've felt in my life!"
    }
  ],
