{
  "movie_id": 514200701,
  "subtitles": [
    {
      "index": 0,
      "start_time": 7.4,
      "end_time": 8.8,
      "text": "..."
    },
    {
      "index": 1,
      "start_time": 10.1,
      "end_time": 11.4,
      "text": "マコトさん……"
    },
    {
      "index": 2,
      "start_time": 13.6,
      "end_time": 17.6,
      "text": "その……ありがとうございました"
    },
    {
      "index": 3,
      "start_time": 19.3,
      "end_time": 20.2,
      "text": "Huh...?"
    },
    {
      "index": 4,
      "start_time": 21.2,
      "end_time": 23.6,
      "text": "い、今……何て……？"
    },
    {
      "index": 5,
      "start_time": 24.8,
      "end_time": 26.6,
      "text": "でっ……ですから……"
    },
    {
      "index": 6,
      "start_time": 27.9,
      "end_time": 30.5,
      "text": "ありがとう、と言ったのです……"
    },
    {
      "index": 7,
      "start_time": 31.1,
      "end_time": 33.3,
      "text": "おまえが？　誰に！？"
    },
    {
      "index": 8,
      "start_time": 33.5,
      "end_time": 35.4,
      "text": "あ、あなたにです！"
    },
    {
      "index": 9,
      "start_time": 36.5,
      "end_time": 40.2,
      "text": "……あなたのおかげで、勲章をもらえました"
    },
    {
      "index": 10,
      "start_time": 41.1,
      "end_time": 43.5,
      "text": "だからその……"
    },
    {
      "index": 11,
      "start_time": 44.9,
      "end_time": 46.0,
      "text": "……お礼です"
    },
    {
      "index": 12,
      "start_time": 46.4,
      "end_time": 50.7,
      "text": "そ、そうか……へへ"
    },
    {
      "index": 13,
      "start_time": 53.1,
      "end_time": 54.6,
      "text": "いいってことよ"
    },
    {
      "index": 14,
      "start_time": 55.1,
      "end_time": 59.1,
      "text": "素直じゃねえ誰かさんからお礼も聞けたことだしな？"
    },
    {
      "index": 15,
      "start_time": 66.5,
      "end_time": 67.6,
      "text": "よし"
    },
    {
      "index": 16,
      "start_time": 68.9,
      "end_time": 70.0,
      "text": "じゃあ行こうぜ"
    },
    {
      "index": 17,
      "start_time": 70.3,
      "end_time": 72.2,
      "text": "あ、待ってください"
    },
    {
      "index": 18,
      "start_time": 72.8,
      "end_time": 75.9,
      "text": "あなたにもう一つ、話しておきたい事が……"
    },
    {
      "index": 19,
      "start_time": 76.9,
      "end_time": 78.1,
      "text": "Um..."
    },
    {
      "index": 20,
      "start_time": 78.3,
      "end_time": 83.2,
      "text": "最初はあなたを、このおかたに近づく雌犬だと思っていたのです"
    },
    {
      "index": 21,
      "start_time": 84.0,
      "end_time": 87.1,
      "text": "つまり……このおかたを好きなのだと"
    },
    {
      "index": 22,
      "start_time": 90.5,
      "end_time": 92.6,
      "text": "あっ、あたしがこいつを！？"
    },
    {
      "index": 23,
      "start_time": 93.2,
      "end_time": 94.4,
      "text": "なわけないだろ！"
    },
    {
      "index": 24,
      "start_time": 94.6,
      "end_time": 97.1,
      "text": "ないないっ！　ぜーったいない！"
    },
    {
      "index": 25,
      "start_time": 98.1,
      "end_time": 100.3,
      "text": "……ふふ。ですわよね"
    },
    {
      "index": 26,
      "start_time": 100.6,
      "end_time": 104.4,
      "text": "私も、勲章をもらうのを手伝ってくださったことで"
    },
    {
      "index": 27,
      "start_time": 104.6,
      "end_time": 106.5,
      "text": "考えを改めましたわ"
    },
    {
      "index": 28,
      "start_time": 108.2,
      "end_time": 113.8,
      "text": "あなたは、私とこのおかたの仲を応援してくださったのだと♪"
    },
    {
      "index": 29,
      "start_time": 115.3,
      "end_time": 116.4,
      "text": "...Eh?"
    },
    {
      "index": 30,
      "start_time": 117.2,
      "end_time": 119.6,
      "text": "こんな方は初めてです……！"
    },
    {
      "index": 31,
      "start_time": 120.6,
      "end_time": 122.3,
      "text": "助かりますわ"
    },
    {
      "index": 32,
      "start_time": 122.7,
      "end_time": 125.6,
      "text": "私たち……その……"
    },
    {
      "index": 33,
      "start_time": 126.1,
      "end_time": 129.1,
      "text": "お友達に、なれますか？"
    },
    {
      "index": 34,
      "start_time": 130.0,
      "end_time": 136.1,
      "text": "や、その、応援してるつもりは……あたしは………"
    },
    {
      "index": 35,
      "start_time": 137.6,
      "end_time": 142.4,
      "text": "ユイの恋路を応援しなきゃだし……！"
    },
    {
      "index": 36,
      "start_time": 145.1,
      "end_time": 146.7,
      "text": "……なれませんか？"
    },
    {
      "index": 37,
      "start_time": 147.4,
      "end_time": 149.0,
      "text": "いいい、いや！"
    },
    {
      "index": 38,
      "start_time": 149.2,
      "end_time": 152.6,
      "text": "友達には、なりたいんだけどよ……"
    },
    {
      "index": 39,
      "start_time": 152.7,
      "end_time": 155.1,
      "text": "では、お友達ですわね♪"
    },
    {
      "index": 40,
      "start_time": 155.5,
      "end_time": 157.3,
      "text": "クスクスクス……♪"
    },
    {
      "index": 41,
      "start_time": 157.5,
      "end_time": 160.2,
      "text": "友達になれてよかったね"
    },
    {
      "index": 42,
      "start_time": 162.4,
      "end_time": 163.1,
      "text": "Yes♪"
    },
    {
      "index": 43,
      "start_time": 163.3,
      "end_time": 165.3,
      "text": "Ahaha..."
    }
  ],
