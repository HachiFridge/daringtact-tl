      "end_time": 5.0,
      "text": "Heh..."
    },
    {
      "index": 1,
      "start_time": 6.0,
      "end_time": 8.0,
      "text": "Full speed ahead, Princess!"
    },
    {
      "index": 2,
      "start_time": 8.3,
      "end_time": 9.3,
      "text": "Please wait!"
    },
    {
      "index": 3,
      "start_time": 9.5,
      "end_time": 10.2,
      "text": "?!"
    },
    {
      "index": 4,
      "start_time": 10.5,
      "end_time": 11.6,
      "text": "Kokkoro!?"
    },
    {
      "index": 5,
      "start_time": 12.5,
      "end_time": 14.4,
      "text": "Um, the left shoulder..."
    },
    {
      "index": 6,
      "start_time": 15.4,
      "end_time": 17.8,
      "text": "Inside the crystal is..."
    },
    {
      "index": 7,
      "start_time": 18.1,
      "end_time": 19.3,
      "text": "Don't tell me..."
    },
    {
      "index": 8,
      "start_time": 20.2,
      "end_time": 21.4,
      "text": "Lady Ameth...!?"
    },
    {
      "index": 9,
      "start_time": 21.6,
      "end_time": 22.3,
      "text": "You...!"
    },
    {
      "index": 10,
      "start_time": 22.5,
      "end_time": 23.8,
      "text": "she's a hostage?!"
    },
    {
      "index": 11,
      "start_time": 24.4,
      "end_time": 25.1,
      "text": "...!"
    },
    {
      "index": 12,
      "start_time": 28.2,
      "end_time": 30.6,
      "text": "Yes, that's right"
    },
    {
      "index": 13,
      "start_time": 32.0,
      "end_time": 35.3,
      "text": "Once you have collected all the Sol Orbs..."
    },
    {
      "index": 14,
      "start_time": 35.5,
      "end_time": 40.0,
      "text": "Let us exchange for the custody of this guide fairy."
    },
    {
      "index": 15,
      "start_time": 40.3,
      "end_time": 41.6,
      "text": "Sol orb...?!"
    },
    {
      "index": 16,
      "start_time": 42.4,
      "end_time": 45.5,
      "text": "If you don't want to, then... That's fine."
    },
    {
      "index": 17,
      "start_time": 46.2,
      "end_time": 47.3,
      "text": "In that case..."
    },
    {
      "index": 18,
      "start_time": 48.2,
      "end_time": 53.3,
      "text": "This guide fairy becomes the brain of \"Giant God\" until she is absorbed."
    },
    {
      "index": 19,
      "start_time": 54.1,
      "end_time": 55.6,
      "text": "How despicable...!"
    },
    {
      "index": 20,
      "start_time": 56.3,
      "end_time": 59.5,
      "text": "Not only Zane, but to also lay a hand on Lady Ameth...!"
    },
    {
      "index": 21,
      "start_time": 59.6,
      "end_time": 60.6,
      "text": "Heheh..."
    },
    {
      "index": 22,
      "start_time": 61.0,
      "end_time": 63.5,
      "text": "Good day, then"
    },
    {
      "index": 23,
      "start_time": 64.0,
      "end_time": 64.6,
      "text": "...!"
    },
    {
      "index": 24,
      "start_time": 65.3,
      "end_time": 67.3,
      "text": "The deadline is a week from now."
    },
    {
      "index": 25,
      "start_time": 67.6,
      "end_time": 70.3,
      "text": "I'll be waiting for you at the tower of Sol."
    }
