{
  "movie_id": 511100402,
  "subtitles": [
    {
      "index": 0,
      "start_time": 15.5,
      "end_time": 17.5,
      "text": "食らいやがれぇ！"
    },
    {
      "index": 1,
      "start_time": 25.2,
      "end_time": 27.4,
      "text": "ぐっ……やるじゃねえか！"
    },
    {
      "index": 2,
      "start_time": 27.6,
      "end_time": 29.0,
      "text": "カヤ、大丈夫！？"
    },
    {
      "index": 3,
      "start_time": 29.2,
      "end_time": 30.4,
      "text": "あ、ああ……ハッ！？"
    },
    {
      "index": 4,
      "start_time": 36.6,
      "end_time": 38.0,
      "text": "隙ありだ！"
    },
    {
      "index": 5,
      "start_time": 40.6,
      "end_time": 42.3,
      "text": "っ！？　おわわっ！？"
    },
    {
      "index": 6,
      "start_time": 45.3,
      "end_time": 48.0,
      "text": "相変わらず突っ走り過ぎだね"
    },
    {
      "index": 7,
      "start_time": 48.2,
      "end_time": 52.2,
      "text": "別にいいだろ？　オマエがそばにいてくれるんだからさ"
    },
    {
      "index": 8,
      "start_time": 53.0,
      "end_time": 57.5,
      "text": "エイエンノシアワセ……ミライハ、ゼツボウ……"
    },
    {
      "index": 9,
      "start_time": 58.1,
      "end_time": 60.6,
      "text": "シアワセヲ、ミンナニ……！"
    },
    {
      "index": 10,
      "start_time": 61.4,
      "end_time": 65.1,
      "text": "あんな姿になっても、理想は失っていないんだ……"
    },
    {
      "index": 11,
      "start_time": 65.3,
      "end_time": 68.3,
      "text": "ああ、大したもんだよ。でもな──"
    },
    {
      "index": 12,
      "start_time": 75.4,
      "end_time": 80.2,
      "text": "オレは今をありったけ楽しみながら、未来を掴んでやるんだよ！"
    },
    {
      "index": 13,
      "start_time": 80.6,
      "end_time": 85.5,
      "text": "辛い思いをしている人を笑顔にして、未来へ進む勇気を与える！"
    },
    {
      "index": 14,
      "start_time": 88.5,
      "end_time": 92.2,
      "text": "それがアイドル、それが私たちカルミナなんだ！"
    },
    {
      "index": 15,
      "start_time": 95.4,
      "end_time": 97.1,
      "text": "未来をこの手で！"
    },
    {
      "index": 16,
      "start_time": 97.3,
      "end_time": 99.4,
      "text": "HAAAAAAHHHHHHHH!!!"
    },
    {
      "index": 17,
      "start_time": 102.9,
      "end_time": 103.7,
      "text": "Now!"
    },
    {
      "index": 18,
      "start_time": 110.1,
      "end_time": 113.0,
      "text": "ク、クルナ……ヤメロ……"
    },
    {
      "index": 19,
      "start_time": 113.3,
      "end_time": 116.5,
      "text": "いこう、ノウェム。昔みたいにコンビプレイだ！"
    },
    {
      "index": 20,
      "start_time": 117.1,
      "end_time": 118.4,
      "text": "ああ、掴むぞ！"
    },
    {
      "index": 21,
      "start_time": 118.6,
      "end_time": 122.1,
      "text": "世界一の大悪党になる未来を、二人の手で！"
    },
    {
      "index": 22,
      "start_time": 122.6,
      "end_time": 125.2,
      "text": "ア、アアア……"
    },
    {
      "index": 23,
      "start_time": 125.5,
      "end_time": 127.2,
      "text": "Haaaahhhh!"
    },
    {
      "index": 24,
      "start_time": 141.3,
      "end_time": 143.6,
      "text": "コレガ……ミライ……"
    },
    {
      "index": 25,
      "start_time": 145.0,
      "end_time": 148.0,
      "text": "マブシイ、ナ……"
    }
