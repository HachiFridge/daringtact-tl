  "subtitles": [
    {
      "index": 0,
      "start_time": 6.7,
      "end_time": 8.8,
      "text": "I-I'm fine around them now"
    },
    {
      "index": 1,
      "start_time": 9.7,
      "end_time": 13.1,
      "text": "Besides, my power might come in handy"
    },
    {
      "index": 2,
      "start_time": 13.3,
      "end_time": 15.7,
      "text": "Ah, if she usesh that powersh...!"
    },
    {
      "index": 3,
      "start_time": 17.4,
      "end_time": 19.1,
      "text": "...Well then, if you would, Milady"
    },
    {
      "index": 4,
      "start_time": 19.3,
      "end_time": 20.7,
      "text": "Right..."
    },
    {
      "index": 5,
      "start_time": 21.0,
      "end_time": 22.5,
      "text": "*Fuuu*..."
    },
    {
      "index": 6,
      "start_time": 23.3,
      "end_time": 26.6,
      "text": "You suspicious perverts... RETURN HOME!"
    },
    {
      "index": 7,
      "start_time": 29.3,
      "end_time": 32.5,
      "text": "Aah...? Aaah..."
    },
    {
      "index": 8,
      "start_time": 32.4,
      "end_time": 33.3,
      "text": "Wha—?!"
    },
    {
      "index": 9,
      "start_time": 33.8,
      "end_time": 35.8,
      "text": "Okay, now's our chance!"
    },
    {
      "index": 10,
      "start_time": 36.2,
      "end_time": 36.9,
      "text": "Kya"
    },
    {
      "index": 11,
      "start_time": 37.6,
      "end_time": 39.3,
      "text": "I'll see you later..."
    },
    {
      "index": 12,
      "start_time": 39.6,
      "end_time": 42.2,
      "text": "Grace-san, you can stay!"
    },
    {
      "index": 13,
      "start_time": 42.4,
      "end_time": 45.0,
      "text": "Ah... My bad"
    },
    {
      "index": 14,
      "start_time": 47.4,
      "end_time": 48.5,
      "text": "Huh?"
    },
    {
      "index": 15,
      "start_time": 50.2,
      "end_time": 51.6,
      "text": "GET LOST!"
    },
    {
      "index": 16,
      "start_time": 52.0,
      "end_time": 53.5,
      "text": "As if I'd... LET YOU!"
    },
    {
      "index": 17,
      "start_time": 59.7,
      "end_time": 61.4,
      "text": "Th-Thank you for your help..."
    },
    {
      "index": 18,
      "start_time": 61.6,
      "end_time": 65.1,
      "text": "No worry. That said... she has no openings"
    },
    {
      "index": 19,
      "start_time": 65.3,
      "end_time": 66.9,
      "text": "There was one just now!"
    },
    {
      "index": 20,
      "start_time": 67.3,
      "end_time": 69.3,
      "text": "If that'sh the casesh, the two of ush will..."
    },
    {
      "index": 21,
      "start_time": 69.6,
      "end_time": 70.6,
      "text": "Yeah..."
    },
    {
      "index": 22,
      "start_time": 71.9,
      "end_time": 73.2,
      "text": "Haahhhh!"
    },
    {
      "index": 23,
      "start_time": 73.7,
      "end_time": 75.3,
      "text": "I'm beggingsh you...!"
    },
    {
      "index": 24,
      "start_time": 81.5,
      "end_time": 85.0,
      "text": "Ugh, cunning little brats!!!"
    },
    {
      "index": 25,
      "start_time": 85.5,
      "end_time": 87.5,
      "text": "I-I won't losesh!"
    },
    {
      "index": 26,
      "start_time": 89.5,
      "end_time": 95.6,
      "text": "Wha... Ahahaha...!"
    },
    {
      "index": 27,
      "start_time": 96.3,
      "end_time": 98.1,
      "text": "Okay, now's our chance!"
    },
    {
      "index": 28,
      "start_time": 98.3,
      "end_time": 100.4,
      "text": "Ahhhh!"
    },
    {
      "index": 29,
      "start_time": 101.7,
      "end_time": 104.3,
      "text": "Pfffft..."
    },
    {
      "index": 30,
      "start_time": 104.6,
      "end_time": 107.0,
      "text": "Pupupupu...!"
    },
    {
      "index": 31,
      "start_time": 107.2,
      "end_time": 109.6,
      "text": "WHY ARE YOU GETTING CAUGHT UP IN IT?!"
    },
    {
      "index": 32,
      "start_time": 109.8,
      "end_time": 111.9,
      "text": "Huh? H-HEY!?"
    },
    {
      "index": 33,
      "start_time": 112.8,
      "end_time": 116.3,
      "text": "Ahahaha!"
    },
    {
      "index": 34,
      "start_time": 117.9,
      "end_time": 119.3,
      "text": "Wh-What shouldsh we do...?"
    },
    {
      "index": 35,
      "start_time": 119.5,
      "end_time": 120.6,
      "text": "I'll go and rescue them!"
    },
    {
      "index": 36,
      "start_time": 120.8,
      "end_time": 122.0,
      "text": "YAAAAAAAH~!"
    },
    {
      "index": 37,
      "start_time": 123.0,
      "end_time": 124.1,
      "text": "Wow"
    },
    {
      "index": 38,
      "start_time": 124.3,
      "end_time": 125.1,
      "text": "What?!"
    },
    {
      "index": 39,
      "start_time": 126.6,
      "end_time": 127.5,
      "text": "Pufuuuu!"
    },
    {
      "index": 40,
      "start_time": 127.7,
      "end_time": 128.4,
      "text": "Ueh!?"
    },
    {
      "index": 41,
      "start_time": 129.2,
      "end_time": 132.3,
      "text": "ENOUGH... OF THIS!!!!"
    },
    {
      "index": 42,
      "start_time": 133.8,
      "end_time": 135.6,
      "text": "YOU THIRD-RATE VILLAINESS!!!"
    },
    {
      "index": 43,
      "start_time": 136.1,
      "end_time": 138.2,
      "text": "Guessh you finallysh let your guard downsh!"
    },
    {
      "index": 44,
      "start_time": 139.7,
      "end_time": 141.3,
      "text": "Look up~"
    },
    {
      "index": 45,
      "start_time": 141.5,
      "end_time": 142.1,
      "text": "Wha—?!"
    },
    {
      "index": 46,
      "start_time": 142.2,
      "end_time": 147.2,
      "text": "I threwsh them upsh with my tentaclesh! Now'sh the time for unitysh!"
    },
    {
      "index": 47,
      "start_time": 147.6,
      "end_time": 149.1,
      "text": "Haahhhh!"
    },
    {
      "index": 48,
      "start_time": 150.4,
      "end_time": 152.3,
      "text": "Aaaah! Yaaah!"
    },
    {
      "index": 49,
      "start_time": 152.7,
      "end_time": 154.3,
      "text": "DAMN IT! I WILL NOT MAKE IT IN TIME~"
    },
    {
      "index": 50,
      "start_time": 156.0,
      "end_time": 158.5,
      "text": "Cake... cut!"
    },
    {
      "index": 51,
      "start_time": 161.0,
      "end_time": 165.5,
      "text": "MESSING AROUND EVEN AT THE VERY END...!"
    },
    {
      "index": 52,
      "start_time": 173.9,
      "end_time": 176.2,
      "text": "That was a good collaboration"
    },
    {
      "index": 53,
      "start_time": 176.6,
