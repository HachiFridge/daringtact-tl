  "subtitles": [
    {
      "index": 0,
      "start_time": 1.3,
      "end_time": 3.0,
      "text": "うにゃー……"
    },
    {
      "index": 1,
      "start_time": 4.5,
      "end_time": 6.3,
      "text": "疲れたねー……"
    },
    {
      "index": 2,
      "start_time": 7.0,
      "end_time": 8.0,
      "text": "そう？"
    },
    {
      "index": 3,
      "start_time": 8.3,
      "end_time": 11.1,
      "text": "やっと今からバカンスを楽しめるというのに"
    },
    {
      "index": 4,
      "start_time": 11.3,
      "end_time": 13.0,
      "text": "疲れてしまったのか"
    },
    {
      "index": 5,
      "start_time": 13.5,
      "end_time": 17.4,
      "text": "二人とも、残念だけど、ヒヨリはそっとしておいてあげよう"
    },
    {
      "index": 6,
      "start_time": 17.6,
      "end_time": 21.1,
      "text": "レイさーん！　仲間はずれにしないでよー！"
    },
    {
      "index": 7,
      "start_time": 24.0,
      "end_time": 25.0,
      "text": "ほらほら"
    },
    {
      "index": 8,
      "start_time": 25.2,
      "end_time": 26.5,
      "text": "ユイちゃんもレイさんも立って！"
    },
    {
      "index": 9,
      "start_time": 28.2,
      "end_time": 29.1,
      "text": "Hiyori-chan?!"
    },
    {
      "index": 10,
      "start_time": 29.3,
      "end_time": 30.3,
      "text": "ちょっとヒヨリ！"
    },
    {
      "index": 11,
      "start_time": 31.5,
      "end_time": 32.6,
      "text": "騎士くーん！"
    },
    {
      "index": 12,
      "start_time": 33.4,
      "end_time": 35.5,
      "text": "あたしたち先に行ってるねー！"
    },
    {
      "index": 13,
      "start_time": 42.5,
      "end_time": 43.3,
      "text": "あのね"
    },
    {
      "index": 14,
      "start_time": 43.9,
      "end_time": 45.9,
      "text": "ユイちゃん。レイさん……"
    },
    {
      "index": 15,
      "start_time": 48.4,
      "end_time": 51.2,
      "text": "分かるよ。ヒヨリちゃんの言いたいこと"
    },
    {
      "index": 16,
      "start_time": 51.5,
      "end_time": 54.3,
      "text": "ああ。昨日の夜に誓ったんだ"
    },
    {
      "index": 17,
      "start_time": 54.6,
      "end_time": 57.2,
      "text": "そう簡単に忘れたりしないさ"
    },
    {
      "index": 18,
      "start_time": 58.1,
      "end_time": 59.1,
      "text": "..."
    },
    {
      "index": 19,
      "start_time": 59.6,
      "end_time": 61.0,
      "text": "..."
    },
    {
      "index": 20,
      "start_time": 61.8,
      "end_time": 63.1,
      "text": "..."
    },
    {
      "index": 21,
      "start_time": 67.2,
      "end_time": 68.0,
      "text": "..."
    },
    {
      "index": 22,
      "start_time": 68.9,
      "end_time": 70.0,
      "text": "伝えよう"
    },
    {
      "index": 23,
      "start_time": 70.2,
      "end_time": 71.6,
      "text": "私たちの気持ちを"
    },
    {
      "index": 24,
      "start_time": 73.0,
      "end_time": 74.6,
      "text": "二人とも準備はいい？"
    },
    {
      "index": 25,
      "start_time": 75.0,
      "end_time": 75.8,
      "text": "It's all right"
    },
    {
      "index": 26,
      "start_time": 76.1,
      "end_time": 77.1,
      "text": "Okay!"
    },
    {
      "index": 27,
      "start_time": 82.6,
      "end_time": 84.0,
      "text": "大好きだよ！"
    }
