  "subtitles": [
    {
      "index": 0,
      "start_time": 22.8,
      "end_time": 23.8,
      "text": "...Miss Jun!"
    },
    {
      "index": 1,
      "start_time": 24.5,
      "end_time": 26.0,
      "text": "You have awoken already?!"
    },
    {
      "index": 2,
      "start_time": 26.4,
      "end_time": 27.0,
      "text": "Yes."
    },
    {
      "index": 3,
      "start_time": 27.4,
      "end_time": 29.0,
      "text": "I was only lightly knocked out."
    },
    {
      "index": 4,
      "start_time": 29.4,
      "end_time": 31.0,
      "text": "I am still in fighting condition."
    },
    {
      "index": 5,
      "start_time": 31.3,
      "end_time": 34.0,
      "text": "In fact, after that refreshing nap..."
    },
    {
      "index": 6,
      "start_time": 34.5,
      "end_time": 35.0,
      "text": "Hmm?"
    },
    {
      "index": 7,
      "start_time": 40.7,
      "end_time": 42.7,
      "text": "Young man... what are you doing here?"
    },
    {
      "index": 8,
      "start_time": 44.4,
      "end_time": 47.5,
      "text": "In fact, why am I in the dungeons?"
    },
    {
      "index": 9,
      "start_time": 48.2,
      "end_time": 49.8,
      "text": "I'm not sure I follow, but this is our chance!"
    },
    {
      "index": 10,
      "start_time": 50.0,
      "end_time": 52.0,
      "text": "Let us escape while she is confused!"
    },
    {
      "index": 11,
      "start_time": 54.2,
      "end_time": 54.7,
      "text": "Wh-whoa?!"
    },
    {
      "index": 12,
      "start_time": 57.2,
      "end_time": 58.4,
      "text": "Thank you very much!"
    },
    {
      "index": 13,
      "start_time": 61.2,
      "end_time": 63.8,
      "text": "Are you going to carry me like this?"
    },
    {
      "index": 14,
      "start_time": 65.0,
      "end_time": 66.0,
      "text": "Eheheh..."
    },
    {
      "index": 15,
      "start_time": 66.4,
      "end_time": 68.3,
      "text": "I'm really getting the princess treatment!"
    }
