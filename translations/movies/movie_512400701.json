{
  "movie_id": 512400701,
  "subtitles": [
    {
      "index": 0,
      "start_time": 3.7,
      "end_time": 4.3,
      "text": "Take this"
    },
    {
      "index": 1,
      "start_time": 4.5,
      "end_time": 5.3,
      "text": "Kyaa!"
    },
    {
      "index": 2,
      "start_time": 5.6,
      "end_time": 7.3,
      "text": "Haaa~♪"
    },
    {
      "index": 3,
      "start_time": 7.5,
      "end_time": 10.5,
      "text": "Guhehehe... How indecent!"
    },
    {
      "index": 4,
      "start_time": 11.2,
      "end_time": 13.2,
      "text": "Whoa, gogogogoh!"
    },
    {
      "index": 5,
      "start_time": 14.2,
      "end_time": 16.2,
      "text": "Hey! I told you to stop, kid!"
    },
    {
      "index": 6,
      "start_time": 16.5,
      "end_time": 19.3,
      "text": "Sadist-san, again please!"
    },
    {
      "index": 7,
      "start_time": 19.5,
      "end_time": 20.3,
      "text": "Eei!"
    },
    {
      "index": 8,
      "start_time": 20.5,
      "end_time": 21.5,
      "text": "Aaah!"
    },
    {
      "index": 9,
      "start_time": 22.0,
      "end_time": 22.8,
      "text": "Aaaaah!"
    },
    {
      "index": 10,
      "start_time": 23.3,
      "end_time": 25.0,
      "text": "Aaaaah! ♪"
    },
    {
      "index": 11,
      "start_time": 25.5,
      "end_time": 26.2,
      "text": "Take this"
    },
    {
      "index": 12,
      "start_time": 26.4,
      "end_time": 27.1,
      "text": "Yes~"
    },
    {
      "index": 13,
      "start_time": 27.5,
      "end_time": 28.6,
      "text": "More!"
    },
    {
      "index": 14,
      "start_time": 28.9,
      "end_time": 31.0,
      "text": "Do more to Kuuka!"
    },
    {
      "index": 15,
      "start_time": 34.4,
      "end_time": 35.3,
      "text": "Ranpha-san"
    },
    {
      "index": 16,
      "start_time": 36.6,
      "end_time": 38.2,
      "text": "Shinobu-chan..."
    },
    {
      "index": 17,
      "start_time": 38.5,
      "end_time": 40.5,
      "text": "Can I sit next to you?"
    },
    {
      "index": 18,
      "start_time": 41.2,
      "end_time": 43.2,
      "text": "S-Sure..."
    },
    {
      "index": 19,
      "start_time": 46.1,
      "end_time": 51.3,
      "text": "...Shinobu-chan, aren't you going to play with everyone...?"
    },
    {
      "index": 20,
      "start_time": 52.1,
      "end_time": 54.6,
      "text": "Of course, I'll play later"
    },
    {
      "index": 21,
      "start_time": 55.6,
      "end_time": 57.0,
      "text": "How about you, Ranpha-san?"
    },
    {
      "index": 22,
      "start_time": 58.0,
      "end_time": 65.2,
      "text": "I... I've told you this before,\nthat I can't get used to this..."
    },
    {
      "index": 23,
      "start_time": 66.3,
      "end_time": 67.5,
      "text": "I see..."
    },
    {
      "index": 24,
      "start_time": 68.2,
      "end_time": 72.1,
      "text": "In that case, I'd like to chat here a little longer"
    },
    {
      "index": 25,
      "start_time": 73.0,
      "end_time": 74.4,
      "text": "Huh...?"
    },
    {
      "index": 26,
      "start_time": 76.5,
      "end_time": 80.0,
      "text": "Thank you very much for your help this time, Ranpha-san"
    },
    {
      "index": 27,
      "start_time": 80.3,
      "end_time": 82.3,
      "text": "e...eh?"
    },
    {
      "index": 28,
      "start_time": 82.5,
      "end_time": 86.6,
      "text": "You've helped me out so many times during the exorcism, haven't you?"
    },
    {
      "index": 29,
      "start_time": 87.5,
      "end_time": 88.7,
      "text": "That's..."
    },
    {
      "index": 30,
      "start_time": 90.1,
      "end_time": 91.8,
      "text": "Don't worry about it"
    },
    {
      "index": 31,
      "start_time": 92.2,
      "end_time": 98.0,
      "text": "Shinobu-chan could have exorcised the spirits without me..."
    },
    {
      "index": 32,
      "start_time": 98.2,
      "end_time": 99.2,
      "text": "But still"
    },
    {
      "index": 33,
      "start_time": 99.8,
      "end_time": 103.4,
      "text": "Ranpha-san does sincerely support me"
    },
    {
      "index": 34,
      "start_time": 104.2,
      "end_time": 107.5,
      "text": "You really are a reliable person, Ranpha-san"
    },
    {
      "index": 35,
      "start_time": 108.2,
      "end_time": 109.2,
      "text": "...!"
    },
    {
      "index": 36,
      "start_time": 110.5,
      "end_time": 112.6,
      "text": "U, um..."
    },
    {
      "index": 37,
      "start_time": 112.9,
      "end_time": 113.6,
      "text": "Hey~"
    },
    {
      "index": 38,
      "start_time": 117.5,
      "end_time": 120.5,
      "text": "Hey! It took me a while to get here!"
    },
    {
      "index": 39,
      "start_time": 121.0,
      "end_time": 122.4,
      "text": "Shinobu-chan..."
    },
    {
      "index": 40,
      "start_time": 123.0,
      "end_time": 124.0,
      "text": "What is it?"
    },
    {
      "index": 41,
      "start_time": 124.6,
      "end_time": 129.2,
      "text": "If you ever need to exorcise spirits again..."
    },
    {
      "index": 42,
      "start_time": 129.6,
      "end_time": 132.4,
      "text": "Will you let me help you...?"
    },
    {
      "index": 43,
      "start_time": 132.9,
      "end_time": 133.9,
      "text": "...!"
    },
    {
      "index": 44,
      "start_time": 134.1,
      "end_time": 140.5,
      "text": "Yes. Let's help people a lot together... Ranpha-san"
    }
  ],
