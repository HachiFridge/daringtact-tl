{
  "movie_id": 508000201,
  "subtitles": [
    {
      "index": 0,
      "start_time": 10.2,
      "end_time": 11.0,
      "text": "どうだ、あんちゃん"
    },
    {
      "index": 1,
      "start_time": 11.2,
      "end_time": 13.2,
      "text": "オラにピッタリな衣装だべ？"
    },
    {
      "index": 2,
      "start_time": 13.5,
      "end_time": 17.2,
      "text": "いやぁ、こんないいもん作れるなんてリノちゃんはすげぇべや"
    },
    {
      "index": 3,
      "start_time": 18.0,
      "end_time": 20.0,
      "text": "私なんてまだまだですけど"
    },
    {
      "index": 4,
      "start_time": 20.2,
      "end_time": 22.2,
      "text": "喜んでもらえてよかったです！"
    },
    {
      "index": 5,
      "start_time": 22.6,
      "end_time": 24.0,
      "text": "..."
    },
    {
      "index": 6,
      "start_time": 24.6,
      "end_time": 26.2,
      "text": "ど、どうしたんですか？"
    },
    {
      "index": 7,
      "start_time": 26.6,
      "end_time": 29.4,
      "text": "やっぱり私には大人なデザインでしたかね……？"
    },
    {
      "index": 8,
      "start_time": 29.7,
      "end_time": 30.9,
      "text": "いいと思う"
    },
    {
      "index": 9,
      "start_time": 31.4,
      "end_time": 32.4,
      "text": "Really?!"
    },
    {
      "index": 10,
      "start_time": 32.6,
      "end_time": 35.1,
      "text": "冒険してみてよかった～"
    },
    {
      "index": 11,
      "start_time": 36.6,
      "end_time": 37.8,
      "text": "Mmm..."
    },
    {
      "index": 12,
      "start_time": 39.2,
      "end_time": 42.2,
      "text": "ミヤコは服よりもプリンが欲しかったの……"
    },
    {
      "index": 13,
      "start_time": 42.6,
      "end_time": 44.6,
      "text": "おぉ、よぉく似合ってるでねぇか"
    },
    {
      "index": 14,
      "start_time": 45.3,
      "end_time": 47.7,
      "text": "そんなめんこいミヤコちゃんが呼び込みすれば"
    },
    {
      "index": 15,
      "start_time": 47.9,
      "end_time": 50.0,
      "text": "千客万来間違いねぇべ！"
    },
    {
      "index": 16,
      "start_time": 50.5,
      "end_time": 51.4,
      "text": "お客さんがたくさん来れば"
    },
    {
      "index": 17,
      "start_time": 51.6,
      "end_time": 54.0,
      "text": "ご褒美のプリンもたくさんもらえますよ！"
    },
    {
      "index": 18,
      "start_time": 55.2,
      "end_time": 56.3,
      "text": "ほんとなの！？"
    },
    {
      "index": 19,
      "start_time": 56.5,
      "end_time": 57.4,
      "text": "約束なの！"
    },
    {
      "index": 20,
      "start_time": 57.6,
      "end_time": 59.6,
      "text": "破ったら化けて出てやるの！"
    },
    {
      "index": 21,
      "start_time": 60.5,
      "end_time": 61.4,
      "text": "もう化けてる"
    },
    {
      "index": 22,
      "start_time": 61.6,
      "end_time": 62.5,
      "text": "こらお兄ちゃん！"
    },
    {
      "index": 23,
      "start_time": 62.7,
      "end_time": 65.1,
      "text": "せっかくのやる気に水を差しちゃダメですよ！"
    },
    {
      "index": 24,
      "start_time": 66.3,
      "end_time": 69.4,
      "text": "ミヤコちゃんのやる気が消える前に始めるべさ"
    },
    {
      "index": 25,
      "start_time": 70.4,
      "end_time": 73.6,
      "text": "さぁさ、どなたさんもサンタさんも見てってけろ～"
    },
    {
      "index": 26,
      "start_time": 74.0,
      "end_time": 76.3,
      "text": "おいしいお菓子の移動販売だべさ！"
    },
    {
      "index": 27,
      "start_time": 76.5,
      "end_time": 79.5,
      "text": "一口食べると飛び上がっちゃいますよ～"
    },
    {
      "index": 28,
      "start_time": 80.3,
      "end_time": 82.4,
      "text": "飛び上がっちゃいますよ～……"
    },
    {
      "index": 29,
      "start_time": 82.6,
      "end_time": 83.0,
      "text": "Yeah..."
    },
    {
      "index": 30,
      "start_time": 85.2,
      "end_time": 85.6,
      "text": "...!"
    },
    {
      "index": 31,
      "start_time": 86.1,
      "end_time": 87.0,
      "text": "Pudding!"
    },
    {
      "index": 32,
      "start_time": 87.4,
      "end_time": 88.0,
      "text": "Mm"
    },
    {
      "index": 33,
      "start_time": 88.8,
      "end_time": 89.6,
      "text": "約束"
    },
    {
      "index": 34,
      "start_time": 90.1,
      "end_time": 91.6,
      "text": "……はっ！　思い出したの！"
    },
    {
      "index": 35,
      "start_time": 92.3,
      "end_time": 95.5,
      "text": "ミヤコちゃん、おばあさんのためにド派手に頼むべさ！"
    },
    {
      "index": 36,
      "start_time": 96.3,
      "end_time": 97.3,
      "text": "任せるの！"
    },
    {
      "index": 37,
      "start_time": 97.5,
      "end_time": 99.1,
      "text": "プリンのためなの！"
    },
    {
      "index": 38,
      "start_time": 103.0,
      "end_time": 105.5,
      "text": "Say ah!"
    },
    {
      "index": 39,
      "start_time": 106.5,
      "end_time": 108.1,
      "text": "んん～～～～～～！"
    },
    {
      "index": 40,
      "start_time": 108.6,
      "end_time": 111.3,
      "text": "ここのプリンは最高なの！"
    },
    {
      "index": 41,
      "start_time": 111.5,
      "end_time": 114.1,
      "text": "おいしくて飛び上がっちゃうの～～～～！"
    },
    {
      "index": 42,
      "start_time": 114.3,
      "end_time": 115.3,
      "text": "なんだなんだ？"
    },
    {
      "index": 43,
      "start_time": 115.5,
      "end_time": 116.4,
      "text": "おもしろい店だな"
    },
    {
      "index": 44,
      "start_time": 116.6,
      "end_time": 117.5,
      "text": "ちょっと見てみよう"
    },
    {
      "index": 45,
      "start_time": 117.7,
      "end_time": 120.4,
      "text": "おう！　どんどん見てってけろ！"
    },
    {
      "index": 46,
      "start_time": 122.5,
      "end_time": 124.0,
      "text": "ふっふっふ～"
    },
    {
      "index": 47,
      "start_time": 124.3,
      "end_time": 128.3,
      "text": "ミヤコのプリンのためにたくさんお菓子を買うがいいの！"
    }
  ],
