{
  "movie_id": 220700101,
  "subtitles": [
    {
      "index": 0,
      "start_time": 6.0,
      "end_time": 13.4,
      "text": "Pii, Pii..."
    },
    {
      "index": 1,
      "start_time": 14.6,
      "end_time": 16.6,
      "text": "Is this area fine?"
    },
    {
      "index": 2,
      "start_time": 17.5,
      "end_time": 19.5,
      "text": "Huff... huff..."
    },
    {
      "index": 3,
      "start_time": 28.1,
      "end_time": 28.9,
      "text": "Sword"
    },
    {
      "index": 4,
      "start_time": 34.5,
      "end_time": 35.7,
      "text": "──fear & fear"
    },
    {
      "index": 5,
      "start_time": 37.0,
      "end_time": 40.3,
      "text": "Gehenna soil drenched in blood, Infinite and countless"
    },
    {
      "index": 6,
      "start_time": 42.2,
      "end_time": 46.0,
      "text": "Avatar of Nue, Monstresses Manticore"
    },
    {
      "index": 7,
      "start_time": 46.4,
      "end_time": 50.2,
      "text": "Invite the fragments of your soul here──"
    },
    {
      "index": 8,
      "start_time": 52.4,
      "end_time": 55.2,
      "text": "One, two, three, four..."
    },
    {
      "index": 9,
      "start_time": 55.4,
      "end_time": 60.2,
      "text": "Infinite myriad of scythes, awaken from the depths of purgatory──"
    },
    {
      "index": 10,
      "start_time": 62.3,
      "end_time": 64.0,
      "text": "...!"
    },
    {
      "index": 11,
      "start_time": 65.1,
      "end_time": 67.6,
      "text": "Hey, stop it Kanon-chan!"
    },
    {
      "index": 12,
      "start_time": 68.2,
      "end_time": 71.1,
      "text": "You'll be punished by Nela-chan...!"
    },
    {
      "index": 13,
      "start_time": 71.5,
      "end_time": 73.1,
      "text": "You're so loud!"
    },
    {
      "index": 14,
      "start_time": 73.3,
      "end_time": 77.1,
      "text": "If I'm going to keep suffering such humiliation"
    },
    {
      "index": 15,
      "start_time": 77.3,
      "end_time": 79.6,
      "text": "I'd rather be dead!"
    },
    {
      "index": 16,
      "start_time": 81.5,
      "end_time": 82.2,
      "text": "That's right...!"
    },
    {
      "index": 17,
      "start_time": 82.4,
      "end_time": 85.2,
      "text": "Watch closely, Nephilim Nebula!"
    },
    {
      "index": 18,
      "start_time": 85.5,
      "end_time": 88.6,
      "text": "I'll definitely make you howl...!"
    }
  ],
