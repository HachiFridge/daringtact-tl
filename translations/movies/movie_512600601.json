    },
    {
      "index": 10,
      "start_time": 59.0,
      "end_time": 60.2,
      "text": "Now, Kyarucchi!"
    },
    {
      "index": 11,
      "start_time": 61.5,
      "end_time": 62.8,
      "text": "Suzuna!!"
    },
    {
      "index": 12,
      "start_time": 63.2,
