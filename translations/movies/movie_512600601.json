      "text": "I told you to run"
    },
    {
      "index": 13,
      "start_time": 65.5,
      "end_time": 66.3,
      "text": "Kyaha♪"
    },
    {
      "index": 14,
      "start_time": 66.6,
      "end_time": 69.6,
      "text": "You're... the best!!"
    },
    {
      "index": 15,
      "start_time": 70.5,
      "end_time": 71.6,
      "text": "Let's finish this!"
    },
    {
      "index": 16,
      "start_time": 79.2,
      "end_time": 81.4,
      "text": "Haaaaahhh!!"
    },
    {
      "index": 17,
      "start_time": 87.2,
      "end_time": 89.7,
      "text": "Gwaaaaahhh!!"
    },
    {
      "index": 18,
      "start_time": 90.5,
      "end_time": 93.5,
      "text": "Damn, you're not going down without a fight, huh?"
    },
    {
      "index": 19,
      "start_time": 93.7,
      "end_time": 95.5,
      "text": "Don't give up, Kyaru!"
    },
    {
      "index": 20,
      "start_time": 96.0,
      "end_time": 96.6,
      "text": "?!"
    },
    {
      "index": 21,
      "start_time": 97.1,
      "end_time": 99.4,
      "text": "That's right, we won't run away either!"
    },
    {
      "index": 22,
      "start_time": 99.6,
      "end_time": 102.6,
      "text": "Come on, Kyaru, do your best! We're with you."
    },
    {
      "index": 23,
      "start_time": 110.3,
      "end_time": 112.0,
      "text": "You guys..."
    },
    {
      "index": 24,
      "start_time": 112.4,
      "end_time": 114.4,
      "text": "Kyaru! Kyaru!"
    },
    {
      "index": 25,
      "start_time": 114.6,
      "end_time": 117.0,
      "text": "Kyaru! Kyaru!"
    },
    {
      "index": 26,
      "start_time": 117.2,
      "end_time": 119.3,
      "text": "Kyaru! Kyaru!"
    },
    {
      "index": 27,
      "start_time": 119.5,
      "end_time": 123.0,
      "text": "Kyaru! Kyaru! Kyaru!"
    },
    {
      "index": 28,
      "start_time": 123.5,
      "end_time": 124.6,
      "text": "Are you idiots?"
    },
    {
      "index": 29,
      "start_time": 124.8,
      "end_time": 130.6,
      "text": "...Why is power surging in me like this?!"
    },
    {
      "index": 30,
      "start_time": 134.5,
      "end_time": 139.1,
      "text": "Grr... This power, it's on par with Ambrose..."
    },
    {
      "index": 31,
      "start_time": 139.3,
      "end_time": 144.3,
      "text": "No, this is... Gaaaahh...!!!"
    },
    {
      "index": 32,
      "start_time": 153.1,
      "end_time": 153.9,
      "text": "Whoops...!"
    },
    {
      "index": 33,
      "start_time": 161.1,
      "end_time": 162.6,
      "text": "It's the power of youth, isn't it?"
    },
    {
      "index": 34,
      "start_time": 163.1,
      "end_time": 165.3,
      "text": "Oh, what is that? Embarrassing, isn't it?"
    },
    {
      "index": 35,
