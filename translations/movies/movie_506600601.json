  "subtitles": [
    {
      "index": 0,
      "start_time": 2.2,
      "end_time": 3.4,
      "text": "うおおおおお！！"
    },
    {
      "index": 1,
      "start_time": 3.6,
      "end_time": 5.8,
      "text": "てやあああああ！！"
    },
    {
      "index": 2,
      "start_time": 6.0,
      "end_time": 7.0,
      "text": "Ahh!"
    },
    {
      "index": 3,
      "start_time": 7.6,
      "end_time": 8.4,
      "text": "なんだぁ！？"
    },
    {
      "index": 4,
      "start_time": 8.6,
      "end_time": 11.2,
      "text": "あ、当たってないですぅ！"
    },
    {
      "index": 5,
      "start_time": 12.0,
      "end_time": 14.4,
      "text": "回避行動完了でス"
    },
    {
      "index": 6,
      "start_time": 17.6,
      "end_time": 21.4,
      "text": "攻撃が当たる前に、時間を止めて逃げてるんだ？"
    },
    {
      "index": 7,
      "start_time": 21.6,
      "end_time": 26.4,
      "text": "へぇ、この空間だとそんな風に認識させる事もできるんだぁ……"
    },
    {
      "index": 8,
      "start_time": 27.4,
      "end_time": 30.0,
      "text": "このままじゃあずっと当たらないね～"
    },
    {
      "index": 9,
      "start_time": 30.5,
      "end_time": 34.1,
      "text": "ねえ君。お願い、聞いてもらってもいいかな？"
    },
    {
      "index": 10,
      "start_time": 34.3,
      "end_time": 38.0,
      "text": "少し大きな力を使うから、二人をよろしくね"
    },
    {
      "index": 11,
      "start_time": 38.6,
      "end_time": 42.4,
      "text": "幸いここは通常とは違うフィールドだから"
    },
    {
      "index": 12,
      "start_time": 43.0,
      "end_time": 47.0,
      "text": "多少の過負荷をかけても外に影響はないよ～……"
    },
    {
      "index": 13,
      "start_time": 47.4,
      "end_time": 48.2,
      "text": "Hey!"
    },
    {
      "index": 14,
      "start_time": 50.6,
      "end_time": 53.4,
      "text": "タイムトンネルへの干渉を感知……"
    },
    {
      "index": 15,
      "start_time": 54.0,
      "end_time": 57.6,
      "text": "解析……不能……解析……不能……"
    },
    {
      "index": 16,
      "start_time": 60.5,
      "end_time": 63.0,
      "text": "ボスが何かやってくれたみたいだな"
    },
    {
      "index": 17,
      "start_time": 63.5,
      "end_time": 67.4,
      "text": "それにお兄さんも力が湧き上がるですよ！"
    },
    {
      "index": 18,
      "start_time": 68.0,
      "end_time": 69.6,
      "text": "へへ、サンキューな！"
    },
    {
      "index": 19,
      "start_time": 70.2,
      "end_time": 71.6,
      "text": "行くぜ、イノリ！！"
    },
    {
      "index": 20,
      "start_time": 73.0,
      "end_time": 73.8,
      "text": "まだ……ダ！"
    },
    {
      "index": 21,
      "start_time": 78.4,
      "end_time": 80.0,
      "text": "くそっ！　足が……っ！"
    },
    {
      "index": 22,
      "start_time": 80.2,
      "end_time": 81.2,
      "text": "カヤぴぃ！！"
    },
    {
      "index": 23,
      "start_time": 81.6,
      "end_time": 84.8,
      "text": "このまま時の牢獄ニ閉じ込めマス"
    },
    {
      "index": 24,
      "start_time": 85.2,
      "end_time": 86.2,
      "text": "させるかよ！"
    },
    {
      "index": 25,
      "start_time": 86.4,
      "end_time": 87.0,
      "text": "へ？？？"
    },
    {
      "index": 26,
      "start_time": 87.4,
      "end_time": 91.2,
      "text": "へへっ大見得切ったんだから根性見せろよ！　イノリ！"
    },
    {
      "index": 27,
      "start_time": 92.4,
      "end_time": 93.2,
      "text": "Ahh...?!"
    },
    {
      "index": 28,
      "start_time": 93.6,
      "end_time": 96.2,
      "text": "ちょっ、ちょっと！　ま、待つです！"
    },
    {
      "index": 29,
      "start_time": 96.4,
      "end_time": 98.2,
      "text": "いっけえええ～"
    },
    {
      "index": 30,
      "start_time": 98.5,
      "end_time": 101.0,
      "text": "カヤぴぃ～ィやあああ"
    },
    {
      "index": 31,
      "start_time": 101.4,
      "end_time": 102.0,
      "text": "ナ……"
    },
    {
      "index": 32,
      "start_time": 102.4,
      "end_time": 105.0,
      "text": "こうなりゃヤケクソですよ～！"
    },
    {
      "index": 33,
      "start_time": 109.6,
      "end_time": 112.4,
      "text": "うわああああああ！"
    },
    {
      "index": 34,
      "start_time": 114.4,
      "end_time": 115.2,
      "text": "ぶべっ！"
    },
    {
      "index": 35,
      "start_time": 117.2,
      "end_time": 118.8,
      "text": "そん、ナ……"
    }
