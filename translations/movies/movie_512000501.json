{
  "movie_id": 512000501,
  "subtitles": [
    {
      "index": 0,
      "start_time": 9.5,
      "end_time": 14.1,
      "text": "Now, the legendary vampire, Lady Illya Ornstein"
    },
    {
      "index": 1,
      "start_time": 14.5,
      "end_time": 18.6,
      "text": "Please make me your Familiar!"
    },
    {
      "index": 2,
      "start_time": 19.6,
      "end_time": 21.6,
      "text": "My Familiar...?"
    },
    {
      "index": 3,
      "start_time": 22.1,
      "end_time": 22.9,
      "text": "Yes...!"
    },
    {
      "index": 4,
      "start_time": 23.1,
      "end_time": 27.5,
      "text": "As a member of Lady Illya’s familiar, who has been fully revived after a long time"
    },
    {
      "index": 5,
      "start_time": 28.0,
      "end_time": 30.1,
      "text": "Give me your affection...!"
    },
    {
      "index": 6,
      "start_time": 30.5,
      "end_time": 32.3,
      "text": "Affection?"
    },
    {
      "index": 7,
      "start_time": 32.6,
      "end_time": 33.6,
      "text": "I refuse"
    },
    {
      "index": 8,
      "start_time": 34.3,
      "end_time": 35.2,
      "text": "I'm..."
    },
    {
      "index": 9,
      "start_time": 36.2,
      "end_time": 37.2,
      "text": "...?!"
    },
    {
      "index": 10,
      "start_time": 41.4,
      "end_time": 43.1,
      "text": "Bastard..."
    },
    {
      "index": 11,
      "start_time": 43.3,
      "end_time": 45.5,
      "text": "Is this...a vampire charm...?"
    },
    {
      "index": 12,
      "start_time": 45.7,
      "end_time": 47.5,
      "text": "Why are you...!?"
    },
    {
      "index": 13,
      "start_time": 48.1,
      "end_time": 50.6,
      "text": "I have one, too"
    },
    {
      "index": 14,
      "start_time": 51.0,
      "end_time": 54.6,
      "text": "The great power of the legendary vampire...!"
    },
    {
      "index": 15,
      "start_time": 56.2,
      "end_time": 57.4,
      "text": "You bastard...!"
    },
    {
      "index": 16,
      "start_time": 57.6,
      "end_time": 61.2,
      "text": "Are you trying to control me...!?"
    },
    {
      "index": 17,
      "start_time": 61.5,
      "end_time": 64.0,
      "text": "Mind control is terrifying...!"
    },
    {
      "index": 18,
      "start_time": 64.5,
      "end_time": 70.6,
      "text": "I’m just Illya-sama’s beloved follower of the ruler of the night"
    },
    {
      "index": 19,
      "start_time": 71.3,
      "end_time": 75.5,
      "text": "I just want to experience the legend with my own body!"
    },
    {
      "index": 20,
      "start_time": 76.2,
      "end_time": 77.3,
      "text": "Stop it...!"
    },
    {
      "index": 21,
      "start_time": 77.5,
      "end_time": 79.4,
      "text": "My love..."
    },
    {
      "index": 22,
      "start_time": 83.0,
      "end_time": 84.0,
      "text": "...!"
    },
    {
      "index": 23,
      "start_time": 84.6,
      "end_time": 85.4,
      "text": "?!"
    },
    {
      "index": 24,
      "start_time": 87.6,
      "end_time": 88.6,
      "text": "Wait a minute!"
    },
    {
      "index": 25,
      "start_time": 90.0,
      "end_time": 91.5,
      "text": "Yuki... You...!"
    },
    {
      "index": 26,
      "start_time": 94.5,
      "end_time": 97.2,
      "text": "What's all the fuss about?"
    },
    {
      "index": 27,
      "start_time": 98.0,
      "end_time": 101.6,
      "text": "If you're going to worship me, do it to me, the ruler of beauty"
    },
    {
      "index": 28,
      "start_time": 102.4,
      "end_time": 104.5,
      "text": "I don't want you to disturb me"
    },
    {
      "index": 29,
      "start_time": 108.5,
      "end_time": 112.1,
      "text": "...Hehe, it's a problem if you're too popular"
    },
    {
      "index": 30,
      "start_time": 113.5,
      "end_time": 115.6,
      "text": "Let's proceed with the ceremony while we still can"
    },
    {
      "index": 31,
      "start_time": 116.2,
      "end_time": 118.2,
      "text": "Now, Lady Illya...!"
    },
    {
      "index": 32,
      "start_time": 126.1,
      "end_time": 127.3,
      "text": "..."
    },
    {
      "index": 33,
      "start_time": 128.6,
      "end_time": 129.5,
      "text": "Haaah!"
    },
    {
      "index": 34,
      "start_time": 133.1,
      "end_time": 134.0,
      "text": "Ahh...!"
    },
    {
      "index": 35,
      "start_time": 137.1,
      "end_time": 139.1,
      "text": "I came to pick you up... Illya"
    },
    {
      "index": 36,
      "start_time": 141.2,
      "end_time": 143.0,
      "text": "......a human......!"
    },
    {
      "index": 37,
      "start_time": 144.2,
      "end_time": 145.5,
      "text": "I won’t let Illya have it"
    },
    {
      "index": 38,
      "start_time": 148.0,
      "end_time": 151.2,
      "text": "You're getting in the way of the start of a new legend..."
    },
    {
      "index": 39,
      "start_time": 151.7,
      "end_time": 152.6,
      "text": "You guys!"
    },
    {
      "index": 40,
      "start_time": 154.6,
      "end_time": 155.6,
      "text": "This is...!?"
    },
    {
      "index": 41,
      "start_time": 156.4,
      "end_time": 159.3,
      "text": "They're totally my slaves"
    },
    {
      "index": 42,
      "start_time": 160.2,
      "end_time": 161.2,
      "text": "What did you say?!"
    },
    {
      "index": 43,
      "start_time": 162.5,
      "end_time": 164.0,
      "text": "Let’s go, Illya"
    },
    {
      "index": 44,
      "start_time": 164.2,
      "end_time": 165.0,
      "text": "...umu"
    },
    {
      "index": 45,
      "start_time": 167.2,
      "end_time": 168.4,
      "text": "Ugh..."
    }
  ],
