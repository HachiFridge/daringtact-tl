{
  "movie_id": 511400701,
  "subtitles": [
    {
      "index": 0,
      "start_time": 1.5,
      "end_time": 7.1,
      "text": "こうして、カフェ『ナッシュカッツェ』は営業再開の日を迎えた"
    },
    {
      "index": 1,
      "start_time": 19.0,
      "end_time": 21.5,
      "text": "早く早くー！　駄菓子屋さん行こうよ！"
    },
    {
      "index": 2,
      "start_time": 21.7,
      "end_time": 23.1,
      "text": "こら、待ちなさい"
    },
    {
      "index": 3,
      "start_time": 23.3,
      "end_time": 25.0,
      "text": "お店は逃げたりしないから"
    },
    {
      "index": 4,
      "start_time": 25.2,
      "end_time": 28.6,
      "text": "パパだって猫ちゃんに会うの楽しみにしてるんでしょ！"
    },
    {
      "index": 5,
      "start_time": 35.0,
      "end_time": 39.4,
      "text": "呪われた招き猫は本当は呪われてなんかいなくて……"
    },
    {
      "index": 6,
      "start_time": 40.3,
      "end_time": 41.7,
      "text": "居場所を追い求めて"
    },
    {
      "index": 7,
      "start_time": 42.0,
      "end_time": 45.6,
      "text": "目標のために間違った手段を使ってしまっただけで"
    },
    {
      "index": 8,
      "start_time": 47.0,
      "end_time": 51.1,
      "text": "それは願いすぎてしまったあたしたちも同じだったにゃ"
    },
    {
      "index": 9,
      "start_time": 61.1,
      "end_time": 63.5,
      "text": "『ナッシュカッツェ』、営業再開だって！"
    },
    {
      "index": 10,
      "start_time": 64.0,
      "end_time": 65.3,
      "text": "楽しみだね！"
    },
    {
      "index": 11,
      "start_time": 69.9,
      "end_time": 72.0,
      "text": "だけど"
    },
    {
      "index": 12,
      "start_time": 74.9,
      "end_time": 77.6,
      "text": "間違っても、失敗しても"
    },
    {
      "index": 13,
      "start_time": 82.6,
      "end_time": 87.0,
      "text": "あたしたちは、またこのお店を開けるのにゃ"
    },
    {
      "index": 14,
      "start_time": 88.5,
      "end_time": 90.5,
      "text": "売り上げのためだけじゃなくて"
    },
    {
      "index": 15,
      "start_time": 91.5,
      "end_time": 94.6,
      "text": "あのお店ができて本当に良かったわ"
    },
    {
      "index": 16,
      "start_time": 95.4,
      "end_time": 98.4,
      "text": "またみんなが笑顔で集まれるのね"
    },
    {
      "index": 17,
      "start_time": 100.3,
      "end_time": 104.5,
      "text": "お客さんのために喜んでくれる人たちのために"
    },
    {
      "index": 18,
      "start_time": 106.2,
      "end_time": 109.2,
      "text": "なぜなら、何気ない日常に"
    },
    {
      "index": 19,
      "start_time": 110.5,
      "end_time": 112.5,
      "text": "平凡な毎日に──"
    },
    {
      "index": 20,
      "start_time": 113.4,
      "end_time": 117.1,
      "text": "一番の価値があるって今は知ってるからにゃ！"
    },
    {
      "index": 21,
      "start_time": 121.1,
      "end_time": 122.8,
      "text": "そして、今日も──"
    },
    {
      "index": 22,
      "start_time": 124.3,
      "end_time": 127.6,
      "text": "うむ、今日からここが、其方の定位置だ！"
    },
    {
      "index": 23,
      "start_time": 128.4,
      "end_time": 131.3,
      "text": "これからも看板猫としてよろしく頼むぞ"
    },
    {
      "index": 24,
      "start_time": 132.6,
      "end_time": 134.3,
      "text": "よく似合ってるにゃ！"
    },
    {
      "index": 25,
      "start_time": 134.6,
      "end_time": 137.6,
      "text": "さあ、二人とも！　『ナッシュカッツェ』、開店の時間だ！"
    },
    {
      "index": 26,
      "start_time": 138.5,
      "end_time": 140.3,
      "text": "今日も程よく稼ぐにゃー！"
    },
    {
      "index": 27,
      "start_time": 142.6,
      "end_time": 144.4,
      "text": "いらっしゃいませ！"
    }
  ],
