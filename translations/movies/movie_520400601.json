      "text": "SEIYAAA!"
    },
    {
      "index": 1,
      "start_time": 3.5,
      "end_time": 4.4,
      "text": "Haaah!"
    },
    {
      "index": 2,
      "start_time": 7.6,
      "end_time": 11.0,
      "text": "Ahaha! You must be pulling my leg with those attacks! What a joke!"
    },
    {
      "index": 3,
      "start_time": 11.8,
      "end_time": 12.8,
      "text": "Ugh...!"
    },
    {
      "index": 4,
      "start_time": 15.7,
      "end_time": 16.5,
      "text": "...?"
    },
    {
      "index": 5,
      "start_time": 19.7,
      "end_time": 21.0,
      "text": "...!"
    },
    {
      "index": 6,
      "start_time": 22.1,
      "end_time": 24.2,
      "text": "Everyone, I have a plan!!"
    },
    {
      "index": 7,
      "start_time": 24.8,
      "end_time": 25.8,
      "text": "Eh!?"
    },
    {
      "index": 8,
      "start_time": 26.1,
      "end_time": 27.7,
      "text": "Rui-chan, are you serious?!"
    },
    {
      "index": 9,
      "start_time": 28.1,
      "end_time": 32.3,
      "text": "...Are you sure? I will not hold back, you know?"
    },
    {
      "index": 10,
      "start_time": 32.8,
      "end_time": 33.7,
      "text": "Yes!"
    },
    {
      "index": 11,
      "start_time": 33.9,
      "end_time": 36.2,
      "text": "All right. I trust you, Rui-chan"
    },
    {
      "index": 12,
      "start_time": 38.0,
      "end_time": 39.1,
      "text": "......Come!!"
    },
    {
      "index": 13,
      "start_time": 40.0,
      "end_time": 42.1,
      "text": "Oh, are they done already?"
    },
    {
      "index": 14,
      "start_time": 45.2,
      "end_time": 46.5,
      "text": "...?!"
    },
    {
      "index": 15,
      "start_time": 47.2,
      "end_time": 48.4,
      "text": "EEEEEHHHH?!"
    },
    {
      "index": 16,
      "start_time": 53.1,
      "end_time": 54.9,
      "text": "Infighting!?"
    },
    {
      "index": 17,
      "start_time": 55.8,
      "end_time": 56.7,
      "text": "Aaaah!"
    },
    {
      "index": 18,
      "start_time": 57.3,
      "end_time": 58.0,
      "text": "Hahh!"
    },
    {
      "index": 19,
      "start_time": 58.5,
      "end_time": 59.3,
      "text": "Yahhh!"
    },
    {
      "index": 20,
      "start_time": 60.3,
      "end_time": 61.0,
      "text": "Haaah!"
    },
    {
      "index": 21,
      "start_time": 61.9,
      "end_time": 62.6,
      "text": "Hah!"
    },
    {
      "index": 22,
      "start_time": 63.1,
      "end_time": 63.9,
      "text": "Haaah!"
    },
    {
      "index": 23,
      "start_time": 65.8,
      "end_time": 66.6,
      "text": "Haaahhh!"
    },
    {
      "index": 24,
      "start_time": 66.9,
      "end_time": 68.8,
      "text": "...No, that's not it!"
    },
    {
      "index": 25,
      "start_time": 69.1,
      "end_time": 71.2,
      "text": "...Haaah!!"
    },
    {
      "index": 26,
      "start_time": 82.0,
      "end_time": 83.1,
      "text": "..."
    },
    {
      "index": 27,
      "start_time": 83.4,
      "end_time": 86.1,
      "text": "Trying to transmute our attacks together..."
    },
    {
      "index": 28,
      "start_time": 86.5,
      "end_time": 88.7,
      "text": "What imagination and application!"
    },
    {
      "index": 29,
      "start_time": 89.3,
      "end_time": 92.0,
      "text": "...This is why I hate alchemists, so!"
    },
    {
      "index": 30,
      "start_time": 92.6,
      "end_time": 95.0,
      "text": "Rui-chan! Take my power of strengthening!"
    },
    {
      "index": 31,
      "start_time": 95.9,
      "end_time": 98.4,
      "text": "(Huh...? What's this?)"
    },
    {
      "index": 32,
      "start_time": 98.6,
      "end_time": 102.0,
      "text": "(Darling's kind feelings are overflowing throughout my body...)"
    },
    {
      "index": 33,
      "start_time": 107.4,
      "end_time": 110.2,
      "text": "(Th-This must be...)"
    },
    {
      "index": 34,
      "start_time": 111.6,
      "end_time": 112.6,
      "text": "(Finally!)"
    },
    {
      "index": 35,
      "start_time": 112.8,
      "end_time": 113.6,
      "text": "Heh"
    },
    {
      "index": 36,
      "start_time": 128.2,
      "end_time": 131.4,
      "text": "(Does this mean me and Darling are finally married?!)"
    },
    {
      "index": 37,
      "start_time": 137.1,
      "end_time": 140.6,
      "text": "...Here it comes, our first collaboration attack...!"
    },
    {
      "index": 38,
      "start_time": 141.3,
      "end_time": 143.1,
      "text": "\"Ultimate Synthesis\"!!"
    },
    {
      "index": 39,
      "start_time": 143.7,
      "end_time": 147.9,
      "text": "Alright, it's done, the ultimate bomb! Now we can take 'em down..."
    },
    {
      "index": 40,
      "start_time": 148.2,
      "end_time": 150.0,
      "text": "This is bad, VERY BAD..."
    },
    {
      "index": 41,
      "start_time": 150.2,
      "end_time": 151.6,
      "text": "Hey, Mari..."
    },
    {
      "index": 42,
      "start_time": 152.0,
      "end_time": 154.6,
      "text": "GYAAAAAAHHHHHHH!!"
    },
    {
      "index": 43,
      "start_time": 161.0,
      "end_time": 162.1,
      "text": "Excellently done, Rui-chan!"
    },
    {
      "index": 44,
      "start_time": 162.8,
      "end_time": 163.8,
      "text": "...!"
    },
    {
      "index": 45,
      "start_time": 167.7,
      "end_time": 170.2,
      "text": "(Well... I am your soulmate, after all~♪)"
    }
