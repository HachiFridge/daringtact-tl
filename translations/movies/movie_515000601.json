{
  "movie_id": 515000601,
  "subtitles": [
    {
      "index": 0,
      "start_time": 7.0,
      "end_time": 8.5,
      "text": "Wait, Nebbia!"
    },
    {
      "index": 1,
      "start_time": 9.6,
      "end_time": 10.4,
      "text": "Wait...!"
    },
    {
      "index": 2,
      "start_time": 10.6,
      "end_time": 12.2,
      "text": "...!"
    },
    {
      "index": 3,
      "start_time": 17.2,
      "end_time": 22.0,
      "text": "Fio. You already have something important, right?"
    },
    {
      "index": 4,
      "start_time": 22.6,
      "end_time": 24.6,
      "text": "..."
    },
    {
      "index": 5,
      "start_time": 27.2,
      "end_time": 30.8,
      "text": "Sorry, I'm such a bothersome little sister."
    },
    {
      "index": 6,
      "start_time": 32.5,
      "end_time": 33.6,
      "text": "Nebbia...!"
    },
    {
      "index": 7,
      "start_time": 38.5,
      "end_time": 40.2,
      "text": "Ahhh!"
    },
    {
      "index": 8,
      "start_time": 42.6,
      "end_time": 44.2,
      "text": "Guh...!"
    },
    {
      "index": 9,
      "start_time": 44.4,
      "end_time": 46.6,
      "text": "Ngh... What are you doing!?"
    },
    {
      "index": 10,
      "start_time": 47.2,
      "end_time": 49.3,
      "text": "I understand! Do you know what will happen if you do that--"
    },
    {
      "index": 11,
      "start_time": 49.5,
      "end_time": 53.3,
      "text": "I don't understand! I don't understand anything, but──"
    },
    {
      "index": 12,
      "start_time": 54.1,
      "end_time": 56.0,
      "text": "I don't want to see Fio's sad face!"
    },
    {
      "index": 13,
      "start_time": 58.6,
      "end_time": 60.4,
      "text": "Then me too"
    },
    {
      "index": 14,
      "start_time": 62.6,
      "end_time": 64.6,
      "text": "Can I give you a hand?"
    },
    {
      "index": 15,
      "start_time": 68.7,
      "end_time": 71.2,
      "text": "Homare...why?"
    },
    {
      "index": 16,
      "start_time": 71.6,
      "end_time": 73.6,
      "text": "Do you really not understand the reason?"
    },
    {
      "index": 17,
      "start_time": 75.2,
      "end_time": 78.2,
      "text": "Now, what will you do? The path is open."
    },
    {
      "index": 18,
      "start_time": 80.2,
      "end_time": 83.3,
      "text": "Next I think it’s your turn to make a decision."
    },
    {
      "index": 19,
      "start_time": 88.6,
      "end_time": 91.5,
      "text": "...I am a guide fairy..."
    },
    {
      "index": 20,
      "start_time": 92.3,
      "end_time": 96.3,
      "text": "I would never do something to destroy this world..."
    },
    {
      "index": 21,
      "start_time": 98.8,
      "end_time": 103.2,
      "text": "The Princess Knight you have guided, is he that unreliable?"
    },
    {
      "index": 22,
      "start_time": 105.2,
      "end_time": 106.2,
      "text": "Fio!"
    },
    {
      "index": 23,
      "start_time": 107.3,
      "end_time": 108.6,
      "text": "Believe in me"
    },
    {
      "index": 24,
      "start_time": 111.0,
      "end_time": 112.6,
      "text": "..."
    },
    {
      "index": 25,
      "start_time": 115.5,
      "end_time": 118.0,
      "text": "...Yes. Thank you"
    },
    {
      "index": 26,
      "start_time": 123.2,
      "end_time": 125.2,
      "text": "...I'm coming now, Nebbia"
    },
    {
      "index": 27,
      "start_time": 136.3,
      "end_time": 137.5,
      "text": "?!"
    }
  ],
