      "text": "?"
    },
    {
      "index": 9,
      "start_time": 38.2,
      "end_time": 40.4,
      "text": "Wow... It's so pretty"
    },
    {
      "index": 10,
      "start_time": 42.6,
      "end_time": 46.6,
      "text": "\"Forbidden Elixir: No. 568\"...?"
    },
    {
      "index": 11,
      "start_time": 47.0,
      "end_time": 48.5,
      "text": "Hey, I wonder what this is..."
    },
    {
      "index": 12,
      "start_time": 56.9,
      "end_time": 57.9,
      "text": "Kyaa!"
    },
    {
      "index": 13,
      "start_time": 61.9,
      "end_time": 65.2,
      "text": "*cough*... Are you okay, Nozomi...?"
    },
    {
      "index": 14,
      "start_time": 66.4,
      "end_time": 67.5,
      "text": "...Nozomi?"
    },
    {
      "index": 15,
      "start_time": 69.1,
      "end_time": 71.1,
      "text": "...Nozomi? Nozomi...?"
    },
    {
      "index": 16,
      "start_time": 71.7,
      "end_time": 72.5,
      "text": "Nozomi!"
    },
    {
      "index": 17,
      "start_time": 72.7,
      "end_time": 73.4,
      "text": "Ungh..."
    },
    {
      "index": 18,
      "start_time": 73.6,
      "end_time": 74.4,
      "text": "Waugh!"
    },
    {
      "index": 19,
      "start_time": 74.7,
      "end_time": 84.0,
      "text": "*pant*...*pant pant*..."
    },
    {
      "index": 20,
      "start_time": 84.5,
      "end_time": 86.5,
      "text": "Ugh!"
    },
    {
      "index": 21,
      "start_time": 86.7,
      "end_time": 89.5,
      "text": "Nozomi!? Are you okay, Nozomi!?"
    },
    {
      "index": 22,
      "start_time": 96.2,
      "end_time": 98.1,
      "text": "......*sniff sniff*"
    },
    {
      "index": 23,
      "start_time": 100.3,
      "end_time": 101.5,
      "text": "...?"
    },
    {
      "index": 24,
      "start_time": 105.6,
      "end_time": 107.9,
      "text": "Huh? What's wrong, Nozomi? You're acting weird!"
    },
    {
      "index": 25,
      "start_time": 108.1,
      "end_time": 110.1,
      "text": "*sigh* This smell..."
    },
    {
      "index": 26,
      "start_time": 110.3,
      "end_time": 113.2,
      "text": "I can't stop myself...!"
    },
    {
      "index": 27,
      "start_time": 113.9,
      "end_time": 115.2,
      "text": "*Sniff, sniff* *sniff...*"
    },
    {
      "index": 28,
      "start_time": 116.1,
      "end_time": 117.0,
      "text": "...!"
    },
    {
      "index": 29,
      "start_time": 120.5,
      "end_time": 122.3,
      "text": "Nozomi... Someone's here!"
    },
    {
      "index": 30,
      "start_time": 122.6,
      "end_time": 125.0,
      "text": "*Sniff, sniff* *Sniff, sniff*"
    },
    {
      "index": 31,
      "start_time": 126.5,
      "end_time": 128.0,
      "text": "Oooh~!?"
    },
    {
      "index": 32,
      "start_time": 130.0,
      "end_time": 131.5,
      "text": "Ohhhh!?"
    },
    {
      "index": 33,
      "start_time": 131.8,
