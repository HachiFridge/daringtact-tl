{
  "movie_id": 514000701,
  "subtitles": [
    {
      "index": 0,
      "start_time": 1.2,
      "end_time": 3.0,
      "text": "皆さんには、同世代に届く"
    },
    {
      "index": 1,
      "start_time": 3.2,
      "end_time": 6.0,
      "text": "等身大のプロモーションを企画していただきます"
    },
    {
      "index": 2,
      "start_time": 7.2,
      "end_time": 8.4,
      "text": "Huh...?"
    },
    {
      "index": 3,
      "start_time": 12.3,
      "end_time": 15.2,
      "text": "で、等身大のプロモーションって何？"
    },
    {
      "index": 4,
      "start_time": 15.4,
      "end_time": 17.5,
      "text": "要は『案件』ってやつじゃないです？"
    },
    {
      "index": 5,
      "start_time": 17.8,
      "end_time": 22.3,
      "text": "配信界隈で企業が個人に依頼するというアレか"
    },
    {
      "index": 6,
      "start_time": 25.4,
      "end_time": 26.5,
      "text": "あ。コレうまっ"
    },
    {
      "index": 7,
      "start_time": 27.1,
      "end_time": 28.0,
      "text": "ほんとですか？"
    },
    {
      "index": 8,
      "start_time": 28.2,
      "end_time": 29.1,
      "text": "やんないよ"
    },
    {
      "index": 9,
      "start_time": 29.3,
      "end_time": 30.2,
      "text": "ブー"
    },
    {
      "index": 10,
      "start_time": 31.4,
      "end_time": 33.6,
      "text": "後輩、なんだその魔導具は"
    },
    {
      "index": 11,
      "start_time": 34.2,
      "end_time": 35.6,
      "text": "え、先輩それ……"
    },
    {
      "index": 12,
      "start_time": 36.0,
      "end_time": 38.2,
      "text": "ひょっとして、今カメラ回してます？"
    },
    {
      "index": 13,
      "start_time": 39.0,
      "end_time": 41.6,
      "text": "うん！　ぷろもーしょんむーびー！"
    },
    {
      "index": 14,
      "start_time": 42.4,
      "end_time": 45.5,
      "text": "ちょっと！　チエル今カオ作ってなかったんですけど！"
    },
    {
      "index": 15,
      "start_time": 45.7,
      "end_time": 48.5,
      "text": "なに肖像権侵害してんだコラ"
    },
    {
      "index": 16,
      "start_time": 49.5,
      "end_time": 51.7,
      "text": "おい、出演料は出るんだろうな"
    },
    {
      "index": 17,
      "start_time": 52.3,
      "end_time": 54.1,
      "text": "事務所通せ、事務所"
    },
    {
      "index": 18,
      "start_time": 54.6,
      "end_time": 57.4,
      "text": "これぞ全天候型屋内遊泳場──"
    },
    {
      "index": 19,
      "start_time": 57.6,
      "end_time": 60.0,
      "text": "『メルクリゾート・ウィスタリアンズ』ですわ！"
    },
    {
      "index": 20,
      "start_time": 60.5,
      "end_time": 62.5,
      "text": "すごーい、海だー"
    },
    {
      "index": 21,
      "start_time": 63.0,
      "end_time": 65.4,
      "text": "ステマ感やばって感じなんですけど"
    },
    {
      "index": 22,
      "start_time": 66.2,
      "end_time": 69.5,
      "text": "全体的に再考の余地がないこともないでしょう"
    },
    {
      "index": 23,
      "start_time": 70.1,
      "end_time": 72.5,
      "text": "ふわっとしたフルリテイクやめてもらっていいすか"
    },
    {
      "index": 24,
      "start_time": 73.4,
      "end_time": 75.3,
      "text": "冬といえばサマーですわ！"
    },
    {
      "index": 25,
      "start_time": 75.5,
      "end_time": 77.6,
      "text": "いや実際すごいんですけど"
    },
    {
      "index": 26,
      "start_time": 78.1,
      "end_time": 80.2,
      "text": "こんな山奥に作ることはなくないです！？"
    },
    {
      "index": 27,
      "start_time": 80.5,
      "end_time": 83.3,
      "text": "パイセーン！　寝たら死ぬぞー！！"
    },
    {
      "index": 28,
      "start_time": 87.1,
      "end_time": 89.7,
      "text": "いっそ爆発とかしてくんないかな"
    },
    {
      "index": 29,
      "start_time": 90.3,
      "end_time": 96.6,
      "text": "山の彼方の空遠く、楽園あると、人の云う……"
    },
    {
      "index": 30,
      "start_time": 100.1,
      "end_time": 102.2,
      "text": "『いつものうちら』ってなんだよ……"
    },
    {
      "index": 31,
      "start_time": 103.0,
      "end_time": 106.5,
      "text": "なんかもう、考えすぎて分かんなくなっちゃいましたね……"
    },
    {
      "index": 32,
      "start_time": 107.2,
      "end_time": 109.3,
      "text": "つまり端的に換言すれば……"
    },
    {
      "index": 33,
      "start_time": 110.5,
      "end_time": 112.0,
      "text": "ここが青春だ"
    },
    {
      "index": 34,
      "start_time": 112.5,
      "end_time": 114.5,
      "text": "いいから爆発しろー！"
    },
    {
      "index": 35,
      "start_time": 115.1,
      "end_time": 116.5,
      "text": "バリクソ感動っす"
    },
    {
      "index": 36,
      "start_time": 117.1,
      "end_time": 118.3,
      "text": "涙止まらぬ"
    },
    {
      "index": 37,
      "start_time": 118.7,
      "end_time": 120.0,
      "text": "ちぇらるれちぇぽぱ！"
    },
    {
      "index": 38,
      "start_time": 120.3,
      "end_time": 122.6,
      "text": "メリゾ最高～！"
    },
    {
      "index": 39,
      "start_time": 122.9,
      "end_time": 124.1,
      "text": "はいカットぉー！"
    },
    {
      "index": 40,
      "start_time": 124.9,
      "end_time": 128.2,
      "text": "あのさあ！　困るよ二人、何やって……"
    },
    {
      "index": 41,
      "start_time": 129.0,
      "end_time": 130.1,
      "text": "Huh...?"
    },
    {
      "index": 42,
      "start_time": 130.9,
      "end_time": 132.7,
      "text": "待って、なんか音してない？"
    },
    {
      "index": 43,
      "start_time": 133.5,
      "end_time": 135.9,
      "text": "して……ますねえ……"
    },
    {
      "index": 44,
      "start_time": 140.0,
      "end_time": 141.2,
      "text": "ちぇるーん"
    },
    {
      "index": 45,
      "start_time": 141.6,
      "end_time": 143.9,
      "text": "違うな……ちぇる──"
    },
    {
      "index": 46,
      "start_time": 146.1,
      "end_time": 147.1,
      "text": "へくちっ！"
    },
    {
      "index": 47,
      "start_time": 147.3,
      "end_time": 148.4,
      "text": "あ、コレうまっ"
    },
    {
      "index": 48,
      "start_time": 148.6,
      "end_time": 149.3,
      "text": "...!"
    },
    {
      "index": 49,
      "start_time": 150.6,
      "end_time": 153.6,
      "text": "メルクリゾートの新名所、エクスプロージョンエリア！"
    },
    {
      "index": 50,
      "start_time": 154.2,
      "end_time": 156.1,
      "text": "ただいま爆速建造中！"
    },
    {
      "index": 51,
      "start_time": 156.5,
      "end_time": 157.2,
      "text": "冬とっ！！　言えばっ！！"
    },
    {
      "index": 52,
      "start_time": 157.6,
      "end_time": 158.6,
      "text": "冬とっ！！　言えばっ！！"
    },
    {
      "index": 53,
      "start_time": 158.9,
      "end_time": 160.0,
      "text": "冬とっ！！　言えばっ！！"
    },
    {
      "index": 54,
      "start_time": 160.2,
      "end_time": 161.7,
      "text": "冬といえば～！！！"
    },
    {
      "index": 55,
      "start_time": 163.2,
      "end_time": 164.6,
      "text": "ボマー！！！"
    },
    {
      "index": 56,
      "start_time": 165.4,
      "end_time": 167.2,
      "text": "メルクリゾート・ウィスタリアンズ！"
    },
    {
      "index": 57,
      "start_time": 167.7,
      "end_time": 168.9,
      "text": "める～ん☆"
    }
  ],
