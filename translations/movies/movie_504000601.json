{
  "movie_id": 504000601,
  "subtitles": [
    {
      "index": 0,
      "start_time": 10.6,
      "end_time": 12.0,
      "text": "It's okay, Rinrin!"
    },
    {
      "index": 1,
      "start_time": 12.2,
      "end_time": 13.0,
      "text": "..."
    },
    {
      "index": 2,
      "start_time": 13.2,
      "end_time": 15.4,
      "text": "We're all here together."
    },
    {
      "index": 3,
      "start_time": 15.6,
      "end_time": 17.4,
      "text": "So there ain't nothin' to be afraid of!"
    },
    {
      "index": 4,
      "start_time": 20.0,
      "end_time": 21.6,
      "text": "Our counterattack begins now!"
    },
    {
      "index": 5,
      "start_time": 22.6,
      "end_time": 23.6,
      "text": "Let's do it!"
    },
    {
      "index": 6,
      "start_time": 24.0,
      "end_time": 28.2,
      "text": "We'll give ya a taste of Elizabeth Park's true power!"
    },
    {
      "index": 7,
      "start_time": 28.8,
      "end_time": 29.8,
      "text": "Hmph."
    },
    {
      "index": 8,
      "start_time": 30.0,
      "end_time": 33.0,
      "text": "It doesn't matter how many of you there are, nothing will change."
    },
    {
      "index": 9,
      "start_time": 34.4,
      "end_time": 36.0,
      "text": "That technique..."
    },
    {
      "index": 10,
      "start_time": 36.8,
      "end_time": 38.0,
      "text": "We'll see about that!"
    },
    {
      "index": 11,
      "start_time": 39.1,
      "end_time": 40.4,
      "text": "Hrrrah!"
    },
    {
      "index": 12,
      "start_time": 46.8,
      "end_time": 47.6,
      "text": "...!"
    },
    {
      "index": 13,
      "start_time": 49.5,
      "end_time": 50.8,
      "text": "Rin!"
    },
    {
      "index": 14,
      "start_time": 51.0,
      "end_time": 52.8,
      "text": "Hahahahahah!"
    },
    {
      "index": 15,
      "start_time": 53.3,
      "end_time": 57.0,
      "text": "You weren't even a good decoy. You died for nothing, little girl."
    },
    {
      "index": 16,
      "start_time": 57.4,
      "end_time": 59.6,
      "text": "...No way... Rinrin..."
    },
    {
      "index": 17,
      "start_time": 59.8,
      "end_time": 60.6,
      "text": "You called?"
    },
    {
      "index": 18,
      "start_time": 61.0,
      "end_time": 61.7,
      "text": "...!"
    },
    {
      "index": 19,
      "start_time": 62.8,
      "end_time": 63.8,
      "text": "What the—?!"
    },
    {
      "index": 20,
      "start_time": 63.9,
      "end_time": 65.6,
      "text": "Whew, that was real hot."
    },
    {
      "index": 21,
      "start_time": 65.8,
      "end_time": 68.6,
      "text": "I ran so hard my armor fell off, you know."
    },
    {
      "index": 22,
      "start_time": 69.0,
      "end_time": 71.8,
      "text": "But thanks to that, I could get close to you."
    },
    {
      "index": 23,
      "start_time": 73.4,
      "end_time": 74.6,
      "text": "Get off me!"
    },
    {
      "index": 24,
      "start_time": 74.8,
      "end_time": 77.4,
      "text": "You're not just mere farmers, are you?!"
    },
    {
      "index": 25,
      "start_time": 77.6,
      "end_time": 80.0,
      "text": "That's exactly what we are. Ain't no doubt about it."
    },
    {
      "index": 26,
      "start_time": 80.2,
      "end_time": 82.6,
      "text": "But 'cause we're all in this together,"
    },
    {
      "index": 27,
      "start_time": 83.0,
      "end_time": 84.8,
      "text": "there's no way we can lose."
    },
    {
      "index": 28,
      "start_time": 85.5,
      "end_time": 86.7,
      "text": "You impudent runt!"
    },
    {
      "index": 29,
      "start_time": 88.0,
      "end_time": 89.6,
      "text": "Come at me, little girl!"
    },
    {
      "index": 30,
      "start_time": 89.8,
      "end_time": 91.8,
      "text": "This time I'll skin you alive."
    },
    {
      "index": 31,
      "start_time": 92.2,
      "end_time": 93.4,
      "text": "Your weak spot's showing!"
    },
    {
      "index": 32,
      "start_time": 93.6,
      "end_time": 95.4,
      "text": "This is our chance, Shiori!"
    },
    {
      "index": 33,
      "start_time": 95.8,
      "end_time": 96.8,
      "text": "...!"
    },
    {
      "index": 34,
      "start_time": 100.4,
      "end_time": 101.6,
      "text": "Damn you all!"
    },
    {
      "index": 35,
      "start_time": 104.2,
      "end_time": 105.2,
      "text": "You're finished!"
    },
    {
      "index": 36,
      "start_time": 105.6,
      "end_time": 107.6,
      "text": "Mahy, now!"
    },
    {
      "index": 37,
      "start_time": 108.2,
      "end_time": 110.4,
      "text": "Feel the resentment of those"
    },
    {
      "index": 38,
      "start_time": 111.0,
      "end_time": 113.2,
      "text": "who suffered at your hands!"
    },
    {
      "index": 39,
      "start_time": 113.4,
      "end_time": 115.8,
      "text": "Gwahhh!"
    }
  ],
