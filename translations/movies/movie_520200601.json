{
  "movie_id": 520200601,
  "subtitles": [
    {
      "index": 0,
      "start_time": 7.3,
      "end_time": 10.6,
      "text": "(A gentle song. And yet... it sounds sad.)"
    },
    {
      "index": 1,
      "start_time": 13.7,
      "end_time": 16.4,
      "text": "(Ranpha-san is a sensitive person...)"
    },
    {
      "index": 2,
      "start_time": 17.0,
      "end_time": 20.6,
      "text": "(To the point where she feels the pain of those around her as if it were her own)"
    },
    {
      "index": 3,
      "start_time": 21.5,
      "end_time": 22.3,
      "text": "...!"
    },
    {
      "index": 4,
      "start_time": 23.1,
      "end_time": 26.2,
      "text": "(Even though Ranpha-san clearly treasures singing so much)"
    },
    {
      "index": 5,
      "start_time": 28.3,
      "end_time": 29.9,
      "text": "(Chika...chan...?)"
    },
    {
      "index": 6,
      "start_time": 31.0,
      "end_time": 32.7,
      "text": "(She's been terrified of it this whole time)"
    },
    {
      "index": 7,
      "start_time": 33.4,
      "end_time": 36.3,
      "text": "(Alone, with a delicate heart.)"
    },
    {
      "index": 8,
      "start_time": 37.2,
      "end_time": 38.4,
      "text": "(...Which is why)"
    },
    {
      "index": 9,
      "start_time": 38.6,
      "end_time": 40.6,
      "text": "(If you're hurting, I want to be there for you)"
    },
    {
      "index": 10,
      "start_time": 41.5,
      "end_time": 43.1,
      "text": "(I want to sing with you!)"
    },
    {
      "index": 11,
      "start_time": 47.8,
      "end_time": 49.5,
      "text": "Wow...!"
    },
    {
      "index": 12,
      "start_time": 51.0,
      "end_time": 53.1,
      "text": "(So dignified and warm...)"
    },
    {
      "index": 13,
      "start_time": 54.2,
      "end_time": 55.9,
      "text": "Ah... The buildings too!"
    },
    {
      "index": 14,
      "start_time": 56.5,
      "end_time": 58.5,
      "text": "(Am I allowed to sing, too...?)"
    },
    {
      "index": 15,
      "start_time": 59.1,
      "end_time": 62.3,
      "text": "(My Song Summoner song, together with you...)"
    },
    {
      "index": 16,
      "start_time": 67.6,
      "end_time": 69.1,
      "text": "What a gentle song"
    },
    {
      "index": 17,
      "start_time": 72.5,
      "end_time": 75.2,
      "text": "This is their power, isn't it?"
    },
    {
      "index": 18,
      "start_time": 75.5,
      "end_time": 76.5,
      "text": "Yeah..."
    }
  ],
