{
  "movie_id": 507400301,
  "subtitles": [
    {
      "index": 0,
      "start_time": 1.2,
      "end_time": 2.5,
      "text": "じゃ～～ん♪"
    },
    {
      "index": 1,
      "start_time": 3.6,
      "end_time": 6.0,
      "text": "ふふ、ふふふふ♪"
    },
    {
      "index": 2,
      "start_time": 6.5,
      "end_time": 7.2,
      "text": "..."
    },
    {
      "index": 3,
      "start_time": 8.2,
      "end_time": 9.4,
      "text": "どうかな、先生"
    },
    {
      "index": 4,
      "start_time": 9.6,
      "end_time": 11.1,
      "text": "ちゃんと見てくれた？"
    },
    {
      "index": 5,
      "start_time": 11.3,
      "end_time": 12.3,
      "text": "ええ、しっかりと"
    },
    {
      "index": 6,
      "start_time": 12.5,
      "end_time": 15.0,
      "text": "やはり頭の検査が必要みたいね"
    },
    {
      "index": 7,
      "start_time": 15.2,
      "end_time": 16.5,
      "text": "ひどいなぁ"
    },
    {
      "index": 8,
      "start_time": 17.1,
      "end_time": 20.6,
      "text": "せっかく先生の専属看護師になってあげようと思ったのに"
    },
    {
      "index": 9,
      "start_time": 21.1,
      "end_time": 22.6,
      "text": "そう。間に合ってるわ"
    },
    {
      "index": 10,
      "start_time": 24.5,
      "end_time": 26.2,
      "text": "……ああ、なるほど"
    },
    {
      "index": 11,
      "start_time": 26.6,
      "end_time": 28.5,
      "text": "そういうことか……"
    },
    {
      "index": 12,
      "start_time": 29.0,
      "end_time": 31.6,
      "text": "ごめんね先生、気付いてあげられなくて"
    },
    {
      "index": 13,
      "start_time": 32.3,
      "end_time": 35.3,
      "text": "トーゴクでは遠慮が美徳とされているみたいだし"
    },
    {
      "index": 14,
      "start_time": 36.0,
      "end_time": 39.5,
      "text": "ボクの美しさを独占することに負い目を感じるのも"
    },
    {
      "index": 15,
      "start_time": 40.0,
      "end_time": 41.6,
      "text": "無理はないよね！"
    },
    {
      "index": 16,
      "start_time": 41.9,
      "end_time": 45.0,
      "text": "ねえ、この子は一体何を言っているのかしら……？"
    },
    {
      "index": 17,
      "start_time": 46.3,
      "end_time": 48.1,
      "text": "ここは素直に感謝して"
    },
    {
      "index": 18,
      "start_time": 48.5,
      "end_time": 51.2,
      "text": "ボクの手を取るところだよ、先生！"
    }
  ],
