{
  "movie_id": 506600001,
  "subtitles": [
    {
      "index": 0,
      "start_time": 4.0,
      "end_time": 6.0,
      "text": "準備はいいか？　イノリ"
    },
    {
      "index": 1,
      "start_time": 6.6,
      "end_time": 8.6,
      "text": "いいいいい、いつでもオッケーですよ！"
    },
    {
      "index": 2,
      "start_time": 8.8,
      "end_time": 10.2,
      "text": "かかってくるです！"
    },
    {
      "index": 3,
      "start_time": 11.3,
      "end_time": 13.5,
      "text": "オッケー。それじゃあ、頼む"
    },
    {
      "index": 4,
      "start_time": 14.3,
      "end_time": 16.3,
      "text": "マスターによる承認を確認"
    },
    {
      "index": 5,
      "start_time": 16.4,
      "end_time": 18.2,
      "text": "タイムラーベ起動"
    },
    {
      "index": 6,
      "start_time": 20.0,
      "end_time": 22.0,
      "text": "タイムゲート、オープン"
    },
    {
      "index": 7,
      "start_time": 30.4,
      "end_time": 31.0,
      "text": "お"
    },
    {
      "index": 8,
      "start_time": 31.4,
      "end_time": 32.6,
      "text": "おおおおおー！？"
    },
    {
      "index": 9,
      "start_time": 34.0,
      "end_time": 35.6,
      "text": "タイムラーベ起動しました"
    },
    {
      "index": 10,
      "start_time": 36.2,
      "end_time": 37.6,
      "text": "タイムゲートへどうぞ"
    },
    {
      "index": 11,
      "start_time": 38.0,
      "end_time": 41.1,
      "text": "この中に入れば過去に戻れるってことか？"
    },
    {
      "index": 12,
      "start_time": 42.0,
      "end_time": 43.3,
      "text": "タイムラーベ起動中"
    },
    {
      "index": 13,
      "start_time": 44.0,
      "end_time": 45.4,
      "text": "タイムゲートへどうぞ"
    },
    {
      "index": 14,
      "start_time": 46.2,
      "end_time": 48.4,
      "text": "よし、早速入ってみようぜ"
    },
    {
      "index": 15,
      "start_time": 49.6,
      "end_time": 50.6,
      "text": "ちょちょちょ！"
    },
    {
      "index": 16,
      "start_time": 51.0,
      "end_time": 53.0,
      "text": "ちょっと待つです！　カヤぴぃ！！！"
    },
    {
      "index": 17,
      "start_time": 53.3,
      "end_time": 56.2,
      "text": "なんだよ……いつでもオッケーって言ってたろ？"
    },
    {
      "index": 18,
      "start_time": 57.3,
      "end_time": 59.6,
      "text": "こんな急に開くなんて聞いてないです！"
    },
    {
      "index": 19,
      "start_time": 60.0,
      "end_time": 62.0,
      "text": "ていうかあまりに無防備すぎですよ！！"
    },
    {
      "index": 20,
      "start_time": 62.3,
      "end_time": 64.6,
      "text": "もっと準備していかないと！！！"
    },
    {
      "index": 21,
      "start_time": 69.0,
      "end_time": 70.0,
      "text": "ああもう！"
    },
    {
      "index": 22,
      "start_time": 70.2,
      "end_time": 71.4,
      "text": "この杖でいいです！"
    },
    {
      "index": 23,
      "start_time": 71.6,
      "end_time": 73.6,
      "text": "おいおい、大丈夫か？"
    },
    {
      "index": 24,
      "start_time": 74.2,
      "end_time": 76.2,
      "text": "この部屋にある物って基本はどれもヤバいヤツじゃ……"
    },
    {
      "index": 25,
      "start_time": 76.6,
      "end_time": 79.0,
      "text": "だから、何かあった時用ですよ！"
    },
    {
      "index": 26,
      "start_time": 79.4,
      "end_time": 83.0,
      "text": "っていうかさ、何かあったら普通に戦えばいいだろ？"
    },
    {
      "index": 27,
      "start_time": 83.4,
      "end_time": 85.0,
      "text": "オレも彼もいるんだしさ"
    },
    {
      "index": 28,
      "start_time": 85.2,
      "end_time": 86.0,
      "text": "Yeah..."
    },
    {
      "index": 29,
      "start_time": 86.6,
      "end_time": 90.0,
      "text": "でも、もし何かあったら、か……"
    },
    {
      "index": 30,
      "start_time": 90.2,
      "end_time": 92.0,
      "text": "そうだなぁ……"
    },
    {
      "index": 31,
      "start_time": 93.6,
      "end_time": 94.4,
      "text": "...!"
    },
    {
      "index": 32,
      "start_time": 95.0,
      "end_time": 99.0,
      "text": "どうせなら過去のオレとケンカしてみるってのもいいかもなぁ～"
    },
    {
      "index": 33,
      "start_time": 99.4,
      "end_time": 103.0,
      "text": "ああもう、ホントカヤぴぃはケンカバカですよおおお！"
    },
    {
      "index": 34,
      "start_time": 103.4,
      "end_time": 105.0,
      "text": "タイムラーベ起動中"
    },
    {
      "index": 35,
      "start_time": 105.4,
      "end_time": 108.6,
      "text": "タイムゲートへどうぞ……タイムラーベ起動中"
    },
    {
      "index": 36,
      "start_time": 109.2,
      "end_time": 111.0,
      "text": "タイムゲートへどうぞ……"
    },
    {
      "index": 37,
      "start_time": 111.4,
      "end_time": 113.8,
      "text": "ゲート開口限界まであと１０、９、８……"
    },
    {
      "index": 38,
      "start_time": 114.0,
      "end_time": 114.8,
      "text": "だってさ"
    },
    {
      "index": 39,
      "start_time": 115.2,
      "end_time": 116.6,
      "text": "ほら、サッサと行こうぜ！"
    },
    {
      "index": 40,
      "start_time": 121.2,
      "end_time": 122.6,
      "text": "ま、待つです！"
    },
    {
      "index": 41,
      "start_time": 123.0,
      "end_time": 125.0,
      "text": "あたしも行くですよ！！"
    }
  ],
