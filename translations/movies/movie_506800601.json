{
  "movie_id": 506800601,
  "subtitles": [
    {
      "index": 0,
      "start_time": 1.0,
      "end_time": 5.6,
      "text": "こ、今度は合体して、おっきくなった！？"
    },
    {
      "index": 1,
      "start_time": 6.0,
      "end_time": 8.2,
      "text": "驚いてる暇はないよ、アオイ！"
    },
    {
      "index": 2,
      "start_time": 8.8,
      "end_time": 10.4,
      "text": "そ、そうだよね！"
    },
    {
      "index": 3,
      "start_time": 10.8,
      "end_time": 13.8,
      "text": "二人の友情の輪に、私たちも混ぜてもらうわ！"
    },
    {
      "index": 4,
      "start_time": 14.0,
      "end_time": 15.2,
      "text": "力を合わせよう"
    },
    {
      "index": 5,
      "start_time": 16.0,
      "end_time": 19.6,
      "text": "1000体のおもちゃは力を与えられているだけだったわよね？"
    },
    {
      "index": 6,
      "start_time": 20.0,
      "end_time": 21.2,
      "text": "O-okay!"
    },
    {
      "index": 7,
      "start_time": 21.8,
      "end_time": 23.2,
      "text": "In that case..."
    },
    {
      "index": 8,
      "start_time": 23.6,
      "end_time": 27.4,
      "text": "オリジナルのトイキングに狙いを絞るのが、最高効率だわ！"
    },
    {
      "index": 9,
      "start_time": 28.6,
      "end_time": 30.2,
      "text": "や、やってみます！"
    },
    {
      "index": 10,
      "start_time": 32.8,
      "end_time": 35.8,
      "text": "グォォォォォン！"
    },
    {
      "index": 11,
      "start_time": 36.8,
      "end_time": 37.6,
      "text": "あわわっ！？"
    },
    {
      "index": 12,
      "start_time": 37.8,
      "end_time": 38.6,
      "text": "Leave it to me!"
    },
    {
      "index": 13,
      "start_time": 38.8,
      "end_time": 42.0,
      "text": "はあ～"
    },
    {
      "index": 14,
      "start_time": 42.3,
      "end_time": 43.0,
      "text": "?!"
    },
    {
      "index": 15,
      "start_time": 44.0,
      "end_time": 47.0,
      "text": "ぐぐぐ……は、離せえっ！"
    },
    {
      "index": 16,
      "start_time": 47.7,
      "end_time": 48.5,
      "text": "Ngh..."
    },
    {
      "index": 17,
      "start_time": 48.8,
      "end_time": 50.2,
      "text": "大人しくしなさい！"
    },
    {
      "index": 18,
      "start_time": 50.8,
      "end_time": 51.6,
      "text": "...!"
    },
    {
      "index": 19,
      "start_time": 52.0,
      "end_time": 54.2,
      "text": "ぐぬぬぬぬ……"
    },
    {
      "index": 20,
      "start_time": 57.0,
      "end_time": 59.0,
      "text": "うぅっ……狙いが……！"
    },
    {
      "index": 21,
      "start_time": 60.0,
      "end_time": 60.8,
      "text": "...!"
    },
    {
      "index": 22,
      "start_time": 61.0,
      "end_time": 63.0,
      "text": "マ、マイベストフレンドくん？"
    },
    {
      "index": 23,
      "start_time": 63.6,
      "end_time": 65.8,
      "text": "大丈夫、落ち着いて"
    },
    {
      "index": 24,
      "start_time": 66.2,
      "end_time": 67.6,
      "text": "オレがついてるからさ"
    },
    {
      "index": 25,
      "start_time": 69.0,
      "end_time": 70.0,
      "text": "...Yeah!"
    },
    {
      "index": 26,
      "start_time": 70.4,
      "end_time": 72.8,
      "text": "じゃまだぁぁぁぁ！"
    },
    {
      "index": 27,
      "start_time": 73.0,
      "end_time": 73.8,
      "text": "...!"
    },
    {
      "index": 28,
      "start_time": 74.0,
      "end_time": 74.8,
      "text": "しまった！？"
    },
    {
      "index": 29,
      "start_time": 75.0,
      "end_time": 75.6,
      "text": "わぁ！"
    },
    {
      "index": 30,
      "start_time": 76.0,
      "end_time": 79.0,
      "text": "うぉぉぉぉぉぉぉぉ！！"
    },
    {
      "index": 31,
      "start_time": 81.8,
      "end_time": 84.2,
      "text": "いっけえーっ！"
    },
    {
      "index": 32,
      "start_time": 84.6,
      "end_time": 87.0,
      "text": "ぬおおおおおお！！"
    },
    {
      "index": 33,
      "start_time": 98.8,
      "end_time": 100.6,
      "text": "トイキングさ～ん！！"
    },
    {
      "index": 34,
      "start_time": 101.0,
      "end_time": 102.0,
      "text": "...!"
    },
    {
      "index": 35,
      "start_time": 106.0,
      "end_time": 108.4,
      "text": "アオイ……ちゃん？"
    },
    {
      "index": 36,
      "start_time": 109.9,
      "end_time": 111.8,
      "text": "も、もう大丈夫"
    },
    {
      "index": 37,
      "start_time": 112.0,
      "end_time": 113.4,
      "text": "独りじゃないよ"
    },
    {
      "index": 38,
      "start_time": 114.8,
      "end_time": 116.8,
      "text": "この温もり……"
    },
    {
      "index": 39,
      "start_time": 118.0,
      "end_time": 119.0,
      "text": "思い出した"
    },
    {
      "index": 40,
      "start_time": 120.8,
      "end_time": 122.0,
      "text": "そうだ"
    },
    {
      "index": 41,
      "start_time": 123.2,
      "end_time": 124.8,
      "text": "これが……"
    },
    {
      "index": 42,
      "start_time": 125.2,
      "end_time": 127.8,
      "text": "本当の友情だ……！"
    }
  ],
