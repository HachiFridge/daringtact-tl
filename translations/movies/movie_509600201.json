{
  "movie_id": 509600201,
  "subtitles": [
    {
      "index": 0,
      "start_time": 10.5,
      "end_time": 11.7,
      "text": "..."
    },
    {
      "index": 1,
      "start_time": 11.9,
      "end_time": 14.0,
      "text": "おーい！　騎士くーん～"
    },
    {
      "index": 2,
      "start_time": 14.3,
      "end_time": 16.3,
      "text": "えへへっ、お待たせー"
    },
    {
      "index": 3,
      "start_time": 17.1,
      "end_time": 19.5,
      "text": "ごめんね、準備に時間かかっちゃって！"
    },
    {
      "index": 4,
      "start_time": 20.2,
      "end_time": 21.6,
      "text": "退屈じゃなかった？"
    },
    {
      "index": 5,
      "start_time": 21.9,
      "end_time": 22.7,
      "text": "We're fine!"
    },
    {
      "index": 6,
      "start_time": 23.0,
      "end_time": 25.2,
      "text": "そっかー！　ならよかったー！"
    },
    {
      "index": 7,
      "start_time": 26.0,
      "end_time": 29.3,
      "text": "ヒヨリ、先に行かないでって言ったはずだよね？"
    },
    {
      "index": 8,
      "start_time": 30.2,
      "end_time": 32.6,
      "text": "そうだった、ごめんねレイさん！"
    },
    {
      "index": 9,
      "start_time": 33.0,
      "end_time": 34.3,
      "text": "まったく……"
    },
    {
      "index": 10,
      "start_time": 34.5,
      "end_time": 37.6,
      "text": "みんなで一緒にビーチまで行こうと約束したのに"
    },
    {
      "index": 11,
      "start_time": 37.8,
      "end_time": 40.6,
      "text": "彼を見た途端走りだすんだから……"
    },
    {
      "index": 12,
      "start_time": 41.4,
      "end_time": 43.5,
      "text": "や、やあ、お待たせ……"
    },
    {
      "index": 13,
      "start_time": 44.9,
      "end_time": 45.6,
      "text": "...?!"
    },
    {
      "index": 14,
      "start_time": 46.8,
      "end_time": 48.1,
      "text": "..."
    },
    {
      "index": 15,
      "start_time": 48.6,
      "end_time": 50.0,
      "text": "えっと、ユイ？"
    },
    {
      "index": 16,
      "start_time": 50.3,
      "end_time": 54.2,
      "text": "私が言うのもなんだけど、ここまできたんだ"
    },
    {
      "index": 17,
      "start_time": 54.5,
      "end_time": 57.6,
      "text": "今さら恥ずかしがっても、もう逃げ場はないよ"
    },
    {
      "index": 18,
      "start_time": 58.3,
      "end_time": 60.0,
      "text": "で、でもぉ……"
    },
    {
      "index": 19,
      "start_time": 60.6,
      "end_time": 64.0,
      "text": "経験上、こういう時は諦めが肝心だ"
    },
    {
      "index": 20,
      "start_time": 66.9,
      "end_time": 68.6,
      "text": "あっ！　あのぉ～！"
    },
    {
      "index": 21,
      "start_time": 69.5,
      "end_time": 70.6,
      "text": "じゃじゃーん！"
    },
    {
      "index": 22,
      "start_time": 71.8,
      "end_time": 75.1,
      "text": "騎士くん。あたしたちの水着、どうかな？"
    },
    {
      "index": 23,
      "start_time": 76.1,
      "end_time": 77.3,
      "text": "……バッチリ！"
    },
    {
      "index": 24,
      "start_time": 77.9,
      "end_time": 79.3,
      "text": "バ、バッチリ？"
    },
    {
      "index": 25,
      "start_time": 79.9,
      "end_time": 80.8,
      "text": "Yeah!"
    },
    {
      "index": 26,
      "start_time": 82.0,
      "end_time": 84.1,
      "text": "Th-Thank goodness..."
    },
    {
      "index": 27,
      "start_time": 86.6,
      "end_time": 91.0,
      "text": "ほらほら、早く遊びにいこー！"
    }
  ],
