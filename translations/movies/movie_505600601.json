{
  "movie_id": 505600601,
  "subtitles": [
    {
      "index": 0,
      "start_time": 0.6,
      "end_time": 5.8,
      "text": "ううううう！"
    },
    {
      "index": 1,
      "start_time": 6.8,
      "end_time": 9.8,
      "text": "あんなでかいの、本当に釣り上げられるわけ！？"
    },
    {
      "index": 2,
      "start_time": 11.0,
      "end_time": 11.8,
      "text": "コロの助！"
    },
    {
      "index": 3,
      "start_time": 12.0,
      "end_time": 13.0,
      "text": "?!"
    },
    {
      "index": 4,
      "start_time": 13.4,
      "end_time": 14.0,
      "text": "こいつを！"
    },
    {
      "index": 5,
      "start_time": 14.6,
      "end_time": 18.4,
      "text": "これは……ライトニングショッカーでございますね！"
    },
    {
      "index": 6,
      "start_time": 19.0,
      "end_time": 21.4,
      "text": "そいつを糸に通してくれ！　早く！"
    },
    {
      "index": 7,
      "start_time": 22.8,
      "end_time": 23.8,
      "text": "ちょ……おっさん！"
    },
    {
      "index": 8,
      "start_time": 24.0,
      "end_time": 26.0,
      "text": "それ、今度こそ大丈夫なんでしょうね？"
    },
    {
      "index": 9,
      "start_time": 26.2,
      "end_time": 30.0,
      "text": "心配すんな猫の助。点検は済ませてある"
    },
    {
      "index": 10,
      "start_time": 31.8,
      "end_time": 34.0,
      "text": "セット、完了いたしました！"
    },
    {
      "index": 11,
      "start_time": 36.8,
      "end_time": 40.0,
      "text": "ようし！　もっとだ、もっと引き寄せろ！"
    },
    {
      "index": 12,
      "start_time": 40.6,
      "end_time": 42.0,
      "text": "ペコの助、できるか！？"
    },
    {
      "index": 13,
      "start_time": 42.4,
      "end_time": 43.8,
      "text": "な、なんとか……！"
    },
    {
      "index": 14,
      "start_time": 44.0,
      "end_time": 47.6,
      "text": "ぬぅ～"
    },
    {
      "index": 15,
      "start_time": 48.0,
      "end_time": 50.0,
      "text": "もう少しだ……もう少し……"
    },
    {
      "index": 16,
      "start_time": 50.2,
      "end_time": 51.0,
      "text": "Now!"
    },
    {
      "index": 17,
      "start_time": 51.4,
      "end_time": 53.6,
      "text": "こいつをくらいやがれ！"
    },
    {
      "index": 18,
      "start_time": 55.6,
      "end_time": 56.2,
      "text": "?"
    },
    {
      "index": 19,
      "start_time": 56.6,
      "end_time": 58.2,
      "text": "..."
    },
    {
      "index": 20,
      "start_time": 58.8,
      "end_time": 60.2,
      "text": "故障のようだな"
    },
    {
      "index": 21,
      "start_time": 60.4,
      "end_time": 62.4,
      "text": "あんたねぇぇぇぇぇぇぇぇぇっ！！？"
    },
    {
      "index": 22,
      "start_time": 63.0,
      "end_time": 64.8,
      "text": "Ugh..."
    },
    {
      "index": 23,
      "start_time": 65.0,
      "end_time": 67.0,
      "text": "もうそろそろ限界です……"
    },
    {
      "index": 24,
      "start_time": 67.4,
      "end_time": 68.8,
      "text": "電撃……"
    },
    {
      "index": 25,
      "start_time": 69.0,
      "end_time": 72.0,
      "text": "はっ、電撃をくらわせればいいのよね！？"
    },
    {
      "index": 26,
      "start_time": 72.4,
      "end_time": 75.0,
      "text": "だったら……これでもくらってなさい！"
    },
    {
      "index": 27,
      "start_time": 81.4,
      "end_time": 82.0,
      "text": "EEEK!"
    },
    {
      "index": 28,
      "start_time": 82.4,
      "end_time": 83.0,
      "text": "Lady Pecorine!"
    },
    {
      "index": 29,
      "start_time": 83.2,
      "end_time": 84.0,
      "text": "あ、っぶな！"
    },
    {
      "index": 30,
      "start_time": 84.2,
      "end_time": 87.8,
      "text": "でも、魔物の動きが明らかに鈍くなりました！"
    },
    {
      "index": 31,
      "start_time": 88.2,
      "end_time": 89.0,
      "text": "これなら……"
    },
    {
      "index": 32,
      "start_time": 89.4,
      "end_time": 91.4,
      "text": "主さま、お願いいたします！"
    },
    {
      "index": 33,
      "start_time": 91.4,
      "end_time": 92.2,
      "text": "Yeah..."
    },
    {
      "index": 34,
      "start_time": 94.0,
      "end_time": 95.0,
      "text": "Haaa!!"
    },
    {
      "index": 35,
      "start_time": 97.0,
      "end_time": 98.2,
      "text": "今です、ペコリーヌさま！"
    },
    {
      "index": 36,
      "start_time": 98.4,
      "end_time": 101.0,
      "text": "ペコリーヌ！　ぶちかましてやりなさい！"
    },
    {
      "index": 37,
      "start_time": 101.6,
      "end_time": 102.8,
      "text": "Understood!"
    },
    {
      "index": 38,
      "start_time": 103.2,
      "end_time": 104.2,
      "text": "全力全開！！"
    },
    {
      "index": 39,
      "start_time": 105.0,
      "end_time": 108.2,
      "text": "プリンセスフィッシング～！"
    }
