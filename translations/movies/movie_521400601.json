{
  "movie_id": 521400601,
  "subtitles": [
    {
      "index": 0,
      "start_time": 9.2,
      "end_time": 10.6,
      "text": "Shiori-san...!"
    },
    {
      "index": 1,
      "start_time": 11.2,
      "end_time": 12.6,
      "text": "Wakana-san...!"
    },
    {
      "index": 2,
      "start_time": 15.0,
      "end_time": 15.9,
      "text": "Hmph!"
    },
    {
      "index": 3,
      "start_time": 17.5,
      "end_time": 19.6,
      "text": "Oooh! It's a \"V\"!"
    },
    {
      "index": 4,
      "start_time": 19.9,
      "end_time": 22.3,
      "text": "A butt-ling \"V\" to aim for victory!"
    },
    {
      "index": 5,
      "start_time": 22.6,
      "end_time": 24.4,
      "text": "Excitement is already building up!"
    },
    {
      "index": 6,
      "start_time": 24.8,
      "end_time": 28.4,
      "text": "I can feel the passion they have to seek victory"
    },
    {
      "index": 7,
      "start_time": 28.9,
      "end_time": 31.8,
      "text": "To think my Shiorin did that..."
    },
    {
      "index": 8,
      "start_time": 32.1,
      "end_time": 34.5,
      "text": "The ones you see are two FIGHTERS"
    },
    {
      "index": 9,
      "start_time": 34.9,
      "end_time": 37.0,
      "text": "No one can stop them now"
    },
    {
      "index": 10,
      "start_time": 37.3,
      "end_time": 38.3,
      "text": "..."
    },
    {
      "index": 11,
      "start_time": 38.7,
      "end_time": 40.4,
      "text": "Now, let the waves start!"
    },
    {
      "index": 12,
      "start_time": 40.6,
      "end_time": 43.4,
      "text": "From now on, both are in danger of falling in the water!"
    },
    {
      "index": 13,
      "start_time": 44.9,
      "end_time": 45.9,
      "text": "（いまだ！）　（いまです！）"
    },
    {
      "index": 14,
      "start_time": 49.0,
      "end_time": 51.9,
      "text": "W-What an impact! It made it all the way here!"
    },
    {
      "index": 15,
      "start_time": 52.7,
      "end_time": 56.1,
      "text": "Things that can't be expressed in words can be conveyed through one's butt"
    },
    {
      "index": 16,
      "start_time": 56.8,
      "end_time": 60.1,
      "text": "That's... A PEACH CRUSH!"
    },
    {
      "index": 17,
      "start_time": 62.6,
      "end_time": 64.5,
      "text": "S-Such amazing offense and defense!"
    },
    {
      "index": 18,
      "start_time": 65.2,
      "end_time": 68.1,
      "text": "Yet both of them are smiling!"
    },
    {
      "index": 19,
      "start_time": 68.6,
      "end_time": 70.0,
      "text": "You did great!"
    },
    {
      "index": 20,
      "start_time": 70.3,
      "end_time": 71.5,
      "text": "Back to you!"
    },
    {
      "index": 21,
      "start_time": 74.2,
      "end_time": 77.1,
      "text": "Shiori-san, you've gotten way stronger...!"
    },
    {
      "index": 22,
      "start_time": 77.3,
      "end_time": 80.1,
      "text": "My belly button is tingling...!"
    },
    {
      "index": 23,
      "start_time": 80.7,
      "end_time": 85.2,
      "text": "You too, Wakana-san... My intestinal muscles are trembling...!"
    },
    {
      "index": 24,
      "start_time": 86.4,
      "end_time": 90.1,
      "text": "I-IT'S HERE! The BIG WAVE of the day!"
    },
    {
      "index": 25,
      "start_time": 90.4,
      "end_time": 92.9,
      "text": "Do you have no sense of security management, Meri-so?!"
    },
    {
      "index": 26,
      "start_time": 93.2,
      "end_time": 95.8,
      "text": "I mean, isn't that up to your guild...?"
    },
    {
      "index": 27,
      "start_time": 96.4,
      "end_time": 97.5,
      "text": "Even so!"
    },
    {
      "index": 28,
      "start_time": 98.7,
      "end_time": 99.9,
      "text": "I knew it!"
    },
    {
      "index": 29,
      "start_time": 101.5,
      "end_time": 103.9,
      "text": "As Big Sis Yamato's little sister..."
    },
    {
      "index": 30,
      "start_time": 104.4,
      "end_time": 106.6,
      "text": "As Big Sis Hatsune's little sister..."
    },
    {
      "index": 31,
      "start_time": 107.2,
      "end_time": 108.8,
      "text": "I CAN'T LOSE!"
    },
    {
      "index": 32,
      "start_time": 109.3,
      "end_time": 111.7,
      "text": "S-SHIORIIIIIIIIIN!"
    },
    {
      "index": 33,
      "start_time": 112.1,
      "end_time": 113.2,
      "text": "Hah...!"
    },
    {
      "index": 34,
      "start_time": 116.0,
      "end_time": 119.6,
      "text": "SHOOTING STAR☆HIIIIIIIIIIIP!"
    },
    {
      "index": 35,
      "start_time": 120.0,
      "end_time": 123.9,
      "text": "Peach Winding: CRUUUUUUUUUUUSH!!!"
    },
    {
      "index": 36,
      "start_time": 124.0,
      "end_time": 125.9,
      "text": "Haaahhh!"
    },
    {
      "index": 37,
      "start_time": 126.3,
      "end_time": 128.0,
      "text": "...!"
    },
    {
      "index": 38,
      "start_time": 129.1,
      "end_time": 131.5,
      "text": "N-NGYUUUUH..."
    },
    {
      "index": 39,
      "start_time": 132.5,
      "end_time": 136.1,
      "text": "WHAT A HUGE MISFIRE! REFEREE DOWN!"
    },
    {
      "index": 40,
      "start_time": 139.0,
      "end_time": 141.0,
      "text": "AAAAAAH~!"
    },
    {
      "index": 41,
      "start_time": 142.4,
      "end_time": 144.2,
      "text": "Hold on to me...! Knight-san!"
    }
  ],
