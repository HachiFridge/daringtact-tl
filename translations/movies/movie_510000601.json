{
  "movie_id": 510000601,
  "subtitles": [
    {
      "index": 0,
      "start_time": 3.7,
      "end_time": 6.2,
      "text": "そんなウソでだまされたりしない！"
    },
    {
      "index": 1,
      "start_time": 9.4,
      "end_time": 13.0,
      "text": "あのお人は、もう、ここには来られへんの！"
    },
    {
      "index": 2,
      "start_time": 13.3,
      "end_time": 14.8,
      "text": "そんなの信じない！"
    },
    {
      "index": 3,
      "start_time": 16.7,
      "end_time": 17.5,
      "text": "KYAAA!?"
    },
    {
      "index": 4,
      "start_time": 17.7,
      "end_time": 18.4,
      "text": "ぷうきち！"
    },
    {
      "index": 5,
      "start_time": 18.6,
      "end_time": 19.8,
      "text": "『任せろ！』"
    },
    {
      "index": 6,
      "start_time": 21.8,
      "end_time": 22.8,
      "text": "帰って！"
    },
    {
      "index": 7,
      "start_time": 23.1,
      "end_time": 24.2,
      "text": "帰れ！！"
    },
    {
      "index": 8,
      "start_time": 26.2,
      "end_time": 27.2,
      "text": "わっ！！"
    },
    {
      "index": 9,
      "start_time": 35.0,
      "end_time": 38.0,
      "text": "あんさんがこれからも一人っきりで"
    },
    {
      "index": 10,
      "start_time": 38.3,
      "end_time": 41.0,
      "text": "ここで待ち続けはるなら……"
    },
    {
      "index": 11,
      "start_time": 41.8,
      "end_time": 43.0,
      "text": "うちは……"
    },
    {
      "index": 12,
      "start_time": 47.2,
      "end_time": 49.1,
      "text": "うちらは全力で……"
    },
    {
      "index": 13,
      "start_time": 49.4,
      "end_time": 51.0,
      "text": "邪魔させてもらいます！"
    },
    {
      "index": 14,
      "start_time": 51.1,
      "end_time": 51.9,
      "text": "Ngh..."
    },
    {
      "index": 15,
      "start_time": 52.1,
      "end_time": 52.9,
      "text": "『姫さん』"
    },
    {
      "index": 16,
      "start_time": 53.0,
      "end_time": 53.9,
      "text": "マホさん……"
    },
    {
      "index": 17,
      "start_time": 54.1,
      "end_time": 56.8,
      "text": "あのおじいはんは、うちに言わはったの！"
    },
    {
      "index": 18,
      "start_time": 57.0,
      "end_time": 59.4,
      "text": "あんさんのことが心配やって！"
    },
    {
      "index": 19,
      "start_time": 59.7,
      "end_time": 63.6,
      "text": "でも、今の体ではもう約束は守られへん、って……"
    },
    {
      "index": 20,
      "start_time": 64.8,
      "end_time": 67.2,
      "text": "わぁっ！"
    },
    {
      "index": 21,
      "start_time": 67.8,
      "end_time": 68.8,
      "text": "おじいさんは！"
    },
    {
      "index": 22,
      "start_time": 69.0,
      "end_time": 71.0,
      "text": "絶対来てくれるんだ！"
    },
    {
      "index": 23,
      "start_time": 75.7,
      "end_time": 76.8,
      "text": "おじいはん"
    },
    {
      "index": 24,
      "start_time": 77.0,
      "end_time": 79.0,
      "text": "あんさんに見せたいもんが"
    },
    {
      "index": 25,
      "start_time": 79.2,
      "end_time": 82.0,
      "text": "ぎょーさんあるって言ってはった"
    },
    {
      "index": 26,
      "start_time": 83.2,
      "end_time": 85.4,
      "text": "楽しいものや、きれいなもの"
    },
    {
      "index": 27,
      "start_time": 86.8,
      "end_time": 89.4,
      "text": "せやから、うちがあんさんを連れ出したる"
    },
    {
      "index": 28,
      "start_time": 89.7,
      "end_time": 91.8,
      "text": "おじいはんの代わりに一緒に……"
    },
    {
      "index": 29,
      "start_time": 92.1,
      "end_time": 93.6,
      "text": "だからお願いや"
    },
    {
      "index": 30,
      "start_time": 93.8,
      "end_time": 94.8,
      "text": "話を聞いて！"
    },
    {
      "index": 31,
      "start_time": 95.0,
      "end_time": 96.4,
      "text": "一緒に行こうよ！"
    },
    {
      "index": 32,
      "start_time": 97.0,
      "end_time": 98.0,
      "text": "みんなで！"
    },
    {
      "index": 33,
      "start_time": 98.3,
      "end_time": 100.0,
      "text": "マホ姫、アヤネちゃん！"
    },
    {
      "index": 34,
      "start_time": 100.4,
      "end_time": 102.0,
      "text": "みらくるまほりん──"
    },
    {
      "index": 35,
      "start_time": 103.0,
      "end_time": 103.9,
      "text": "『いくぞアヤネ！』"
    },
    {
      "index": 36,
      "start_time": 104.2,
      "end_time": 106.2,
      "text": "くるりんぱー！　てええええいっ！"
    },
    {
      "index": 37,
      "start_time": 107.0,
      "end_time": 108.0,
      "text": "わああああ！"
    },
    {
      "index": 38,
      "start_time": 117.8,
      "end_time": 118.6,
      "text": "行きまひょ"
    },
    {
      "index": 39,
      "start_time": 118.8,
      "end_time": 122.0,
      "text": "世界中の楽しいこと一緒に探しに"
    },
    {
      "index": 40,
      "start_time": 122.8,
      "end_time": 125.0,
      "text": "..."
    },
    {
      "index": 41,
      "start_time": 126.2,
      "end_time": 129.0,
      "text": "ぼく、本当は……"
    }
  ],
