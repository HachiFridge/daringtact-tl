{
  "movie_id": 508200601,
  "subtitles": [
    {
      "index": 0,
      "start_time": 10.9,
      "end_time": 11.6,
      "text": "...!"
    },
    {
      "index": 1,
      "start_time": 11.8,
      "end_time": 13.0,
      "text": "They're back!"
    },
    {
      "index": 2,
      "start_time": 13.2,
      "end_time": 13.8,
      "text": "Yes...!"
    },
    {
      "index": 3,
      "start_time": 14.0,
      "end_time": 16.0,
      "text": "I can tell just by looking!"
    },
    {
      "index": 4,
      "start_time": 16.8,
      "end_time": 17.8,
      "text": "Ah, wait...!"
    },
    {
      "index": 5,
      "start_time": 28.4,
      "end_time": 29.8,
      "text": "..."
    },
    {
      "index": 6,
      "start_time": 41.8,
      "end_time": 43.6,
      "text": "..."
    },
    {
      "index": 7,
      "start_time": 44.0,
      "end_time": 45.0,
      "text": "Um..."
    },
    {
      "index": 8,
      "start_time": 45.8,
      "end_time": 47.0,
      "text": "Um..."
    },
    {
      "index": 9,
      "start_time": 48.2,
      "end_time": 49.6,
      "text": "..."
    },
    {
      "index": 10,
      "start_time": 51.0,
      "end_time": 53.2,
      "text": "A lot has happened so..."
    },
    {
      "index": 11,
      "start_time": 54.0,
      "end_time": 56.0,
      "text": "I've returned later than expected..."
    },
    {
      "index": 12,
      "start_time": 61.6,
      "end_time": 64.0,
      "text": "Welcome back, Sheffy..."
    },
    {
      "index": 13,
      "start_time": 68.2,
      "end_time": 69.8,
      "text": "...I-I'm home"
    },
    {
      "index": 14,
      "start_time": 70.0,
      "end_time": 72.8,
      "text": "Welcome back, Lady Sheffy"
    },
    {
      "index": 15,
      "start_time": 74.1,
      "end_time": 75.3,
      "text": "...Sheffy-chan..."
    },
    {
      "index": 16,
      "start_time": 76.3,
      "end_time": 77.8,
      "text": "...Really..."
    },
    {
      "index": 17,
      "start_time": 78.0,
      "end_time": 80.0,
      "text": "I'm so proud of you..."
    },
    {
      "index": 18,
      "start_time": 80.4,
      "end_time": 82.8,
      "text": "Ugh... ugh..."
    },
    {
      "index": 19,
      "start_time": 83.0,
      "end_time": 86.0,
      "text": "Uwaaaaah! Sheffyyyyy!"
    },
    {
      "index": 20,
      "start_time": 86.2,
      "end_time": 87.8,
      "text": "...!"
    },
    {
      "index": 21,
      "start_time": 88.0,
      "end_time": 89.8,
      "text": "Ungh..."
    },
    {
      "index": 22,
      "start_time": 90.0,
      "end_time": 94.0,
      "text": "Waaaaahhhh!"
    },
    {
      "index": 23,
      "start_time": 95.0,
      "end_time": 97.8,
      "text": "Geez... What's with all the crying nowadays...?"
    },
    {
      "index": 24,
      "start_time": 98.0,
      "end_time": 99.8,
      "text": "But even so...!!"
    },
    {
      "index": 25,
      "start_time": 100.0,
      "end_time": 102.8,
      "text": "We're all relieved to see you return safely"
    },
    {
      "index": 26,
      "start_time": 103.0,
      "end_time": 103.8,
      "text": "Yeah..."
    },
    {
      "index": 27,
      "start_time": 104.2,
      "end_time": 106.0,
      "text": "That can't be true, I mean..."
    },
    {
      "index": 28,
      "start_time": 106.8,
      "end_time": 109.2,
      "text": "I haven't concluded anything by myself just yet"
    },
    {
      "index": 29,
      "start_time": 109.4,
      "end_time": 112.0,
      "text": "Everyone's always helping me out..."
    },
    {
      "index": 30,
      "start_time": 112.8,
      "end_time": 114.8,
      "text": "You know that's not the truth here"
    },
    {
      "index": 31,
      "start_time": 115.0,
      "end_time": 117.0,
      "text": "Be confident in yourself"
    },
    {
      "index": 32,
      "start_time": 117.2,
      "end_time": 119.8,
      "text": "You did what you thought you should do"
    },
    {
      "index": 33,
      "start_time": 120.0,
      "end_time": 121.2,
      "text": "And that's the result of your work"
    },
    {
      "index": 34,
      "start_time": 121.8,
      "end_time": 123.0,
      "text": "Kyaru..."
    },
    {
      "index": 35,
      "start_time": 124.0,
      "end_time": 124.8,
      "text": "But now..."
    },
    {
      "index": 36,
      "start_time": 125.0,
      "end_time": 126.2,
      "text": "...?"
    },
    {
      "index": 37,
      "start_time": 128.8,
      "end_time": 131.8,
      "text": "With the materials that Sheffy-chan's brought back..."
    },
    {
      "index": 38,
      "start_time": 132.0,
      "end_time": 134.0,
      "text": "Let's make a delicious osechi!"
    },
    {
      "index": 39,
      "start_time": 134.8,
      "end_time": 138.2,
      "text": "Our operation's final task is to eat delicious New Year's osechi with everyone!"
    },
    {
      "index": 40,
      "start_time": 140.8,
      "end_time": 142.2,
      "text": "...Yeah!"
    }
  ],
