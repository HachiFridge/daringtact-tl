{
  "movie_id": 514607401,
  "subtitles": [
    {
      "index": 0,
      "start_time": 0.7,
      "end_time": 2.0,
      "text": "え、ええと……"
    },
    {
      "index": 1,
      "start_time": 2.9,
      "end_time": 4.5,
      "text": "トイキングさんと出会ったのは"
    },
    {
      "index": 2,
      "start_time": 4.8,
      "end_time": 7.2,
      "text": "アルバイト先のおもちゃ工場で……"
    },
    {
      "index": 3,
      "start_time": 8.3,
      "end_time": 10.9,
      "text": "バイトの志望動機ですか？"
    },
    {
      "index": 4,
      "start_time": 11.2,
      "end_time": 13.4,
      "text": "ええとお金欲しさ……"
    },
    {
      "index": 5,
      "start_time": 13.9,
      "end_time": 17.8,
      "text": "じゃなくてマイフレンドくんをカスタマイズするためです！"
    },
    {
      "index": 6,
      "start_time": 18.2,
      "end_time": 22.4,
      "text": "って、すみません～！　こんなぼっちの話はいいですよね！"
    },
    {
      "index": 7,
      "start_time": 23.7,
      "end_time": 26.0,
      "text": "工場の倉庫で眠り続けた結果"
    },
    {
      "index": 8,
      "start_time": 26.3,
      "end_time": 29.0,
      "text": "意思を持ったおもちゃのトイキングさんでしたが"
    },
    {
      "index": 9,
      "start_time": 29.3,
      "end_time": 33.8,
      "text": "自分が捨てられてしまったと勘違いしたことから暴走してしまい"
    },
    {
      "index": 10,
      "start_time": 34.0,
      "end_time": 36.1,
      "text": "トイキングJr.と合体して"
    },
    {
      "index": 11,
      "start_time": 36.3,
      "end_time": 39.0,
      "text": "メガトイキングさんになってしまいました"
    },
    {
      "index": 12,
      "start_time": 39.7,
      "end_time": 43.3,
      "text": "でも、最後は本当の友情を思い出して"
    },
    {
      "index": 13,
      "start_time": 43.7,
      "end_time": 47.0,
      "text": "ただのおもちゃに戻ったはずだったんですが……"
    },
    {
      "index": 14,
      "start_time": 47.9,
      "end_time": 52.8,
      "text": "今回、ジオ・テオゴニアの子どもたちと友情を育むために"
    },
    {
      "index": 15,
      "start_time": 53.0,
      "end_time": 56.3,
      "text": "追加生産したトイキングJr.たちと合体して"
    },
    {
      "index": 16,
      "start_time": 56.8,
      "end_time": 59.9,
      "text": "一緒にグランドリームパークに来てくれました！"
    },
    {
      "index": 17,
      "start_time": 60.3,
      "end_time": 64.2,
      "text": "この世界でも、素敵な友達がたくさんできると思います！"
    },
    {
      "index": 18,
      "start_time": 65.0,
      "end_time": 67.0,
      "text": "……ぼっちの私と違って……"
    },
    {
      "index": 19,
      "start_time": 69.1,
      "end_time": 70.1,
      "text": "ええと"
    },
    {
      "index": 20,
      "start_time": 70.7,
      "end_time": 74.5,
      "text": "トイキングJr.はグランドリームパーク内各売店にて"
    },
    {
      "index": 21,
      "start_time": 74.8,
      "end_time": 76.9,
      "text": "好評発売中ですー！"
    }
  ],
