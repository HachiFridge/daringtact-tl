{
  "movie_id": 514000201,
  "subtitles": [
    {
      "index": 0,
      "start_time": 11.3,
      "end_time": 12.6,
      "text": "やまないわね……"
    },
    {
      "index": 1,
      "start_time": 13.1,
      "end_time": 14.5,
      "text": "まあ想定内にゃ"
    },
    {
      "index": 2,
      "start_time": 15.0,
      "end_time": 19.3,
      "text": "この雪景色も『冬といえばサマー』の一環ですわ"
    },
    {
      "index": 3,
      "start_time": 19.6,
      "end_time": 20.6,
      "text": "..."
    },
    {
      "index": 4,
      "start_time": 22.5,
      "end_time": 25.0,
      "text": "なななな何をわけの分からんことを……"
    },
    {
      "index": 5,
      "start_time": 25.2,
      "end_time": 27.1,
      "text": "無理無理無理無理……"
    },
    {
      "index": 6,
      "start_time": 27.2,
      "end_time": 31.3,
      "text": "死ぬ死ぬ死ぬ死ぬ……"
    },
    {
      "index": 7,
      "start_time": 31.6,
      "end_time": 34.6,
      "text": "ねえ、みんな……やる気があるのは結構だけど……"
    },
    {
      "index": 8,
      "start_time": 35.5,
      "end_time": 39.5,
      "text": "水着になるのは、着いてからで良かったんじゃないかしら……"
    },
    {
      "index": 9,
      "start_time": 39.9,
      "end_time": 41.5,
      "text": "そういうの先に言って！"
    },
    {
      "index": 10,
      "start_time": 41.4,
      "end_time": 42.1,
      "text": "Eek!"
    },
    {
      "index": 11,
      "start_time": 42.6,
      "end_time": 44.6,
      "text": "もうやだ～！"
    },
    {
      "index": 12,
      "start_time": 45.8,
      "end_time": 47.2,
      "text": "帰りてぇー！"
    },
    {
      "index": 13,
      "start_time": 47.6,
      "end_time": 49.6,
      "text": "ほあああぁ～ッ……！"
    },
    {
      "index": 14,
      "start_time": 50.2,
      "end_time": 53.2,
      "text": "うわぁぁぁー！！"
    },
    {
      "index": 15,
      "start_time": 53.4,
      "end_time": 54.9,
      "text": "あっ……？"
    },
    {
      "index": 16,
      "start_time": 55.1,
      "end_time": 57.0,
      "text": "あはははは"
    },
    {
      "index": 17,
      "start_time": 57.2,
      "end_time": 59.1,
      "text": "さあ、ご覧あそばせ！"
    },
    {
      "index": 18,
      "start_time": 59.6,
      "end_time": 61.5,
      "text": "おーっほっほ！"
    },
    {
      "index": 19,
      "start_time": 62.0,
      "end_time": 65.2,
      "text": "これぞ全天候型屋内遊泳場──"
    },
    {
      "index": 20,
      "start_time": 65.4,
      "end_time": 68.1,
      "text": "『メルクリゾート・ウィスタリアンズ』ですわ！"
    },
    {
      "index": 21,
      "start_time": 68.3,
      "end_time": 70.0,
      "text": "..."
    },
    {
      "index": 22,
      "start_time": 72.9,
      "end_time": 74.5,
      "text": "わぁ～～い"
    },
    {
      "index": 23,
      "start_time": 75.0,
      "end_time": 76.2,
      "text": "ちぇるーん！"
    },
    {
      "index": 24,
      "start_time": 77.5,
      "end_time": 79.3,
      "text": "うぇ～～～い！"
    },
    {
      "index": 25,
      "start_time": 81.1,
      "end_time": 83.1,
      "text": "読書はかどるー……"
    },
    {
      "index": 26,
      "start_time": 83.3,
      "end_time": 86.4,
      "text": "ぽーん、ぽーん、ぽーん……！"
    },
    {
      "index": 27,
      "start_time": 93.8,
      "end_time": 95.4,
      "text": "みなさま、いかがです？"
    },
    {
      "index": 28,
      "start_time": 97.3,
      "end_time": 98.5,
      "text": "いかがも何も"
    },
    {
      "index": 29,
      "start_time": 99.1,
      "end_time": 100.4,
      "text": "愚問だな"
    },
    {
      "index": 30,
      "start_time": 102.6,
      "end_time": 104.4,
      "text": "冬といえばー？"
    },
    {
      "index": 31,
      "start_time": 105.1,
      "end_time": 107.0,
      "text": "サマーですわ～！"
    }
  ],
