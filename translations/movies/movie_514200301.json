{
  "movie_id": 514200301,
  "subtitles": [
    {
      "index": 0,
      "start_time": 4.0,
      "end_time": 5.1,
      "text": "ほらよ！"
    },
    {
      "index": 1,
      "start_time": 9.5,
      "end_time": 10.5,
      "text": "This is...?"
    },
    {
      "index": 2,
      "start_time": 11.1,
      "end_time": 14.2,
      "text": "【王宮騎士団（NIGHTMARE）】が兵士に支給してる剣だ"
    },
    {
      "index": 3,
      "start_time": 15.0,
      "end_time": 16.6,
      "text": "それであたしに打ってこい！"
    },
    {
      "index": 4,
      "start_time": 19.2,
      "end_time": 21.1,
      "text": "..."
    },
    {
      "index": 5,
      "start_time": 22.2,
      "end_time": 24.3,
      "text": "やわな作りですわね"
    },
    {
      "index": 6,
      "start_time": 24.6,
      "end_time": 27.1,
      "text": "おまえの武器がおかしいんだよっ"
    },
    {
      "index": 7,
      "start_time": 27.8,
      "end_time": 33.1,
      "text": "そうでしょうか？　何だか気が乗りませんわね……"
    },
    {
      "index": 8,
      "start_time": 33.4,
      "end_time": 34.2,
      "text": "二人ともー！"
    },
    {
      "index": 9,
      "start_time": 34.4,
      "end_time": 35.1,
      "text": "...!"
    },
    {
      "index": 10,
      "start_time": 36.1,
      "end_time": 37.9,
      "text": "あ、あなた様……！"
    },
    {
      "index": 11,
      "start_time": 38.3,
      "end_time": 40.2,
      "text": "頑張ってー！"
    },
    {
      "index": 12,
      "start_time": 42.3,
      "end_time": 45.3,
      "text": "あぁ……！　何て素敵な笑顔！"
    },
    {
      "index": 13,
      "start_time": 46.5,
      "end_time": 49.6,
      "text": "何としても声援に応えなくては……"
    },
    {
      "index": 14,
      "start_time": 50.5,
      "end_time": 53.6,
      "text": "絶対に、負けられませんわっ！！"
    },
    {
      "index": 15,
      "start_time": 54.0,
      "end_time": 56.1,
      "text": "いきなりやる気になったな、オイ！？"
    },
    {
      "index": 16,
      "start_time": 57.2,
      "end_time": 59.3,
      "text": "クスクスクス……"
    },
    {
      "index": 17,
      "start_time": 59.8,
      "end_time": 61.1,
      "text": "参ります♪"
    },
    {
      "index": 18,
      "start_time": 64.2,
      "end_time": 67.1,
      "text": "へえ、初めてにしちゃやるな"
    },
    {
      "index": 19,
      "start_time": 67.6,
      "end_time": 71.1,
      "text": "けど……守りのほうはどうだ！？"
    },
    {
      "index": 20,
      "start_time": 73.1,
      "end_time": 74.0,
      "text": "...!"
    },
    {
      "index": 21,
      "start_time": 74.3,
      "end_time": 75.6,
      "text": "...!"
    },
    {
      "index": 22,
      "start_time": 77.0,
      "end_time": 79.2,
      "text": "へへっ……！　どうだ"
    },
    {
      "index": 23,
      "start_time": 79.6,
      "end_time": 82.1,
      "text": "剣術の必要性が分かったかよ？"
    },
    {
      "index": 24,
      "start_time": 83.1,
      "end_time": 87.7,
      "text": "……ええ。ですが、あのおかたに応援された以上"
    },
    {
      "index": 25,
      "start_time": 87.9,
      "end_time": 90.5,
      "text": "この勝負、負けられません"
    },
    {
      "index": 26,
      "start_time": 91.0,
      "end_time": 93.0,
      "text": "かくなる上は……"
    },
    {
      "index": 27,
      "start_time": 94.5,
      "end_time": 95.3,
      "text": "Wha...!?"
    },
    {
      "index": 28,
      "start_time": 95.7,
      "end_time": 98.1,
      "text": "この一撃で、決めますわっ！"
    },
    {
      "index": 29,
      "start_time": 98.4,
      "end_time": 99.4,
      "text": "クスクスクスっ♪"
    },
    {
      "index": 30,
      "start_time": 99.6,
      "end_time": 100.4,
      "text": "!"
    },
    {
      "index": 31,
      "start_time": 100.6,
      "end_time": 102.6,
      "text": "こんにゃろぉっ！！"
    },
    {
      "index": 32,
      "start_time": 107.6,
      "end_time": 108.6,
      "text": "二人ともっ！"
    },
    {
      "index": 33,
      "start_time": 112.1,
      "end_time": 114.3,
      "text": "..."
    }
