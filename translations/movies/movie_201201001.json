{
  "movie_id": 201201001,
  "subtitles": [
    {
      "index": 0,
      "start_time": 12.5,
      "end_time": 13.6,
      "text": "Miss Pecorine."
    },
    {
      "index": 1,
      "start_time": 14.6,
      "end_time": 15.8,
      "text": "Miss Pecorine."
    },
    {
      "index": 2,
      "start_time": 18.0,
      "end_time": 19.8,
      "text": "You are Miss Pecorine, are you not...?"
    },
    {
      "index": 3,
      "start_time": 20.4,
      "end_time": 20.9,
      "text": "Huh?"
    },
    {
      "index": 4,
      "start_time": 21.2,
      "end_time": 22.8,
      "text": "Are you... Kokkoro?"
    },
    {
      "index": 5,
      "start_time": 22.9,
      "end_time": 23.3,
      "text": "Indeed!"
    },
    {
      "index": 6,
      "start_time": 23.9,
      "end_time": 26.8,
      "text": "I think this must be my real-world self."
    },
    {
      "index": 7,
      "start_time": 27.2,
      "end_time": 29.7,
      "text": "My name, I am told, is Kokoro Natsume."
    },
    {
      "index": 8,
      "start_time": 30.3,
      "end_time": 32.2,
      "text": "Kokkoro... Natsume?"
    },
    {
      "index": 9,
      "start_time": 32.4,
      "end_time": 33.0,
      "text": "No, \"Kokoro.\""
    },
    {
      "index": 10,
      "start_time": 33.5,
      "end_time": 36.0,
      "text": "Though it makes little difference."
    },
    {
      "index": 11,
      "start_time": 37.3,
      "end_time": 38.9,
      "text": "Is this the real world?"
    },
    {
      "index": 12,
      "start_time": 39.6,
      "end_time": 43.5,
      "text": "Did something suddenly wake both of us up from the dream?"
    },
    {
      "index": 13,
      "start_time": 43.8,
      "end_time": 44.3,
      "text": "No."
    },
    {
      "index": 14,
      "start_time": 45.0,
      "end_time": 47.9,
      "text": "It seems that through Lady Ameth's power,"
    },
    {
      "index": 15,
      "start_time": 48.2,
      "end_time": 50.7,
      "text": "we have been transported inside Miss Karyl's mind."
    },
    {
      "index": 16,
      "start_time": 50.7,
      "end_time": 52.4,
      "text": "I don't really get it..."
    },
    {
      "index": 17,
      "start_time": 53.2,
      "end_time": 56.4,
      "text": "But this Lady Ameth must be pretty amazing, huh?"
    },
    {
      "index": 18,
      "start_time": 56.7,
      "end_time": 57.1,
      "text": "Whoa!"
    },
    {
      "index": 19,
      "start_time": 58.2,
      "end_time": 61.3,
      "text": "Look at these cute clothes I'm wearing!"
    },
    {
      "index": 20,
      "start_time": 61.5,
      "end_time": 63.4,
      "text": "After sitting in that cell for days,"
    },
    {
      "index": 21,
      "start_time": 63.5,
      "end_time": 65.3,
      "text": "I was dying to change into something nicer!"
    },
    {
      "index": 22,
      "start_time": 66.6,
      "end_time": 69.6,
      "text": "And your hair's super long in this world, huh?!"
    },
    {
      "index": 23,
      "start_time": 69.8,
      "end_time": 71.5,
      "text": "It's so cuuuute!"
    },
    {
      "index": 24,
      "start_time": 71.9,
      "end_time": 74.2,
      "text": "P-please do not pull on my cheeks...!"
    },
    {
      "index": 25,
      "start_time": 74.9,
      "end_time": 77.9,
      "text": "You two... This is no time to be playing around."
    },
    {
      "index": 26,
      "start_time": 78.3,
      "end_time": 78.9,
      "text": "?!"
    },
    {
      "index": 27,
      "start_time": 86.2,
      "end_time": 86.8,
      "text": "Ahh...?!"
    },
    {
      "index": 28,
      "start_time": 87.0,
      "end_time": 89.3,
      "text": "And, ehm... who might you be?"
    },
    {
      "index": 29,
      "start_time": 90.1,
      "end_time": 91.0,
      "text": "...?"
    }
  ],
