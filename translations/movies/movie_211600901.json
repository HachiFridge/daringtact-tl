{
  "movie_id": 211600901,
  "subtitles": [
    {
      "index": 0,
      "start_time": 9.2,
      "end_time": 11.2,
      "text": "Kusano, Yuiiiii!!"
    },
    {
      "index": 1,
      "start_time": 12.6,
      "end_time": 14.0,
      "text": "Ahh!"
    },
    {
      "index": 2,
      "start_time": 15.6,
      "end_time": 17.0,
      "text": "I..."
    },
    {
      "index": 3,
      "start_time": 18.7,
      "end_time": 20.1,
      "text": "I, will protect everyone."
    },
    {
      "index": 4,
      "start_time": 21.5,
      "end_time": 23.3,
      "text": "I want to save you...!"
    },
    {
      "index": 5,
      "start_time": 26.4,
      "end_time": 28.5,
      "text": "(Everyone, do you want to be saved...?)"
    },
    {
      "index": 6,
      "start_time": 30.2,
      "end_time": 32.0,
      "text": "(...I, am...)"
    },
    {
      "index": 7,
      "start_time": 37.4,
      "end_time": 38.7,
      "text": "(That's right...)"
    },
    {
      "index": 8,
      "start_time": 41.3,
      "end_time": 42.5,
      "text": "(...I, am...)"
    },
    {
      "index": 9,
      "start_time": 43.5,
      "end_time": 47.2,
      "text": "(I hate this world...)"
    },
    {
      "index": 10,
      "start_time": 48.5,
      "end_time": 54.4,
      "text": "(But I couldn't do anything about it myself.)"
    },
    {
      "index": 11,
      "start_time": 56.2,
      "end_time": 58.1,
      "text": "(I want you to help me)"
    },
    {
      "index": 12,
      "start_time": 62.4,
      "end_time": 63.9,
      "text": "(And so...)"
    },
    {
      "index": 13,
      "start_time": 64.9,
      "end_time": 66.7,
      "text": "(The Kishi-kun seen in the log is...)"
    },
    {
      "index": 14,
      "start_time": 67.5,
      "end_time": 69.4,
      "text": "(I'm helping everyone.)"
    },
    {
      "index": 15,
      "start_time": 70.5,
      "end_time": 74.5,
      "text": "(That's why... I'm sure they'll come to save me too.)"
    },
    {
      "index": 16,
      "start_time": 75.5,
      "end_time": 78.3,
      "text": "(That's what I thought...)"
    },
    {
      "index": 17,
      "start_time": 79.0,
      "end_time": 81.0,
      "text": "(I couldn't stop myself...)"
    },
    {
      "index": 18,
      "start_time": 83.5,
      "end_time": 84.4,
      "text": "?!"
    },
    {
      "index": 19,
      "start_time": 94.8,
      "end_time": 95.6,
      "text": "...!"
    },
    {
      "index": 20,
      "start_time": 103.2,
      "end_time": 104.2,
      "text": "..."
    }
  ],
