{
  "movie_id": 221300201,
  "subtitles": [
    {
      "index": 0,
      "start_time": 8.1,
      "end_time": 9.2,
      "text": "Please, excuse me"
    },
    {
      "index": 1,
      "start_time": 12.8,
      "end_time": 14.2,
      "text": "Princess Lyrael"
    },
    {
      "index": 2,
      "start_time": 15.2,
      "end_time": 16.9,
      "text": "First, a drink"
    },
    {
      "index": 3,
      "start_time": 17.6,
      "end_time": 20.2,
      "text": "I hope it is to your liking"
    },
    {
      "index": 4,
      "start_time": 21.3,
      "end_time": 24.0,
      "text": "Thank you very much, Princess Nephi Nela"
    },
    {
      "index": 5,
      "start_time": 27.9,
      "end_time": 29.8,
      "text": "Wh-What do you think?"
    },
    {
      "index": 6,
      "start_time": 30.5,
      "end_time": 32.0,
      "text": "Mm~"
    },
    {
      "index": 7,
      "start_time": 33.0,
      "end_time": 34.3,
      "text": "Hmm, hmm"
    },
    {
      "index": 8,
      "start_time": 35.9,
      "end_time": 38.1,
      "text": "Seems okay to me, Violet-san♪"
    },
    {
      "index": 9,
      "start_time": 38.4,
      "end_time": 41.6,
      "text": "No wounds or bruises, just a very pretty back!"
    },
    {
      "index": 10,
      "start_time": 42.2,
      "end_time": 43.6,
      "text": "Thank goodness..."
    },
    {
      "index": 11,
      "start_time": 45.4,
      "end_time": 48.2,
      "text": "Goodness, I just could not check my back myself"
    },
    {
      "index": 12,
      "start_time": 48.6,
      "end_time": 50.7,
      "text": "Thank you very much, Princess Pecorine"
    },
    {
      "index": 13,
      "start_time": 51.0,
      "end_time": 52.1,
      "text": "It's okay, really..."
    },
    {
      "index": 14,
      "start_time": 52.3,
      "end_time": 56.1,
      "text": "The battles at your castle and the Obsidian Palace were tough, after all..."
    },
    {
      "index": 15,
      "start_time": 60.4,
      "end_time": 63.8,
      "text": "It seems that you have had a rough time in Gio Nivlhel..."
    },
    {
      "index": 16,
      "start_time": 64.8,
      "end_time": 68.1,
      "text": "If you do not mind, could you tell us more?"
    },
    {
      "index": 17,
      "start_time": 71.3,
      "end_time": 72.2,
      "text": "Correct!"
    },
    {
      "index": 18,
      "start_time": 74.1,
      "end_time": 75.3,
      "text": "I see..."
    },
    {
      "index": 19,
      "start_time": 75.9,
      "end_time": 78.1,
      "text": "Once again, Freyja and her allies were working behind the scenes..."
    },
    {
      "index": 20,
      "start_time": 78.7,
      "end_time": 82.8,
      "text": "She really is incorrigible"
    },
    {
      "index": 21,
      "start_time": 84.2,
      "end_time": 86.0,
      "text": "Always hiding and plotting..."
    },
    {
      "index": 22,
      "start_time": 87.0,
      "end_time": 90.8,
      "text": "Princess Pecorine. Would you have some?"
    },
    {
      "index": 23,
      "start_time": 91.0,
      "end_time": 92.3,
      "text": "Ah..."
    },
    {
      "index": 24,
      "start_time": 94.3,
      "end_time": 95.5,
      "text": "Princess Pecorine...?"
    },
    {
      "index": 25,
      "start_time": 97.3,
      "end_time": 100.2,
      "text": "Actually... I gathered you all here because..."
    },
    {
      "index": 26,
      "start_time": 100.4,
      "end_time": 103.2,
      "text": "Because I want to tell you something important"
    },
    {
      "index": 27,
      "start_time": 103.5,
      "end_time": 106.3,
      "text": "Princess Pecorine, does that mean..."
    },
    {
      "index": 28,
      "start_time": 106.6,
      "end_time": 107.4,
      "text": "Correct!"
    },
    {
      "index": 29,
      "start_time": 108.3,
      "end_time": 111.6,
      "text": "Yes. The \"Second Four Worlds Princess Conference\" is starting"
    }
  ],
