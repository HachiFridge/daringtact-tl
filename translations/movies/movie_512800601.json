{
  "movie_id": 512800601,
  "subtitles": [
    {
      "index": 0,
      "start_time": 6.1,
      "end_time": 8.5,
      "text": "8th Sword, Sangakintai──"
    },
    {
      "index": 1,
      "start_time": 15.7,
      "end_time": 18.5,
      "text": "If that had hit, there wouldn't be anything left of us..."
    },
    {
      "index": 2,
      "start_time": 18.7,
      "end_time": 21.6,
      "text": "Really sorry, but don't expect me to be able to block that a second time."
    },
    {
      "index": 3,
      "start_time": 22.5,
      "end_time": 24.1,
      "text": "We have to stop it somehow."
    },
    {
      "index": 4,
      "start_time": 25.2,
      "end_time": 26.3,
      "text": "What's the plan?"
    },
    {
      "index": 5,
      "start_time": 26.6,
      "end_time": 28.3,
      "text": "I'm thinking of one."
    },
    {
      "index": 6,
      "start_time": 28.5,
      "end_time": 30.5,
      "text": "Then I'll stop its legs."
    },
    {
      "index": 7,
      "start_time": 31.5,
      "end_time": 33.2,
      "text": "I'll divert its attention!"
    },
    {
      "index": 8,
      "start_time": 33.6,
      "end_time": 34.5,
      "text": "I'll provide support!"
    },
    {
      "index": 9,
      "start_time": 35.2,
      "end_time": 37.0,
      "text": "Spirit of Wind..."
    },
    {
      "index": 10,
      "start_time": 46.5,
      "end_time": 47.5,
      "text": "...!"
    },
    {
      "index": 11,
      "start_time": 48.3,
      "end_time": 51.6,
      "text": "That attack just now, it didn't even aim at him."
    },
    {
      "index": 12,
      "start_time": 51.8,
      "end_time": 53.1,
      "text": "How is it doing it..."
    },
    {
      "index": 13,
      "start_time": 53.6,
      "end_time": 55.3,
      "text": "It's likely heat detection!"
    },
    {
      "index": 14,
      "start_time": 55.5,
      "end_time": 57.3,
      "text": "Everyone, be careful!"
    },
    {
      "index": 15,
      "start_time": 61.5,
      "end_time": 63.0,
      "text": "Heat..."
    },
    {
      "index": 16,
      "start_time": 63.2,
      "end_time": 65.2,
      "text": "If everyone's hidden like an oasis..."
    },
    {
      "index": 17,
      "start_time": 65.5,
      "end_time": 66.2,
      "text": "...!"
    },
    {
      "index": 18,
      "start_time": 66.5,
      "end_time": 67.6,
      "text": "That's it!"
    },
    {
      "index": 19,
      "start_time": 68.5,
      "end_time": 70.1,
      "text": "Leave it to me!"
    },
    {
      "index": 20,
      "start_time": 72.6,
      "end_time": 74.0,
      "text": "Yahh!"
    },
    {
      "index": 21,
      "start_time": 80.1,
      "end_time": 81.5,
      "text": "The attack was stopped!"
    },
    {
      "index": 22,
      "start_time": 81.7,
      "end_time": 84.1,
      "text": "He couldn't detect us through the heat!"
    },
    {
      "index": 23,
      "start_time": 84.4,
      "end_time": 85.6,
      "text": "I think this'll work!"
    },
    {
      "index": 24,
      "start_time": 86.0,
      "end_time": 88.1,
      "text": "Yeah, let's finish him right away!"
    },
    {
      "index": 25,
      "start_time": 88.3,
      "end_time": 90.3,
      "text": "Yeah! Haaaaah～"
    },
    {
      "index": 26,
      "start_time": 91.3,
      "end_time": 92.3,
      "text": "Stop moving!"
    },
    {
      "index": 27,
      "start_time": 93.3,
      "end_time": 94.0,
      "text": "Hah!"
    },
    {
      "index": 28,
      "start_time": 96.1,
      "end_time": 96.9,
      "text": "Hahh!"
    },
    {
      "index": 29,
      "start_time": 101.1,
      "end_time": 102.5,
      "text": "Now, please jump!"
    },
    {
      "index": 30,
      "start_time": 111.4,
      "end_time": 114.3,
      "text": "Too bad, that was just a mirage!"
    },
    {
      "index": 31,
      "start_time": 116.2,
      "end_time": 118.4,
      "text": "HAAAAAAAAH!"
    },
    {
      "index": 32,
      "start_time": 135.2,
      "end_time": 136.6,
      "text": "...Amazing."
    }
  ],
