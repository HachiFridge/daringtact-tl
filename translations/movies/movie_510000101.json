{
  "movie_id": 510000101,
  "subtitles": [
    {
      "index": 0,
      "start_time": 4.3,
      "end_time": 9.8,
      "text": "針をとめて、糸の端を始末したらいらない分を……"
    },
    {
      "index": 1,
      "start_time": 10.1,
      "end_time": 11.8,
      "text": "ちょっきり切って♪"
    },
    {
      "index": 2,
      "start_time": 12.2,
      "end_time": 13.8,
      "text": "完成どす！"
    },
    {
      "index": 3,
      "start_time": 14.0,
      "end_time": 16.5,
      "text": "うち、頑張りましたえ王子はん……♪"
    },
    {
      "index": 4,
      "start_time": 16.8,
      "end_time": 18.0,
      "text": "ふあ～あ……"
    },
    {
      "index": 5,
      "start_time": 18.4,
      "end_time": 21.4,
      "text": "これでどうにか、旅に出られます……"
    },
    {
      "index": 6,
      "start_time": 31.2,
      "end_time": 34.0,
      "text": "うち、眠って……？"
    },
    {
      "index": 7,
      "start_time": 35.7,
      "end_time": 37.4,
      "text": "マホ姫、おはよう"
    },
    {
      "index": 8,
      "start_time": 38.0,
      "end_time": 39.6,
      "text": "お、王子はん……！？"
    },
    {
      "index": 9,
      "start_time": 39.8,
      "end_time": 41.6,
      "text": "お、おはようさんどす……"
    },
    {
      "index": 10,
      "start_time": 41.8,
      "end_time": 43.8,
      "text": "いやや、うち眠って……"
    },
    {
      "index": 11,
      "start_time": 44.0,
      "end_time": 45.0,
      "text": "遅くまでお疲れ様"
    },
    {
      "index": 12,
      "start_time": 45.8,
      "end_time": 46.6,
      "text": "Ah..."
    },
    {
      "index": 13,
      "start_time": 46.8,
      "end_time": 48.6,
      "text": "この毛布も王子はんが？"
    },
    {
      "index": 14,
      "start_time": 48.8,
      "end_time": 49.9,
      "text": "Yeah..."
    },
    {
      "index": 15,
      "start_time": 50.8,
      "end_time": 52.9,
      "text": "おおきに、王子はん"
    },
    {
      "index": 16,
      "start_time": 53.1,
      "end_time": 55.2,
      "text": "マホさんマホさーん！　おはよう！"
    },
    {
      "index": 17,
      "start_time": 55.8,
      "end_time": 57.7,
      "text": "ねぇねぇ、お洋服できた！？"
    },
    {
      "index": 18,
      "start_time": 58.0,
      "end_time": 59.0,
      "text": "もちろんどす♪"
    },
    {
      "index": 19,
      "start_time": 59.2,
      "end_time": 61.0,
      "text": "やったぁ！　着てみていい！？"
    },
    {
      "index": 20,
      "start_time": 61.2,
      "end_time": 63.8,
      "text": "えっへへーうれしいな♪"
    },
    {
      "index": 21,
      "start_time": 64.0,
      "end_time": 66.0,
      "text": "ぷうきちはんの分もありますえ"
    },
    {
      "index": 22,
      "start_time": 66.3,
      "end_time": 68.7,
      "text": "『マホの姫さん、俺の分まで！？』"
    },
    {
      "index": 23,
      "start_time": 69.0,
      "end_time": 71.2,
      "text": "さ、お着がえしてきまひょ"
    },
    {
      "index": 24,
      "start_time": 72.0,
      "end_time": 74.4,
      "text": "王子はん、ちょっと待っておくれやす"
    },
    {
      "index": 25,
      "start_time": 74.9,
      "end_time": 76.0,
      "text": "早く早く～♪"
    },
    {
      "index": 26,
      "start_time": 76.2,
      "end_time": 77.3,
      "text": "『おおおおお～～～！？』"
    },
    {
      "index": 27,
      "start_time": 77.8,
      "end_time": 79.0,
      "text": "行ってらっしゃい"
    },
    {
      "index": 28,
      "start_time": 88.8,
      "end_time": 90.1,
      "text": "見て見て！　お兄ちゃん！"
    },
    {
      "index": 29,
      "start_time": 90.3,
      "end_time": 92.7,
      "text": "私たちの服！　似合ってる？"
    },
    {
      "index": 30,
      "start_time": 97.0,
      "end_time": 98.0,
      "text": "王子はん"
    },
    {
      "index": 31,
      "start_time": 98.2,
      "end_time": 100.0,
      "text": "慣れないところに行くさかい……"
    },
    {
      "index": 32,
      "start_time": 100.4,
      "end_time": 102.8,
      "text": "気合を入れて縫うたんよ"
    },
    {
      "index": 33,
      "start_time": 103.0,
      "end_time": 104.7,
      "text": "どうですやろ……？"
    },
    {
      "index": 34,
      "start_time": 106.8,
      "end_time": 108.0,
      "text": "みんな、よく似合ってるよ"
    },
    {
      "index": 35,
      "start_time": 108.2,
      "end_time": 111.0,
      "text": "えへへ～これならどこにだって行けるよ！"
    },
    {
      "index": 36,
      "start_time": 111.4,
      "end_time": 112.6,
      "text": "ね、ぷうきち！"
    },
    {
      "index": 37,
      "start_time": 112.8,
      "end_time": 113.4,
      "text": "Ooh!"
    },
    {
      "index": 38,
      "start_time": 113.6,
      "end_time": 114.6,
      "text": "アヤネはん"
    },
    {
      "index": 39,
      "start_time": 114.9,
      "end_time": 118.2,
      "text": "背中のとこ少しだけ塩梅を調節させてもらいます"
    },
    {
      "index": 40,
      "start_time": 118.6,
      "end_time": 120.4,
      "text": "わ、私のこと縫わないでね！？"
    },
    {
      "index": 41,
      "start_time": 120.6,
      "end_time": 123.6,
      "text": "ええ子にしてくれたら、うちは布しか刺しまへんえ"
    },
    {
      "index": 42,
      "start_time": 124.0,
      "end_time": 125.8,
      "text": "おっ、おとなしくします～～"
    },
    {
      "index": 43,
      "start_time": 126.3,
      "end_time": 128.2,
      "text": "さっ、出来上がりや♪"
    },
    {
      "index": 44,
      "start_time": 128.7,
      "end_time": 130.7,
      "text": "動きやすうなっとりますやろ♪"
    },
    {
      "index": 45,
      "start_time": 131.0,
      "end_time": 132.6,
      "text": "うん、ほんとだ！"
    },
    {
      "index": 46,
      "start_time": 132.8,
      "end_time": 135.1,
      "text": "王子はん、準備はよろしおすか？"
    },
    {
      "index": 47,
      "start_time": 135.4,
      "end_time": 136.9,
      "text": "うん、もちろん"
    },
    {
      "index": 48,
      "start_time": 138.0,
      "end_time": 140.8,
      "text": "『それじゃ、羊を探しに、出発だぜ！』"
    },
    {
      "index": 49,
      "start_time": 141.0,
      "end_time": 143.6,
      "text": "Yeeeah!"
    }
  ],
