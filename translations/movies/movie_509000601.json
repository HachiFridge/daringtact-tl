{
  "movie_id": 509000601,
  "subtitles": [
    {
      "index": 0,
      "start_time": 2.5,
      "end_time": 6.5,
      "text": "UUUUOOOOOAAAAHHHH!!!"
    },
    {
      "index": 1,
      "start_time": 8.0,
      "end_time": 9.3,
      "text": "DORYAAAAAAAAAH!"
    },
    {
      "index": 2,
      "start_time": 11.0,
      "end_time": 12.8,
      "text": "Guuu!!"
    },
    {
      "index": 3,
      "start_time": 13.6,
      "end_time": 14.6,
      "text": "Inori..."
    },
    {
      "index": 4,
      "start_time": 15.5,
      "end_time": 17.0,
      "text": "You have awakened"
    },
    {
      "index": 5,
      "start_time": 18.0,
      "end_time": 19.0,
      "text": "I see."
    },
    {
      "index": 6,
      "start_time": 20.0,
      "end_time": 22.5,
      "text": "That sure is a lot of power"
    },
    {
      "index": 7,
      "start_time": 24.0,
      "end_time": 25.2,
      "text": "But... SO WHAT!"
    },
    {
      "index": 8,
      "start_time": 27.3,
      "end_time": 28.1,
      "text": "Guh...!"
    },
    {
      "index": 9,
      "start_time": 29.0,
      "end_time": 30.2,
      "text": "Inori-chan!"
    },
    {
      "index": 10,
      "start_time": 32.0,
      "end_time": 33.6,
      "text": "Don't underestimate ME!"
    },
    {
      "index": 11,
      "start_time": 39.3,
      "end_time": 40.6,
      "text": "Hahaha!"
    },
    {
      "index": 12,
      "start_time": 41.0,
      "end_time": 42.0,
      "text": "Thank you so much!"
    },
    {
      "index": 13,
      "start_time": 42.5,
      "end_time": 44.5,
      "text": "I've been starved for stimulation lately!"
    },
    {
      "index": 14,
      "start_time": 45.3,
      "end_time": 47.1,
      "text": "Go ahead and give me more fun!"
    },
    {
      "index": 15,
      "start_time": 47.3,
      "end_time": 48.6,
      "text": "Shut up already!"
    },
    {
      "index": 16,
      "start_time": 49.3,
      "end_time": 51.5,
      "text": "YOU DAMNED MUSCLE GEEZER!"
    },
    {
      "index": 17,
      "start_time": 65.1,
      "end_time": 67.2,
      "text": "*pant pant*"
    },
    {
      "index": 18,
      "start_time": 67.6,
      "end_time": 68.5,
      "text": "Ungh..."
    },
    {
      "index": 19,
      "start_time": 69.0,
      "end_time": 70.1,
      "text": "This is bad..."
    },
    {
      "index": 20,
      "start_time": 70.4,
      "end_time": 73.5,
      "text": "Her body hasn't caught up with the power of her awakening...!?"
    },
    {
      "index": 21,
      "start_time": 78.1,
      "end_time": 80.2,
      "text": "All I can do is..."
    },
    {
      "index": 22,
      "start_time": 82.5,
      "end_time": 85.5,
      "text": "Hey, hey... don't tell me you're done already?"
    },
    {
      "index": 23,
      "start_time": 86.2,
      "end_time": 88.5,
      "text": "I-I still have a lot left in me"
    },
    {
      "index": 24,
      "start_time": 89.3,
      "end_time": 90.6,
      "text": "Is that so?"
    },
    {
      "index": 25,
      "start_time": 98.3,
      "end_time": 101.1,
      "text": "I'll show you what I've got!"
    },
    {
      "index": 26,
      "start_time": 104.6,
      "end_time": 106.0,
      "text": "Interesting...!"
    },
    {
      "index": 27,
      "start_time": 108.3,
      "end_time": 109.2,
      "text": "BRING IT!"
    },
    {
      "index": 28,
      "start_time": 115.3,
      "end_time": 117.3,
      "text": "Is that really all you've got?"
    },
    {
      "index": 29,
      "start_time": 118.2,
      "end_time": 121.0,
      "text": "What a disappointment, a big one!"
    },
    {
      "index": 30,
      "start_time": 121.2,
      "end_time": 121.8,
      "text": "Nooope"
    },
    {
      "index": 31,
      "start_time": 122.0,
      "end_time": 124.3,
      "text": "Heh, it's a jackpot!"
    },
    {
      "index": 32,
      "start_time": 125.0,
      "end_time": 125.6,
      "text": "?!"
    },
    {
      "index": 33,
      "start_time": 126.0,
      "end_time": 127.0,
      "text": "Wha...!?"
    },
    {
      "index": 34,
      "start_time": 128.6,
      "end_time": 131.2,
      "text": "You bastard... when did you!?"
    },
    {
      "index": 35,
      "start_time": 132.2,
      "end_time": 133.2,
      "text": "I..."
    },
    {
      "index": 36,
      "start_time": 134.2,
      "end_time": 135.3,
      "text": "BECAUSE I'M A PHANTOM THIEF!"
    },
    {
      "index": 37,
      "start_time": 137.3,
      "end_time": 139.2,
      "text": "WHERE THE HELL DID YOU GO?!"
    },
    {
      "index": 38,
      "start_time": 139.6,
      "end_time": 140.6,
      "text": "(Ugh...)"
    },
    {
      "index": 39,
      "start_time": 141.2,
      "end_time": 144.5,
      "text": "(If I attack at random, it might get absorbed in the \"Dragon Egg\"...!)"
    },
    {
      "index": 40,
      "start_time": 145.5,
      "end_time": 148.5,
      "text": "(So she was the most dangerous one after all)"
    },
    {
      "index": 41,
      "start_time": 149.5,
      "end_time": 151.1,
      "text": "Where are you looking?"
    },
    {
      "index": 42,
      "start_time": 152.5,
      "end_time": 154.1,
      "text": "Let's go, AyuAyu!"
    },
    {
      "index": 43,
      "start_time": 154.3,
      "end_time": 156.0,
      "text": "Yeah...! Inori-chan!"
    },
    {
      "index": 44,
      "start_time": 161.0,
      "end_time": 166.3,
      "text": "GUOOOOOOHHHHHHHH..."
    },
    {
      "index": 45,
      "start_time": 170.5,
      "end_time": 172.3,
      "text": "*pant pant*..."
    },
    {
      "index": 46,
      "start_time": 172.6,
      "end_time": 174.5,
      "text": "D-Did we do it?"
    },
    {
      "index": 47,
      "start_time": 175.0,
      "end_time": 176.3,
      "text": "Y-Yeah!"
    },
    {
      "index": 48,
      "start_time": 176.6,
      "end_time": 179.3,
      "text": "We really did it!"
    }
  ],
