{
  "movie_id": 510400601,
  "subtitles": [
    {
      "index": 0,
      "start_time": 7.2,
      "end_time": 8.5,
      "text": "Nightmare..."
    },
    {
      "index": 1,
      "start_time": 9.2,
      "end_time": 12.5,
      "text": "And I will fight for the Beastfolk tribe!"
    },
    {
      "index": 2,
      "start_time": 22.0,
      "end_time": 22.6,
      "text": "...!"
    },
    {
      "index": 3,
      "start_time": 33.5,
      "end_time": 34.1,
      "text": "Ngh..."
    },
    {
      "index": 4,
      "start_time": 34.3,
      "end_time": 36.0,
      "text": "How tough is it?!"
    },
    {
      "index": 5,
      "start_time": 38.3,
      "end_time": 40.3,
      "text": "Let me have some fun, too!"
    },
    {
      "index": 6,
      "start_time": 47.5,
      "end_time": 51.4,
      "text": "Fighting without using a sword is refreshing and surprisingly enjoyable."
    },
    {
      "index": 7,
      "start_time": 52.0,
      "end_time": 53.5,
      "text": "Wow, this is amazing!"
    },
    {
      "index": 8,
      "start_time": 54.3,
      "end_time": 55.5,
      "text": "...Ah!"
    },
    {
      "index": 9,
      "start_time": 57.6,
      "end_time": 60.1,
      "text": "Oh... It has to be that way!"
    },
    {
      "index": 10,
      "start_time": 60.5,
      "end_time": 62.5,
      "text": "This isn't the time to be having fun!"
    },
    {
      "index": 11,
      "start_time": 62.7,
      "end_time": 65.0,
      "text": "You haven't forgotten the mission, right?"
    },
    {
      "index": 12,
      "start_time": 65.2,
      "end_time": 67.1,
      "text": "This isn't going to get us anywhere"
    },
    {
      "index": 13,
      "start_time": 67.5,
      "end_time": 68.3,
      "text": "Mm..."
    },
    {
      "index": 14,
      "start_time": 69.0,
      "end_time": 70.6,
      "text": "Hmmm, a mission, huh..."
    },
    {
      "index": 15,
      "start_time": 74.0,
      "end_time": 78.3,
      "text": "It seems that I won't be able to deliver a decisive blow."
    },
    {
      "index": 16,
      "start_time": 78.6,
      "end_time": 81.4,
      "text": "...To think it could withstand such strength..."
    },
    {
      "index": 17,
      "start_time": 82.1,
      "end_time": 83.4,
      "text": "I'm completely stumped, pyon!"
    },
    {
      "index": 18,
      "start_time": 83.5,
      "end_time": 85.4,
      "text": "Hey, wait a minute!"
    },
    {
      "index": 19,
      "start_time": 85.9,
      "end_time": 86.7,
      "text": "Therefore..."
    },
    {
      "index": 20,
      "start_time": 87.2,
      "end_time": 88.5,
      "text": "I'll leave the final blow to you."
    },
    {
      "index": 21,
      "start_time": 91.6,
      "end_time": 94.6,
      "text": "I will break down that troublesome outer layer."
    },
    {
      "index": 22,
      "start_time": 95.5,
      "end_time": 98.3,
      "text": "And before it can recover, tear it apart with your sword."
    },
    {
      "index": 23,
      "start_time": 99.5,
      "end_time": 101.2,
      "text": "A-All right!"
    },
    {
      "index": 24,
      "start_time": 102.2,
      "end_time": 104.2,
      "text": "Let's begin. Don't miss your chance."
    },
    {
      "index": 25,
      "start_time": 105.6,
      "end_time": 107.6,
      "text": "Now, please give me your hand!"
    },
    {
      "index": 26,
      "start_time": 108.5,
      "end_time": 113.4,
      "text": "Let's start a passionate and intense ballroom dance towards peace!"
    },
    {
      "index": 27,
      "start_time": 120.5,
      "end_time": 122.3,
      "text": "Oh, how delightful!"
    },
    {
      "index": 28,
      "start_time": 122.6,
      "end_time": 125.1,
      "text": "Isn't this a passionate conversation we're having!"
    },
    {
      "index": 29,
      "start_time": 129.1,
      "end_time": 133.3,
      "text": "Now, next up, I will showcase my elegant steps!"
    },
    {
      "index": 30,
      "start_time": 141.1,
      "end_time": 141.7,
      "text": "Now!"
    },
    {
      "index": 31,
      "start_time": 142.3,
      "end_time": 143.0,
      "text": "...!"
    },
    {
      "index": 32,
      "start_time": 144.3,
      "end_time": 147.1,
      "text": "With the pride of Nightmare and the Beastfolk tribe..."
    },
    {
      "index": 33,
      "start_time": 147.4,
      "end_time": 150.3,
      "text": "With this swing, I'll carve open the future!"
    },
    {
      "index": 34,
      "start_time": 150.6,
      "end_time": 152.1,
      "text": "Haaaaa!"
    }
  ],
