{
  "movie_id": 201301001,
  "subtitles": [
    {
      "index": 0,
      "start_time": 1.3,
      "end_time": 2.5,
      "text": "Nicely done..."
    },
    {
      "index": 1,
      "start_time": 3.0,
      "end_time": 4.3,
      "text": "But you can't let your guard down."
    },
    {
      "index": 2,
      "start_time": 4.5,
      "end_time": 7.0,
      "text": "You have to think several steps ahead."
    },
    {
      "index": 3,
      "start_time": 7.7,
      "end_time": 8.7,
      "text": "Aaahh!"
    },
    {
      "index": 4,
      "start_time": 10.3,
      "end_time": 10.8,
      "text": "Ah!"
    },
    {
      "index": 5,
      "start_time": 11.2,
      "end_time": 12.0,
      "text": "Miyako!"
    },
    {
      "index": 6,
      "start_time": 14.6,
      "end_time": 16.6,
      "text": "That brute... When did she...?!"
    },
    {
      "index": 7,
      "start_time": 17.7,
      "end_time": 20.0,
      "text": "You're... a ghost, am I correct?"
    },
    {
      "index": 8,
      "start_time": 20.4,
      "end_time": 23.1,
      "text": "What do you want with Miyako?!"
    },
    {
      "index": 9,
      "start_time": 23.1,
      "end_time": 27.2,
      "text": "Hahaha... That saves me the effort of preparing my meal."
    },
    {
      "index": 10,
      "start_time": 27.8,
      "end_time": 30.6,
      "text": "Aaaaghhh! Stop! Stop that!"
    },
    {
      "index": 11,
      "start_time": 30.7,
      "end_time": 34.1,
      "text": "It hurts! Miyako isn't a bad ghost!"
    },
    {
      "index": 12,
      "start_time": 34.3,
      "end_time": 35.2,
      "text": "Miyako!"
    },
    {
      "index": 13,
      "start_time": 36.1,
      "end_time": 38.3,
      "text": "No... I'm the bad one."
    },
    {
      "index": 14,
      "start_time": 39.1,
      "end_time": 43.3,
      "text": "A mere villain who was never able to become the hero."
    },
    {
      "index": 15,
      "start_time": 44.1,
      "end_time": 48.0,
      "text": "But this is your fault too, you know, for failing to stop me."
    },
    {
      "index": 16,
      "start_time": 49.5,
      "end_time": 52.2,
      "text": "Don't make Miyako disappear!"
    },
    {
      "index": 17,
      "start_time": 53.1,
      "end_time": 57.3,
      "text": "Miyako wants to stay with everyone until Miyako passes on!"
    },
    {
      "index": 18,
      "start_time": 57.8,
      "end_time": 59.1,
      "text": "Well, too bad."
    },
    {
      "index": 19,
      "start_time": 59.3,
      "end_time": 60.0,
      "text": "!"
    },
    {
      "index": 20,
      "start_time": 60.2,
      "end_time": 62.0,
      "text": "That wish won't be granted."
    },
    {
      "index": 21,
      "start_time": 62.2,
      "end_time": 66.5,
      "text": "Only one person in this world is allowed to fulfill their wish."
    },
    {
      "index": 22,
      "start_time": 67.2,
      "end_time": 70.0,
      "text": "Don't you think that's cruel?"
    },
    {
      "index": 23,
      "start_time": 71.0,
      "end_time": 73.0,
      "text": "Aaaaahhhhhh!"
    },
    {
      "index": 24,
      "start_time": 73.2,
      "end_time": 75.1,
      "text": "Just let Miyako go already!"
    },
    {
      "index": 25,
      "start_time": 75.2,
      "end_time": 76.0,
      "text": "Why, you...!"
    },
    {
      "index": 26,
      "start_time": 77.2,
      "end_time": 79.8,
      "text": "Aaaaaaghh!"
    },
    {
      "index": 27,
      "start_time": 84.2,
      "end_time": 86.3,
      "text": "Could you stay out of this?"
    },
    {
      "index": 28,
      "start_time": 89.6,
      "end_time": 91.1,
      "text": "Don't worry."
    },
    {
      "index": 29,
      "start_time": 91.3,
      "end_time": 94.4,
      "text": "I'll consume the rest of you too, soon enough."
    }
  ],
