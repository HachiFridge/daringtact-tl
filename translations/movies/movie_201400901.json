{
  "movie_id": 201400901,
  "subtitles": [
    {
      "index": 0,
      "start_time": 9.4,
      "end_time": 10.4,
      "text": "Haha..."
    },
    {
      "index": 1,
      "start_time": 14.6,
      "end_time": 16.5,
      "text": "Urghhh...!"
    },
    {
      "index": 2,
      "start_time": 17.7,
      "end_time": 19.0,
      "text": "Ah! ...Look!"
    },
    {
      "index": 3,
      "start_time": 19.2,
      "end_time": 21.2,
      "text": "The Omniscient Kaiser looks different!"
    },
    {
      "index": 4,
      "start_time": 29.3,
      "end_time": 30.5,
      "text": "How outrageous..."
    },
    {
      "index": 5,
      "start_time": 31.1,
      "end_time": 34.5,
      "text": "The magical energy of that form far exceeds"
    },
    {
      "index": 6,
      "start_time": 34.6,
      "end_time": 36.2,
      "text": "what any human should possess!"
    },
    {
      "index": 7,
      "start_time": 37.1,
      "end_time": 38.0,
      "text": "Heheheh..."
    },
    {
      "index": 8,
      "start_time": 38.4,
      "end_time": 40.5,
      "text": "More than human, you say...?"
    },
    {
      "index": 9,
      "start_time": 41.1,
      "end_time": 42.4,
      "text": "Well, of course!"
    },
    {
      "index": 10,
      "start_time": 42.6,
      "end_time": 44.2,
      "text": "After all..."
    },
    {
      "index": 11,
      "start_time": 44.5,
      "end_time": 47.5,
      "text": "I am nothing less than a god!"
    },
    {
      "index": 12,
      "start_time": 52.4,
      "end_time": 55.3,
      "text": "Now, prostrate yourselves."
    },
    {
      "index": 13,
      "start_time": 55.7,
      "end_time": 58.2,
      "text": "You stand before the divine."
    },
    {
      "index": 14,
      "start_time": 59.1,
      "end_time": 62.6,
      "text": "Now that I've taken this form, all of you—"
    },
    {
      "index": 15,
      "start_time": 63.1,
      "end_time": 66.5,
      "text": "—no, every human in this realm—"
    },
    {
      "index": 16,
      "start_time": 66.6,
      "end_time": 69.7,
      "text": "will perish before you see another dawn."
    },
    {
      "index": 17,
      "start_time": 70.6,
      "end_time": 72.1,
      "text": "Now..."
    },
    {
      "index": 18,
      "start_time": 72.4,
      "end_time": 75.5,
      "text": "Everything must kneel to me!"
    }
  ],
