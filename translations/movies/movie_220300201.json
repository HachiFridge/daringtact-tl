      "end_time": 2.1,
      "text": "Oh, right...!"
    },
    {
      "index": 1,
      "start_time": 2.3,
      "end_time": 3.1,
      "text": "?"
    },
    {
      "index": 2,
      "start_time": 3.6,
      "end_time": 5.3,
      "text": "Um, umm, uhhh!"
    },
    {
      "index": 3,
      "start_time": 7.2,
      "end_time": 8.0,
      "text": "Leave it to me!"
    },
    {
      "index": 4,
      "start_time": 9.4,
      "end_time": 11.6,
      "text": "As thanks for the delicious lunch!"
    },
    {
      "index": 5,
      "start_time": 12.1,
      "end_time": 13.1,
      "text": "I'll give you this♪"
    },
    {
      "index": 6,
      "start_time": 13.3,
      "end_time": 14.3,
      "text": "..."
    },
    {
      "index": 7,
      "start_time": 14.5,
      "end_time": 15.2,
      "text": "Oh, and also..."
    },
    {
      "index": 8,
      "start_time": 15.4,
      "end_time": 18.5,
      "text": "This is to commemorate your visit to Gio Teogonia!"
    },
    {
      "index": 9,
      "start_time": 19.1,
      "end_time": 22.0,
      "text": "Oh, and one more! To commemorate our meeting♪"
    },
    {
      "index": 10,
      "start_time": 22.3,
      "end_time": 23.5,
      "text": "I'll give you this too!"
    },
    {
      "index": 11,
      "start_time": 24.1,
      "end_time": 26.2,
      "text": "This, this, this..."
    },
    {
      "index": 12,
      "start_time": 26.9,
      "end_time": 28.1,
      "text": "..."
    },
    {
      "index": 13,
      "start_time": 28.3,
      "end_time": 29.7,
      "text": "And this one..."
    },
    {
      "index": 14,
      "start_time": 30.2,
      "end_time": 32.6,
      "text": "Huh? You don't like it?"
    },
    {
      "index": 15,
      "start_time": 33.3,
      "end_time": 35.2,
      "text": "Let's see, umm..."
    },
    {
      "index": 16,
      "start_time": 36.1,
      "end_time": 36.8,
      "text": "Ahh—!"
    },
    {
      "index": 17,
      "start_time": 37.0,
      "end_time": 38.1,
      "text": "I apologize for the late introduction!"
    },
    {
      "index": 18,
      "start_time": 38.3,
      "end_time": 41.2,
      "text": "I'm Kururu the Carbuncle. ♪"
    },
    {
      "index": 19,
      "start_time": 41.4,
      "end_time": 44.4,
      "text": "Looking forward to working with you!"
    }
