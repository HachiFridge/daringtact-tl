{
  "movie_id": 510200201,
  "subtitles": [
    {
      "index": 0,
      "start_time": 2.2,
      "end_time": 6.0,
      "text": "Hm hm hm hm, hm hm hm hm♪"
    },
    {
      "index": 1,
      "start_time": 6.3,
      "end_time": 10.0,
      "text": "Hm hm hm hm, hm hm hm hm♪"
    },
    {
      "index": 2,
      "start_time": 10.3,
      "end_time": 11.9,
      "text": "...What are you doing?"
    },
    {
      "index": 3,
      "start_time": 12.3,
      "end_time": 13.6,
      "text": "Oh, Tomo."
    },
    {
      "index": 4,
      "start_time": 16.0,
      "end_time": 18.9,
      "text": "Halloween Police, it suits you well~!"
    },
    {
      "index": 5,
      "start_time": 19.1,
      "end_time": 20.3,
      "text": "Huh, really!?"
    },
    {
      "index": 6,
      "start_time": 21.2,
      "end_time": 22.2,
      "text": "Not that..."
    },
    {
      "index": 7,
      "start_time": 22.6,
      "end_time": 24.2,
      "text": "Why a bed of all things?"
    },
    {
      "index": 8,
      "start_time": 24.6,
      "end_time": 28.6,
      "text": "Oh, when I went to pick up Rin, she wouldn't\nwake up, you know as usual."
    },
    {
      "index": 9,
      "start_time": 29.2,
      "end_time": 32.1,
      "text": "And so, I brought the whole bed with me!"
    },
    {
      "index": 10,
      "start_time": 42.6,
      "end_time": 45.0,
      "text": "Rin! It is time to wake up!"
    },
    {
      "index": 11,
      "start_time": 45.6,
      "end_time": 46.4,
      "text": "Ugh..."
    },
    {
      "index": 12,
      "start_time": 46.6,
      "end_time": 48.6,
      "text": "Wow. Where am I?"
    },
    {
      "index": 13,
      "start_time": 49.0,
      "end_time": 51.4,
      "text": "Oh, hello! We've arrived at the venue!"
    },
    {
      "index": 14,
      "start_time": 51.7,
      "end_time": 54.6,
      "text": "Oh, did you transport me with magic?"
    },
    {
      "index": 15,
      "start_time": 55.0,
      "end_time": 57.0,
      "text": "This is convenient, isn't it?"
    },
    {
      "index": 16,
      "start_time": 57.2,
      "end_time": 60.5,
      "text": "Whenever I play with Nanaka,\nI wonder if I should ask her to carry me every time."
    },
    {
      "index": 17,
      "start_time": 61.5,
      "end_time": 62.3,
      "text": "All right."
    },
    {
      "index": 18,
      "start_time": 63.1,
      "end_time": 66.0,
      "text": "But still, it really feels like a festival,\ndoesn't it?"
    },
    {
      "index": 19,
      "start_time": 66.2,
      "end_time": 68.5,
      "text": "I think my excitement level might have gone\nup a bit."
    },
    {
      "index": 20,
      "start_time": 69.0,
      "end_time": 70.5,
      "text": "Well, you see..."
    },
    {
      "index": 21,
      "start_time": 71.6,
      "end_time": 73.6,
      "text": "Oops, I forgot."
    },
    {
      "index": 22,
      "start_time": 76.0,
      "end_time": 77.6,
      "text": "That's enough for now."
    },
    {
      "index": 23,
      "start_time": 78.2,
      "end_time": 81.9,
      "text": "Alright! Today is the day when everyone's\n\"likes\" come together!"
    },
    {
      "index": 24,
      "start_time": 82.2,
      "end_time": 84.2,
      "text": "I'm going to enjoy this to the fullest!"
    },
    {
      "index": 25,
      "start_time": 86.3,
      "end_time": 87.8,
      "text": "(\"My... Likes?\")"
    },
    {
      "index": 26,
      "start_time": 88.5,
      "end_time": 92.7,
      "text": "(I have a liking for magical girls and an\ninterest in games)"
    },
    {
      "index": 27,
      "start_time": 93.2,
      "end_time": 95.2,
      "text": "(I absolutely can't hide it...!)"
    },
    {
      "index": 28,
      "start_time": 96.5,
      "end_time": 98.0,
      "text": "Please take a look."
    },
    {
      "index": 29,
      "start_time": 99.6,
      "end_time": 101.2,
      "text": "This voice is..."
    },
    {
      "index": 30,
      "start_time": 103.4,
      "end_time": 104.7,
      "text": "Thank you very much!"
    },
    {
      "index": 31,
      "start_time": 107.1,
      "end_time": 109.1,
      "text": "What are you doing here...?"
    },
    {
      "index": 32,
      "start_time": 111.6,
      "end_time": 113.3,
      "text": "Manga vendor!"
    }
  ],
