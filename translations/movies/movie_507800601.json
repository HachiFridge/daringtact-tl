  "subtitles": [
    {
      "index": 0,
      "start_time": 1.3,
      "end_time": 3.3,
      "text": "キキキキキ！"
    },
    {
      "index": 1,
      "start_time": 3.8,
      "end_time": 5.3,
      "text": "ムダムダムダ！"
    },
    {
      "index": 2,
      "start_time": 5.5,
      "end_time": 7.6,
      "text": "この世界はオレサマのものだ！"
    },
    {
      "index": 3,
      "start_time": 8.5,
      "end_time": 10.6,
      "text": "うふふ、元気な子ね♪"
    },
    {
      "index": 4,
      "start_time": 10.8,
      "end_time": 13.8,
      "text": "い～っぱい、かわいがってあげたくなっちゃう♪"
    },
    {
      "index": 5,
      "start_time": 16.4,
      "end_time": 17.2,
      "text": "...!"
    },
    {
      "index": 6,
      "start_time": 17.4,
      "end_time": 21.0,
      "text": "あなたでは、クウカを征服することはできませんよ～……"
    },
    {
      "index": 7,
      "start_time": 21.2,
      "end_time": 22.5,
      "text": "ぐふふ♪"
    },
    {
      "index": 8,
      "start_time": 23.0,
      "end_time": 24.0,
      "text": "その野望……"
    },
    {
      "index": 9,
      "start_time": 24.3,
      "end_time": 28.3,
      "text": "私たちのでっかい愛と希望が打ち砕いてあげちゃうね♪"
    },
    {
      "index": 10,
      "start_time": 29.5,
      "end_time": 31.6,
      "text": "キッ、キキッ！　キキキキキーーーー！"
    },
    {
      "index": 11,
      "start_time": 34.2,
      "end_time": 35.0,
      "text": "ゆけっ！"
    },
    {
      "index": 12,
      "start_time": 35.2,
      "end_time": 36.3,
      "text": "了解っ！"
    },
    {
      "index": 13,
      "start_time": 42.1,
      "end_time": 44.3,
      "text": "クウカにお任せですぅ～！"
    },
    {
      "index": 14,
      "start_time": 47.2,
      "end_time": 49.2,
      "text": "お姉ちゃんチョーップ♪"
    },
    {
      "index": 15,
      "start_time": 53.6,
      "end_time": 55.5,
      "text": "いい子いい子♪"
    },
    {
      "index": 16,
      "start_time": 57.8,
      "end_time": 60.4,
      "text": "ぐ～ふ～ふ～♪"
    },
    {
      "index": 17,
      "start_time": 65.1,
      "end_time": 67.6,
      "text": "とってもいいですぅ～！"
    },
    {
      "index": 18,
      "start_time": 84.2,
      "end_time": 86.5,
      "text": "お姉ちゃんに不可能はないっ♪"
    },
    {
      "index": 19,
      "start_time": 98.6,
      "end_time": 101.8,
      "text": "キキキー！！"
    },
    {
      "index": 20,
      "start_time": 102.2,
      "end_time": 105.0,
      "text": "オイタしちゃダ・メ・よ♪"
    },
    {
      "index": 21,
      "start_time": 109.4,
      "end_time": 110.2,
      "text": "キ……キキッ……！？"
    },
    {
      "index": 22,
      "start_time": 110.6,
      "end_time": 111.5,
      "text": "Now!"
    },
    {
      "index": 23,
