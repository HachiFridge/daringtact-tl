{
  "movie_id": 504400601,
  "subtitles": [
    {
      "index": 0,
      "start_time": 1.6,
      "end_time": 3.6,
      "text": "Hehe..."
    },
    {
      "index": 1,
      "start_time": 4.0,
      "end_time": 6.8,
      "text": "さぁ、こちらに来るんだ"
    },
    {
      "index": 2,
      "start_time": 7.2,
      "end_time": 11.0,
      "text": "俺様と一緒に素晴らしきハーレムを築こう！"
    },
    {
      "index": 3,
      "start_time": 11.2,
      "end_time": 15.4,
      "text": "残念だけどハーレムに入ることはできないんだよね～"
    },
    {
      "index": 4,
      "start_time": 16.0,
      "end_time": 18.8,
      "text": "嫌よ嫌よもすきのうちってことか？"
    },
    {
      "index": 5,
      "start_time": 19.2,
      "end_time": 20.2,
      "text": "それはそれで……"
    },
    {
      "index": 6,
      "start_time": 21.0,
      "end_time": 23.8,
      "text": "はん、何を勘違いしてるんだい？"
    },
    {
      "index": 7,
      "start_time": 24.2,
      "end_time": 25.0,
      "text": "こっ……"
    },
    {
      "index": 8,
      "start_time": 29.2,
      "end_time": 30.4,
      "text": "こういうことだよ！"
    },
    {
      "index": 9,
      "start_time": 31.0,
      "end_time": 31.8,
      "text": "Wha—?!"
    },
    {
      "index": 10,
      "start_time": 32.2,
      "end_time": 33.8,
      "text": "シ、シグルド～♪"
    },
    {
      "index": 11,
      "start_time": 34.0,
      "end_time": 38.0,
      "text": "きょ、今日は私を甘やかしてく、くれるのだろ～？"
    },
    {
      "index": 12,
      "start_time": 38.2,
      "end_time": 40.0,
      "text": "な、何を言ってるんだい！"
    },
    {
      "index": 13,
      "start_time": 40.2,
      "end_time": 43.8,
      "text": "今日は私と一緒にふ、風呂に入るんだよ！"
    },
    {
      "index": 14,
      "start_time": 44.2,
      "end_time": 47.8,
      "text": "こらこら二人とも、抜け駆けはいけませんぞ～！"
    },
    {
      "index": 15,
      "start_time": 48.0,
      "end_time": 52.0,
      "text": "今日はナナカちゃんとときめきなトゥナイトな日でござる☆"
    },
    {
      "index": 16,
      "start_time": 52.4,
      "end_time": 55.6,
      "text": "それともみんなでトゥナイトしちゃいますかな～！？"
    },
    {
      "index": 17,
      "start_time": 56.0,
      "end_time": 59.0,
      "text": "す……すでにハーレムを作っている……だと！？"
    },
    {
      "index": 18,
      "start_time": 60.0,
      "end_time": 63.2,
      "text": "あ～あ！　シ、シグルドのハーレム幸せ過ぎて"
    },
    {
      "index": 19,
      "start_time": 63.4,
      "end_time": 67.0,
      "text": "ほ、他に行くとか考えられないな～！"
    },
    {
      "index": 20,
      "start_time": 67.6,
      "end_time": 71.0,
      "text": "べ、別に羨ましくなんか……うう……"
    },
    {
      "index": 21,
      "start_time": 71.2,
      "end_time": 73.0,
      "text": "そっちの方がいいっ！"
    },
    {
      "index": 22,
      "start_time": 74.6,
      "end_time": 75.6,
      "text": "出た！"
    },
    {
      "index": 23,
      "start_time": 76.4,
      "end_time": 78.0,
      "text": "その体……"
    },
    {
      "index": 24,
      "start_time": 79.2,
      "end_time": 81.2,
      "text": "俺様にーー！"
    },
    {
      "index": 25,
      "start_time": 82.0,
      "end_time": 83.0,
      "text": "At long last!"
    },
    {
      "index": 26,
      "start_time": 83.4,
      "end_time": 86.6,
      "text": "スーパーグレートガッチリケッカイ、略してー！"
    },
    {
      "index": 27,
      "start_time": 86.9,
      "end_time": 90.0,
      "text": "SGGK！　はつどうー！！"
    },
    {
      "index": 28,
      "start_time": 91.4,
      "end_time": 92.0,
      "text": "うぶぇっ！？"
    },
    {
      "index": 29,
      "start_time": 93.2,
      "end_time": 96.4,
      "text": "はあ……ようやく彦星から剥がれたね"
    },
    {
      "index": 30,
      "start_time": 96.8,
      "end_time": 101.0,
      "text": "ふっ、まんまと我らの策にハマるとは、愚か者め！"
    },
    {
      "index": 31,
      "start_time": 101.2,
      "end_time": 104.8,
      "text": "アンタのおかげでこちとら苦労させられたんだ"
    },
    {
      "index": 32,
      "start_time": 105.0,
      "end_time": 106.8,
      "text": "覚悟してもらうよ！"
    },
    {
      "index": 33,
      "start_time": 107.0,
      "end_time": 110.6,
      "text": "ぐぬぬぬ……こうなったらやってやるぅ～"
    },
    {
      "index": 34,
      "start_time": 110.8,
      "end_time": 112.8,
      "text": "ふぬお～っ"
    },
    {
      "index": 35,
      "start_time": 113.2,
      "end_time": 114.0,
      "text": "Ahh!"
    },
    {
      "index": 36,
      "start_time": 117.0,
      "end_time": 118.0,
      "text": "?!"
    },
    {
      "index": 37,
      "start_time": 119.2,
      "end_time": 123.6,
      "text": "こっちの気持ちも知らないで！　もう許さないぞぉー！"
    },
    {
      "index": 38,
      "start_time": 124.0,
      "end_time": 128.0,
      "text": "ありゃりゃ、なんか激おこぷんぷん丸になっちゃってるよ"
    },
    {
      "index": 39,
      "start_time": 128.2,
      "end_time": 129.6,
      "text": "どうするルカ姉？"
    },
    {
      "index": 40,
      "start_time": 130.0,
      "end_time": 132.0,
      "text": "分かっていること聞かないでおくれ"
    },
    {
      "index": 41,
      "start_time": 132.6,
      "end_time": 136.0,
      "text": "織姫、アタシたちから離れるんじゃないよ！"
    },
    {
      "index": 42,
      "start_time": 136.2,
      "end_time": 138.0,
      "text": "わ、分かりました、ルカ様！"
    },
    {
      "index": 43,
      "start_time": 138.6,
      "end_time": 143.0,
      "text": "ふふ、やはり我らに相応しいのは戦いということだな！"
    },
    {
      "index": 44,
      "start_time": 143.6,
      "end_time": 144.4,
      "text": "貴様は"
    },
    {
      "index": 45,
      "start_time": 144.5,
      "end_time": 147.6,
      "text": "このアンネローゼ・フォン・シュテッヒパルムが滅してやろう！"
    },
    {
      "index": 46,
      "start_time": 148.0,
      "end_time": 149.4,
      "text": "バカにしてぇ～！"
    },
    {
      "index": 47,
      "start_time": 149.6,
      "end_time": 151.4,
      "text": "うわぁぁぁぁ～！"
    },
    {
      "index": 48,
      "start_time": 152.0,
      "end_time": 153.8,
      "text": "さぁ、ここが正念場だ！"
    },
    {
      "index": 49,
      "start_time": 154.2,
      "end_time": 156.0,
      "text": "アンタたち、気合いを入れな！"
    },
    {
      "index": 50,
      "start_time": 156.4,
      "end_time": 157.8,
      "text": "OOH!"
    }
  ],
