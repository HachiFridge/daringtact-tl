      "text": "What's this?"
    },
    {
      "index": 1,
      "start_time": 3.9,
      "end_time": 7.3,
      "text": "Waaahhh! Get back! Don't come near me!"
    },
    {
      "index": 2,
      "start_time": 7.5,
      "end_time": 9.1,
      "text": "You big, fat dummies!"
    },
    {
      "index": 3,
      "start_time": 10.2,
      "end_time": 12.3,
      "text": "Don't get your panties in a twist, sis!"
    },
    {
      "index": 4,
      "start_time": 12.5,
      "end_time": 15.4,
      "text": "Look, it's not like they're tough monsters!"
    },
    {
      "index": 5,
      "start_time": 16.0,
      "end_time": 18.6,
      "text": "If we keep our cool, they'll be easy pickings!"
    },
    {
      "index": 6,
      "start_time": 18.9,
      "end_time": 19.5,
      "text": "B-but...!"
    },
    {
      "index": 7,
      "start_time": 19.8,
      "end_time": 23.3,
      "text": "That weird liquid they spray... It melts right through clothes!"
    },
    {
      "index": 8,
      "start_time": 23.9,
      "end_time": 24.2,
      "text": "Ahh!"
    },
    {
      "index": 9,
      "start_time": 25.9,
      "end_time": 27.8,
      "text": "Y-you creeps!"
    },
    {
      "index": 10,
      "start_time": 27.9,
      "end_time": 32.2,
      "text": "Ooh, that is awful! Your outfit cost a pretty penny, didn't it?"
    },
    {
      "index": 11,
      "start_time": 32.6,
      "end_time": 35.2,
      "text": "All right, I'll take care of them!"
    },
    {
      "index": 12,
      "start_time": 36.8,
      "end_time": 39.0,
      "text": "Take that, and that! And..."
    },
    {
