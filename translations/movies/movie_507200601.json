{
  "movie_id": 507200601,
  "subtitles": [
    {
      "index": 0,
      "start_time": 2.2,
      "end_time": 3.4,
      "text": "キャ～"
    },
    {
      "index": 1,
      "start_time": 4.0,
      "end_time": 6.0,
      "text": "う……うわー……"
    },
    {
      "index": 2,
      "start_time": 7.2,
      "end_time": 8.2,
      "text": "Everyone!"
    },
    {
      "index": 3,
      "start_time": 8.3,
      "end_time": 10.0,
      "text": "私たちのライブは"
    },
    {
      "index": 4,
      "start_time": 11.2,
      "end_time": 12.6,
      "text": "まだ途中だよ！"
    },
    {
      "index": 5,
      "start_time": 13.2,
      "end_time": 14.6,
      "text": "目をそらさないで！"
    },
    {
      "index": 6,
      "start_time": 15.2,
      "end_time": 17.2,
      "text": "何が起きても大丈夫"
    },
    {
      "index": 7,
      "start_time": 18.1,
      "end_time": 19.7,
      "text": "だって私たちは……"
    },
    {
      "index": 8,
      "start_time": 24.2,
      "end_time": 25.2,
      "text": "歌って！"
    },
    {
      "index": 9,
      "start_time": 29.2,
      "end_time": 30.2,
      "text": "踊って！"
    },
    {
      "index": 10,
      "start_time": 33.0,
      "end_time": 34.2,
      "text": "戦うアイドル！"
    },
    {
      "index": 11,
      "start_time": 34.6,
      "end_time": 36.4,
      "text": "カルミナ！　オンステージ！"
    },
    {
      "index": 12,
      "start_time": 37.2,
      "end_time": 38.2,
      "text": "ワーッ！"
    },
    {
      "index": 13,
      "start_time": 42.6,
      "end_time": 44.6,
      "text": "（みんなの笑顔は私たちが守る……）"
    },
    {
      "index": 14,
      "start_time": 45.6,
      "end_time": 49.0,
      "text": "（ううん、もっと眩しい笑顔を生み出してみせる！）"
    },
    {
      "index": 15,
      "start_time": 49.6,
      "end_time": 52.4,
      "text": "（そのために、私たちはいっぱい練習して）"
    },
    {
      "index": 16,
      "start_time": 52.6,
      "end_time": 53.8,
      "text": "（準備をして来たんだから！）"
    },
    {
      "index": 17,
      "start_time": 54.6,
      "end_time": 58.6,
      "text": "（カルミナの歌と踊り、重ねて来たすべてをここに……！）"
    },
    {
      "index": 18,
      "start_time": 62.4,
      "end_time": 64.0,
      "text": "ワァァァァ"
    },
    {
      "index": 19,
      "start_time": 65.2,
      "end_time": 67.5,
      "text": "……、声援、ありがとーっ！"
    },
    {
      "index": 20,
      "start_time": 96.0,
      "end_time": 97.2,
      "text": "...!"
    },
    {
      "index": 21,
      "start_time": 98.0,
      "end_time": 100.4,
      "text": "さあみなさん、まだまだこれからです！"
    },
    {
      "index": 22,
      "start_time": 101.2,
      "end_time": 103.2,
      "text": "次は私たちの新曲！"
    },
    {
      "index": 23,
      "start_time": 105.3,
      "end_time": 107.1,
      "text": "『ジャストアモーメント！』"
    }
  ],
