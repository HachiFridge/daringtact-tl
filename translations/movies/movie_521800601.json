{
  "movie_id": 521800601,
  "subtitles": [
    {
      "index": 0,
      "start_time": 0.5,
      "end_time": 3.5,
      "text": "WAAAAAAHHHHHHH!"
    },
    {
      "index": 1,
      "start_time": 5.1,
      "end_time": 5.9,
      "text": "Rui-chan!"
    },
    {
      "index": 2,
      "start_time": 6.0,
      "end_time": 7.8,
      "text": "No! Darling...!"
    },
    {
      "index": 3,
      "start_time": 8.2,
      "end_time": 9.5,
      "text": "I SWEAR I'LL SAVE YOU...!"
    },
    {
      "index": 4,
      "start_time": 9.7,
      "end_time": 11.8,
      "text": "(The effect expires in 5 seconds..."
    },
    {
      "index": 5,
      "start_time": 12.0,
      "end_time": 14.7,
      "text": "(But in 3 seconds, I'll be on the ground...!)"
    },
    {
      "index": 6,
      "start_time": 14.9,
      "end_time": 17.8,
      "text": "(I'm so sorry, Sono-san... Iroha-chan...)"
    },
    {
      "index": 7,
      "start_time": 18.0,
      "end_time": 20.3,
      "text": "(Goodbye... Darling.)"
    },
    {
      "index": 8,
      "start_time": 20.7,
      "end_time": 21.9,
      "text": "...!"
    },
    {
      "index": 9,
      "start_time": 22.8,
      "end_time": 23.8,
      "text": "...!"
    },
    {
      "index": 10,
      "start_time": 30.7,
      "end_time": 33.9,
      "text": "GYOOOOOEEEEEEHHHHHHH!!?"
    },
    {
      "index": 11,
      "start_time": 39.7,
      "end_time": 41.5,
      "text": "No way..."
    },
    {
      "index": 12,
      "start_time": 42.2,
      "end_time": 45.5,
      "text": "No way... this cannot be..."
    },
    {
      "index": 13,
      "start_time": 46.0,
      "end_time": 47.0,
      "text": "*cough cough*"
    },
    {
      "index": 14,
      "start_time": 47.2,
      "end_time": 48.2,
      "text": "... Huh?"
    },
    {
      "index": 15,
      "start_time": 48.9,
      "end_time": 51.0,
      "text": "N-No way..."
    },
    {
      "index": 16,
      "start_time": 53.9,
      "end_time": 55.1,
      "text": "...!"
    },
    {
      "index": 17,
      "start_time": 56.5,
      "end_time": 59.8,
      "text": "*Cough, cough, cough, cough*..."
    },
    {
      "index": 18,
      "start_time": 60.1,
      "end_time": 63.8,
      "text": "...Boy, you..."
    },
    {
      "index": 19,
      "start_time": 64.6,
      "end_time": 68.3,
      "text": "By immediately touching the ground, he blasted a hole through it..."
    },
    {
      "index": 20,
      "start_time": 68.6,
      "end_time": 72.7,
      "text": "Thanks to the resulting hole, Louise Marie's fall got delayed"
    },
    {
      "index": 21,
      "start_time": 73.1,
      "end_time": 78.0,
      "text": "So he was able to buy enough time for the Forbidden Elixir's effect to wear off"
    },
    {
      "index": 22,
      "start_time": 82.6,
      "end_time": 84.8,
      "text": "Lou-chan... Are you okay?"
    },
    {
      "index": 23,
      "start_time": 85.4,
      "end_time": 87.2,
      "text": "I'm okay"
    },
    {
      "index": 24,
      "start_time": 87.4,
      "end_time": 89.8,
      "text": "More importantly, Darling..."
    },
    {
      "index": 25,
      "start_time": 90.6,
      "end_time": 91.7,
      "text": "We're fine!"
    },
    {
      "index": 26,
      "start_time": 101.5,
      "end_time": 103.1,
      "text": "Darling...♡"
    }
  ],
