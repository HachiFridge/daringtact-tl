{
  "movie_id": 501700601,
  "subtitles": [
    {
      "index": 0,
      "start_time": 6.9,
      "end_time": 7.5,
      "text": "Fura!"
    },
    {
      "index": 1,
      "start_time": 8.2,
      "end_time": 9.2,
      "text": "Lightning Sphere!"
    },
    {
      "index": 2,
      "start_time": 10.2,
      "end_time": 11.2,
      "text": "Huma!"
    },
    {
      "index": 3,
      "start_time": 20.2,
      "end_time": 22.3,
      "text": "He seems to be redoubling his defenses."
    },
    {
      "index": 4,
      "start_time": 23.2,
      "end_time": 26.1,
      "text": "At this rate, his Unseen Hands will block all our attacks!"
    },
    {
      "index": 5,
      "start_time": 27.0,
      "end_time": 27.4,
      "text": "My lord!"
    },
    {
      "index": 6,
      "start_time": 30.8,
      "end_time": 31.2,
      "text": "...!"
    },
    {
      "index": 7,
      "start_time": 32.0,
      "end_time": 32.9,
      "text": "What's this...?!"
    },
    {
      "index": 8,
      "start_time": 33.1,
      "end_time": 35.0,
      "text": "Power is suddenly flooding through me!"
    },
    {
      "index": 9,
      "start_time": 35.2,
      "end_time": 37.1,
      "text": "You always have the perfect timing!"
    },
    {
      "index": 10,
      "start_time": 37.9,
      "end_time": 40.2,
      "text": "Let's do this, deadbeat maid, perfect maid!"
    },
    {
      "index": 11,
      "start_time": 41.0,
      "end_time": 43.1,
      "text": "I will do my best to shed that deadbeat label!"
    },
    {
      "index": 12,
      "start_time": 43.9,
      "end_time": 47.0,
      "text": "You've got some nerve, calling my sister a deadbeat."
    },
    {
      "index": 13,
      "start_time": 47.1,
      "end_time": 49.0,
      "text": "You're obviously the deadbeat here!"
    },
    {
      "index": 14,
      "start_time": 54.2,
      "end_time": 56.0,
      "text": "--Al Huma! --Grim Burst! --El Fura!"
    },
    {
      "index": 15,
      "start_time": 69.0,
      "end_time": 70.5,
      "text": "This explosive power...!"
    },
    {
      "index": 16,
      "start_time": 71.2,
      "end_time": 72.2,
      "text": "Can it be?"
    },
    {
      "index": 17,
      "start_time": 74.2,
      "end_time": 77.0,
      "text": "My Unseen Hands...!"
    },
    {
      "index": 18,
      "start_time": 78.1,
      "end_time": 79.2,
      "text": "You're up, final blow team!"
    },
    {
      "index": 19,
      "start_time": 80.0,
      "end_time": 83.0,
      "text": "You've had your rest, now work like packhorses!"
    },
    {
      "index": 20,
      "start_time": 83.2,
      "end_time": 85.2,
      "text": "Horsie #1, reporting for duty!"
    },
    {
      "index": 21,
      "start_time": 88.0,
      "end_time": 90.2,
      "text": "...Huh? Am I Horsie #2?"
    },
    {
      "index": 22,
      "start_time": 91.0,
      "end_time": 93.4,
      "text": "And I'm #3, the peerless powerhorse!"
    },
    {
      "index": 23,
      "start_time": 94.0,
      "end_time": 95.0,
      "text": "Futile efforts!"
    },
    {
      "index": 24,
      "start_time": 95.1,
      "end_time": 98.0,
      "text": "My Unseen Hands, my gift of purest love, will--!!!"
    },
    {
      "index": 25,
      "start_time": 99.0,
      "end_time": 99.5,
      "text": "No, they won't!"
    },
    {
      "index": 26,
      "start_time": 106.1,
      "end_time": 107.0,
      "text": "What is this?!"
    },
    {
      "index": 27,
      "start_time": 107.1,
      "end_time": 109.0,
      "text": "Preposterous... Preposterous, preposterous!"
    },
    {
      "index": 28,
      "start_time": 109.1,
      "end_time": 111.0,
      "text": "My diligence cannot be--"
    },
    {
      "index": 29,
      "start_time": 111.1,
      "end_time": 112.2,
      "text": "Haaaaahhhhhh!"
    },
    {
      "index": 30,
      "start_time": 116.0,
      "end_time": 117.1,
      "text": "Prepos... terous..."
    },
    {
      "index": 31,
      "start_time": 118.0,
      "end_time": 122.0,
      "text": "I alone am... a diligent... believer..."
    },
    {
      "index": 32,
      "start_time": 122.2,
      "end_time": 127.0,
      "text": "My brain... My brain... trembles..."
    }
  ],
