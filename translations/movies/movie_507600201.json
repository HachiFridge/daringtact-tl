{
  "movie_id": 507600201,
  "subtitles": [
    {
      "index": 0,
      "start_time": 3.6,
      "end_time": 6.3,
      "text": "Halloween is just a little while away~"
    },
    {
      "index": 1,
      "start_time": 7.0,
      "end_time": 10.0,
      "text": "To be able to play, I'll do my best starting from today~!"
    },
    {
      "index": 2,
      "start_time": 10.2,
      "end_time": 11.4,
      "text": "Sure, nice to have you."
    },
    {
      "index": 3,
      "start_time": 11.7,
      "end_time": 12.5,
      "text": "Hey!"
    },
    {
      "index": 4,
      "start_time": 12.7,
      "end_time": 14.6,
      "text": "I have arrived!"
    },
    {
      "index": 5,
      "start_time": 15.6,
      "end_time": 17.6,
      "text": "Yo! Sorry to keep you waiting!"
    },
    {
      "index": 6,
      "start_time": 18.0,
      "end_time": 20.0,
      "text": "Ahaha, over here!"
    },
    {
      "index": 7,
      "start_time": 22.0,
      "end_time": 24.0,
      "text": "Is this, like, super delicious or what?"
    },
    {
      "index": 8,
      "start_time": 24.2,
      "end_time": 25.6,
      "text": "I ended up buying it on the way here!"
    },
    {
      "index": 9,
      "start_time": 26.2,
      "end_time": 27.5,
      "text": "Here you go! Hidesai."
    },
    {
      "index": 10,
      "start_time": 28.6,
      "end_time": 31.4,
      "text": "Come on! Please, both of you! Here you go!"
    },
    {
      "index": 11,
      "start_time": 33.4,
      "end_time": 37.4,
      "text": "Wow~ The food looks delicious!"
    },
    {
      "index": 12,
      "start_time": 37.6,
      "end_time": 38.6,
      "text": "Yes! Kaorin!"
    },
    {
      "index": 13,
      "start_time": 41.6,
      "end_time": 42.6,
      "text": "Thank you..."
    },
    {
      "index": 14,
      "start_time": 45.3,
      "end_time": 47.3,
      "text": "Hey hey hey, let's eat quickly!"
    },
    {
      "index": 15,
      "start_time": 47.5,
      "end_time": 49.5,
      "text": "I can't take it anymore! I've reached my limit!"
    },
    {
      "index": 16,
      "start_time": 49.9,
      "end_time": 53.3,
      "text": "We've been enduring it for so long,\njust so we can eat together!"
    },
    {
      "index": 17,
      "start_time": 56.0,
      "end_time": 56.6,
      "text": "Well then,"
    },
    {
      "index": 18,
      "start_time": 58.5,
      "end_time": 59.5,
      "text": "Bon──"
    },
    {
      "index": 19,
      "start_time": 60.6,
      "end_time": 61.3,
      "text": "Appétit!"
    },
    {
      "index": 20,
      "start_time": 62.8,
      "end_time": 64.0,
      "text": "...Huh?"
    },
    {
      "index": 21,
      "start_time": 64.5,
      "end_time": 65.3,
      "text": "Suzuna!"
    },
    {
      "index": 22,
      "start_time": 65.6,
      "end_time": 67.6,
      "text": "Cotton Candy-chan stole it~!"
    },
    {
      "index": 23,
      "start_time": 70.5,
      "end_time": 73.0,
      "text": "This is absolutely unbelievable!!"
    },
    {
      "index": 24,
      "start_time": 75.3,
      "end_time": 76.6,
      "text": "Ah~!!"
    },
    {
      "index": 25,
      "start_time": 77.5,
      "end_time": 80.8,
      "text": "Mmm! I cannot forgive you for stealing the shogun's sweets!"
    },
    {
      "index": 26,
      "start_time": 81.5,
      "end_time": 83.3,
      "text": "I'm super duper mad now!"
    },
    {
      "index": 27,
      "start_time": 83.5,
      "end_time": 85.0,
      "text": "I will definitely get it back!"
    },
    {
      "index": 28,
      "start_time": 85.3,
      "end_time": 86.6,
      "text": "Both of you, calm down."
    },
    {
      "index": 29,
      "start_time": 87.0,
      "end_time": 90.4,
      "text": "Our mission is to collect all the cotton candy-chan's~"
    },
    {
      "index": 30,
      "start_time": 90.6,
      "end_time": 92.4,
      "text": "Let's go. That's right, isn't it?!"
    },
    {
      "index": 31,
      "start_time": 92.6,
      "end_time": 95.5,
      "text": "Shogun, please give the signal for the first battle!"
    },
    {
      "index": 32,
      "start_time": 96.0,
      "end_time": 96.5,
      "text": "Yeah..."
    },
    {
      "index": 33,
      "start_time": 97.1,
      "end_time": 98.6,
      "text": "Halloween Savers"
    },
    {
      "index": 34,
      "start_time": 99.0,
      "end_time": 100.1,
      "text": "Deploy!"
    },
    {
      "index": 35,
      "start_time": 100.5,
      "end_time": 101.5,
      "text": "Yeeeah!"
    }
  ],
