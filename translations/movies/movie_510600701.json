{
  "movie_id": 510600701,
  "subtitles": [
    {
      "index": 0,
      "start_time": 10.3,
      "end_time": 11.5,
      "text": "じゃ～ん！"
    },
    {
      "index": 1,
      "start_time": 13.6,
      "end_time": 17.0,
      "text": "おお～！"
    },
    {
      "index": 2,
      "start_time": 17.2,
      "end_time": 18.3,
      "text": "すごいな……"
    },
    {
      "index": 3,
      "start_time": 18.5,
      "end_time": 20.1,
      "text": "二人だけで準備したの？"
    },
    {
      "index": 4,
      "start_time": 20.5,
      "end_time": 21.3,
      "text": "いえ"
    },
    {
      "index": 5,
      "start_time": 21.5,
      "end_time": 25.2,
      "text": "クリスマスで関わった街の人たちにも協力してもらって……"
    },
    {
      "index": 6,
      "start_time": 26.0,
      "end_time": 28.6,
      "text": "こんな素敵なパーティーを開いてくれるなんて"
    },
    {
      "index": 7,
      "start_time": 29.1,
      "end_time": 30.6,
      "text": "さすがエミィちゃんだね"
    },
    {
      "index": 8,
      "start_time": 31.0,
      "end_time": 34.3,
      "text": "ちょっとちょっと！　私もちゃんと手伝いましたよ！"
    },
    {
      "index": 9,
      "start_time": 34.5,
      "end_time": 36.1,
      "text": "忘れないで下さい！"
    },
    {
      "index": 10,
      "start_time": 36.5,
      "end_time": 39.3,
      "text": "それに最後の仕上げがまだ残ってます！"
    },
    {
      "index": 11,
      "start_time": 40.6,
      "end_time": 44.0,
      "text": "大切な恩人に天使の祝福を！"
    },
    {
      "index": 12,
      "start_time": 47.4,
      "end_time": 48.8,
      "text": "This is..."
    },
    {
      "index": 13,
      "start_time": 49.0,
      "end_time": 50.0,
      "text": "わ～きれい"
    },
    {
      "index": 14,
      "start_time": 51.2,
      "end_time": 52.3,
      "text": "Thank goodness..."
    },
    {
      "index": 15,
      "start_time": 52.5,
      "end_time": 55.5,
      "text": "また変な魔法をかけられたのかと思ったわ"
    },
    {
      "index": 16,
      "start_time": 55.7,
      "end_time": 56.5,
      "text": "かけましたよ"
    },
    {
      "index": 17,
      "start_time": 56.7,
      "end_time": 58.2,
      "text": "な、なんですって！？"
    },
    {
      "index": 18,
      "start_time": 58.6,
      "end_time": 61.8,
      "text": "あれ？　でもなんともない？　空振り？"
    },
    {
      "index": 19,
      "start_time": 62.1,
      "end_time": 64.2,
      "text": "たぶん最初に魔法がかかるのは……"
    },
    {
      "index": 20,
      "start_time": 64.5,
      "end_time": 65.3,
      "text": "私？"
    },
    {
      "index": 21,
      "start_time": 65.5,
      "end_time": 69.0,
      "text": "私なんとも……な……"
    },
    {
      "index": 22,
      "start_time": 69.6,
      "end_time": 71.3,
      "text": "アカリ？　どうしたの？"
    },
    {
      "index": 23,
      "start_time": 72.0,
      "end_time": 74.1,
      "text": "私はお姉ちゃんを応援したい！"
    },
    {
      "index": 24,
      "start_time": 74.3,
      "end_time": 76.2,
      "text": "でも私もがんばりたい！"
    },
    {
      "index": 25,
      "start_time": 76.4,
      "end_time": 77.5,
      "text": "ア……アカリ？"
    },
    {
      "index": 26,
      "start_time": 78.2,
      "end_time": 79.3,
      "text": "お兄ちゃんの周りには"
    },
    {
      "index": 27,
      "start_time": 79.5,
      "end_time": 82.3,
      "text": "ジュンさんみたいな素敵な人がたくさんいるんだよ！"
    },
    {
      "index": 28,
      "start_time": 82.6,
      "end_time": 85.0,
      "text": "応援するだけじゃまだ足りないよ！"
    },
    {
      "index": 29,
      "start_time": 85.2,
      "end_time": 86.4,
      "text": "わ、私！？"
    },
    {
      "index": 30,
      "start_time": 86.6,
      "end_time": 87.5,
      "text": "ジュンさん！"
    },
    {
      "index": 31,
      "start_time": 88.0,
      "end_time": 90.6,
      "text": "ジュンさんはお兄ちゃんのことどう思ってるんですか！？"
    },
    {
      "index": 32,
      "start_time": 91.6,
      "end_time": 95.0,
      "text": "少年のことはとても好ましく思っている！"
    },
    {
      "index": 33,
      "start_time": 95.2,
      "end_time": 96.2,
      "text": "H-Huh?"
    },
    {
      "index": 34,
      "start_time": 96.5,
      "end_time": 97.5,
      "text": "私はいったい"
    },
    {
      "index": 35,
      "start_time": 98.2,
      "end_time": 101.2,
      "text": "どうやら魔法はきちんと成功しているようですね"
    },
    {
      "index": 36,
      "start_time": 101.4,
      "end_time": 103.2,
      "text": "私たちなら当然です！"
    },
    {
      "index": 37,
      "start_time": 103.5,
      "end_time": 106.1,
      "text": "最近アカリちゃんの様子が変でしたから"
    },
    {
      "index": 38,
      "start_time": 106.3,
      "end_time": 109.2,
      "text": "素直になれるお手伝いをさせていただきました♪"
    },
    {
      "index": 39,
      "start_time": 109.6,
      "end_time": 112.1,
      "text": "あ……そういう魔法なのね"
    },
    {
      "index": 40,
      "start_time": 112.5,
      "end_time": 114.1,
      "text": "でもなんでジュンさんまで？"
    },
    {
      "index": 41,
      "start_time": 114.3,
      "end_time": 115.4,
      "text": "おまけです♪"
    },
    {
      "index": 42,
      "start_time": 115.6,
      "end_time": 116.4,
      "text": "That can't be...!"
    },
    {
      "index": 43,
      "start_time": 116.6,
      "end_time": 120.0,
      "text": "あ、いや、少年のことを好ましいと思っているのは"
    },
    {
      "index": 44,
      "start_time": 120.2,
      "end_time": 122.0,
      "text": "別に隠していないけれど……"
    },
    {
      "index": 45,
      "start_time": 122.5,
      "end_time": 124.6,
      "text": "ほら！　だから私決めたの！"
    },
    {
      "index": 46,
      "start_time": 125.2,
      "end_time": 127.6,
      "text": "お姉ちゃんと一緒に共同戦線を張るって！"
    },
    {
      "index": 47,
      "start_time": 128.5,
      "end_time": 130.2,
      "text": "きょ……共同戦線？"
    },
    {
      "index": 48,
      "start_time": 130.4,
      "end_time": 132.1,
      "text": "ほら、お姉ちゃん行くよ！"
    },
    {
      "index": 49,
      "start_time": 132.3,
      "end_time": 134.0,
      "text": "ちょ、ちょっとアカリ！"
    },
    {
      "index": 50,
      "start_time": 138.1,
      "end_time": 142.1,
      "text": "お姉ちゃん、これからも姉妹仲良く戦っていこうね♪"
    },
    {
      "index": 51,
      "start_time": 148.2,
      "end_time": 149.0,
      "text": "Mm!"
    },
    {
      "index": 52,
      "start_time": 149.5,
      "end_time": 151.0,
      "text": "フフフッ！"
    },
    {
      "index": 53,
      "start_time": 157.0,
      "end_time": 158.8,
      "text": "ハッピークリスマス♪"
    }
  ],
