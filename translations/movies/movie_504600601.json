{
  "movie_id": 504600601,
  "subtitles": [
    {
      "index": 0,
      "start_time": 2.0,
      "end_time": 4.0,
      "text": "Be careful, everyone!"
    },
    {
      "index": 1,
      "start_time": 12.0,
      "end_time": 14.0,
      "text": "Oh my, could it be...?"
    },
    {
      "index": 2,
      "start_time": 14.2,
      "end_time": 17.3,
      "text": "Did our home run ball just now hit him?"
    },
    {
      "index": 3,
      "start_time": 18.0,
      "end_time": 19.7,
      "text": "He seems REALLY mad!"
    },
    {
      "index": 4,
      "start_time": 23.0,
      "end_time": 27.0,
      "text": "That thing... it seems an uninvited guest has appeared"
    },
    {
      "index": 5,
      "start_time": 28.0,
      "end_time": 30.0,
      "text": "Those who can fight come with me"
    },
    {
      "index": 6,
      "start_time": 30.5,
      "end_time": 33.5,
      "text": "Sports and brawls really go hand in hand!"
    },
    {
      "index": 7,
      "start_time": 34.0,
      "end_time": 37.0,
      "text": "Leave evacuating the audience to me"
    },
    {
      "index": 8,
      "start_time": 37.6,
      "end_time": 38.6,
      "text": "Yeah, please"
    },
    {
      "index": 9,
      "start_time": 41.1,
      "end_time": 43.6,
      "text": "I'll help too! Right, Pukichi?"
    },
    {
      "index": 10,
      "start_time": 44.0,
      "end_time": 44.8,
      "text": "Yeah!"
    },
    {
      "index": 11,
      "start_time": 45.2,
      "end_time": 47.6,
      "text": "Hehe, how cute~"
    },
    {
      "index": 12,
      "start_time": 48.0,
      "end_time": 50.0,
      "text": "Suzuna-chan, please help them too"
    },
    {
      "index": 13,
      "start_time": 50.3,
      "end_time": 51.2,
      "text": "'Course!"
    },
    {
      "index": 14,
      "start_time": 51.5,
      "end_time": 54.3,
      "text": "I won't let my fans get hurt, so... YEHELLO!"
    },
    {
      "index": 15,
      "start_time": 58.5,
      "end_time": 60.0,
      "text": "I see an opening!"
    },
    {
      "index": 16,
      "start_time": 66.3,
      "end_time": 67.0,
      "text": "Huh?"
    },
    {
      "index": 17,
      "start_time": 69.7,
      "end_time": 71.0,
      "text": "Whoa!?"
    },
    {
      "index": 18,
      "start_time": 74.0,
      "end_time": 75.0,
      "text": "Not hurt, are you?"
    },
    {
      "index": 19,
      "start_time": 75.3,
      "end_time": 77.0,
      "text": "T-Thanks!"
    },
    {
      "index": 20,
      "start_time": 81.3,
      "end_time": 82.3,
      "text": "If you want to punch..."
    },
    {
      "index": 21,
      "start_time": 82.5,
      "end_time": 83.6,
      "text": "THIS IS MORE LIKE IT!"
    },
    {
      "index": 22,
      "start_time": 84.0,
      "end_time": 85.0,
      "text": "ORAAA!!"
    },
    {
      "index": 23,
      "start_time": 89.2,
      "end_time": 91.5,
      "text": "How about it? My fist packs a PUNCH, doesn't it?"
    },
    {
      "index": 24,
      "start_time": 95.6,
      "end_time": 97.0,
      "text": "That's more like it!"
    },
    {
      "index": 25,
      "start_time": 97.2,
      "end_time": 99.3,
      "text": "It wouldn't be fun if things ended right here!"
    },
    {
      "index": 26,
      "start_time": 101.0,
      "end_time": 104.6,
      "text": "Looks like the sea's no stranger to tough guys, huh?"
    },
    {
      "index": 27,
      "start_time": 105.5,
      "end_time": 108.0,
      "text": "Let's get fired up, everyone!"
    },
    {
      "index": 28,
      "start_time": 108.5,
      "end_time": 109.5,
      "text": "OHHHH!"
    },
    {
      "index": 29,
      "start_time": 109.7,
      "end_time": 111.7,
      "text": "Hey, hey... are you serious?"
    },
    {
      "index": 30,
      "start_time": 112.3,
      "end_time": 115.3,
      "text": "You guys have another match tomorrow, so you should rest..."
    },
    {
      "index": 31,
      "start_time": 116.0,
      "end_time": 117.8,
      "text": "Extra time's here!"
    },
    {
      "index": 32,
      "start_time": 120.0,
      "end_time": 123.0,
      "text": "Hehe, how full of energy~"
    },
    {
      "index": 33,
      "start_time": 123.8,
      "end_time": 125.6,
      "text": "I'm counting on you all"
    },
    {
      "index": 34,
      "start_time": 126.5,
      "end_time": 130.0,
      "text": "No matter what happens, Sensei will protect you"
    }
  ],
