  "subtitles": [
    {
      "index": 0,
      "start_time": 2.5,
      "end_time": 3.6,
      "text": "Kokoro"
    },
    {
      "index": 1,
      "start_time": 4.7,
      "end_time": 8.3,
      "text": "...Come here.\nLet me pat you on the head."
    },
    {
      "index": 2,
      "start_time": 8.9,
      "end_time": 10.3,
      "text": "Y-Yes"
    },
    {
      "index": 3,
      "start_time": 16.6,
      "end_time": 18.0,
      "text": "...!"
    },
    {
      "index": 4,
      "start_time": 21.0,
      "end_time": 22.8,
      "text": "..."
    },
    {
      "index": 5,
      "start_time": 27.2,
      "end_time": 28.0,
      "text": "...!"
    },
    {
      "index": 6,
      "start_time": 33.5,
      "end_time": 34.5,
      "text": "This is...?"
    },
    {
      "index": 7,
      "start_time": 35.3,
      "end_time": 37.5,
      "text": "To me a \"Knight\" is unnecessary, but..."
    },
    {
      "index": 8,
      "start_time": 37.7,
      "end_time": 40.5,
      "text": "If you choose the right path..."
    },
    {
      "index": 9,
      "start_time": 40.8,
      "end_time": 46.4,
      "text": "That power will serve as a beacon for you to guide him."
    },
    {
      "index": 10,
      "start_time": 48.0,
      "end_time": 49.2,
      "text": "Father..."
    },
    {
      "index": 11,
      "start_time": 50.6,
      "end_time": 52.6,
      "text": "Come on, you should go now."
    },
    {
      "index": 12,
      "start_time": 54.2,
      "end_time": 55.8,
      "text": "Ameth"
    },
    {
      "index": 13,
      "start_time": 56.3,
      "end_time": 61.2,
      "text": "Fio's rescue, You will accomplish this. Kokoro"
    },
    {
      "index": 14,
      "start_time": 63.6,
      "end_time": 65.5,
      "text": "...Yes, Father"
    },
    {
      "index": 15,
      "start_time": 70.2,
      "end_time": 71.7,
      "text": "Definitely..."
    },
    {
      "index": 16,
      "start_time": 72.6,
      "end_time": 76.2,
      "text": "We will definitely meet again on the other side."
    },
    {
      "index": 17,
      "start_time": 96.8,
      "end_time": 98.4,
      "text": "I'm sorry, okay?"
    },
    {
      "index": 18,
      "start_time": 103.3,
      "end_time": 106.2,
      "text": "Thank you very much for your time"
    },
    {
      "index": 19,
      "start_time": 106.5,
      "end_time": 108.5,
      "text": "Old man, \"Great Guidance\""
    }
  ],
