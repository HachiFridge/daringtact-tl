{
  "movie_id": 514600701,
  "subtitles": [
    {
      "index": 0,
      "start_time": 11.9,
      "end_time": 14.2,
      "text": "Welcome to our store~♪"
    },
    {
      "index": 1,
      "start_time": 14.6,
      "end_time": 17.3,
      "text": "Today, let's have lots of fun~♪"
    },
    {
      "index": 2,
      "start_time": 18.1,
      "end_time": 21.3,
      "text": "Miracle Marin, Kururinpa~♪"
    },
    {
      "index": 3,
      "start_time": 22.5,
      "end_time": 24.1,
      "text": "...!"
    },
    {
      "index": 4,
      "start_time": 26.4,
      "end_time": 28.1,
      "text": "Hey Ayane! Over there!"
    },
    {
      "index": 5,
      "start_time": 30.5,
      "end_time": 32.6,
      "text": "Hey, sheep!"
    },
    {
      "index": 6,
      "start_time": 32.9,
      "end_time": 35.9,
      "text": "Hehe. Everyone seems pleased!"
    },
    {
      "index": 7,
      "start_time": 36.1,
      "end_time": 38.3,
      "text": "I'm glad I practiced a lot!"
    },
    {
      "index": 8,
      "start_time": 39.5,
      "end_time": 43.2,
      "text": "Heh, you're not cool, Plant Sheep bro"
    },
    {
      "index": 9,
      "start_time": 43.6,
      "end_time": 47.3,
      "text": "After practice, not showing your weaknesses is what makes a professional performer!"
    },
    {
      "index": 10,
      "start_time": 47.7,
      "end_time": 50.5,
      "text": "Hehe, boss sure knows how to say the right things!"
    },
    {
      "index": 11,
      "start_time": 51.0,
      "end_time": 54.2,
      "text": "Well, I'm not an actor but a stage rat..."
    },
    {
      "index": 12,
      "start_time": 56.0,
      "end_time": 57.6,
      "text": "Ouch!!"
    },
    {
      "index": 13,
      "start_time": 59.0,
      "end_time": 59.6,
      "text": "Meow"
    },
    {
      "index": 14,
      "start_time": 59.9,
      "end_time": 63.6,
      "text": "It feels nice, but it's still not exciting enough, meow."
    },
    {
      "index": 15,
      "start_time": 64.4,
      "end_time": 68.2,
      "text": "Hmm, after all, shall I invite you, meow?"
    },
    {
      "index": 16,
      "start_time": 68.4,
      "end_time": 69.5,
      "text": "I won't get bored♪"
    },
    {
      "index": 17,
      "start_time": 70.4,
      "end_time": 74.6,
      "text": "Even if it's like that, I'm sure customers will come in ♪"
    },
    {
      "index": 18,
      "start_time": 75.3,
      "end_time": 76.7,
      "text": "Oh, Kururu-han♪"
    },
    {
      "index": 19,
      "start_time": 78.0,
      "end_time": 80.3,
      "text": "Wait, w-wait..."
    },
    {
      "index": 20,
      "start_time": 80.5,
      "end_time": 82.6,
      "text": "What is this!?"
    },
    {
      "index": 21,
      "start_time": 84.4,
      "end_time": 85.6,
      "text": "H-Hello, Hero-san!"
    },
    {
      "index": 22,
      "start_time": 85.9,
      "end_time": 88.1,
      "text": "What does this mean~!?"
    },
    {
      "index": 23,
      "start_time": 88.4,
      "end_time": 89.6,
      "text": "It's a present from everyone!"
    },
    {
      "index": 24,
      "start_time": 89.8,
      "end_time": 90.6,
      "text": "...!"
    },
    {
      "index": 25,
      "start_time": 91.3,
      "end_time": 95.0,
      "text": "Haha! Just as I designed!"
    },
    {
      "index": 26,
      "start_time": 95.2,
      "end_time": 97.0,
      "text": "You're moving in a good way!"
    },
    {
      "index": 27,
      "start_time": 97.2,
      "end_time": 99.0,
      "text": "Looking good...right"
    },
    {
      "index": 28,
      "start_time": 99.7,
      "end_time": 102.3,
      "text": "Let's wave our hands with a smile!"
    },
    {
      "index": 29,
      "start_time": 105.6,
      "end_time": 107.0,
      "text": "..."
    },
    {
      "index": 30,
      "start_time": 112.1,
      "end_time": 114.6,
      "text": "Wait, wait a minute!"
    },
    {
      "index": 31,
      "start_time": 118.2,
      "end_time": 120.0,
      "text": "Wow♪ What an exciting atmosphere♪"
    },
    {
      "index": 32,
      "start_time": 120.2,
      "end_time": 121.3,
      "text": "How crazy is that? ☆"
    },
    {
      "index": 33,
      "start_time": 121.5,
      "end_time": 123.9,
      "text": "It's dangerous, isn't it!"
    },
    {
      "index": 34,
      "start_time": 124.1,
      "end_time": 127.7,
      "text": "Because you had three refills, you were late!"
    },
    {
      "index": 35,
      "start_time": 128.1,
      "end_time": 131.1,
      "text": "Come on, hurry up! We're going!"
    },
    {
      "index": 36,
      "start_time": 149.5,
      "end_time": 152.4,
      "text": "Amazing! I can't stop feeling excited!"
    },
    {
      "index": 37,
      "start_time": 152.7,
      "end_time": 155.6,
      "text": "Yes! But... What about Kururu-san?"
    },
    {
      "index": 38,
      "start_time": 156.2,
      "end_time": 157.6,
      "text": "Everyone!"
    },
    {
      "index": 39,
      "start_time": 158.3,
      "end_time": 161.6,
      "text": "Welcome to \"Grand Dream Park\"~!!"
    },
    {
      "index": 40,
      "start_time": 163.0,
      "end_time": 164.3,
      "text": "Oh~"
    },
    {
      "index": 41,
      "start_time": 165.0,
      "end_time": 167.6,
      "text": "You're the best!! Kulu-chan!!"
    },
    {
      "index": 42,
      "start_time": 167.9,
      "end_time": 171.4,
      "text": "Kururu-chan! Thank you for the wonderful parade~~!!"
    },
    {
      "index": 43,
      "start_time": 202.2,
      "end_time": 203.6,
      "text": "Your dream has come true!"
    },
    {
      "index": 44,
      "start_time": 204.2,
      "end_time": 205.3,
      "text": "..."
    },
    {
      "index": 45,
      "start_time": 208.4,
      "end_time": 211.6,
      "text": "My dream is to make everyone smile...!"
    },
    {
      "index": 46,
      "start_time": 215.0,
      "end_time": 216.2,
      "text": "No...!!"
    },
    {
      "index": 47,
      "start_time": 220.0,
      "end_time": 222.0,
      "text": "Until the parade is over...!!"
    },
    {
      "index": 48,
      "start_time": 223.3,
      "end_time": 226.4,
      "text": "Until the end... with a smile!!"
    }
  ],
