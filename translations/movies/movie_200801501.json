{
  "movie_id": 200801501,
  "subtitles": [
    {
      "index": 0,
      "start_time": 4.7,
      "end_time": 6.2,
      "text": "Begone, rebel traitors!"
    },
    {
      "index": 1,
      "start_time": 6.5,
      "end_time": 8.9,
      "text": "Bow before Her Majesty's glory and might!"
    },
    {
      "index": 2,
      "start_time": 17.5,
      "end_time": 20.5,
      "text": "Urgh... How crazy is this?"
    },
    {
      "index": 3,
      "start_time": 20.7,
      "end_time": 25.3,
      "text": "I think I took a direct hit. My stomach... hurts..."
    },
    {
      "index": 4,
      "start_time": 26.3,
      "end_time": 27.1,
      "text": "But...!"
    },
    {
      "index": 5,
      "start_time": 27.9,
      "end_time": 30.1,
      "text": "I don't care if my stomach bursts!"
    },
    {
      "index": 6,
      "start_time": 30.8,
      "end_time": 33.7,
      "text": "I don't care if I can never eat again!"
    },
    {
      "index": 7,
      "start_time": 34.7,
      "end_time": 37.4,
      "text": "If it'll bring Karyl back to normal..."
    },
    {
      "index": 8,
      "start_time": 37.9,
      "end_time": 40.9,
      "text": "If we can smile together again..."
    },
    {
      "index": 9,
      "start_time": 41.6,
      "end_time": 44.8,
      "text": "I know I won't regret a thing!"
    },
    {
      "index": 10,
      "start_time": 55.8,
      "end_time": 56.4,
      "text": "Karyl!"
    },
    {
      "index": 11,
      "start_time": 59.0,
      "end_time": 62.0,
      "text": "Don't you touch me!"
    },
    {
      "index": 12,
      "start_time": 62.3,
      "end_time": 63.6,
      "text": "Damn this mask!"
    },
    {
      "index": 13,
      "start_time": 64.0,
      "end_time": 64.7,
      "text": "Urgh..."
    },
    {
      "index": 14,
      "start_time": 80.1,
      "end_time": 83.7,
      "text": "Karyl! It's me! Do you know who I am?!"
    },
    {
      "index": 15,
      "start_time": 85.4,
      "end_time": 87.7,
      "text": "Peco... rine..."
    },
    {
      "index": 16,
      "start_time": 88.7,
      "end_time": 90.2,
      "text": "Thank goodness!"
    },
    {
      "index": 17,
      "start_time": 90.4,
      "end_time": 93.8,
      "text": "Otherwise known as Eustiana von Astraea."
    },
    {
      "index": 18,
      "start_time": 96.3,
      "end_time": 99.9,
      "text": "Foul pretender to Her Majesty's throne... Begone."
    },
    {
      "index": 19,
      "start_time": 103.0,
      "end_time": 104.4,
      "text": "Miss Pecorine?!"
    }
  ],
