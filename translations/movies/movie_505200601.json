{
  "movie_id": 505200601,
  "subtitles": [
    {
      "index": 0,
      "start_time": 0.8,
      "end_time": 1.8,
      "text": "なんだよもう"
    },
    {
      "index": 1,
      "start_time": 2.0,
      "end_time": 3.2,
      "text": "それ！"
    },
    {
      "index": 2,
      "start_time": 8.8,
      "end_time": 12.0,
      "text": "たくさんの人から攻撃を受けて……"
    },
    {
      "index": 3,
      "start_time": 12.2,
      "end_time": 15.3,
      "text": "こんな刺激、クウカ、クウカ……"
    },
    {
      "index": 4,
      "start_time": 15.6,
      "end_time": 19.0,
      "text": "気持ちよくなっちゃいます！"
    },
    {
      "index": 5,
      "start_time": 20.0,
      "end_time": 21.5,
      "text": "ギャオオオオッ！"
    },
    {
      "index": 6,
      "start_time": 22.2,
      "end_time": 23.2,
      "text": "よし、いいぞ！"
    },
    {
      "index": 7,
      "start_time": 23.4,
      "end_time": 26.8,
      "text": "手を休めるな！　このまま攻撃を続けるのだ！"
    },
    {
      "index": 8,
      "start_time": 27.0,
      "end_time": 28.0,
      "text": "グオオオオッ！"
    },
    {
      "index": 9,
      "start_time": 28.3,
      "end_time": 29.8,
      "text": "モニカちゃん！　危ないっ！"
    },
    {
      "index": 10,
      "start_time": 30.3,
      "end_time": 31.0,
      "text": "...!"
    },
    {
      "index": 11,
      "start_time": 35.3,
      "end_time": 36.5,
      "text": "グルル"
    },
    {
      "index": 12,
      "start_time": 37.2,
      "end_time": 38.2,
      "text": "全員、撤退！"
    },
    {
      "index": 13,
      "start_time": 45.5,
      "end_time": 47.6,
      "text": "今だ！　ラブリー★モニカ！"
    },
    {
      "index": 14,
      "start_time": 50.0,
      "end_time": 51.5,
      "text": "うむ、感謝する！"
    },
    {
      "index": 15,
      "start_time": 52.0,
      "end_time": 54.8,
      "text": "さぁ行くぞ我が仲間たち！"
    },
    {
      "index": 16,
      "start_time": 55.0,
      "end_time": 57.8,
      "text": "４人揃った魔法少女の力を"
    },
    {
      "index": 17,
      "start_time": 58.2,
      "end_time": 60.2,
      "text": "見せてやるのだ！"
    },
    {
      "index": 18,
      "start_time": 60.6,
      "end_time": 61.4,
      "text": "Indeed!"
    },
    {
      "index": 19,
      "start_time": 62.3,
      "end_time": 63.5,
      "text": "食らいたまえ！"
    },
    {
      "index": 20,
      "start_time": 63.7,
      "end_time": 67.0,
      "text": "ミスティバレット乱れ撃ちだっ！"
    },
    {
      "index": 21,
      "start_time": 67.3,
      "end_time": 68.6,
      "text": "まとめて射ぬきます！"
    },
    {
      "index": 22,
      "start_time": 69.0,
      "end_time": 71.0,
      "text": "ピュアリーアローッ！"
    },
    {
      "index": 23,
      "start_time": 72.0,
      "end_time": 73.0,
      "text": "ギャオオオオッ！"
    },
    {
      "index": 24,
      "start_time": 73.5,
      "end_time": 75.5,
      "text": "Yaaaaah!"
    },
    {
      "index": 25,
      "start_time": 76.6,
      "end_time": 79.3,
      "text": "仲間には指一本触れさせない！"
    },
    {
      "index": 26,
      "start_time": 79.5,
      "end_time": 81.0,
      "text": "私が守ってみせる！"
    },
    {
      "index": 27,
      "start_time": 81.3,
      "end_time": 84.0,
      "text": "私の正義見せてあげるよ！"
    },
    {
      "index": 28,
      "start_time": 84.2,
      "end_time": 88.6,
      "text": "ミクマ流”魔法”剣術シャイニーブレードッ！"
    },
    {
      "index": 29,
      "start_time": 90.6,
      "end_time": 91.6,
      "text": "さぁ、モニカちゃん！"
    },
    {
      "index": 30,
      "start_time": 91.8,
      "end_time": 94.0,
      "text": "今の君ならきっとやれるはずさ！"
    },
    {
      "index": 31,
      "start_time": 94.2,
      "end_time": 96.3,
      "text": "ああ、私に任せろ！"
    },
    {
      "index": 32,
      "start_time": 97.2,
      "end_time": 99.2,
      "text": "ラブリー！　キュアリー！　ブレイブリー！"
    },
    {
      "index": 33,
      "start_time": 99.4,
      "end_time": 102.0,
      "text": "マジカルレベル・インフィニット！"
    },
    {
      "index": 34,
      "start_time": 102.2,
      "end_time": 104.6,
      "text": "愛と希望の力を込めて！"
    },
    {
      "index": 35,
      "start_time": 104.8,
      "end_time": 109.0,
      "text": "必殺！　スカイラブリーハリケーン！"
    },
    {
      "index": 36,
      "start_time": 116.0,
      "end_time": 120.0,
      "text": "クウカ、星になります～！"
    }
