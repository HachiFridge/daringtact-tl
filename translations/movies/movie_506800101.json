      "text": "…………じゅ、じゅじゅっ……"
    },
    {
      "index": 12,
      "start_time": 23.8,
      "end_time": 27.0,
      "text": "重々承知の十太郎ー！"
    },
    {
      "index": 13,
      "start_time": 28.0,
      "end_time": 30.0,
      "text": "..."
    },
    {
      "index": 14,
      "start_time": 31.0,
      "end_time": 35.4,
      "text": "バイト初日に、しかも第一声で失敗！"
    },
    {
      "index": 15,
      "start_time": 35.8,
      "end_time": 38.6,
      "text": "工場でもぼっち確定です……"
    },
    {
      "index": 16,
      "start_time": 38.8,
      "end_time": 41.0,
      "text": "ふふっ。あなたが新人さんね"
    },
    {
      "index": 17,
      "start_time": 41.2,
      "end_time": 42.0,
      "text": "?"
    },
    {
      "index": 18,
      "start_time": 42.6,
      "end_time": 45.8,
      "text": "私はミフユ。ここのバイトリーダーよ"
    },
    {
      "index": 19,
      "start_time": 46.8,
      "end_time": 48.2,
      "text": "今日からよろしくね"
    },
    {
      "index": 20,
      "start_time": 48.8,
      "end_time": 51.8,
      "text": "よよ、よろしくお願いします！"
    },
    {
      "index": 21,
      "start_time": 53.0,
      "end_time": 54.6,
      "text": "ここの工場のモットーは"
    },
    {
      "index": 22,
      "start_time": 54.8,
      "end_time": 57.7,
      "text": "事故ゼロ・怪我ゼロ・効率全開！"
    },
    {
      "index": 23,
      "start_time": 58.0,
      "end_time": 61.0,
      "text": "というわけで、点呼の次は準備体操よ！"
    },
    {
      "index": 24,
      "start_time": 61.2,
      "end_time": 62.6,
      "text": "Yeeeah!"
    },
    {
      "index": 25,
      "start_time": 63.0,
      "end_time": 65.8,
      "text": "え！？　ななな何？　何！？"
    },
    {
      "index": 26,
      "start_time": 66.2,
      "end_time": 68.6,
      "text": "さあ、あなたも一緒に！"
    },
    {
      "index": 27,
      "start_time": 69.0,
      "end_time": 70.8,
      "text": "は、はい～～っ！？"
    }
