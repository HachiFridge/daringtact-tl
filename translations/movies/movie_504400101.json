{
  "movie_id": 504400101,
  "subtitles": [
    {
      "index": 0,
      "start_time": 3.8,
      "end_time": 6.6,
      "text": "ルカ姉はちょーっち恥ずかしがり屋だから"
    },
    {
      "index": 1,
      "start_time": 6.8,
      "end_time": 10.2,
      "text": "ナナカちゃんセレクトは、大人セクシーなパレオだよん！"
    },
    {
      "index": 2,
      "start_time": 10.6,
      "end_time": 13.0,
      "text": "ほぅ、似合っているではないか！"
    },
    {
      "index": 3,
      "start_time": 13.6,
      "end_time": 17.8,
      "text": "さすがナナカ、貴様の審美眼は衰えていないようだな"
    },
    {
      "index": 4,
      "start_time": 18.0,
      "end_time": 21.8,
      "text": "はぁ……ヒラヒラして落ち着かないねぇ……"
    },
    {
      "index": 5,
      "start_time": 22.0,
      "end_time": 24.8,
      "text": "こういうのアタシには似合わないだろうに"
    },
    {
      "index": 6,
      "start_time": 25.0,
      "end_time": 28.6,
      "text": "この水着のポイントは、チラリと見える太もも！"
    },
    {
      "index": 7,
      "start_time": 29.2,
      "end_time": 31.8,
      "text": "デュフフ、拙者たまらんでござる！"
    },
    {
      "index": 8,
      "start_time": 32.0,
      "end_time": 35.2,
      "text": "こらっ！　エロ親父みたいな目で見るんじゃないよ！"
    },
    {
      "index": 9,
      "start_time": 35.8,
      "end_time": 38.2,
      "text": "つ……次は私か……う、うぅ……"
    },
    {
      "index": 10,
      "start_time": 38.6,
      "end_time": 40.6,
      "text": "いつまで恥ずかしがっているんだい"
    },
    {
      "index": 11,
      "start_time": 41.0,
      "end_time": 41.9,
      "text": "そーれ！"
    },
    {
      "index": 12,
      "start_time": 42.0,
      "end_time": 42.9,
      "text": "あ～～……"
    },
    {
      "index": 13,
      "start_time": 43.0,
      "end_time": 44.8,
      "text": "や～んまいっちんぐ！"
    },
    {
      "index": 14,
      "start_time": 45.0,
      "end_time": 47.0,
      "text": "アンナたそに相応しいのは"
    },
    {
      "index": 15,
      "start_time": 47.2,
      "end_time": 51.0,
      "text": "古来より伝わる最強の水着、スク水だよ～っ！"
    },
    {
      "index": 16,
      "start_time": 51.4,
      "end_time": 54.0,
      "text": "こ、これは服を着ていないのと同じくらい"
    },
    {
      "index": 17,
      "start_time": 54.1,
      "end_time": 55.4,
      "text": "恥ずかしいんじゃないかい？"
    },
    {
      "index": 18,
      "start_time": 56.2,
      "end_time": 58.8,
      "text": "こ、ここ、こんな水着を用意するなぁ～！"
    },
    {
      "index": 19,
      "start_time": 59.0,
      "end_time": 62.6,
      "text": "それに私の許可なく真名を晒すとはどういうつもりだあっ！"
    },
    {
      "index": 20,
      "start_time": 63.0,
      "end_time": 66.0,
      "text": "いやぁ、それがスク水のルールらしくてね～"
    },
    {
      "index": 21,
      "start_time": 66.4,
      "end_time": 69.8,
      "text": "大丈夫、似合ってるから自信持つんだぞい☆"
    },
    {
      "index": 22,
      "start_time": 70.0,
      "end_time": 72.0,
      "text": "そういうことではなーいっ！"
    },
    {
      "index": 23,
      "start_time": 72.4,
      "end_time": 75.2,
      "text": "そして、ナナカちゃんはビキニを活かした格好……"
    },
    {
      "index": 24,
      "start_time": 76.2,
      "end_time": 79.8,
      "text": "そう！　セクスィー魔法少女の登場だぁーっ！"
    },
    {
      "index": 25,
      "start_time": 80.0,
      "end_time": 81.0,
      "text": "..."
    },
    {
      "index": 26,
      "start_time": 81.2,
      "end_time": 84.0,
      "text": "え、二人ともリアクション薄くない？"
    },
    {
      "index": 27,
      "start_time": 84.2,
      "end_time": 86.8,
      "text": "いや、ナナカは普段の格好が……"
    },
    {
      "index": 28,
      "start_time": 87.0,
      "end_time": 90.8,
      "text": "いつも水着みたいな服だし……"
    },
    {
      "index": 29,
      "start_time": 91.0,
      "end_time": 93.0,
      "text": "あまり違いがない気もするねぇ……"
    },
    {
      "index": 30,
      "start_time": 93.8,
      "end_time": 96.2,
      "text": "違うよ！　全然違うよ！"
    },
    {
      "index": 31,
      "start_time": 96.8,
      "end_time": 97.8,
      "text": "くぅ～……"
    },
    {
      "index": 32,
      "start_time": 98.0,
      "end_time": 100.8,
      "text": "このバカンスでセクスィー魔法少女の素晴らしさを"
    },
    {
      "index": 33,
      "start_time": 101.0,
      "end_time": 104.4,
      "text": "ナナカ先生が教えてやろうではないか～っ！"
    }
  ],
