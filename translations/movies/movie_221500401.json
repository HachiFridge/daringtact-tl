{
  "movie_id": 221500401,
  "subtitles": [
    {
      "index": 0,
      "start_time": 0.4,
      "end_time": 2.0,
      "text": "Okay! Ready for me?"
    },
    {
      "index": 1,
      "start_time": 3.0,
      "end_time": 4.0,
      "text": "...!"
    },
    {
      "index": 2,
      "start_time": 13.3,
      "end_time": 15.4,
      "text": "You...! If I could beat you to a pulp...!"
    },
    {
      "index": 3,
      "start_time": 15.8,
      "end_time": 17.2,
      "text": "HAAAAAAAAH!"
    },
    {
      "index": 4,
      "start_time": 27.6,
      "end_time": 29.7,
      "text": "Ahhh... it hurts"
    },
    {
      "index": 5,
      "start_time": 30.7,
      "end_time": 33.1,
      "text": "Pain signals danger..."
    },
    {
      "index": 6,
      "start_time": 33.9,
      "end_time": 35.2,
      "text": "...!"
    },
    {
      "index": 7,
      "start_time": 36.0,
      "end_time": 37.3,
      "text": "Mmm..."
    },
    {
      "index": 8,
      "start_time": 37.9,
      "end_time": 41.8,
      "text": "Hehe...♪ I don't know what you're so mad about, but..."
    },
    {
      "index": 9,
      "start_time": 42.0,
      "end_time": 44.0,
      "text": "Like that, you won't win, you know?"
    },
    {
      "index": 10,
      "start_time": 44.9,
      "end_time": 45.9,
      "text": "Ngh!"
    },
    {
      "index": 11,
      "start_time": 46.7,
      "end_time": 49.6,
      "text": "...I will not deny that I am inferior to you..."
    },
    {
      "index": 12,
      "start_time": 50.7,
      "end_time": 54.1,
      "text": "(Indeed... Even when compared to Eustiana, I am...!)"
    },
    {
      "index": 13,
      "start_time": 72.9,
      "end_time": 76.3,
      "text": "(Right~ I am angry...!)"
    },
    {
      "index": 14,
      "start_time": 79.9,
      "end_time": 83.2,
      "text": "(At my own... WEAKNESS!!)"
    },
    {
      "index": 15,
      "start_time": 90.1,
      "end_time": 92.7,
      "text": "AAHHHHHHHHHHH!!"
    },
    {
      "index": 16,
      "start_time": 98.0,
      "end_time": 99.1,
      "text": "HOMARE-SAN?!"
    },
    {
      "index": 17,
      "start_time": 100.7,
      "end_time": 102.0,
      "text": "KYAAAAA!!?"
    },
    {
      "index": 18,
      "start_time": 110.4,
      "end_time": 114.2,
      "text": "Haa, haa..."
    },
    {
      "index": 19,
      "start_time": 115.0,
      "end_time": 116.0,
      "text": "...!"
    },
    {
      "index": 20,
      "start_time": 116.3,
      "end_time": 118.1,
      "text": "...!?"
    },
    {
      "index": 21,
      "start_time": 124.8,
      "end_time": 126.8,
      "text": "...Ahh, you scared me back there"
    },
    {
      "index": 22,
      "start_time": 127.9,
      "end_time": 130.0,
      "text": "Well then, coming in round two..."
    },
    {
      "index": 23,
      "start_time": 135.1,
      "end_time": 137.0,
      "text": "Here's a little something♪"
    }
