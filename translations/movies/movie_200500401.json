    {
      "index": 0,
      "start_time": 4.0,
      "end_time": 7.5,
      "text": "*sigh* ...I can't say I anticipated this."
    },
    {
      "index": 1,
      "start_time": 8.1,
      "end_time": 12.3,
      "text": "But of course... This world is no game; it's reality."
    },
    {
      "index": 2,
      "start_time": 13.5,
      "end_time": 16.7,
      "text": "Your Majesty...? Wh-what are you talking about?"
    },
    {
      "index": 3,
      "start_time": 17.5,
      "end_time": 21.4,
      "text": "I've told you not to call me that, dolt."
    },
    {
      "index": 4,
      "start_time": 23.9,
      "end_time": 24.5,
      "text": "Ahh...!"
    },
    {
      "index": 5,
      "start_time": 25.1,
      "end_time": 27.8,
      "text": "Aaaghhhhhhh...?!"
    },
    {
      "index": 6,
      "start_time": 29.7,
      "end_time": 31.1,
      "text": "Oh, do be quiet."
    },
    {
      "index": 7,
      "start_time": 31.9,
      "end_time": 35.3,
      "text": "Your squealing is such a nuisance. It irritates me."
    },
    {
      "index": 8,
      "start_time": 36.2,
      "end_time": 38.2,
      "text": "Careful not to bite your own tongue."
    },
    {
      "index": 9,
      "start_time": 38.7,
      "end_time": 42.2,
      "text": "It would be a little unhelpful if you died right now."
    },
    {
      "index": 10,
      "start_time": 43.9,
      "end_time": 44.5,
      "text": "Aaahhhh!"
    },
    {
      "index": 11,
      "start_time": 44.7,
      "end_time": 45.5,
      "text": "Stooop!"
    },
    {
      "index": 12,
      "start_time": 46.5,
      "end_time": 49.8,
      "text": "Wh-why? I did everything you asked me to!"
    },
    {
      "index": 13,
      "start_time": 50.4,
      "end_time": 52.1,
      "text": "I did everything I could!"
    },
    {
      "index": 14,
      "start_time": 52.2,
      "end_time": 56.1,
      "text": "Aaaaaaghhhh!"
    }
