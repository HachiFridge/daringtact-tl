{
  "movie_id": 520500701,
  "subtitles": [
    {
      "index": 0,
      "start_time": 14.3,
      "end_time": 17.1,
      "text": "You O'Pink-brained raisin-headed commoner!"
    },
    {
      "index": 1,
      "start_time": 17.3,
      "end_time": 20.1,
      "text": "You fashion disaster pervert of a woman!"
    },
    {
      "index": 2,
      "start_time": 23.4,
      "end_time": 26.1,
      "text": "Hmph! Just who are you calling a pervert here?!"
    },
    {
      "index": 3,
      "start_time": 26.6,
      "end_time": 29.1,
      "text": "You do not just have feelings for that Rei girl..."
    },
    {
      "index": 4,
      "start_time": 29.3,
      "end_time": 31.9,
      "text": "You also love Lowborn, do you not?"
    },
    {
      "index": 5,
      "start_time": 32.1,
      "end_time": 34.6,
      "text": "H-Huh?! T-That’s ridiculous!"
    },
    {
      "index": 6,
      "start_time": 34.8,
      "end_time": 36.5,
      "text": "W-Why would I... for Kishi-san?!"
    },
    {
      "index": 7,
      "start_time": 37.8,
      "end_time": 38.8,
      "text": "...!?"
    },
    {
      "index": 8,
      "start_time": 40.7,
      "end_time": 41.2,
      "text": "...!"
    },
    {
      "index": 9,
      "start_time": 41.4,
      "end_time": 44.8,
      "text": "Ohh my, someone is getting flustered here!"
    },
    {
      "index": 10,
      "start_time": 45.0,
      "end_time": 47.0,
      "text": "Why not just admit it?"
    },
    {
      "index": 11,
      "start_time": 47.2,
      "end_time": 50.0,
      "text": "You're a classic tsundere!"
    },
    {
      "index": 12,
      "start_time": 53.9,
      "end_time": 55.4,
      "text": "Tsumugi-chan...!"
    },
    {
      "index": 13,
      "start_time": 55.9,
      "end_time": 57.9,
      "text": "......!"
    },
    {
      "index": 14,
      "start_time": 58.9,
      "end_time": 61.0,
      "text": "Fine! You're right!"
    },
    {
      "index": 15,
      "start_time": 64.6,
      "end_time": 65.7,
      "text": "HAAAAAAA!"
    },
    {
      "index": 16,
      "start_time": 65.9,
      "end_time": 66.8,
      "text": "Wha—?!"
    },
    {
      "index": 17,
      "start_time": 67.1,
      "end_time": 69.0,
      "text": "The feelings I have for Kishi-san..."
    },
    {
      "index": 18,
      "start_time": 69.4,
      "end_time": 70.9,
      "text": "I love him!"
    },
    {
      "index": 19,
      "start_time": 73.2,
      "end_time": 77.0,
      "text": "OH HO HO HO♪ So you have finally shown your true colours!"
    },
    {
      "index": 20,
      "start_time": 77.2,
      "end_time": 81.4,
      "text": "A greedy two-timer! How utterly indecent!"
    },
    {
      "index": 21,
      "start_time": 82.1,
      "end_time": 84.0,
      "text": "You can say whatever you want!"
    },
    {
      "index": 22,
      "start_time": 84.2,
      "end_time": 87.0,
      "text": "Rei-sama and Kishi-san are both MINE!"
    },
    {
      "index": 23,
      "start_time": 89.1,
      "end_time": 91.6,
      "text": "Also you too! Big words from someone who calls him \"Lowborn\"..."
    },
    {
      "index": 24,
      "start_time": 91.8,
      "end_time": 94.3,
      "text": "Yet you're starting to feel something for him too, aren't you?!"
    },
    {
      "index": 25,
      "start_time": 94.9,
      "end_time": 98.1,
      "text": "I saw you back there... you got that power-up! You're falling for him too!"
    },
    {
      "index": 26,
      "start_time": 98.4,
      "end_time": 101.8,
      "text": "Th-Th-That is absolute nonsense! L-Like hell I would ever—!"
    },
    {
      "index": 27,
      "start_time": 102.0,
      "end_time": 105.0,
      "text": "Do not be so full of yourself, you little...!"
    },
    {
      "index": 28,
      "start_time": 105.2,
      "end_time": 106.2,
      "text": "That is it! I will not forgive you for this!"
    },
    {
      "index": 29,
      "start_time": 106.4,
      "end_time": 108.0,
      "text": "That's my line!"
    },
    {
      "index": 30,
      "start_time": 111.1,
      "end_time": 112.0,
      "text": "..."
    },
    {
      "index": 31,
      "start_time": 112.2,
      "end_time": 113.3,
      "text": "?!"
    },
    {
      "index": 32,
      "start_time": 113.9,
      "end_time": 114.9,
      "text": "Rei...!"
    },
    {
      "index": 33,
      "start_time": 115.1,
      "end_time": 116.6,
      "text": "Leave this to me"
    },
    {
      "index": 34,
      "start_time": 116.9,
      "end_time": 118.0,
      "text": "...Strengthen me up"
    },
    {
      "index": 35,
      "start_time": 118.6,
      "end_time": 120.1,
      "text": "...!!"
    },
    {
      "index": 36,
      "start_time": 120.5,
      "end_time": 122.2,
      "text": "...!!"
    },
    {
      "index": 37,
      "start_time": 122.7,
      "end_time": 126.0,
      "text": "Grrrrrr...!"
    },
    {
      "index": 38,
      "start_time": 127.4,
      "end_time": 128.8,
      "text": "AGYAH! GUEH!"
    },
    {
      "index": 39,
      "start_time": 129.1,
      "end_time": 130.5,
      "text": "CUT IT OUT ALREADY!"
    },
    {
      "index": 40,
      "start_time": 131.0,
      "end_time": 132.9,
      "text": "Ugh..."
    }
  ],
