      "text": "! Wawah?!"
    },
    {
      "index": 5,
      "start_time": 21.2,
      "end_time": 22.4,
      "text": "Pigyu?! Pigyugyugyugyuuu!!?"
    },
    {
      "index": 6,
      "start_time": 22.6,
      "end_time": 23.4,
      "text": "Onigiri-sama!"
    },
    {
      "index": 7,
      "start_time": 23.6,
      "end_time": 25.2,
      "text": "They're like arrows...!"
    },
    {
      "index": 8,
      "start_time": 25.5,
      "end_time": 28.4,
      "text": "So throwing weapons is their idea of a warm welcome! Seriously!"
    },
    {
      "index": 9,
      "start_time": 46.3,
      "end_time": 48.4,
      "text": "Precia, can you find them?!"
    },
    {
      "index": 10,
      "start_time": 51.8,
      "end_time": 53.4,
      "text": "...There."
    },
    {
      "index": 11,
      "start_time": 56.4,
      "end_time": 58.2,
      "text": "Don't run."
    },
    {
      "index": 12,
      "start_time": 68.4,
      "end_time": 69.6,
      "text": "You're ...!?"
    },
    {
      "index": 13,
      "start_time": 71.4,
      "end_time": 73.3,
      "text": "─An Alraune Monstresses."
    },
    {
      "index": 14,
      "start_time": 75.3,
      "end_time": 76.4,
      "text": "Anemone"
    },
    {
      "index": 15,
      "start_time": 77.1,
      "end_time": 78.4,
      "text": "W-Wait a minute!"
    },
    {
      "index": 16,
      "start_time": 78.6,
      "end_time": 80.6,
      "text": "We're not your enemies!"
    },
    {
      "index": 17,
      "start_time": 81.6,
      "end_time": 85.1,
      "text": "But you've invaded our territory"
    },
    {
      "index": 18,
      "start_time": 85.4,
      "end_time": 86.8,
      "text": "So"
    },
    {
      "index": 19,
      "start_time": 87.2,
      "end_time": 88.4,
      "text": "I'll eliminate you."
    },
    {
      "index": 20,
