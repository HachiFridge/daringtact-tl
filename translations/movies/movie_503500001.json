      "text": "Hey, Rin!"
    },
    {
      "index": 1,
      "start_time": 25.0,
      "end_time": 26.8,
      "text": "Ahhh... ♪"
    },
    {
      "index": 2,
      "start_time": 27.6,
      "end_time": 28.6,
      "text": "Ahhh... ♪"
    },
    {
      "index": 3,
      "start_time": 28.8,
