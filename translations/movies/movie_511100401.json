{
  "movie_id": 511100401,
  "subtitles": [
    {
      "index": 0,
      "start_time": 12.1,
      "end_time": 13.8,
      "text": "Is that...?"
    },
    {
      "index": 1,
      "start_time": 14.5,
      "end_time": 18.0,
      "text": "あの剣、どっかで見たような……"
    },
    {
      "index": 2,
      "start_time": 25.0,
      "end_time": 26.3,
      "text": "...Huh?"
    },
    {
      "index": 3,
      "start_time": 26.5,
      "end_time": 27.5,
      "text": "Hmph!"
    },
    {
      "index": 4,
      "start_time": 28.4,
      "end_time": 33.6,
      "text": "はぁ、はぁ、くっそ～"
    },
    {
      "index": 5,
      "start_time": 34.2,
      "end_time": 35.9,
      "text": "もう一回だ"
    },
    {
      "index": 6,
      "start_time": 36.2,
      "end_time": 38.6,
      "text": "なんなんだよ、この剣は！"
    },
    {
      "index": 7,
      "start_time": 38.8,
      "end_time": 41.6,
      "text": "抜けろ、抜けろってば～！"
    },
    {
      "index": 8,
      "start_time": 42.3,
      "end_time": 46.0,
      "text": "ぐぬぬうー、なんでか分からないけど……"
    },
    {
      "index": 9,
      "start_time": 48.0,
      "end_time": 52.0,
      "text": "これは……絶対に抜かなきゃ駄目なんだよ！"
    },
    {
      "index": 10,
      "start_time": 56.5,
      "end_time": 58.1,
      "text": "うおおおぉーっ！"
    },
    {
      "index": 11,
      "start_time": 58.3,
      "end_time": 61.3,
      "text": "現出せよ、天楼覇断剣！"
    },
    {
      "index": 12,
      "start_time": 74.1,
      "end_time": 75.5,
      "text": "誰だ……？"
    },
    {
      "index": 13,
      "start_time": 76.1,
      "end_time": 78.5,
      "text": "いやアタシは知っているはず……！"
    },
    {
      "index": 14,
      "start_time": 80.0,
      "end_time": 82.5,
      "text": "やれやれ、やっと繋がった"
    },
    {
      "index": 15,
      "start_time": 84.3,
      "end_time": 88.0,
      "text": "こんなところでのんびりしてるなんて、らしくないんじゃない？"
    },
    {
      "index": 16,
      "start_time": 88.6,
      "end_time": 91.3,
      "text": "そうだ……コイツは……！"
    },
    {
      "index": 17,
      "start_time": 94.6,
      "end_time": 96.0,
      "text": "オクトー！"
    },
    {
      "index": 18,
      "start_time": 97.1,
      "end_time": 99.2,
      "text": "Huh..."
    },
    {
      "index": 19,
      "start_time": 100.0,
      "end_time": 101.1,
      "text": "アタシは……"
    },
    {
      "index": 20,
      "start_time": 101.3,
      "end_time": 103.3,
      "text": "はっ！　そうだ、オクトー！"
    },
    {
      "index": 21,
      "start_time": 103.9,
      "end_time": 104.6,
      "text": "やあノウェム"
    },
    {
      "index": 22,
      "start_time": 105.0,
      "end_time": 106.0,
      "text": "...!"
    },
    {
      "index": 23,
      "start_time": 106.5,
      "end_time": 108.0,
      "text": "おはよう"
    },
    {
      "index": 24,
      "start_time": 109.6,
      "end_time": 111.5,
      "text": "なんだ……オマエか……"
    },
    {
      "index": 25,
      "start_time": 112.0,
      "end_time": 115.5,
      "text": "あれあれ？　思い出したんじゃないの？"
    },
    {
      "index": 26,
      "start_time": 121.0,
      "end_time": 124.3,
      "text": "オクトーが二人……？　どういうことだ……？"
    },
    {
      "index": 27,
      "start_time": 125.0,
      "end_time": 127.2,
      "text": "こういうこと、さ"
    },
    {
      "index": 28,
      "start_time": 137.6,
      "end_time": 139.5,
      "text": "まったく……"
    },
    {
      "index": 29,
      "start_time": 145.0,
      "end_time": 148.1,
      "text": "ダメじゃないか、いつも持っていなくちゃ"
    },
    {
      "index": 30,
      "start_time": 149.1,
      "end_time": 155.1,
      "text": "あ、ああっ……ありがとう……！"
    }
  ],
