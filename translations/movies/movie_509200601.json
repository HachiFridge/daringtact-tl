{
  "movie_id": 509200601,
  "subtitles": [
    {
      "index": 0,
      "start_time": 9.5,
      "end_time": 13.5,
      "text": "吹き鳴らせ混沌楽土の怠惰な魔笛……"
    },
    {
      "index": 1,
      "start_time": 14.0,
      "end_time": 15.3,
      "text": "はぁあああ！"
    },
    {
      "index": 2,
      "start_time": 18.3,
      "end_time": 19.3,
      "text": "...!"
    },
    {
      "index": 3,
      "start_time": 21.5,
      "end_time": 23.5,
      "text": "HAAAAAAH!"
    },
    {
      "index": 4,
      "start_time": 25.2,
      "end_time": 25.8,
      "text": "?!"
    },
    {
      "index": 5,
      "start_time": 26.4,
      "end_time": 29.5,
      "text": "わあああぁぁぁ……！！？"
    },
    {
      "index": 6,
      "start_time": 32.0,
      "end_time": 34.5,
      "text": "嗤う愚者と冷徹なる審判者"
    },
    {
      "index": 7,
      "start_time": 34.8,
      "end_time": 38.3,
      "text": "胡乱なる伽藍より溶け堕ちる月を見る"
    },
    {
      "index": 8,
      "start_time": 39.0,
      "end_time": 43.6,
      "text": "千の獣の咆哮は黒き泥土の王に捧げん……"
    },
    {
      "index": 9,
      "start_time": 47.2,
      "end_time": 48.5,
      "text": "いけませんっ！"
    },
    {
      "index": 10,
      "start_time": 49.5,
      "end_time": 50.6,
      "text": "やらせませんっ！"
    },
    {
      "index": 11,
      "start_time": 56.6,
      "end_time": 57.4,
      "text": "?!"
    },
    {
      "index": 12,
      "start_time": 67.0,
      "end_time": 69.0,
      "text": "よくぞ持ちこたえてくれたな"
    },
    {
      "index": 13,
      "start_time": 70.0,
      "end_time": 73.1,
      "text": "さあ、共に終局の時を祝おうぞ！"
    },
    {
      "index": 14,
      "start_time": 73.6,
      "end_time": 75.0,
      "text": "受けてみよっ！"
    },
    {
      "index": 15,
      "start_time": 75.3,
      "end_time": 78.0,
      "text": "滅渦真獄黒覇閃！"
    },
    {
      "index": 16,
      "start_time": 82.0,
      "end_time": 83.0,
      "text": "..."
    },
    {
      "index": 17,
      "start_time": 93.2,
      "end_time": 95.7,
      "text": "はーっはっはっはっはっ！"
    },
    {
      "index": 18,
      "start_time": 96.1,
      "end_time": 97.1,
      "text": "見たか"
    },
    {
      "index": 19,
      "start_time": 97.3,
      "end_time": 99.3,
      "text": "我が究極魔法の前では"
    },
    {
      "index": 20,
      "start_time": 99.5,
      "end_time": 104.1,
      "text": "いかなる者でも立っていることはかなわ──"
    },
    {
      "index": 21,
      "start_time": 104.4,
      "end_time": 107.1,
      "text": "ん、にゃぁああ……"
    },
    {
      "index": 22,
      "start_time": 108.5,
      "end_time": 110.1,
      "text": "それはあなたもです"
    },
    {
      "index": 23,
      "start_time": 110.5,
      "end_time": 112.3,
      "text": "でも、お見事でした"
    },
    {
      "index": 24,
      "start_time": 113.0,
      "end_time": 115.0,
      "text": "さすがは疾風の冥姫です"
    },
    {
      "index": 25,
      "start_time": 115.2,
      "end_time": 116.2,
      "text": "無論だ！"
    },
    {
      "index": 26,
      "start_time": 119.1,
      "end_time": 123.1,
      "text": "だが、今回はその……みんなのおかげ"
    },
    {
      "index": 27,
      "start_time": 123.3,
      "end_time": 124.6,
      "text": "私一人では……"
    },
    {
      "index": 28,
      "start_time": 125.1,
      "end_time": 126.0,
      "text": "Huh?"
    },
    {
      "index": 29,
      "start_time": 126.2,
      "end_time": 127.2,
      "text": "...?"
    },
    {
      "index": 30,
      "start_time": 135.2,
      "end_time": 137.2,
      "text": "危ない、シノブウウゥ！"
    },
    {
      "index": 31,
      "start_time": 141.6,
      "end_time": 144.3,
      "text": "お父さーーーん！？"
    }
  ],
