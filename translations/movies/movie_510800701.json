{
  "movie_id": 510800701,
  "subtitles": [
    {
      "index": 0,
      "start_time": 3.6,
      "end_time": 5.0,
      "text": "Ahahah..."
    },
    {
      "index": 1,
      "start_time": 5.3,
      "end_time": 8.3,
      "text": "これで私たちもただのお客さんですね"
    },
    {
      "index": 2,
      "start_time": 10.5,
      "end_time": 13.0,
      "text": "心身ともに、癒やしましょ"
    },
    {
      "index": 3,
      "start_time": 15.6,
      "end_time": 18.5,
      "text": "ここからは大人の時間だね～♪"
    },
    {
      "index": 4,
      "start_time": 29.6,
      "end_time": 32.5,
      "text": "う～ん、この開放感"
    },
    {
      "index": 5,
      "start_time": 33.3,
      "end_time": 35.7,
      "text": "やっぱり温泉はいいねー♪"
    },
    {
      "index": 6,
      "start_time": 41.1,
      "end_time": 42.1,
      "text": "あっつ"
    },
    {
      "index": 7,
      "start_time": 42.3,
      "end_time": 43.3,
      "text": "ん……っ"
    },
    {
      "index": 8,
      "start_time": 47.5,
      "end_time": 51.1,
      "text": "いいわ～、やっぱりこれよねぇ♪"
    },
    {
      "index": 9,
      "start_time": 51.5,
      "end_time": 54.1,
      "text": "じんわり体に染みるね～♪"
    },
    {
      "index": 10,
      "start_time": 55.2,
      "end_time": 59.5,
      "text": "一年を締めくくる日だったのに大変だったわね"
    },
    {
      "index": 11,
      "start_time": 60.1,
      "end_time": 61.2,
      "text": "そうね～"
    },
    {
      "index": 12,
      "start_time": 61.5,
      "end_time": 64.5,
      "text": "でもこうして３人だけで温泉に浸かれるなんて"
    },
    {
      "index": 13,
      "start_time": 64.7,
      "end_time": 66.4,
      "text": "贅沢じゃないかしら"
    },
    {
      "index": 14,
      "start_time": 67.2,
      "end_time": 68.3,
      "text": "ダメだよ～♪"
    },
    {
      "index": 15,
      "start_time": 68.6,
      "end_time": 72.6,
      "text": "浸かるだけじゃまだ足りないものがあるでしょう～？"
    },
    {
      "index": 16,
      "start_time": 73.2,
      "end_time": 74.3,
      "text": "?"
    },
    {
      "index": 17,
      "start_time": 79.3,
      "end_time": 80.3,
      "text": "あらあら……"
    },
    {
      "index": 18,
      "start_time": 80.5,
      "end_time": 82.4,
      "text": "ふふ、気が利いてるじゃない♪"
    },
    {
      "index": 19,
      "start_time": 82.6,
      "end_time": 83.5,
      "text": "でしょ～？"
    },
    {
      "index": 20,
      "start_time": 84.5,
      "end_time": 86.5,
      "text": "ね、注いでもらえるかな？"
    },
    {
      "index": 21,
      "start_time": 87.1,
      "end_time": 88.2,
      "text": "若旦那さん♪"
    },
    {
      "index": 22,
      "start_time": 94.2,
      "end_time": 96.1,
      "text": "ありがと、若旦那♪"
    },
    {
      "index": 23,
      "start_time": 97.2,
      "end_time": 99.5,
      "text": "お疲れ様、若旦那くん"
    },
    {
      "index": 24,
      "start_time": 103.1,
      "end_time": 105.0,
      "text": "Ah..."
    },
    {
      "index": 25,
      "start_time": 108.4,
      "end_time": 110.3,
      "text": "ふふっ、いいタイミングだね～♪"
    },
    {
      "index": 26,
      "start_time": 110.5,
      "end_time": 113.1,
      "text": "ミツキちゃん、ミサトちゃん"
    },
    {
      "index": 27,
      "start_time": 114.1,
      "end_time": 116.3,
      "text": "初日の出を見ながら乾杯といこっか♪"
    },
    {
      "index": 28,
      "start_time": 117.1,
      "end_time": 117.6,
      "text": "Indeed..."
    },
    {
      "index": 29,
      "start_time": 119.6,
      "end_time": 122.6,
      "text": "新年、あけましておめでとう"
    },
    {
      "index": 30,
      "start_time": 124.0,
      "end_time": 126.0,
      "text": "今年もよろしくお願いします"
    }
  ],
