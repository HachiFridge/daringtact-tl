{
  "movie_id": 521301201,
  "subtitles": [
    {
      "index": 0,
      "start_time": 14.1,
      "end_time": 15.2,
      "text": "How is it?"
    },
    {
      "index": 1,
      "start_time": 15.9,
      "end_time": 20.3,
      "text": "It's delicious... Truly"
    },
    {
      "index": 2,
      "start_time": 21.5,
      "end_time": 22.7,
      "text": "Are you all right now?"
    },
    {
      "index": 3,
      "start_time": 23.7,
      "end_time": 27.7,
      "text": "Yes. My stomach and heart both... have been filled"
    },
    {
      "index": 4,
      "start_time": 33.4,
      "end_time": 35.6,
      "text": "Done with your last supper?"
    },
    {
      "index": 5,
      "start_time": 36.1,
      "end_time": 39.5,
      "text": "Then... I'll blow you and the castle both!"
    },
    {
      "index": 6,
      "start_time": 39.9,
      "end_time": 42.1,
      "text": "HONEYTRAP GRANDE!"
    },
    {
      "index": 7,
      "start_time": 45.5,
      "end_time": 47.0,
      "text": "...?!"
    },
    {
      "index": 8,
      "start_time": 47.9,
      "end_time": 50.1,
      "text": "...! Aah!"
    },
    {
      "index": 9,
      "start_time": 56.3,
      "end_time": 59.6,
      "text": "...?"
    },
    {
      "index": 10,
      "start_time": 69.4,
      "end_time": 72.0,
      "text": "Allow me to thank you, Melissa-san"
    },
    {
      "index": 11,
      "start_time": 73.4,
      "end_time": 77.0,
      "text": "Thanks to you, I now understand what is important to me"
    },
    {
      "index": 12,
      "start_time": 78.6,
      "end_time": 81.9,
      "text": "I am Eustiana von Astraea"
    },
    {
      "index": 13,
      "start_time": 82.4,
      "end_time": 84.8,
      "text": "In my name as this kingdom's Princess..."
    },
    {
      "index": 14,
      "start_time": 85.2,
      "end_time": 90.5,
      "text": "The people I love, our happy dinner table, everything..."
    },
    {
      "index": 15,
      "start_time": 91.0,
      "end_time": 92.7,
      "text": "I SHALL PROTECT THEM!"
    }
  ],
