{
  "movie_id": 201400801,
  "subtitles": [
    {
      "index": 0,
      "start_time": 1.0,
      "end_time": 2.2,
      "text": "Brace yourself, Majesty!"
    },
    {
      "index": 1,
      "start_time": 3.5,
      "end_time": 5.3,
      "text": "Numbers Avalon!"
    },
    {
      "index": 2,
      "start_time": 8.5,
      "end_time": 9.5,
      "text": "An illusion?!"
    },
    {
      "index": 3,
      "start_time": 10.2,
      "end_time": 11.7,
      "text": "Guaahhh!"
    },
    {
      "index": 4,
      "start_time": 12.5,
      "end_time": 14.8,
      "text": "To think you'd fall for such a ruse."
    },
    {
      "index": 5,
      "start_time": 15.0,
      "end_time": 19.1,
      "text": "Perhaps it's you who should watch me more closely?"
    },
    {
      "index": 6,
      "start_time": 20.3,
      "end_time": 21.3,
      "text": "But now..."
    },
    {
      "index": 7,
      "start_time": 21.5,
      "end_time": 22.7,
      "text": "This is the end!"
    },
    {
      "index": 8,
      "start_time": 22.8,
      "end_time": 24.0,
      "text": "Christina!"
    },
    {
      "index": 9,
      "start_time": 26.4,
      "end_time": 27.2,
      "text": "Hah!"
    },
    {
      "index": 10,
      "start_time": 27.3,
      "end_time": 31.0,
      "text": "Blows of absolute accuracy, springing from the void..."
    },
    {
      "index": 11,
      "start_time": 31.1,
      "end_time": 32.6,
      "text": "Is that your new plan?"
    },
    {
      "index": 12,
      "start_time": 34.0,
      "end_time": 35.0,
      "text": "But..."
    },
    {
      "index": 13,
      "start_time": 35.3,
      "end_time": 36.4,
      "text": "Too bad for you!"
    },
    {
      "index": 14,
      "start_time": 37.7,
      "end_time": 39.1,
      "text": "Guaahhh!"
    },
    {
      "index": 15,
      "start_time": 39.6,
      "end_time": 41.3,
      "text": "And... bingo."
    },
    {
      "index": 16,
      "start_time": 42.0,
      "end_time": 44.1,
      "text": "My Astral Insight can tell me"
    },
    {
      "index": 17,
      "start_time": 44.3,
      "end_time": 48.2,
      "text": "exactly where you will next appear."
    },
    {
      "index": 18,
      "start_time": 49.6,
      "end_time": 51.6,
      "text": "Ha... hahaha..."
    },
    {
      "index": 19,
      "start_time": 51.8,
      "end_time": 56.2,
      "text": "I hope you don't think this will be enough to take my life."
    },
    {
      "index": 20,
      "start_time": 56.7,
      "end_time": 58.5,
      "text": "Majesty!"
    },
    {
      "index": 21,
      "start_time": 58.7,
      "end_time": 59.4,
      "text": "?!"
    },
    {
      "index": 22,
      "start_time": 59.5,
      "end_time": 60.7,
      "text": "Yaaahhh!"
    },
    {
      "index": 23,
      "start_time": 60.8,
      "end_time": 62.2,
      "text": "...!"
    },
    {
      "index": 24,
      "start_time": 64.2,
      "end_time": 66.8,
      "text": "Haaaaaahhhhhh!"
    }
  ],
