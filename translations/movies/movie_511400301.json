{
  "movie_id": 511400301,
  "subtitles": [
    {
      "index": 0,
      "start_time": 4.4,
      "end_time": 6.4,
      "text": "これで良し、だにゃ！"
    },
    {
      "index": 1,
      "start_time": 7.0,
      "end_time": 9.0,
      "text": "今日からここは"
    },
    {
      "index": 2,
      "start_time": 9.5,
      "end_time": 11.9,
      "text": "【ヴァイスフリューゲル　ランドソル支部】出張所！"
    },
    {
      "index": 3,
      "start_time": 12.2,
      "end_time": 13.6,
      "text": "街の駄菓子屋さん"
    },
    {
      "index": 4,
      "start_time": 14.0,
      "end_time": 16.3,
      "text": "それから、猫のいるたい焼きカフェ"
    },
    {
      "index": 5,
      "start_time": 16.5,
      "end_time": 18.6,
      "text": "盛りだくさんの複合カフェ"
    },
    {
      "index": 6,
      "start_time": 19.0,
      "end_time": 22.1,
      "text": "『ナッシュカッツェ』の完成にゃ！"
    },
    {
      "index": 7,
      "start_time": 22.4,
      "end_time": 23.6,
      "text": "Ooooh!"
    },
    {
      "index": 8,
      "start_time": 24.5,
      "end_time": 29.4,
      "text": "目標とする立派なギルドハウス出張所にまた一歩近づいたな"
    },
    {
      "index": 9,
      "start_time": 29.6,
      "end_time": 31.0,
      "text": "うんうん！"
    },
    {
      "index": 10,
      "start_time": 31.2,
      "end_time": 35.1,
      "text": "これからは目標の売り上げに向かってバンバン稼ぐにゃ"
    },
    {
      "index": 11,
      "start_time": 35.3,
      "end_time": 39.4,
      "text": "何しろお家賃３倍返しだからにゃ～！"
    },
    {
      "index": 12,
      "start_time": 39.6,
      "end_time": 41.0,
      "text": "う、そうだな"
    },
    {
      "index": 13,
      "start_time": 41.2,
      "end_time": 42.6,
      "text": "負けてなるものか！"
    },
    {
      "index": 14,
      "start_time": 42.8,
      "end_time": 44.4,
      "text": "その心意気だにゃ！"
    },
    {
      "index": 15,
      "start_time": 44.6,
      "end_time": 46.3,
      "text": "にゃーにゃー！"
    },
    {
      "index": 16,
      "start_time": 47.2,
      "end_time": 49.6,
      "text": "それじゃ、……みんな、入ってくるにゃー！"
    },
    {
      "index": 17,
      "start_time": 53.0,
      "end_time": 55.4,
      "text": "にゃー！　にゃーにゃー！"
    },
    {
      "index": 18,
      "start_time": 55.6,
      "end_time": 57.4,
      "text": "一緒に働く猫たちにゃ"
    },
    {
      "index": 19,
      "start_time": 57.6,
      "end_time": 59.1,
      "text": "よろしくにゃ！"
    },
    {
      "index": 20,
      "start_time": 59.3,
      "end_time": 60.3,
      "text": "All right!"
    },
    {
      "index": 21,
      "start_time": 60.5,
      "end_time": 61.5,
      "text": "よろしく頼……"
    },
    {
      "index": 22,
      "start_time": 62.1,
      "end_time": 63.0,
      "text": "...!?"
    },
    {
      "index": 23,
      "start_time": 64.1,
      "end_time": 65.0,
      "text": "あわわわわ"
    },
    {
      "index": 24,
      "start_time": 65.2,
      "end_time": 66.6,
      "text": "こらっ登るな！"
    },
    {
      "index": 25,
      "start_time": 70.3,
      "end_time": 71.5,
      "text": "な、なめるな"
    },
    {
      "index": 26,
      "start_time": 73.4,
      "end_time": 76.8,
      "text": "あはは、モニカのこと気に入ったみたいにゃ"
    },
    {
      "index": 27,
      "start_time": 77.2,
      "end_time": 80.5,
      "text": "それともさっき食べてたおやつの味がするのかも"
    },
    {
      "index": 28,
      "start_time": 80.7,
      "end_time": 84.1,
      "text": "わ、私はつまみ食いなんて……"
    },
    {
      "index": 29,
      "start_time": 87.1,
      "end_time": 88.4,
      "text": "と、とにかく！"
    },
    {
      "index": 30,
      "start_time": 89.1,
      "end_time": 90.6,
      "text": "Nyaah~"
    },
    {
      "index": 31,
      "start_time": 91.2,
      "end_time": 95.2,
      "text": "カフェ『ナッシュカッツェ』の開店をここに宣言するぞ！"
    },
    {
      "index": 32,
      "start_time": 95.4,
      "end_time": 97.1,
      "text": "Yeeeah!"
    },
    {
      "index": 33,
      "start_time": 97.4,
      "end_time": 98.5,
      "text": "Nya!"
    }
  ],
