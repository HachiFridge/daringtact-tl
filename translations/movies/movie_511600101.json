      "text": "Kwaaaa ⁇"
    },
    {
      "index": 1,
      "start_time": 8.2,
      "end_time": 10.3,
      "text": "It is our turn."
    },
    {
      "index": 2,
      "start_time": 12.0,
      "end_time": 14.3,
      "text": "Well then, my Doggie Lord"
    },
    {
      "index": 3,
      "start_time": 14.6,
      "end_time": 16.3,
      "text": "Your hand, please"
    },
    {
      "index": 4,
      "start_time": 21.0,
      "end_time": 24.0,
      "text": "Ah, how adorable~"
    },
    {
      "index": 5,
      "start_time": 24.3,
      "end_time": 26.4,
      "text": "It's soothing..."
    },
    {
      "index": 6,
      "start_time": 28.2,
      "end_time": 29.2,
      "text": "Hah!"
    },
    {
      "index": 7,
      "start_time": 29.4,
      "end_time": 31.0,
      "text": "N-No, I can't"
    },
    {
      "index": 8,
      "start_time": 31.2,
      "end_time": 33.3,
      "text": "This is a moment where I must steel my heart."
    },
    {
      "index": 9,
      "start_time": 34.5,
      "end_time": 36.5,
      "text": "My Lord, your hand"
    },
    {
      "index": 10,
      "start_time": 36.7,
      "end_time": 38.6,
      "text": "Your hand, please"
    },
    {
      "index": 11,
      "start_time": 42.2,
      "end_time": 45.3,
      "text": "Um... I didn't mean you at the moment, my Lord"
    },
    {
      "index": 12,
      "start_time": 45.5,
      "end_time": 49.2,
      "text": "I asked my Doggie Lord to do it, but..."
    },
    {
      "index": 13,
      "start_time": 51.0,
      "end_time": 51.6,
      "text": "Wah?"
    },
    {
      "index": 14,
      "start_time": 52.0,
      "end_time": 53.5,
      "text": "N-Nyatt?"
    },
    {
      "index": 15,
      "start_time": 56.6,
      "end_time": 59.4,
      "text": "Could it be that my Doggie Lord..."
    },
    {
      "index": 16,
      "start_time": 59.6,
      "end_time": 63.1,
      "text": "Did they think Miss Shiori would be taken from them?"
    },
    {
      "index": 17,
      "start_time": 63.5,
      "end_time": 66.2,
      "text": "Nyatt, it's okay"
    },
    {
      "index": 18,
      "start_time": 66.4,
      "end_time": 69.0,
      "text": "So be a good boy..."
    },
    {
      "index": 19,
      "start_time": 70.3,
      "end_time": 71.3,
      "text": "Woof!"
    },
    {
      "index": 20,
      "start_time": 73.3,
      "end_time": 74.2,
      "text": "...!"
    },
    {
      "index": 21,
      "start_time": 76.2,
      "end_time": 77.2,
      "text": "My lord..."
    },
    {
      "index": 22,
      "start_time": 77.4,
      "end_time": 81.2,
      "text": "Oh, no, My Doggie Lord, please calm down a little"
    },
    {
      "index": 23,
      "start_time": 81.6,
      "end_time": 83.5,
      "text": "Nyatt, no!"
    },
    {
      "index": 24,
      "start_time": 84.0,
      "end_time": 85.7,
      "text": "Don't get in the way"
    },
    {
      "index": 25,
      "start_time": 91.2,
      "end_time": 92.2,
      "text": "Hmph!"
    },
    {
      "index": 26,
      "start_time": 95.1,
      "end_time": 96.3,
      "text": "Wow"
    },
    {
      "index": 27,
      "start_time": 96.6,
      "end_time": 98.3,
      "text": "My Lord...!"
    },
    {
      "index": 28,
      "start_time": 100.0,
      "end_time": 101.0,
      "text": "?!"
    },
    {
      "index": 29,
      "start_time": 103.6,
      "end_time": 106.6,
      "text": "Ah, my Lord?!"
    }
