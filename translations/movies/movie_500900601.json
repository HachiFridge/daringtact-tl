{
  "movie_id": 500900601,
  "subtitles": [
    {
      "index": 0,
      "start_time": 10.5,
      "end_time": 12.6,
      "text": "GRRRAAARGHHH!"
    },
    {
      "index": 1,
      "start_time": 17.4,
      "end_time": 20.0,
      "text": "Is this Foggy's real form?!"
    },
    {
      "index": 2,
      "start_time": 23.1,
      "end_time": 24.2,
      "text": "Grrrrrr..."
    },
    {
      "index": 3,
      "start_time": 24.5,
      "end_time": 25.5,
      "text": "Eeeek!"
    },
    {
      "index": 4,
      "start_time": 26.0,
      "end_time": 27.8,
      "text": "I-it's terrifying!"
    },
    {
      "index": 5,
      "start_time": 28.0,
      "end_time": 31.5,
      "text": "D-don't worry! I'll protect you!"
    },
    {
      "index": 6,
      "start_time": 34.9,
      "end_time": 38.0,
      "text": "Let's do this!"
    },
    {
      "index": 7,
      "start_time": 41.9,
      "end_time": 43.4,
      "text": "Yaaahhh!"
    },
    {
      "index": 8,
      "start_time": 48.8,
      "end_time": 50.9,
      "text": "Spirits are not bound to a physical form,"
    },
    {
      "index": 9,
      "start_time": 51.2,
      "end_time": 53.4,
      "text": "so there's little point in using a sword against it."
    },
    {
      "index": 10,
      "start_time": 54.5,
      "end_time": 56.0,
      "text": "That said, this may be our chance...!"
    },
    {
      "index": 11,
      "start_time": 58.7,
      "end_time": 62.9,
      "text": "O zephyr anima, gentle yet strong."
    },
    {
      "index": 12,
      "start_time": 63.3,
      "end_time": 67.0,
      "text": "Be as one with my song."
    },
    {
      "index": 13,
      "start_time": 67.9,
      "end_time": 72.2,
      "text": "Your blessings we seek,"
    },
    {
      "index": 14,
      "start_time": 72.5,
      "end_time": 76.3,
      "text": "to protect the weak."
    },
    {
      "index": 15,
      "start_time": 77.1,
      "end_time": 79.3,
      "text": "Spirits of wind, I beseech you."
    },
    {
      "index": 16,
      "start_time": 80.3,
      "end_time": 81.1,
      "text": "Heed my call!"
    },
    {
      "index": 17,
      "start_time": 96.2,
      "end_time": 99.9,
      "text": "Lend me your strength, everyone."
    },
    {
      "index": 18,
      "start_time": 100.7,
      "end_time": 101.6,
      "text": "Our peaceful days hang in the balance."
    },
    {
      "index": 19,
      "start_time": 102.4,
      "end_time": 104.6,
      "text": "We must win this fight."
    }
  ],
