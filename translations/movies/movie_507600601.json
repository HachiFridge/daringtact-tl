{
  "movie_id": 507600601,
  "subtitles": [
    {
      "index": 0,
      "start_time": 0.8,
      "end_time": 3.3,
      "text": "Grrrrrr..."
    },
    {
      "index": 1,
      "start_time": 8.6,
      "end_time": 9.6,
      "text": "Ahh!"
    },
    {
      "index": 2,
      "start_time": 10.0,
      "end_time": 11.5,
      "text": "Leave the extermination to us!"
    },
    {
      "index": 3,
      "start_time": 12.6,
      "end_time": 14.4,
      "text": "You all need to leave quickly!"
    },
    {
      "index": 4,
      "start_time": 15.5,
      "end_time": 17.0,
      "text": "I want you to wait, okay!"
    },
    {
      "index": 5,
      "start_time": 17.2,
      "end_time": 19.6,
      "text": "Right now, she's just in a bad mood!"
    },
    {
      "index": 6,
      "start_time": 20.5,
      "end_time": 22.6,
      "text": "Even so, the city is suffering from damage."
    },
    {
      "index": 7,
      "start_time": 23.2,
      "end_time": 24.5,
      "text": "I cannot let it escape!"
    },
    {
      "index": 8,
      "start_time": 25.0,
      "end_time": 27.3,
      "text": "In truth, she's actually a good kid..."
    },
    {
      "index": 9,
      "start_time": 28.6,
      "end_time": 30.6,
      "text": "If you don't understand...!"
    },
    {
      "index": 10,
      "start_time": 33.6,
      "end_time": 34.4,
      "text": "Kaori!?"
    },
    {
      "index": 11,
      "start_time": 34.6,
      "end_time": 37.0,
      "text": "This is bad! It's super dangerous!"
    },
    {
      "index": 12,
      "start_time": 37.5,
      "end_time": 38.9,
      "text": "Don't worry about it."
    },
    {
      "index": 13,
      "start_time": 39.5,
      "end_time": 40.6,
      "text": "I believe in you!"
    },
    {
      "index": 14,
      "start_time": 41.9,
      "end_time": 43.2,
      "text": "I can't take it anymore...!"
    },
    {
      "index": 15,
      "start_time": 43.5,
      "end_time": 45.3,
      "text": "Everyone, charge!"
    },
    {
      "index": 16,
      "start_time": 45.5,
      "end_time": 47.0,
      "text": "?!"
    },
    {
      "index": 17,
      "start_time": 47.3,
      "end_time": 49.3,
      "text": "Cotton Candy-chan, Kaori believes in her"
    },
    {
      "index": 18,
      "start_time": 50.0,
      "end_time": 50.8,
      "text": "I also..."
    },
    {
      "index": 19,
      "start_time": 51.1,
      "end_time": 52.3,
      "text": "Believe."
    },
    {
      "index": 20,
      "start_time": 54.2,
      "end_time": 55.6,
      "text": "If the Shogun says so!"
    },
    {
      "index": 21,
      "start_time": 56.0,
      "end_time": 58.1,
      "text": "Suzuna, us too!"
    },
    {
      "index": 22,
      "start_time": 58.3,
      "end_time": 60.0,
      "text": "Sure thing!"
    },
    {
      "index": 23,
      "start_time": 71.6,
      "end_time": 74.4,
      "text": "Kaori! Leave it to me!"
    },
    {
      "index": 24,
      "start_time": 74.6,
      "end_time": 75.6,
      "text": "Good luck!"
    },
    {
      "index": 25,
      "start_time": 85.0,
      "end_time": 86.6,
      "text": "Damn. This is...!"
    },
    {
      "index": 26,
      "start_time": 87.3,
      "end_time": 88.0,
      "text": "...!"
    },
    {
      "index": 27,
      "start_time": 88.9,
      "end_time": 91.6,
      "text": "Everyone... Thank you so much for the support!"
    },
    {
      "index": 28,
      "start_time": 96.6,
      "end_time": 97.6,
      "text": "Cotton candy-chan"
    },
    {
      "index": 29,
      "start_time": 98.0,
      "end_time": 101.0,
      "text": "I'll definitely return you to being a good kid!"
    },
    {
      "index": 30,
      "start_time": 101.3,
      "end_time": 103.0,
      "text": "Grrrrrr..."
    },
    {
      "index": 31,
      "start_time": 111.6,
      "end_time": 113.1,
      "text": "I can't take this anymore..."
    },
    {
      "index": 32,
      "start_time": 114.1,
      "end_time": 116.6,
      "text": "I won't let you feel lonely!"
    },
    {
      "index": 33,
      "start_time": 121.5,
      "end_time": 124.1,
      "text": "Did you like this?"
    },
    {
      "index": 34,
      "start_time": 126.3,
      "end_time": 129.8,
      "text": "Because you're a good kid,\nI want you to eat it again...!"
    },
    {
      "index": 35,
      "start_time": 156.8,
      "end_time": 158.3,
      "text": "♪"
    },
    {
      "index": 36,
      "start_time": 159.5,
      "end_time": 163.0,
      "text": "Look, there's nothing left to worry about~"
    }
  ],
