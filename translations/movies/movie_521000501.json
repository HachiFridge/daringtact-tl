{
  "movie_id": 521000501,
  "subtitles": [
    {
      "index": 0,
      "start_time": 0.9,
      "end_time": 2.0,
      "text": "Haaaah!"
    },
    {
      "index": 1,
      "start_time": 2.2,
      "end_time": 3.2,
      "text": "Hah!"
    },
    {
      "index": 2,
      "start_time": 4.5,
      "end_time": 5.8,
      "text": "Kyaah! Wow!"
    },
    {
      "index": 3,
      "start_time": 6.0,
      "end_time": 6.8,
      "text": "Huh?"
    },
    {
      "index": 4,
      "start_time": 7.0,
      "end_time": 9.0,
      "text": "Ah...! Ohnononono~"
    },
    {
      "index": 5,
      "start_time": 9.9,
      "end_time": 11.1,
      "text": "Kyaaa!"
    },
    {
      "index": 6,
      "start_time": 12.3,
      "end_time": 17.0,
      "text": "YOU MISCREANTS! How dare you put on such a perverted act in a sacred hall of law?!"
    },
    {
      "index": 7,
      "start_time": 18.1,
      "end_time": 20.9,
      "text": "A-Awawa...!"
    },
    {
      "index": 8,
      "start_time": 21.9,
      "end_time": 24.2,
      "text": "Na-chan... run away...!"
    },
    {
      "index": 9,
      "start_time": 24.4,
      "end_time": 26.3,
      "text": "Th-That's...!"
    },
    {
      "index": 10,
      "start_time": 26.5,
      "end_time": 28.1,
      "text": "Ugh..."
    },
    {
      "index": 11,
      "start_time": 34.8,
      "end_time": 37.2,
      "text": "A-chan! Put one of your threads on Nana!"
    },
    {
      "index": 12,
      "start_time": 37.8,
      "end_time": 39.0,
      "text": "Huh? But...!"
    },
    {
      "index": 13,
      "start_time": 40.2,
      "end_time": 41.4,
      "text": "Please!"
    },
    {
      "index": 14,
      "start_time": 48.6,
      "end_time": 50.7,
      "text": "I'M GOING TO RESTRAIN YOU!"
    },
    {
      "index": 15,
      "start_time": 50.8,
      "end_time": 52.3,
      "text": "Yaaaaah!"
    },
    {
      "index": 16,
      "start_time": 52.5,
      "end_time": 54.0,
      "text": "Muguu?!"
    },
    {
      "index": 17,
      "start_time": 54.2,
      "end_time": 56.8,
      "text": "Waaaaahhh!"
    },
    {
      "index": 18,
      "start_time": 57.0,
      "end_time": 58.8,
      "text": "This is no big deal!"
    },
    {
      "index": 19,
      "start_time": 59.6,
      "end_time": 61.4,
      "text": "...DROP DEAAAAAD!"
    },
    {
      "index": 20,
      "start_time": 61.6,
      "end_time": 63.6,
      "text": "GWAAAAAAAAAAHHH!"
    },
    {
      "index": 21,
      "start_time": 64.2,
      "end_time": 66.4,
      "text": "Guh! Guguu...!"
    },
    {
      "index": 22,
      "start_time": 70.4,
      "end_time": 73.5,
      "text": "Ugh... Owww, oww..."
    },
    {
      "index": 23,
      "start_time": 74.2,
      "end_time": 76.3,
      "text": "N-No way... could this be...!?"
    },
    {
      "index": 24,
      "start_time": 77.3,
      "end_time": 81.8,
      "text": "...The first thing that felt strange was that you were egging on Kanon-san."
    },
    {
      "index": 25,
      "start_time": 82.4,
      "end_time": 83.6,
      "text": "Ugh...!"
    },
    {
      "index": 26,
      "start_time": 84.9,
      "end_time": 85.9,
      "text": "...Wow!"
    },
    {
      "index": 27,
      "start_time": 86.1,
      "end_time": 87.1,
      "text": "Second..."
    },
    {
      "index": 28,
      "start_time": 87.4,
      "end_time": 91.3,
      "text": "When Kanon-san was killed, you didn't even bother to investigate"
    },
    {
      "index": 29,
      "start_time": 91.9,
      "end_time": 93.1,
      "text": "Guh... Gaah!"
    },
    {
      "index": 30,
      "start_time": 93.3,
      "end_time": 94.5,
      "text": "Aaah...!"
    },
    {
      "index": 31,
      "start_time": 95.8,
      "end_time": 96.9,
      "text": "Third..."
    },
    {
      "index": 32,
      "start_time": 97.1,
      "end_time": 102.7,
      "text": "A double standard of condoning lynching while calling it a sacred judgment"
    },
    {
      "index": 33,
      "start_time": 103.0,
      "end_time": 104.7,
      "text": "GUUUUUU!"
    },
    {
      "index": 34,
      "start_time": 104.9,
      "end_time": 105.8,
      "text": "In other words"
    },
    {
      "index": 35,
      "start_time": 106.0,
      "end_time": 107.3,
      "text": "The culprit is..."
    },
    {
      "index": 36,
      "start_time": 108.8,
      "end_time": 110.5,
      "text": "...YOU!"
    }
  ],
