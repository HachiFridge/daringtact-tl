{
  "movie_id": 220200101,
  "subtitles": [
    {
      "index": 0,
      "start_time": 29.0,
      "end_time": 30.4,
      "text": "Hey! What the hell is that?!"
    },
    {
      "index": 1,
      "start_time": 30.6,
      "end_time": 32.3,
      "text": "I wonder what that thing is."
    },
    {
      "index": 2,
      "start_time": 34.0,
      "end_time": 36.1,
      "text": "An attack from that far away...?"
    },
    {
      "index": 3,
      "start_time": 36.9,
      "end_time": 38.6,
      "text": "Hey, hey! A new type of monsters?"
    },
    {
      "index": 4,
      "start_time": 39.6,
      "end_time": 43.0,
      "text": "Good grief, don't get too cocky~"
    },
    {
      "index": 5,
      "start_time": 43.2,
      "end_time": 44.3,
      "text": "Daaaaah!"
    },
    {
      "index": 6,
      "start_time": 44.6,
      "end_time": 46.5,
      "text": "Hahaha!"
    },
    {
      "index": 7,
      "start_time": 46.7,
      "end_time": 49.1,
      "text": "This is it, [Gio Teogonia]!"
    },
    {
      "index": 8,
      "start_time": 62.6,
      "end_time": 64.1,
      "text": "That was your doing!?"
    },
    {
      "index": 9,
      "start_time": 64.3,
      "end_time": 65.3,
      "text": "Aahn?"
    },
    {
      "index": 10,
      "start_time": 65.5,
      "end_time": 70.1,
      "text": "I don't know who you are, but whatever, I'll let you know who I am in the afterlife!"
    },
    {
      "index": 11,
      "start_time": 70.5,
      "end_time": 74.6,
      "text": "I'm the third daughter of the guild, Bandit Sister, Fubuki!☆"
    },
    {
      "index": 12,
      "start_time": 75.4,
      "end_time": 77.2,
      "text": "I-I'm the second daughter, Wakana..."
    },
    {
      "index": 13,
      "start_time": 77.4,
      "end_time": 79.8,
      "text": "Hey! Stupid sister? You're too small!"
    },
    {
      "index": 14,
      "start_time": 80.0,
      "end_time": 82.4,
      "text": "Eeek...! I-I'm sorry!"
    },
    {
      "index": 15,
      "start_time": 82.6,
      "end_time": 86.1,
      "text": "And I'm the eldest daughter, Yamato!"
    },
    {
      "index": 16,
      "start_time": 86.5,
      "end_time": 90.6,
      "text": "Come on, let's get this country's treasure, [Royal Equipment]!"
    }
  ],
