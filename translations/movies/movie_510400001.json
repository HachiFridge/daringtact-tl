{
  "movie_id": 510400001,
  "subtitles": [
    {
      "index": 0,
      "start_time": 10.1,
      "end_time": 12.0,
      "text": "Now, let's begin the mission"
    },
    {
      "index": 1,
      "start_time": 12.2,
      "end_time": 14.2,
      "text": "Aunt Christina is going too, you know?"
    },
    {
      "index": 2,
      "start_time": 14.6,
      "end_time": 16.3,
      "text": "I got it, I got it."
    },
    {
      "index": 3,
      "start_time": 17.0,
      "end_time": 18.6,
      "text": "Don't scream like that, Matsuri."
    },
    {
      "index": 4,
      "start_time": 20.0,
      "end_time": 20.8,
      "text": "And of course..."
    },
    {
      "index": 5,
      "start_time": 21.5,
      "end_time": 24.6,
      "text": "If you call me \"Auntie\" again, I'll kill you, okay?"
    },
    {
      "index": 6,
      "start_time": 28.3,
      "end_time": 29.3,
      "text": "Okay"
    },
    {
      "index": 7,
      "start_time": 29.5,
      "end_time": 32.5,
      "text": "This is an important request from Her Majesty, you know!!"
    },
    {
      "index": 8,
      "start_time": 35.5,
      "end_time": 38.4,
      "text": "Are those two really going to be okay?"
    },
    {
      "index": 9,
      "start_time": 38.6,
      "end_time": 40.5,
      "text": "Putting aside Matsuri..."
    },
    {
      "index": 10,
      "start_time": 41.0,
      "end_time": 45.3,
      "text": "To change the stalemate situation,\nbold choices are also necessary."
    },
    {
      "index": 11,
      "start_time": 46.0,
      "end_time": 46.8,
      "text": "And..."
    },
    {
      "index": 12,
      "start_time": 47.3,
      "end_time": 48.7,
      "text": "And...?"
    },
    {
      "index": 13,
      "start_time": 50.0,
      "end_time": 53.3,
      "text": "And, Jun appointed me!"
    },
    {
      "index": 14,
      "start_time": 55.3,
      "end_time": 58.6,
      "text": "So please don't cause any unnecessary commotion!"
    },
    {
      "index": 15,
      "start_time": 59.0,
      "end_time": 59.6,
      "text": "Okay"
    },
    {
      "index": 16,
      "start_time": 60.5,
      "end_time": 66.2,
      "text": "Haha, who are you talking to?\nI will fulfill the mission I accepted."
    },
    {
      "index": 17,
      "start_time": 66.5,
      "end_time": 68.5,
      "text": "I am Christina, you know."
    },
    {
      "index": 18,
      "start_time": 70.9,
      "end_time": 74.0,
      "text": "...I believe in, Chris."
    },
    {
      "index": 19,
      "start_time": 74.6,
      "end_time": 76.0,
      "text": "Why is that?"
    },
    {
      "index": 20,
      "start_time": 76.6,
      "end_time": 80.0,
      "text": "It's because she is a person who keeps promises.\nIt's that simple."
    },
    {
      "index": 21,
      "start_time": 81.3,
      "end_time": 82.6,
      "text": "That's absolutely right."
    },
    {
      "index": 22,
      "start_time": 83.4,
      "end_time": 85.6,
      "text": "Alright, let's go"
    },
    {
      "index": 23,
      "start_time": 86.2,
      "end_time": 88.0,
      "text": "Oh, please wait a moment~"
    }
  ],
