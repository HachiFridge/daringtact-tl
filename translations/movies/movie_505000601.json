{
  "movie_id": 505000601,
  "subtitles": [
    {
      "index": 0,
      "start_time": 1.0,
      "end_time": 2.6,
      "text": "Ha ha ha!"
    },
    {
      "index": 1,
      "start_time": 3.0,
      "end_time": 8.0,
      "text": "Like a failure, just disappear miserably!"
    },
    {
      "index": 2,
      "start_time": 10.0,
      "end_time": 12.0,
      "text": "I am not a failure or anything!"
    },
    {
      "index": 3,
      "start_time": 12.2,
      "end_time": 15.6,
      "text": "Hmph, what are you saying in such a weakened state?"
    },
    {
      "index": 4,
      "start_time": 16.0,
      "end_time": 17.8,
      "text": "All of you scum..."
    },
    {
      "index": 5,
      "start_time": 18.4,
      "end_time": 20.2,
      "text": "Hmm?"
    },
    {
      "index": 6,
      "start_time": 21.0,
      "end_time": 23.6,
      "text": "I-I won't let youー!"
    },
    {
      "index": 7,
      "start_time": 23.8,
      "end_time": 25.8,
      "text": "Well, how annoying!"
    },
    {
      "index": 8,
      "start_time": 26.0,
      "end_time": 27.0,
      "text": "Stop your futile struggle!!"
    },
    {
      "index": 9,
      "start_time": 27.2,
      "end_time": 28.4,
      "text": "Wow!"
    },
    {
      "index": 10,
      "start_time": 28.8,
      "end_time": 29.8,
      "text": "Matthew!!"
    },
    {
      "index": 11,
      "start_time": 31.0,
      "end_time": 33.0,
      "text": "Haaaaaaaah!!"
    },
    {
      "index": 12,
      "start_time": 35.2,
      "end_time": 36.2,
      "text": "Ahh!"
    },
    {
      "index": 13,
      "start_time": 39.0,
      "end_time": 41.4,
      "text": "Thank you. I feel much better now."
    },
    {
      "index": 14,
      "start_time": 41.8,
      "end_time": 46.0,
      "text": "Tsk! Then I shall continue to absorb your energy even more!"
    },
    {
      "index": 15,
      "start_time": 46.4,
      "end_time": 47.8,
      "text": "Haahhhh!"
    },
    {
      "index": 16,
      "start_time": 48.4,
      "end_time": 50.0,
      "text": "Squishy-squishy~"
    },
    {
      "index": 17,
      "start_time": 53.6,
      "end_time": 54.6,
      "text": "Ugh..."
    },
    {
      "index": 18,
      "start_time": 55.0,
      "end_time": 56.4,
      "text": "I will not lose!"
    },
    {
      "index": 19,
      "start_time": 56.8,
      "end_time": 58.6,
      "text": "Haaaah!"
    },
    {
      "index": 20,
      "start_time": 58.8,
      "end_time": 59.6,
      "text": "Ugh..."
    },
    {
      "index": 21,
      "start_time": 60.0,
      "end_time": 62.2,
      "text": "Whoa!? Are you okay, Kishi-san?!"
    },
    {
      "index": 22,
      "start_time": 62.6,
      "end_time": 63.8,
      "text": "S-So, that's how it is, Miss Rei!"
    },
    {
      "index": 23,
      "start_time": 64.0,
      "end_time": 66.0,
      "text": "If you keep that up, pal, you'll collapse too!"
    },
    {
      "index": 24,
      "start_time": 66.4,
      "end_time": 68.6,
      "text": "Don't worry, let's trust him."
    },
    {
      "index": 25,
      "start_time": 69.0,
      "end_time": 71.0,
      "text": "Ah, if you say so, Miss Rei..."
    },
    {
      "index": 26,
      "start_time": 71.8,
      "end_time": 73.0,
      "text": "Grrrrr!!"
    },
    {
      "index": 27,
      "start_time": 77.2,
      "end_time": 79.0,
      "text": "Haahhhhh."
    },
    {
      "index": 28,
      "start_time": 87.6,
      "end_time": 88.8,
      "text": "What!?"
    },
    {
      "index": 29,
      "start_time": 91.0,
      "end_time": 93.2,
      "text": "So this was your plan from the beginning!"
    },
    {
      "index": 30,
      "start_time": 93.4,
      "end_time": 95.8,
      "text": "You're quite impressive Kishi-san!"
    },
    {
      "index": 31,
      "start_time": 96.4,
      "end_time": 97.6,
      "text": "C-Curse you~"
    },
    {
      "index": 32,
      "start_time": 98.0,
      "end_time": 101.0,
      "text": "Now, it seems the tables have turned."
    },
    {
      "index": 33,
      "start_time": 101.8,
      "end_time": 104.0,
      "text": "They did their best, too."
    },
    {
      "index": 34,
      "start_time": 104.4,
      "end_time": 106.2,
      "text": "I cannot show you my uncool side!"
    },
    {
      "index": 35,
      "start_time": 106.4,
      "end_time": 108.6,
      "text": "That's right! Let's go, pal!"
    },
    {
      "index": 36,
      "start_time": 110.4,
      "end_time": 112.8,
      "text": "You! sneaky little!"
    },
    {
      "index": 37,
      "start_time": 113.6,
      "end_time": 116.0,
      "text": "I've already seen through your attacks, pal!"
    },
    {
      "index": 38,
      "start_time": 116.6,
      "end_time": 119.4,
      "text": "Hehe, I just wanted to say this once~♪"
    },
    {
      "index": 39,
      "start_time": 120.4,
      "end_time": 121.8,
      "text": "Wawah!"
    },
    {
      "index": 40,
      "start_time": 126.8,
      "end_time": 127.8,
      "text": "You saved me, pal!"
    },
    {
      "index": 41,
      "start_time": 128.0,
      "end_time": 130.6,
      "text": "Hey, please don't let your guard down until the very end!"
    },
    {
      "index": 42,
      "start_time": 130.8,
      "end_time": 133.0,
      "text": "I must have a thorough lesson later!"
    },
    {
      "index": 43,
      "start_time": 133.2,
      "end_time": 133.8,
      "text": "Ugh..."
    },
    {
      "index": 44,
      "start_time": 134.0,
      "end_time": 135.6,
      "text": "Now! Miss Rei"
    },
    {
      "index": 45,
      "start_time": 136.0,
      "end_time": 137.0,
      "text": "Leave it to me!"
    },
    {
      "index": 46,
      "start_time": 141.4,
      "end_time": 143.6,
      "text": "Haaaaahhh!"
    }
  ],
