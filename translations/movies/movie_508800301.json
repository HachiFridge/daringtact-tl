{
  "movie_id": 508800301,
  "subtitles": [
    {
      "index": 0,
      "start_time": 4.6,
      "end_time": 7.0,
      "text": "さぁ、準備をいたしましょう！"
    },
    {
      "index": 1,
      "start_time": 7.3,
      "end_time": 8.7,
      "text": "ウィスタリア家の名に懸けて"
    },
    {
      "index": 2,
      "start_time": 9.1,
      "end_time": 12.1,
      "text": "必ずや最高の物産展にしてみせますわ！"
    },
    {
      "index": 3,
      "start_time": 12.5,
      "end_time": 13.3,
      "text": "Ahh!"
    },
    {
      "index": 4,
      "start_time": 14.0,
      "end_time": 15.3,
      "text": "みんなでがんばろうねっ"
    },
    {
      "index": 5,
      "start_time": 16.3,
      "end_time": 17.3,
      "text": "待たせたわね！"
    },
    {
      "index": 6,
      "start_time": 19.5,
      "end_time": 22.5,
      "text": "どう？　似合ってる？"
    },
    {
      "index": 7,
      "start_time": 23.1,
      "end_time": 25.6,
      "text": "はいっ、ミサキちゃん、すごく素敵です……"
    },
    {
      "index": 8,
      "start_time": 29.6,
      "end_time": 31.0,
      "text": "クルミもなかなかじゃない"
    },
    {
      "index": 9,
      "start_time": 31.5,
      "end_time": 33.0,
      "text": "サイズもぴったりね"
    },
    {
      "index": 10,
      "start_time": 33.3,
      "end_time": 35.6,
      "text": "うぅ……ど、どうかなぁ……"
    },
    {
      "index": 11,
      "start_time": 36.0,
      "end_time": 38.2,
      "text": "私が着ても、変じゃないですか？"
    },
    {
      "index": 12,
      "start_time": 39.0,
      "end_time": 40.8,
      "text": "あぅ、心配ですぅ……"
    },
    {
      "index": 13,
      "start_time": 41.2,
      "end_time": 42.1,
      "text": "二人ともよく似合ってるよ"
    },
    {
      "index": 14,
      "start_time": 42.5,
      "end_time": 45.6,
      "text": "お、お兄ちゃん……本当、ですか……？"
    },
    {
      "index": 15,
      "start_time": 46.0,
      "end_time": 47.6,
      "text": "あっ、着替え終わりましたわね！"
    },
    {
      "index": 16,
      "start_time": 48.3,
      "end_time": 49.2,
      "text": "こっちですわ！"
    },
    {
      "index": 17,
      "start_time": 49.5,
      "end_time": 51.0,
      "text": "皆さまにお披露目いたしましょう！"
    },
    {
      "index": 18,
      "start_time": 51.5,
      "end_time": 52.3,
      "text": "Auuu..."
    },
    {
      "index": 19,
      "start_time": 52.5,
      "end_time": 53.5,
      "text": "お披露目……！？"
    },
    {
      "index": 20,
      "start_time": 53.7,
      "end_time": 54.7,
      "text": "行きましょ、クルミ！"
    },
    {
      "index": 21,
      "start_time": 55.3,
      "end_time": 58.3,
      "text": "大人のレディはいつも胸を張っていないとね！"
    },
    {
      "index": 22,
      "start_time": 58.5,
      "end_time": 60.0,
      "text": "大人じゃないですぅ……"
    },
    {
      "index": 23,
      "start_time": 63.9,
      "end_time": 64.6,
      "text": "……クルミ？"
    },
    {
      "index": 24,
      "start_time": 65.0,
      "end_time": 70.0,
      "text": "うぅ……私……こういう時って、いつも、出ていけなくて……！"
    },
    {
      "index": 25,
      "start_time": 71.0,
      "end_time": 71.6,
      "text": "?"
    },
    {
      "index": 26,
      "start_time": 74.9,
      "end_time": 76.5,
      "text": "お、お兄ちゃん……？"
    },
    {
      "index": 27,
      "start_time": 77.5,
      "end_time": 78.5,
      "text": "..."
    },
    {
      "index": 28,
      "start_time": 80.5,
      "end_time": 82.3,
      "text": "ミ、ミサキちゃん……！"
    },
    {
      "index": 29,
      "start_time": 83.0,
      "end_time": 85.5,
      "text": "そういう時は手を引いてもらうの！"
    },
    {
      "index": 30,
      "start_time": 86.4,
      "end_time": 88.2,
      "text": "今日は、アタシが引いてあげるわ"
    },
    {
      "index": 31,
      "start_time": 89.0,
      "end_time": 90.2,
      "text": "行きましょ、クルミ！"
    },
    {
      "index": 32,
      "start_time": 93.0,
      "end_time": 95.0,
      "text": "..."
    },
    {
      "index": 33,
      "start_time": 96.0,
      "end_time": 97.3,
      "text": "...!"
    },
    {
      "index": 34,
      "start_time": 105.5,
      "end_time": 107.5,
      "text": "さあ、稼ぎますわよ！！"
    }
  ],
