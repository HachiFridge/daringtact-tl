{
  "movie_id": 515000101,
  "subtitles": [
    {
      "index": 0,
      "start_time": 2.6,
      "end_time": 6.6,
      "text": "Honestly, why do I have to change clothes..."
    },
    {
      "index": 1,
      "start_time": 9.3,
      "end_time": 12.1,
      "text": "I usually just watch others wear them but"
    },
    {
      "index": 2,
      "start_time": 14.3,
      "end_time": 17.3,
      "text": "When it's my turn to wear it..."
    },
    {
      "index": 3,
      "start_time": 18.1,
      "end_time": 19.7,
      "text": "It's embarrassing."
    },
    {
      "index": 4,
      "start_time": 20.7,
      "end_time": 21.8,
      "text": "Hehe"
    },
    {
      "index": 5,
      "start_time": 22.1,
      "end_time": 25.5,
      "text": "...I wonder what he'll say"
    },
    {
      "index": 6,
      "start_time": 36.1,
      "end_time": 37.0,
      "text": "Sorry to keep you waiting."
    },
    {
      "index": 7,
      "start_time": 37.2,
      "end_time": 38.0,
      "text": "?"
    },
    {
      "index": 8,
      "start_time": 56.6,
      "end_time": 58.8,
      "text": "See. Is this enough for you?"
    },
    {
      "index": 9,
      "start_time": 59.6,
      "end_time": 63.5,
      "text": "It's such a strange feeling, wearing this in front of someone I've known for so long."
    },
    {
      "index": 10,
      "start_time": 64.0,
      "end_time": 67.6,
      "text": "I feel strange. Like, ticklish or something."
    },
    {
      "index": 11,
      "start_time": 68.6,
      "end_time": 72.0,
      "text": "Well. Even if you see me in a swimsuit──"
    },
    {
      "index": 12,
      "start_time": 72.2,
      "end_time": 73.6,
      "text": "I'm happy to see."
    },
    {
      "index": 13,
      "start_time": 73.8,
      "end_time": 75.0,
      "text": "...!"
    },
    {
      "index": 14,
      "start_time": 76.5,
      "end_time": 78.2,
      "text": "...I see"
    },
    {
      "index": 15,
      "start_time": 79.1,
      "end_time": 82.1,
      "text": "Ah~ Ameth-chan is blushing~♪"
    },
    {
      "index": 16,
      "start_time": 82.5,
      "end_time": 83.5,
      "text": "Hehe"
    },
    {
      "index": 17,
      "start_time": 83.9,
      "end_time": 85.7,
      "text": "So innocent~♪"
    },
    {
      "index": 18,
      "start_time": 86.5,
      "end_time": 88.5,
      "text": "..."
    },
    {
      "index": 19,
      "start_time": 88.9,
      "end_time": 92.6,
      "text": "But you can't be fidgeting like that~♪"
    },
    {
      "index": 20,
      "start_time": 93.5,
      "end_time": 94.5,
      "text": "You should be"
    },
    {
      "index": 21,
      "start_time": 95.2,
      "end_time": 96.2,
      "text": "More confident"
    },
    {
      "index": 22,
      "start_time": 98.2,
      "end_time": 100.2,
      "text": "And show it off~♪"
    },
    {
      "index": 23,
      "start_time": 101.0,
      "end_time": 102.0,
      "text": "Oh~"
    },
    {
      "index": 24,
      "start_time": 102.2,
      "end_time": 103.9,
      "text": "Thank you~♪"
    },
    {
      "index": 25,
      "start_time": 104.1,
      "end_time": 105.3,
      "text": "Hah..."
    },
    {
      "index": 26,
      "start_time": 105.5,
      "end_time": 110.2,
      "text": "Homare, just to let you know, this guy doesn't understand anything."
    },
    {
      "index": 27,
      "start_time": 111.5,
      "end_time": 113.5,
      "text": "The outfit change seems to be complete♪"
    },
    {
      "index": 28,
      "start_time": 114.3,
      "end_time": 117.6,
      "text": "Then let's make it flashy~♪"
    }
  ],
