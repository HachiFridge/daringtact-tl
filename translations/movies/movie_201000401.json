{
  "movie_id": 201000401,
  "subtitles": [
    {
      "index": 0,
      "start_time": 2.0,
      "end_time": 2.9,
      "text": "Ah..."
    },
    {
      "index": 1,
      "start_time": 15.1,
      "end_time": 19.1,
      "text": "Please do not embrace me quite so tightly, my lord."
    },
    {
      "index": 2,
      "start_time": 20.0,
      "end_time": 21.8,
      "text": "It is difficult to breathe."
    },
    {
      "index": 3,
      "start_time": 26.0,
      "end_time": 28.0,
      "text": "I am sorry..."
    },
    {
      "index": 4,
      "start_time": 29.0,
      "end_time": 32.1,
      "text": "I really must have worried you terribly."
    },
    {
      "index": 5,
      "start_time": 33.2,
      "end_time": 34.8,
      "text": "Hm? Could it be..."
    },
    {
      "index": 6,
      "start_time": 35.0,
      "end_time": 38.1,
      "text": "Have you been shedding tears?"
    },
    {
      "index": 7,
      "start_time": 38.3,
      "end_time": 41.2,
      "text": "Your eyes look puffy and red, my lord."
    },
    {
      "index": 8,
      "start_time": 42.2,
      "end_time": 46.1,
      "text": "...Eheh. They say that big boys like yourself"
    },
    {
      "index": 9,
      "start_time": 46.3,
      "end_time": 48.9,
      "text": "should only allow themselves to cry"
    },
    {
      "index": 10,
      "start_time": 49.1,
      "end_time": 51.3,
      "text": "three times in their lives."
    },
    {
      "index": 11,
      "start_time": 51.8,
      "end_time": 54.1,
      "text": "I would not wish for you to waste"
    },
    {
      "index": 12,
      "start_time": 54.3,
      "end_time": 58.2,
      "text": "one of those precious three times on me."
    },
    {
      "index": 13,
      "start_time": 58.4,
      "end_time": 59.4,
      "text": "And yet..."
    },
    {
      "index": 14,
      "start_time": 59.6,
      "end_time": 63.0,
      "text": "It is such an honor... So wonderful..."
    },
    {
      "index": 15,
      "start_time": 63.2,
      "end_time": 66.1,
      "text": "I feel I may shed my own tears of joy."
    },
    {
      "index": 16,
      "start_time": 67.2,
      "end_time": 72.1,
      "text": "Eheheh. What a state the both of us are in."
    },
    {
      "index": 17,
      "start_time": 75.0,
      "end_time": 76.2,
      "text": "Ehm..."
    },
    {
      "index": 18,
      "start_time": 77.0,
      "end_time": 84.1,
      "text": "May I put my arms around you as well? My lord..."
    },
    {
      "index": 19,
      "start_time": 84.2,
      "end_time": 92.0,
      "text": "I want to feel your heartbeat, your warmth, more closely."
    }
  ],
