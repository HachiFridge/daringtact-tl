      "text": "That's it~☆"
    },
    {
      "index": 6,
      "start_time": 24.2,
      "end_time": 25.2,
      "text": "You did it!"
    },
    {
      "index": 7,
      "start_time": 27.0,
      "end_time": 28.2,
      "text": "Ugh..."
    },
    {
      "index": 8,
      "start_time": 30.0,
      "end_time": 33.0,
      "text": "What, are you afraid of the water?"
    },
    {
      "index": 9,
      "start_time": 33.4,
      "end_time": 34.8,
      "text": "That's not it, but..."
    },
    {
      "index": 10,
      "start_time": 35.0,
      "end_time": 37.4,
      "text": "Haha. So it's embarrassing?"
    },
    {
      "index": 11,
      "start_time": 37.8,
      "end_time": 39.2,
      "text": "Th-That's not it..."
    },
    {
      "index": 12,
      "start_time": 39.8,
      "end_time": 41.6,
      "text": "Huh~?"
    },
    {
      "index": 13,
      "start_time": 43.2,
      "end_time": 45.0,
      "text": "That's it!"
    },
    {
      "index": 14,
      "start_time": 47.8,
      "end_time": 49.0,
      "text": "*sigh*!"
    },
    {
      "index": 15,
      "start_time": 49.2,
      "end_time": 50.4,
      "text": "It's because you're careless"
    },
    {
      "index": 16,
      "start_time": 50.6,
      "end_time": 52.0,
      "text": "Wait!"
    },
    {
      "index": 17,
      "start_time": 54.0,
      "end_time": 56.0,
      "text": "Everyone's so energetic!"
    },
    {
      "index": 18,
      "start_time": 68.6,
      "end_time": 70.0,
      "text": "*sigh*..."
    },
    {
      "index": 19,
      "start_time": 79.0,
      "end_time": 81.6,
      "text": "Huh? What's wrong?"
    },
    {
      "index": 20,
      "start_time": 81.8,
      "end_time": 84.0,
      "text": "Aren't you going to swim, Kishi-kun?"
    },
    {
      "index": 21,
      "start_time": 86.2,
      "end_time": 87.2,
      "text": "Ah!"
    },
    {
      "index": 22,
      "start_time": 88.2,
      "end_time": 92.4,
      "text": "...Geez. Don't stare at me like that. ★"
