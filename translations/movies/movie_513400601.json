  "subtitles": [
    {
      "index": 0,
      "start_time": 19.1,
      "end_time": 20.6,
      "text": "Well then, time to check"
    },
    {
      "index": 1,
      "start_time": 21.5,
      "end_time": 23.2,
      "text": "If my deduction is correct..."
    },
    {
      "index": 2,
      "start_time": 25.2,
      "end_time": 26.2,
      "text": "You're here...!"
    },
    {
      "index": 3,
      "start_time": 28.2,
      "end_time": 31.5,
      "text": "Shouldn't we give a signal to Inori-chan!?"
    },
    {
      "index": 4,
      "start_time": 32.0,
      "end_time": 34.5,
      "text": "Still too far! We have to wait until it's even closer"
    },
    {
      "index": 5,
      "start_time": 39.1,
      "end_time": 40.0,
      "text": "...Now!"
    },
    {
      "index": 6,
      "start_time": 47.0,
      "end_time": 48.6,
      "text": "Finally, I've been waiting!"
    },
    {
      "index": 7,
      "start_time": 49.8,
      "end_time": 52.2,
      "text": "Suu...!"
    },
    {
      "index": 8,
      "start_time": 59.1,
      "end_time": 62.6,
      "text": "Baaaaaaaa～!"
    },
    {
      "index": 9,
      "start_time": 83.2,
      "end_time": 84.6,
      "text": "Next is... Hatsune-san!"
    },
    {
      "index": 10,
      "start_time": 85.4,
      "end_time": 86.2,
      "text": "Yeah!"
    },
    {
      "index": 11,
      "start_time": 86.5,
      "end_time": 88.3,
      "text": "Stop～!"
    },
    {
      "index": 12,
      "start_time": 94.4,
      "end_time": 96.5,
      "text": "Uhh... Guhh...!?"
    },
    {
      "index": 13,
      "start_time": 96.8,
      "end_time": 98.6,
      "text": "Put your hearts into it!"
    },
    {
      "index": 14,
      "start_time": 99.1,
      "end_time": 101.1,
      "text": "The meteor fragments aren't stopping yet!"
    },
    {
      "index": 15,
      "start_time": 106.2,
      "end_time": 110.4,
      "text": "...That's right, it's not like me to give up!"
    },
    {
      "index": 16,
      "start_time": 112.0,
      "end_time": 114.6,
      "text": "I'll absolutely, definitely..."
    },
    {
      "index": 17,
      "start_time": 115.1,
      "end_time": 118.5,
      "text": "Make sure everyone have their first shrine visit～!"
    },
    {
      "index": 18,
      "start_time": 121.0,
      "end_time": 123.2,
      "text": "Serves you right～!"
    },
    {
      "index": 19,
      "start_time": 123.5,
      "end_time": 126.2,
      "text": "Not even a single fragment is left～"
    },
    {
      "index": 20,
      "start_time": 126.5,
      "end_time": 128.4,
      "text": "*pant pant*..."
    },
    {
      "index": 21,
      "start_time": 128.6,
      "end_time": 131.1,
      "text": "This is... Could it be..."
    },
    {
      "index": 22,
      "start_time": 135.4,
      "end_time": 137.1,
      "text": "Yay～!"
    },
    {
      "index": 23,
      "start_time": 137.3,
      "end_time": 139.0,
      "text": "We did it!"
    },
    {
      "index": 24,
      "start_time": 139.2,
      "end_time": 142.2,
      "text": "It's all because you were by my side☆"
    },
    {
      "index": 25,
      "start_time": 142.5,
      "end_time": 145.3,
      "text": "Wha- don't do that out in public!"
    },
    {
      "index": 26,
      "start_time": 145.5,
      "end_time": 148.0,
      "text": "You're right but..."
    },
    {
      "index": 27,
      "start_time": 148.2,
      "end_time": 151.1,
      "text": "She made a huge contribution in saving the city"
    },
    {
      "index": 28,
      "start_time": 151.3,
      "end_time": 153.9,
      "text": "Let her have this moment for herself"
    }
