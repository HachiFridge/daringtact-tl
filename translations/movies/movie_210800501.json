      "text": "Zane..."
    },
    {
      "index": 3,
      "start_time": 30.2,
      "end_time": 31.6,
      "text": "What can I do for you?"
    },
    {
      "index": 4,
      "start_time": 32.0,
      "end_time": 35.0,
      "text": "In order to prevent you from laying a hand on Landosol any further..."
