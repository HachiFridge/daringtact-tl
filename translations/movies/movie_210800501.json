      "text": "Yes..."
    },
    {
      "index": 9,
      "start_time": 48.0,
      "end_time": 50.4,
      "text": "What about the other members of the [Rage Legion]...?"
    },
    {
      "index": 10,
      "start_time": 51.8,
      "end_time": 53.2,
      "text": "They're not here..."
