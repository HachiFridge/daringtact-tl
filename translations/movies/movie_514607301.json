{
  "movie_id": 514607301,
  "subtitles": [
    {
      "index": 0,
      "start_time": 0.2,
      "end_time": 4.0,
      "text": "チュウジさんとチュウザさんのことを紹介するなら……"
    },
    {
      "index": 1,
      "start_time": 4.7,
      "end_time": 10.0,
      "text": "チーズお守り大作戦っていう演劇のお話は外せないですぅ"
    },
    {
      "index": 2,
      "start_time": 11.0,
      "end_time": 15.1,
      "text": "あ……チーズお守り大作戦っていうのは"
    },
    {
      "index": 3,
      "start_time": 15.7,
      "end_time": 19.3,
      "text": "牧場の物産展をアピールするために"
    },
    {
      "index": 4,
      "start_time": 20.0,
      "end_time": 23.1,
      "text": "私とミサキちゃんで演じた舞台で……"
    },
    {
      "index": 5,
      "start_time": 23.9,
      "end_time": 29.0,
      "text": "その裏で、牧場の住処を追われたネズミさんたちが"
    },
    {
      "index": 6,
      "start_time": 29.3,
      "end_time": 34.9,
      "text": "自分たちの居場所を、そしてチーズを奪おうと計画していて……"
    },
    {
      "index": 7,
      "start_time": 35.2,
      "end_time": 39.0,
      "text": "なんと舞台中に襲ってきちゃったんですぅ……"
    },
    {
      "index": 8,
      "start_time": 40.0,
      "end_time": 43.2,
      "text": "でもなんとそれがお客さんに大うけで"
    },
    {
      "index": 9,
      "start_time": 43.9,
      "end_time": 49.0,
      "text": "その後改心してくれたネズミさんたちは、私たちと一緒に"
    },
    {
      "index": 10,
      "start_time": 49.2,
      "end_time": 52.0,
      "text": "舞台に立ってくれることになったんです……♪"
    },
    {
      "index": 11,
      "start_time": 53.3,
      "end_time": 56.0,
      "text": "『魔物のパレード』の話を聞いて"
    },
    {
      "index": 12,
      "start_time": 56.3,
      "end_time": 60.5,
      "text": "私、絶対成功するって確信してました"
    },
    {
      "index": 13,
      "start_time": 62.0,
      "end_time": 63.0,
      "text": "After all..."
    },
    {
      "index": 14,
      "start_time": 63.2,
      "end_time": 69.1,
      "text": "義理と人情に厚い最高の役者さんが協力してくれるんですから♪"
    }
  ],
