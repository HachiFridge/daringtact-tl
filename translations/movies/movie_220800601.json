{
  "movie_id": 220800601,
  "subtitles": [
    {
      "index": 0,
      "start_time": 9.3,
      "end_time": 10.2,
      "text": "Hmm~?"
    },
    {
      "index": 1,
      "start_time": 10.4,
      "end_time": 12.1,
      "text": "Piiiii!?"
    },
    {
      "index": 2,
      "start_time": 16.3,
      "end_time": 18.3,
      "text": "As expected, the Bandy Sisters!"
    },
    {
      "index": 3,
      "start_time": 21.9,
      "end_time": 23.5,
      "text": "......!"
    },
    {
      "index": 4,
      "start_time": 23.7,
      "end_time": 25.4,
      "text": "..."
    },
    {
      "index": 5,
      "start_time": 25.7,
      "end_time": 27.1,
      "text": "～♪"
    },
    {
      "index": 6,
      "start_time": 28.0,
      "end_time": 29.2,
      "text": "However, something seems off..."
    },
    {
      "index": 7,
      "start_time": 30.0,
      "end_time": 30.7,
      "text": "Ah"
    },
    {
      "index": 8,
      "start_time": 31.3,
      "end_time": 32.4,
      "text": "Behind...!"
    },
    {
      "index": 9,
      "start_time": 39.6,
      "end_time": 40.6,
      "text": "...!"
    },
    {
      "index": 10,
      "start_time": 41.6,
      "end_time": 42.4,
      "text": "Hah!"
    },
    {
      "index": 11,
      "start_time": 48.0,
      "end_time": 50.6,
      "text": "──Such indecent tyranny"
    },
    {
      "index": 12,
      "start_time": 51.6,
      "end_time": 57.0,
      "text": "That girl, is she prepared to lose her head?"
    },
    {
      "index": 13,
      "start_time": 58.2,
      "end_time": 59.2,
      "text": "No?"
    },
    {
      "index": 14,
      "start_time": 59.5,
      "end_time": 62.6,
      "text": "I'm more prepared to take the head\nI missed though"
    },
    {
      "index": 15,
      "start_time": 64.6,
      "end_time": 66.1,
      "text": "..."
    },
    {
      "index": 16,
      "start_time": 67.0,
      "end_time": 69.5,
      "text": "As you have ravaged my Gio Teogonia"
    },
    {
      "index": 17,
      "start_time": 69.7,
      "end_time": 72.6,
      "text": "So, are you declaring war?"
    },
    {
      "index": 18,
      "start_time": 73.4,
      "end_time": 75.1,
      "text": "No, not that either"
    },
    {
      "index": 19,
      "start_time": 75.3,
      "end_time": 78.6,
      "text": "This time──it's also an offer of surrender"
    },
    {
      "index": 20,
      "start_time": 83.6,
      "end_time": 84.6,
      "text": "?!"
    },
    {
      "index": 21,
      "start_time": 91.0,
      "end_time": 92.8,
      "text": "......As expected......"
    },
    {
      "index": 22,
      "start_time": 94.6,
      "end_time": 96.7,
      "text": "──Lady Arachne......"
    },
    {
      "index": 23,
      "start_time": 97.6,
      "end_time": 99.9,
      "text": "──Hehe. Hehehe……"
    },
    {
      "index": 24,
      "start_time": 100.1,
      "end_time": 103.3,
      "text": "Long time no see. Iron Princess"
    },
    {
      "index": 25,
      "start_time": 104.1,
      "end_time": 107.6,
      "text": "I never wanted to see your face again──"
    },
    {
      "index": 26,
      "start_time": 108.2,
      "end_time": 109.4,
      "text": "Finally"
    },
    {
      "index": 27,
      "start_time": 109.6,
      "end_time": 114.3,
      "text": "I am prepared to take everything from you"
    },
    {
      "index": 28,
      "start_time": 115.0,
      "end_time": 119.4,
      "text": "Thus, I wanted to see your miserable face"
    },
    {
      "index": 29,
      "start_time": 119.8,
      "end_time": 123.2,
      "text": "You are one of the 'Six Calamities'\nNephi Nela-san spoke of......!?"
    },
    {
      "index": 30,
      "start_time": 123.6,
      "end_time": 126.6,
      "text": "But we won't let you do as you please any longer......!"
    },
    {
      "index": 31,
      "start_time": 128.0,
      "end_time": 132.7,
      "text": "Hehe. Quite spirited, 'Gluttonous' Eustiana"
    },
    {
      "index": 32,
      "start_time": 133.6,
      "end_time": 138.4,
      "text": "But take a look at this──\ncan you still say the same words?"
    }
  ],
