{
  "movie_id": 200909901,
  "subtitles": [
    {
      "index": 0,
      "start_time": 16.0,
      "end_time": 18.2,
      "text": "Ehmmm...?"
    },
    {
      "index": 1,
      "start_time": 19.5,
      "end_time": 24.0,
      "text": "(Where... am I? Is this some manner of dream?)"
    },
    {
      "index": 2,
      "start_time": 26.9,
      "end_time": 29.1,
      "text": "(Ahh, my memories seem confused...)"
    },
    {
      "index": 3,
      "start_time": 29.2,
      "end_time": 33.1,
      "text": "(My head aches, and I have trouble thinking straight.)"
    },
    {
      "index": 4,
      "start_time": 33.6,
      "end_time": 39.0,
      "text": "Mommy, who's that girl? Look at her funny clothes!"
    },
    {
      "index": 5,
      "start_time": 39.5,
      "end_time": 42.8,
      "text": "Shh! It's not nice to stare."
    },
    {
      "index": 6,
      "start_time": 43.0,
      "end_time": 44.8,
      "text": "Excuse me..."
    },
    {
      "index": 7,
      "start_time": 45.0,
      "end_time": 47.9,
      "text": "If I may trouble you, madam... Where am I, exactly?"
    },
    {
      "index": 8,
      "start_time": 48.1,
      "end_time": 50.1,
      "text": "Huh? Well, um..."
    },
    {
      "index": 9,
      "start_time": 50.5,
      "end_time": 54.1,
      "text": "This is the public park in Tsubakigaoka's Third District."
    },
    {
      "index": 10,
      "start_time": 54.4,
      "end_time": 57.5,
      "text": "Shall I take you to a police station?"
    },
    {
      "index": 11,
      "start_time": 57.7,
      "end_time": 59.0,
      "text": "Oh, no, that's quite all right."
    },
    {
      "index": 12,
      "start_time": 59.5,
      "end_time": 62.3,
      "text": "Hmm. Tsubakigaoka?"
    },
    {
      "index": 13,
      "start_time": 62.9,
      "end_time": 64.0,
      "text": "Come on, let's go."
    },
    {
      "index": 14,
      "start_time": 64.3,
      "end_time": 68.5,
      "text": "That sounds... vaguely familiar. Ahh..."
    },
    {
      "index": 15,
      "start_time": 69.1,
      "end_time": 71.1,
      "text": "Hey, Little Miss Cutie, over here!"
    },
    {
      "index": 16,
      "start_time": 71.3,
      "end_time": 72.3,
      "text": "Hmm?"
    },
    {
      "index": 17,
      "start_time": 79.1,
      "end_time": 81.9,
      "text": "Would you care for a crepe?"
    }
  ],
