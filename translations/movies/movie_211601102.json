{
  "movie_id": 211601102,
  "subtitles": [
    {
      "index": 0,
      "start_time": 17.0,
      "end_time": 18.3,
      "text": "Oh, umm..."
    },
    {
      "index": 1,
      "start_time": 19.6,
      "end_time": 23.2,
      "text": "You know, um..."
    },
    {
      "index": 2,
      "start_time": 25.9,
      "end_time": 27.2,
      "text": "Ah..."
    },
    {
      "index": 3,
      "start_time": 33.5,
      "end_time": 34.3,
      "text": "...!"
    },
    {
      "index": 4,
      "start_time": 36.5,
      "end_time": 39.1,
      "text": "I think it's time to say goodbye"
    },
    {
      "index": 5,
      "start_time": 40.3,
      "end_time": 42.5,
      "text": "I asked Homare-san for a favor..."
    },
    {
      "index": 6,
      "start_time": 43.1,
      "end_time": 47.5,
      "text": "As a terminal, please make it possible for me to interfere with Minerva."
    },
    {
      "index": 7,
      "start_time": 48.1,
      "end_time": 51.3,
      "text": "I knew that this would happen eventually..."
    },
    {
      "index": 8,
      "start_time": 51.5,
      "end_time": 54.0,
      "text": "But in the end,"
    },
    {
      "index": 9,
      "start_time": 55.6,
      "end_time": 58.1,
      "text": "I'm not sure if I can do it well, but"
    },
    {
      "index": 10,
      "start_time": 59.0,
      "end_time": 62.3,
      "text": "Just before this world disappears"
    },
    {
      "index": 11,
      "start_time": 62.5,
      "end_time": 67.2,
      "text": "I'll give it a try.... To see if I can get you back to 'reality'..."
    },
    {
      "index": 12,
      "start_time": 69.1,
      "end_time": 70.9,
      "text": "I will no longer say goodbye."
    },
    {
      "index": 13,
      "start_time": 71.6,
      "end_time": 73.3,
      "text": "But in return..."
    },
    {
      "index": 14,
      "start_time": 73.5,
      "end_time": 76.6,
      "text": "...!"
    },
    {
      "index": 15,
      "start_time": 77.5,
      "end_time": 78.3,
      "text": "... You know,"
    },
    {
      "index": 16,
      "start_time": 78.5,
      "end_time": 80.0,
      "text": "Sheffy...!?"
    },
    {
      "index": 17,
      "start_time": 83.5,
      "end_time": 85.6,
      "text": "About you"
    },
    {
      "index": 18,
      "start_time": 87.0,
      "end_time": 88.1,
      "text": "I love you."
    }
  ],
