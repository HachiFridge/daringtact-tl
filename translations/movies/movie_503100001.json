{
  "movie_id": 503100001,
  "subtitles": [
    {
      "index": 0,
      "start_time": 5.8,
      "end_time": 6.8,
      "text": "Heyas!"
    },
    {
      "index": 1,
      "start_time": 7.0,
      "end_time": 9.0,
      "text": "There you are. ♪"
    },
    {
      "index": 2,
      "start_time": 9.4,
      "end_time": 13.8,
      "text": "My lord, what is your opinion of our kimonos?"
    },
    {
      "index": 3,
      "start_time": 14.0,
      "end_time": 16.0,
      "text": "I hope you find them pleasing..."
    },
    {
      "index": 4,
      "start_time": 17.0,
      "end_time": 18.5,
      "text": "Eheheh."
    },
    {
      "index": 5,
      "start_time": 18.7,
      "end_time": 20.5,
      "text": "We're dressed to the nines!"
    },
    {
      "index": 6,
      "start_time": 20.7,
      "end_time": 22.0,
      "text": "How crazy is that? ☆"
    },
    {
      "index": 7,
      "start_time": 23.8,
      "end_time": 24.4,
      "text": "What're you looking at?!"
    },
    {
      "index": 8,
      "start_time": 24.5,
      "end_time": 25.8,
      "text": "Keep your eyes away from me!"
    },
    {
      "index": 9,
      "start_time": 26.0,
      "end_time": 27.0,
      "text": "I'll kill you!"
    },
    {
      "index": 10,
      "start_time": 27.1,
      "end_time": 28.5,
      "text": "You're thinking there's no way"
    },
    {
      "index": 11,
      "start_time": 28.6,
      "end_time": 30.6,
      "text": "I can look good in this, aren't you?!"
    },
    {
      "index": 12,
      "start_time": 31.0,
      "end_time": 32.6,
      "text": "What are you talking about?"
    },
    {
      "index": 13,
      "start_time": 32.8,
      "end_time": 35.5,
      "text": "You look so cute in your kimono, Karyl. ♪"
    },
    {
      "index": 14,
      "start_time": 35.9,
      "end_time": 37.0,
      "text": "Oh, hello everyone!"
    },
    {
      "index": 15,
      "start_time": 37.2,
      "end_time": 39.0,
      "text": "So this is where you've been."
    },
    {
      "index": 16,
      "start_time": 40.0,
      "end_time": 42.0,
      "text": "Miss Suzume, you look like—"
    },
    {
      "index": 17,
      "start_time": 42.1,
      "end_time": 44.2,
      "text": "You're not a maid today, but a shrine maiden, right?"
    },
    {
      "index": 18,
      "start_time": 44.8,
      "end_time": 45.4,
      "text": "Correct!"
    },
    {
      "index": 19,
      "start_time": 45.8,
      "end_time": 48.2,
      "text": "I'm going to work part-time at the shrine for a while."
    },
    {
      "index": 20,
      "start_time": 48.8,
      "end_time": 49.8,
      "text": "Wow!"
    },
    {
      "index": 21,
      "start_time": 50.0,
      "end_time": 52.1,
      "text": "Suzume, you look like a real shrine maiden!"
    },
    {
      "index": 22,
      "start_time": 52.3,
      "end_time": 54.7,
      "text": "You're so cute in that costume. ♪"
    },
    {
      "index": 23,
      "start_time": 55.0,
      "end_time": 56.0,
      "text": "Awww, really?"
    },
    {
      "index": 24,
      "start_time": 56.2,
      "end_time": 58.7,
      "text": "Eheheh. Thank you very much!"
    }
  ],
