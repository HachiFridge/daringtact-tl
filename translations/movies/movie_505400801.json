{
  "movie_id": 505400801,
  "subtitles": [
    {
      "index": 0,
      "start_time": 11.3,
      "end_time": 15.0,
      "text": "愛のバラは暴力の前に枯れてしまいました……"
    },
    {
      "index": 1,
      "start_time": 15.6,
      "end_time": 17.6,
      "text": "しかし心配はいりません"
    },
    {
      "index": 2,
      "start_time": 18.2,
      "end_time": 19.2,
      "text": "愛は……"
    },
    {
      "index": 3,
      "start_time": 20.5,
      "end_time": 22.0,
      "text": "不滅なのですから"
    },
    {
      "index": 4,
      "start_time": 23.3,
      "end_time": 24.0,
      "text": "...?"
    },
    {
      "index": 5,
      "start_time": 24.6,
      "end_time": 26.0,
      "text": "ご覧いただきましょう"
    },
    {
      "index": 6,
      "start_time": 27.3,
      "end_time": 32.0,
      "text": "心優しきシンデレラボーイによる聖夜のショーを！"
    },
    {
      "index": 7,
      "start_time": 42.3,
      "end_time": 43.3,
      "text": "This is..."
    },
    {
      "index": 8,
      "start_time": 45.0,
      "end_time": 47.3,
      "text": "魔法のバラ……ね"
    },
    {
      "index": 9,
      "start_time": 48.1,
      "end_time": 49.3,
      "text": "..."
    },
    {
      "index": 10,
      "start_time": 57.8,
      "end_time": 59.0,
      "text": "...!"
    },
    {
      "index": 11,
      "start_time": 63.0,
      "end_time": 64.5,
      "text": "Wow...!"
    },
    {
      "index": 12,
      "start_time": 77.0,
      "end_time": 79.0,
      "text": "うぃ～～ひっく……"
    },
    {
      "index": 13,
      "start_time": 81.0,
      "end_time": 82.0,
      "text": "……はれぇ？"
    },
    {
      "index": 14,
      "start_time": 82.3,
      "end_time": 84.3,
      "text": "気のせいかなぁ～？"
    },
    {
      "index": 15,
      "start_time": 84.5,
      "end_time": 89.0,
      "text": "空からバラがたくさん落ちてきているよ～な～？"
    },
    {
      "index": 16,
      "start_time": 89.2,
      "end_time": 91.4,
      "text": "へえ～、粋な計らいじゃない"
    },
    {
      "index": 17,
      "start_time": 93.6,
      "end_time": 95.5,
      "text": "……ホワイトクリスマスじゃなくて"
    },
    {
      "index": 18,
      "start_time": 95.7,
      "end_time": 97.0,
      "text": "ローズクリスマスだにゃ！"
    },
    {
      "index": 19,
      "start_time": 97.5,
      "end_time": 98.7,
      "text": "えへへ～！"
    },
    {
      "index": 20,
      "start_time": 99.0,
      "end_time": 102.0,
      "text": "今日はたっくさんお小遣いも稼げたしぃ"
    },
    {
      "index": 21,
      "start_time": 102.3,
      "end_time": 104.5,
      "text": "悪者もやっつけられたしぃ"
    },
    {
      "index": 22,
      "start_time": 105.3,
      "end_time": 110.0,
      "text": "みんなとクリスマスを過ごせてすっごくハッピー！"
    },
    {
      "index": 23,
      "start_time": 112.0,
      "end_time": 114.3,
      "text": "今夜はたっくさん飲むわよ～！"
    },
    {
      "index": 24,
      "start_time": 114.6,
      "end_time": 117.3,
      "text": "しょうがないわね、ユカリさんは"
    },
    {
      "index": 25,
      "start_time": 117.6,
      "end_time": 119.6,
      "text": "今日くらい付き合ってあげるにゃ"
    },
    {
      "index": 26,
      "start_time": 120.6,
      "end_time": 122.0,
      "text": "それじゃ～"
    },
    {
      "index": 27,
      "start_time": 122.2,
      "end_time": 126.2,
      "text": "本日のあたしたちの大健闘と友情を祝して～"
    },
    {
      "index": 28,
      "start_time": 127.0,
      "end_time": 129.0,
      "text": "Cheers!"
    },
    {
      "index": 29,
      "start_time": 135.5,
      "end_time": 137.3,
      "text": "..."
    },
    {
      "index": 30,
      "start_time": 137.7,
      "end_time": 140.7,
      "text": "確かにこれは『お約束』ね……"
    },
    {
      "index": 31,
      "start_time": 141.2,
      "end_time": 143.3,
      "text": "それも『とびっきりの』ですわ！"
    },
    {
      "index": 32,
      "start_time": 143.8,
      "end_time": 145.2,
      "text": "ふふふっ"
    },
    {
      "index": 33,
      "start_time": 154.0,
      "end_time": 155.4,
      "text": "ねえ、アキノさん"
    },
    {
      "index": 34,
      "start_time": 155.6,
      "end_time": 156.6,
      "text": "何ですの？"
    },
    {
      "index": 35,
      "start_time": 157.6,
      "end_time": 160.3,
      "text": "あたし、もうちょっと頑張ってみようと思うの……"
    },
    {
      "index": 36,
      "start_time": 161.6,
      "end_time": 164.0,
      "text": "真っ直ぐ自分の想いを伝える"
    },
    {
      "index": 37,
      "start_time": 164.3,
      "end_time": 166.5,
      "text": "素直なアキノさんみたいにね！"
    },
    {
      "index": 38,
      "start_time": 167.2,
      "end_time": 171.6,
      "text": "ふふ……それなら私も一層励まないといけませんわね"
    },
    {
      "index": 39,
      "start_time": 172.0,
      "end_time": 174.5,
      "text": "信じた相手を信じ抜く"
    },
    {
      "index": 40,
      "start_time": 174.7,
      "end_time": 178.5,
      "text": "そんな強さを持ったサレンさんみたいに、ですわ！"
    },
    {
      "index": 41,
      "start_time": 184.3,
      "end_time": 185.3,
      "text": "Huh...?"
    }
  ],
