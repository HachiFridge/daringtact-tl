      "end_time": 55.0,
      "text": "Gruaaaahhhhh!"
    },
    {
      "index": 13,
      "start_time": 55.2,
      "end_time": 57.2,
      "text": "Kaya-P, that's enough!"
    },
    {
      "index": 14,
      "start_time": 57.3,
      "end_time": 58.3,
      "text": "Ino... ri...?"
    },
    {
      "index": 15,
      "start_time": 58.5,
      "end_time": 60.0,
      "text": "It's all right now!"
    },
    {
      "index": 16,
      "start_time": 60.1,
      "end_time": 61.8,
      "text": "Thanks to you, everyone's safe!"
    },
    {
      "index": 17,
      "start_time": 62.0,
      "end_time": 62.5,
      "text": "So please..."
    },
    {
      "index": 18,
