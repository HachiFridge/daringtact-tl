    {
      "index": 7,
      "start_time": 37.8,
      "end_time": 42.0,
      "text": "The trigger for Kaya's awakening isn't herself, it's her friends!"
    },
    {
      "index": 8,
      "start_time": 42.2,
      "end_time": 44.2,
      "text": "This is the power of the dragonfolk?"
    },
    {
      "index": 9,
      "start_time": 44.4,
      "end_time": 46.0,
      "text": "D-doesn't this look kinda bad?"
    },
    {
