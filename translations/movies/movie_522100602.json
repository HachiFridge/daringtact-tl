{
  "movie_id": 522100602,
  "subtitles": [
    {
      "index": 0,
      "start_time": 2.1,
      "end_time": 3.1,
      "text": "Ahhhh!"
    },
    {
      "index": 1,
      "start_time": 3.3,
      "end_time": 5.6,
      "text": "A herd of Elizabeth's Park cows is on the road!"
    },
    {
      "index": 2,
      "start_time": 7.7,
      "end_time": 9.0,
      "text": "Tah! Toh!"
    },
    {
      "index": 3,
      "start_time": 10.2,
      "end_time": 11.4,
      "text": "Like a graceful dance...!"
    },
    {
      "index": 4,
      "start_time": 12.0,
      "end_time": 15.0,
      "text": "Excuse me, could you let me through?!"
    },
    {
      "index": 5,
      "start_time": 16.8,
      "end_time": 20.6,
      "text": "Hoho... You girls sure are great"
    },
    {
      "index": 6,
      "start_time": 20.8,
      "end_time": 24.0,
      "text": "Pros of turning grass into milk, even"
    },
    {
      "index": 7,
      "start_time": 24.3,
      "end_time": 27.9,
      "text": "Well♪ Everyone has their way of dealing with accidents!"
    },
    {
      "index": 8,
      "start_time": 30.0,
      "end_time": 31.9,
      "text": "They made it through the ranch's area without issue!"
    },
    {
      "index": 9,
      "start_time": 32.1,
      "end_time": 34.4,
      "text": "The race is still going on!"
    },
    {
      "index": 10,
      "start_time": 35.7,
      "end_time": 37.6,
      "text": "(Legend of Astrum~)"
    },
    {
      "index": 11,
      "start_time": 38.6,
      "end_time": 41.7,
      "text": "(Running through the sea, through the sky...)"
    },
    {
      "index": 12,
      "start_time": 42.5,
      "end_time": 43.9,
      "text": "(Goodness, what a ridiculous place~)"
    },
    {
      "index": 13,
      "start_time": 44.1,
      "end_time": 46.8,
      "text": "(Truly a world where anythin' goes)"
    },
    {
      "index": 14,
      "start_time": 48.1,
      "end_time": 50.1,
      "text": "(But no matter who I'm up against...)"
    },
    {
      "index": 15,
      "start_time": 50.3,
      "end_time": 51.9,
      "text": "(No matter what world I'm in...)"
    },
    {
      "index": 16,
      "start_time": 52.1,
      "end_time": 54.2,
      "text": "(Even in a race that could only happen here...)"
    },
    {
      "index": 17,
      "start_time": 54.5,
      "end_time": 56.8,
      "text": "I'm gonna win, no matter what!\"\n\"I'll definitely win!\"\n\"I will win!"
    },
    {
      "index": 18,
      "start_time": 57.1,
      "end_time": 59.9,
      "text": "That's what I'm talking about! You girls are the best!"
    },
    {
      "index": 19,
      "start_time": 60.2,
      "end_time": 64.7,
      "text": "All right! I'm gonna chow down on every last one of you!!"
    },
    {
      "index": 20,
      "start_time": 82.2,
      "end_time": 85.1,
      "text": "DAAAAAAAHHHHHH!!"
    },
    {
      "index": 21,
      "start_time": 86.9,
      "end_time": 89.8,
      "text": "Hahaha!!"
    },
    {
      "index": 22,
      "start_time": 93.1,
      "end_time": 94.5,
      "text": "And now, they've cleared the mountain trail..."
    },
    {
      "index": 23,
      "start_time": 94.7,
      "end_time": 98.7,
      "text": "The racers are now charging into the final section: the Space Area!"
    },
    {
      "index": 24,
      "start_time": 99.1,
      "end_time": 101.9,
      "text": "The glorious finish line is just ahead!"
    },
    {
      "index": 25,
      "start_time": 102.3,
      "end_time": 105.3,
      "text": "Who will claim victory?!"
    },
    {
      "index": 26,
      "start_time": 106.1,
      "end_time": 107.4,
      "text": "...Go"
    },
    {
      "index": 27,
      "start_time": 118.2,
      "end_time": 121.0,
      "text": "AAAAAAAHHHHHHHH...!!!"
    }
