    },
    {
      "index": 3,
      "start_time": 15.6,
      "end_time": 18.5,
      "text": "..."
    },
    {
      "index": 4,
      "start_time": 20.0,
      "end_time": 21.1,
      "text": "?!"
    },
    {
      "index": 5,
      "start_time": 22.5,
      "end_time": 23.2,
      "text": "GRRRRAAAAGHHH!"
    },
    {
      "index": 6,
      "start_time": 23.6,
      "end_time": 24.5,
      "text": "Ahh?!"
    },
    {
      "index": 7,
      "start_time": 26.1,
      "end_time": 27.2,
      "text": "Hoh!"
    },
    {
      "index": 8,
      "start_time": 27.8,
      "end_time": 29.1,
      "text": "GGYYYAAARRGHH!"
    },
    {
      "index": 9,
      "start_time": 29.5,
      "end_time": 30.3,
      "text": "Huh?!"
    },
    {
      "index": 10,
      "start_time": 31.0,
      "end_time": 32.1,
      "text": "Hiyori-chan?!"
    },
    {
      "index": 11,
      "start_time": 32.5,
      "end_time": 33.4,
      "text": "Are you okay?!"
    },
    {
      "index": 12,
      "start_time": 34.5,
      "end_time": 37.5,
      "text": "Ugh, what the hell is going on...!?"
    },
    {
      "index": 13,
      "start_time": 45.5,
      "end_time": 46.4,
      "text": "...!?"
    },
    {
      "index": 14,
      "start_time": 48.0,
      "end_time": 49.2,
      "text": "The fog...!?"
    },
    {
      "index": 15,
      "start_time": 53.5,
      "end_time": 55.0,
      "text": "That wind current..."
    },
    {
      "index": 16,
      "start_time": 55.6,
      "end_time": 57.0,
      "text": "...!"
    },
    {
      "index": 17,
      "start_time": 58.5,
      "end_time": 59.4,
      "text": "Here we are!"
    },
    {
      "index": 18,
      "start_time": 61.0,
      "end_time": 62.6,
      "text": "Everyone! Are you hurt?"
    },
    {
      "index": 19,
      "start_time": 63.1,
      "end_time": 65.2,
      "text": "Ah, it doesn't look like it, does it?"
    },
    {
      "index": 20,
      "start_time": 65.5,
      "end_time": 68.2,
      "text": "Okay, okay! Ahahaha!"
    },
    {
      "index": 21,
      "start_time": 69.3,
      "end_time": 71.1,
      "text": "Did you guys do that?"
    },
    {
      "index": 22,
      "start_time": 71.8,
      "end_time": 73.1,
      "text": "...And if we did?"
    },
    {
      "index": 23,
      "start_time": 73.5,
      "end_time": 76.6,
      "text": "Ah, um... Thank you very much!"
    },
    {
      "index": 24,
      "start_time": 77.5,
      "end_time": 79.4,
      "text": "Ahahaha! It's okay, it's okay!"
    },
    {
      "index": 25,
      "start_time": 79.6,
      "end_time": 80.4,
      "text": "I mean, come on~"
    },
    {
      "index": 26,
      "start_time": 80.6,
      "end_time": 83.2,
      "text": "I scratch your back, you scratch mine!"
    },
    {
      "index": 27,
      "start_time": 83.4,
      "end_time": 84.2,
      "text": "Right?"
    },
    {
      "index": 28,
      "start_time": 84.4,
      "end_time": 85.2,
      "text": "Huh...?"
    },
    {
      "index": 29,
      "start_time": 86.1,
      "end_time": 87.5,
      "text": "...!!"
    },
    {
      "index": 30,
      "start_time": 93.9,
      "end_time": 97.4,
      "text": "...I'll take care of this. Everyone stay back."
    },
    {
      "index": 31,
      "start_time": 98.6,
      "end_time": 100.3,
      "text": "B-But..."
    },
    {
      "index": 32,
      "start_time": 101.1,
      "end_time": 102.4,
      "text": "It's all right, it's all right!"
    },
    {
      "index": 33,
      "start_time": 103.0,
      "end_time": 106.1,
      "text": "I think you've probably figured it out by now:"
    },
    {
      "index": 34,
      "start_time": 107.0,
      "end_time": 108.6,
      "text": "But we're pretty strong♪"
    },
    {
      "index": 35,
      "start_time": 109.4,
      "end_time": 112.0,
      "text": "Now then, let's get this over with!"
    },
    {
      "index": 36,
      "start_time": 112.4,
      "end_time": 116.1,
      "text": "All right! It's time for your big sisters to get going!"
    },
    {
      "index": 37,
      "start_time": 116.3,
      "end_time": 117.3,
      "text": "Nihi♪"
    }
  ],
