{
  "movie_id": 512200201,
  "subtitles": [
    {
      "index": 0,
      "start_time": 12.2,
      "end_time": 14.5,
      "text": "Yukari-san! Suppress that..."
    },
    {
      "index": 1,
      "start_time": 15.0,
      "end_time": 18.2,
      "text": "Wait, Yukari-san? She's not here?!"
    },
    {
      "index": 2,
      "start_time": 18.5,
      "end_time": 19.9,
      "text": "At such an important moment..."
    },
    {
      "index": 3,
      "start_time": 20.1,
      "end_time": 21.1,
      "text": "EEEK!"
    },
    {
      "index": 4,
      "start_time": 26.2,
      "end_time": 29.3,
      "text": "At this rate......\nsomeone's gonna get hurt......!"
    },
    {
      "index": 5,
      "start_time": 29.5,
      "end_time": 32.5,
      "text": "Even if I want to get rid of the jamming, I'll start with this!"
    },
    {
      "index": 6,
      "start_time": 32.7,
      "end_time": 36.2,
      "text": "If I don't hold back the rampaging hose..."
    },
    {
      "index": 7,
      "start_time": 36.6,
      "end_time": 38.3,
      "text": "Guaah!"
    },
    {
      "index": 8,
      "start_time": 48.3,
      "end_time": 50.6,
      "text": "We are completely lacking in manpower..."
    },
    {
      "index": 9,
      "start_time": 51.1,
      "end_time": 53.9,
      "text": "Everyone, you're worthless!"
    },
    {
      "index": 10,
      "start_time": 54.1,
      "end_time": 56.9,
      "text": "Now that it's come to this, I can't do it alone...!"
    },
    {
      "index": 11,
      "start_time": 57.1,
      "end_time": 58.1,
      "text": "Let me help you"
    },
    {
      "index": 12,
      "start_time": 58.3,
      "end_time": 59.2,
      "text": "...!"
    },
    {
      "index": 13,
      "start_time": 59.4,
      "end_time": 60.6,
      "text": "Neneka-san!"
    },
    {
      "index": 14,
      "start_time": 61.0,
      "end_time": 62.2,
      "text": "...A lot!?"
    },
    {
      "index": 15,
      "start_time": 63.3,
      "end_time": 64.5,
      "text": "Neneka-sama?!"
    },
    {
      "index": 16,
      "start_time": 64.7,
      "end_time": 67.1,
      "text": "If it's like this, it's better to help with draining the water."
    },
    {
      "index": 17,
      "start_time": 67.3,
      "end_time": 71.6,
      "text": "It is a good idea to retrieve my own secrets before anyone else does."
    },
    {
      "index": 18,
      "start_time": 72.1,
      "end_time": 74.5,
      "text": "──！That's my master for you!"
    },
    {
      "index": 19,
      "start_time": 75.2,
      "end_time": 77.4,
      "text": "I've been waiting for you!"
    },
    {
      "index": 20,
      "start_time": 81.0,
      "end_time": 83.6,
      "text": "Okay, I suppressed it! Now!"
    },
    {
      "index": 21,
      "start_time": 84.2,
      "end_time": 85.7,
      "text": "The affected area is..."
    },
    {
      "index": 22,
      "start_time": 88.3,
      "end_time": 90.1,
      "text": "Here it is!"
    },
    {
      "index": 23,
      "start_time": 90.6,
      "end_time": 93.2,
      "text": "H-H-Hold on!"
    },
    {
      "index": 24,
      "start_time": 93.6,
      "end_time": 94.5,
      "text": "?!"
    },
    {
      "index": 25,
      "start_time": 101.1,
      "end_time": 103.7,
      "text": "*Haaa* *Haaa*..."
    },
    {
      "index": 26,
      "start_time": 104.3,
      "end_time": 106.6,
      "text": "I accidentally got sucked in..."
    },
    {
      "index": 27,
      "start_time": 106.8,
      "end_time": 108.2,
      "text": "I'm sorry..."
    },
    {
      "index": 28,
      "start_time": 108.5,
      "end_time": 110.3,
      "text": "A-Are you okay?!"
    },
    {
      "index": 29,
      "start_time": 110.5,
      "end_time": 113.3,
      "text": "Didn't you just drink the seawater?"
    },
    {
      "index": 30,
      "start_time": 113.6,
      "end_time": 116.5,
      "text": "Ugh... I-It hurts..."
    },
    {
      "index": 31,
      "start_time": 117.1,
      "end_time": 119.6,
      "text": "Hm? ...I'm fine"
    },
    {
      "index": 32,
      "start_time": 120.1,
      "end_time": 123.3,
      "text": "I'm used to drinking things that aren't water..."
    },
    {
      "index": 33,
      "start_time": 123.6,
      "end_time": 125.5,
      "text": "Oh, I'm totally fine"
    },
    {
      "index": 34,
      "start_time": 135.1,
      "end_time": 136.0,
      "text": "Let's pull it out!"
    },
    {
      "index": 35,
      "start_time": 136.3,
      "end_time": 138.5,
      "text": "...!"
    },
    {
      "index": 36,
      "start_time": 148.1,
      "end_time": 150.1,
      "text": "Let's get back on track!"
    },
    {
      "index": 37,
      "start_time": 150.4,
      "end_time": 151.6,
      "text": "Ohhh!"
    },
    {
      "index": 38,
      "start_time": 152.0,
      "end_time": 153.1,
      "text": "Water of the sea!"
    },
    {
      "index": 39,
      "start_time": 153.5,
      "end_time": 154.9,
      "text": "Pull it out!"
    },
    {
      "index": 40,
      "start_time": 155.2,
      "end_time": 156.3,
      "text": "All of it!"
    },
    {
      "index": 41,
      "start_time": 156.6,
      "end_time": 158.6,
      "text": "Pull it out!"
    }
  ],
