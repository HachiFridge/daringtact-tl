  "subtitles": [
    {
      "index": 0,
      "start_time": 0.3,
      "end_time": 2.5,
      "text": "──Graaaaahhh!"
    },
    {
      "index": 1,
      "start_time": 6.5,
      "end_time": 11.3,
      "text": "Illya. Show me the beauty of the legendary vampire"
    },
    {
      "index": 2,
      "start_time": 11.6,
      "end_time": 14.5,
      "text": "Well, I don't think he's a match for me"
    },
    {
      "index": 3,
      "start_time": 15.0,
      "end_time": 17.6,
      "text": "You're always so cheeky"
    },
    {
      "index": 4,
      "start_time": 18.2,
      "end_time": 20.1,
      "text": "...Heh. Very well"
    },
    {
      "index": 5,
      "start_time": 20.5,
      "end_time": 23.6,
      "text": "Let's captivate those eyes, Yuki"
    },
    {
      "index": 6,
      "start_time": 28.1,
      "end_time": 31.2,
      "text": "This pounding in my chest that you give me..."
    },
    {
      "index": 7,
      "start_time": 31.6,
      "end_time": 34.4,
      "text": "This is also my true power"
    },
    {
      "index": 8,
      "start_time": 35.3,
      "end_time": 38.3,
      "text": "Behold my true power"
    },
    {
      "index": 9,
      "start_time": 39.1,
      "end_time": 40.0,
      "text": "Yeah..."
    },
    {
      "index": 10,
      "start_time": 47.0,
      "end_time": 48.6,
      "text": "You said it yourself"
    },
    {
      "index": 11,
      "start_time": 49.5,
      "end_time": 52.6,
      "text": "She wanted to experience the legend with her own body"
    },
    {
      "index": 12,
      "start_time": 53.4,
      "end_time": 55.2,
      "text": "The ruler of the night ⁇"
    },
    {
      "index": 13,
      "start_time": 55.4,
      "end_time": 59.6,
      "text": "Illya Ornstein will grant your wish"
    },
    {
      "index": 14,
      "start_time": 67.2,
      "end_time": 68.1,
      "text": "?!"
    },
    {
      "index": 15,
      "start_time": 68.5,
      "end_time": 70.6,
      "text": "Hmm... It's beautiful"
    },
    {
      "index": 16,
      "start_time": 71.5,
      "end_time": 73.7,
      "text": "Know as much as you want"
    },
    {
      "index": 17,
      "start_time": 80.5,
      "end_time": 84.6,
      "text": "Oh... So this is the legend...!"
    },
    {
      "index": 18,
      "start_time": 95.1,
      "end_time": 96.1,
      "text": "Heheh..."
    },
    {
      "index": 19,
      "start_time": 96.3,
      "end_time": 98.6,
      "text": "HAAHAHAHAHA!"
    },
    {
      "index": 20,
