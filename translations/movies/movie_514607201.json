{
  "movie_id": 514607201,
  "subtitles": [
    {
      "index": 0,
      "start_time": 0.2,
      "end_time": 6.9,
      "text": "小さい頃におじいはんから聞かせてもろた伝説の羊はんのお話"
    },
    {
      "index": 1,
      "start_time": 7.6,
      "end_time": 10.7,
      "text": "その羊はんに会いに行くため"
    },
    {
      "index": 2,
      "start_time": 11.1,
      "end_time": 14.1,
      "text": "アヤネはんとぷうきちはんと一緒に"
    },
    {
      "index": 3,
      "start_time": 14.7,
      "end_time": 20.0,
      "text": "世界の果てを目指す冒険に出発したんよ"
    },
    {
      "index": 4,
      "start_time": 21.0,
      "end_time": 25.7,
      "text": "冒険の末たどり着いた最果ての大樹の上に"
    },
    {
      "index": 5,
      "start_time": 26.0,
      "end_time": 29.4,
      "text": "その羊はん──バロメッツはんはおった"
    },
    {
      "index": 6,
      "start_time": 30.0,
      "end_time": 35.9,
      "text": "ほんまはとっても穏やかで優しい羊はんなんやけど"
    },
    {
      "index": 7,
      "start_time": 36.8,
      "end_time": 43.2,
      "text": "少し悲しいことがあって……気ぃが立ってしもてたなぁ"
    },
    {
      "index": 8,
      "start_time": 44.7,
      "end_time": 47.2,
      "text": "そやけど落ち着いてからは"
    },
    {
      "index": 9,
      "start_time": 47.5,
      "end_time": 51.9,
      "text": "元の素直でかいらしいもこもこのバロメッツはんに"
    },
    {
      "index": 10,
      "start_time": 52.1,
      "end_time": 54.3,
      "text": "戻ってくれはった♪"
    },
    {
      "index": 11,
      "start_time": 54.9,
      "end_time": 59.2,
      "text": "その後、冒険の旅に出たバロメッツはんと"
    },
    {
      "index": 12,
      "start_time": 59.5,
      "end_time": 62.3,
      "text": "こうやって再会できたけど"
    },
    {
      "index": 13,
      "start_time": 62.9,
      "end_time": 66.3,
      "text": "なんやとってもたくましくなってはって……"
    },
    {
      "index": 14,
      "start_time": 67.8,
      "end_time": 73.0,
      "text": "男の子の成長には、ほんまにびっくりさせられてまうね～♪"
    }
  ],
