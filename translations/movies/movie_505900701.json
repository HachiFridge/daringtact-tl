{
  "movie_id": 505900701,
  "subtitles": [
    {
      "index": 0,
      "start_time": 1.0,
      "end_time": 4.8,
      "text": "Start with a low flame,\nthen turn the heat up♪"
    },
    {
      "index": 1,
      "start_time": 5.6,
      "end_time": 7.2,
      "text": "Even if your baby cries..."
    },
    {
      "index": 2,
      "start_time": 7.8,
      "end_time": 10.8,
      "text": "Oh, you've awoken, I see."
    },
    {
      "index": 3,
      "start_time": 12.0,
      "end_time": 13.6,
      "text": "...Kokkoro."
    },
    {
      "index": 4,
      "start_time": 15.0,
      "end_time": 18.0,
      "text": "Yes, I am Kokkoro, my Lord."
    },
    {
      "index": 5,
      "start_time": 19.8,
      "end_time": 20.8,
      "text": "... Huh?"
    },
    {
      "index": 6,
      "start_time": 21.0,
      "end_time": 23.0,
      "text": "Um..."
    },
    {
      "index": 7,
      "start_time": 25.0,
      "end_time": 26.0,
      "text": "?"
    },
    {
      "index": 8,
      "start_time": 30.0,
      "end_time": 32.0,
      "text": "I'm... hungry."
    },
    {
      "index": 9,
      "start_time": 33.0,
      "end_time": 36.0,
      "text": "Ah, I thought you would say that, so..."
    },
    {
      "index": 10,
      "start_time": 36.2,
      "end_time": 38.0,
      "text": "I've prepared a meal."
    },
    {
      "index": 11,
      "start_time": 39.0,
      "end_time": 40.8,
      "text": "But no, not that!"
    },
    {
      "index": 12,
      "start_time": 41.0,
      "end_time": 43.0,
      "text": "C-Could it be that, you remember...!?"
    },
    {
      "index": 13,
      "start_time": 43.4,
      "end_time": 44.8,
      "text": "*tired cat noises*"
    },
    {
      "index": 14,
      "start_time": 45.0,
      "end_time": 49.0,
      "text": "You guys are so loud... *yawn*"
    },
    {
      "index": 15,
      "start_time": 49.8,
      "end_time": 51.4,
      "text": "Morning, Korosuke."
    },
    {
      "index": 16,
      "start_time": 53.0,
      "end_time": 54.8,
      "text": "Miss Kyaru, just now you..."
    },
    {
      "index": 17,
      "start_time": 55.0,
      "end_time": 57.0,
      "text": "*yawn*"
    },
    {
      "index": 18,
      "start_time": 57.6,
      "end_time": 59.0,
      "text": "Good morning..."
    },
    {
      "index": 19,
      "start_time": 59.8,
      "end_time": 60.8,
      "text": "*Sniff*, *sniff*..."
    },
    {
      "index": 20,
      "start_time": 61.0,
      "end_time": 64.8,
      "text": "Ah, this is... the smell of freshly cooked\nrice!"
    },
    {
      "index": 21,
      "start_time": 65.2,
      "end_time": 66.4,
      "text": "Kokkoro!"
    },
    {
      "index": 22,
      "start_time": 67.8,
      "end_time": 68.8,
      "text": "...!"
    },
    {
      "index": 23,
      "start_time": 69.0,
      "end_time": 71.0,
      "text": "Thank you very much, as always!"
    },
    {
      "index": 24,
      "start_time": 71.2,
      "end_time": 73.0,
      "text": "*Squeeze*♪"
    },
    {
      "index": 25,
      "start_time": 76.0,
      "end_time": 78.4,
      "text": "..."
    },
    {
      "index": 26,
      "start_time": 78.8,
      "end_time": 79.8,
      "text": "Kokkoro...?"
    },
    {
      "index": 27,
      "start_time": 80.0,
      "end_time": 81.2,
      "text": "Korosuke...?"
    },
    {
      "index": 28,
      "start_time": 82.8,
      "end_time": 87.0,
      "text": "You all... know who I am...?"
    },
    {
      "index": 29,
      "start_time": 88.0,
      "end_time": 90.0,
      "text": "What're you saying?"
    },
    {
      "index": 30,
      "start_time": 91.0,
      "end_time": 93.0,
      "text": "Of course we do."
    },
    {
      "index": 31,
      "start_time": 94.0,
      "end_time": 98.0,
      "text": "No matter what happens, I... We..."
    },
    {
      "index": 32,
      "start_time": 98.6,
      "end_time": 101.0,
      "text": "Wouldn't let go of the bonds we have here."
    },
    {
      "index": 33,
      "start_time": 101.8,
      "end_time": 103.4,
      "text": "...No matter what."
    },
    {
      "index": 34,
      "start_time": 104.8,
      "end_time": 109.0,
      "text": "Miss Pecorine, Miss Kyaru..."
    },
    {
      "index": 35,
      "start_time": 112.6,
      "end_time": 114.0,
      "text": "Kokkoro!"
    },
    {
      "index": 36,
      "start_time": 116.8,
      "end_time": 117.8,
      "text": "Head."
    },
    {
      "index": 37,
      "start_time": 118.8,
      "end_time": 121.2,
      "text": "T-This is..."
    },
    {
      "index": 38,
      "start_time": 123.0,
      "end_time": 126.0,
      "text": "You forgot it, your hair accessory."
    },
    {
      "index": 39,
      "start_time": 135.0,
      "end_time": 140.0,
      "text": "My Lord... Kokkoro... Kokkoro..."
    },
    {
      "index": 40,
      "start_time": 153.4,
      "end_time": 156.0,
      "text": "Has returned home...!"
    },
    {
      "index": 41,
      "start_time": 158.0,
      "end_time": 161.0,
      "text": "Welcome back, Kokkoro."
    }
  ],
