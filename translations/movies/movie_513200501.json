{
  "movie_id": 513200501,
  "subtitles": [
    {
      "index": 0,
      "start_time": 4.9,
      "end_time": 7.2,
      "text": "I-If you're coming, then come!"
    },
    {
      "index": 1,
      "start_time": 7.6,
      "end_time": 12.2,
      "text": "Catch the stars or whatever..."
    },
    {
      "index": 2,
      "start_time": 14.3,
      "end_time": 16.5,
      "text": "..."
    },
    {
      "index": 3,
      "start_time": 19.3,
      "end_time": 20.6,
      "text": "Eeeeeeeek!!"
    },
    {
      "index": 4,
      "start_time": 21.2,
      "end_time": 23.8,
      "text": "Creditta! Don't worry, okay?☆"
    },
    {
      "index": 5,
      "start_time": 24.2,
      "end_time": 25.4,
      "text": "You can do it, you can do it!"
    },
    {
      "index": 6,
      "start_time": 26.1,
      "end_time": 29.4,
      "text": "You can't catch it, can you? This is tough."
    },
    {
      "index": 7,
      "start_time": 29.8,
      "end_time": 31.5,
      "text": "Shut up, outfielder!!"
    },
    {
      "index": 8,
      "start_time": 32.2,
      "end_time": 36.3,
      "text": "Watch, this time I'll definitely catch you..."
    },
    {
      "index": 9,
      "start_time": 36.6,
      "end_time": 38.2,
      "text": "..."
    },
    {
      "index": 10,
      "start_time": 38.6,
      "end_time": 40.3,
      "text": "Eek! Eeeeeek!"
    },
    {
      "index": 11,
      "start_time": 40.5,
      "end_time": 43.3,
      "text": "Impossible, impossible, impossible! I'm going to die!"
    },
    {
      "index": 12,
      "start_time": 43.5,
      "end_time": 45.1,
      "text": "Ah! There's a big star!"
    },
    {
      "index": 13,
      "start_time": 45.6,
      "end_time": 46.6,
      "text": "..."
    },
    {
      "index": 14,
      "start_time": 49.0,
      "end_time": 52.5,
      "text": "Wow... There's no way I can catch something like that..."
    },
    {
      "index": 15,
      "start_time": 52.6,
      "end_time": 56.0,
      "text": "Please rest assured.\nWe are already enrolled in workers compensation."
    },
    {
      "index": 16,
      "start_time": 56.2,
      "end_time": 60.0,
      "text": "You, huh...?! I'll remember this later!!"
    },
    {
      "index": 17,
      "start_time": 67.1,
      "end_time": 69.3,
      "text": "...Ngh..."
    },
    {
      "index": 18,
      "start_time": 69.9,
      "end_time": 71.0,
      "text": "Ugh..."
    },
    {
      "index": 19,
      "start_time": 71.5,
      "end_time": 74.5,
      "text": "I-I am Her Majesty's most loyal retainer...!"
    },
    {
      "index": 20,
      "start_time": 75.5,
      "end_time": 77.5,
      "text": "One star... two stars... three stars..."
    },
    {
      "index": 21,
      "start_time": 79.6,
      "end_time": 83.2,
      "text": "I'll catch them with all my might!!"
    },
    {
      "index": 22,
      "start_time": 83.4,
      "end_time": 84.4,
      "text": "...!!"
    },
    {
      "index": 23,
      "start_time": 85.0,
      "end_time": 87.2,
      "text": "Daaaaahhhh! Bagaragobugebe!!"
    },
    {
      "index": 24,
      "start_time": 88.2,
      "end_time": 89.0,
      "text": "Ahh!"
    },
    {
      "index": 25,
      "start_time": 91.1,
      "end_time": 92.2,
      "text": "Credittaaa!!"
    },
    {
      "index": 26,
      "start_time": 92.4,
      "end_time": 93.3,
      "text": "Are you okay?!"
    },
    {
      "index": 27,
      "start_time": 94.9,
      "end_time": 97.0,
      "text": "Miss... Creditta...?"
    },
    {
      "index": 28,
      "start_time": 97.2,
      "end_time": 99.6,
      "text": "Oh no... Creditta..."
    },
    {
      "index": 29,
      "start_time": 100.3,
      "end_time": 102.5,
      "text": "I wonder if the life insurance will pay out..."
    },
    {
      "index": 30,
      "start_time": 103.1,
      "end_time": 105.5,
      "text": "I won't let you kill me without permission!"
    },
    {
      "index": 31,
      "start_time": 106.4,
      "end_time": 107.6,
      "text": "I'm so glad you're safe..."
    },
    {
      "index": 32,
      "start_time": 108.1,
      "end_time": 111.3,
      "text": "Thank you for your hard work.\nYou're as sturdy as ever, aren't you?"
    },
    {
      "index": 33,
      "start_time": 111.5,
      "end_time": 114.4,
      "text": "I-I swear, you really have some nerve..."
    },
    {
      "index": 34,
      "start_time": 114.6,
      "end_time": 117.1,
      "text": "And, how was the crucial star?"
    },
    {
      "index": 35,
      "start_time": 117.5,
      "end_time": 120.2,
      "text": "Hmph. Tell me after you see this"
    },
    {
      "index": 36,
      "start_time": 120.6,
      "end_time": 122.0,
      "text": "...!!"
    },
    {
      "index": 37,
      "start_time": 125.1,
      "end_time": 126.4,
      "text": "Eheh~"
    }
  ],
