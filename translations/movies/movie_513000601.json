      "text": "This..."
    },
    {
      "index": 4,
      "start_time": 28.5,
      "end_time": 30.1,
      "text": "Love..."
    },
    {
      "index": 5,
      "start_time": 30.6,
      "end_time": 31.6,
      "text": "It won't disappear."
    },
    {
      "index": 6,
      "start_time": 40.4,
      "end_time": 41.4,
      "text": "...!"
    },
    {
      "index": 7,
