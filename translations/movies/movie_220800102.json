{
  "movie_id": 220800102,
  "subtitles": [
    {
      "index": 0,
      "start_time": 4.0,
      "end_time": 6.3,
      "text": "Knight-saaan!"
    },
    {
      "index": 1,
      "start_time": 9.6,
      "end_time": 12.0,
      "text": "Knight-san!"
    },
    {
      "index": 2,
      "start_time": 12.5,
      "end_time": 13.6,
      "text": "That's...!"
    },
    {
      "index": 3,
      "start_time": 13.8,
      "end_time": 14.8,
      "text": "Intruder──!"
    },
    {
      "index": 4,
      "start_time": 15.3,
      "end_time": 15.7,
      "text": "Huh?!"
    },
    {
      "index": 5,
      "start_time": 16.1,
      "end_time": 17.2,
      "text": "Just wait──"
    },
    {
      "index": 6,
      "start_time": 22.8,
      "end_time": 23.5,
      "text": "Ahh!"
    },
    {
      "index": 7,
      "start_time": 27.3,
      "end_time": 31.5,
      "text": "Knight-saaaaan!!!"
    },
    {
      "index": 8,
      "start_time": 42.3,
      "end_time": 43.5,
      "text": "Ahahaha♪"
    },
    {
      "index": 9,
      "start_time": 43.8,
      "end_time": 45.5,
      "text": "It's been a while, Knight-san♪"
    },
    {
      "index": 10,
      "start_time": 48.5,
      "end_time": 49.3,
      "text": "Hmm?"
    },
    {
      "index": 11,
      "start_time": 51.5,
      "end_time": 55.5,
      "text": "Unauthorized entry,\npreemptive attack.──Retaliating."
    },
    {
      "index": 12,
      "start_time": 56.0,
      "end_time": 56.8,
      "text": "W-Wait a minute!"
    },
    {
      "index": 13,
      "start_time": 57.0,
      "end_time": 58.4,
      "text": "No, she's not an enemy...!"
    },
    {
      "index": 14,
      "start_time": 58.6,
      "end_time": 60.2,
      "text": "Fufufufu"
    },
    {
      "index": 15,
      "start_time": 60.5,
      "end_time": 61.4,
      "text": "?!"
    },
    {
      "index": 16,
      "start_time": 62.2,
      "end_time": 68.0,
      "text": "Once more, we find ourselves in company of delightful guests."
    },
    {
      "index": 17,
      "start_time": 69.6,
      "end_time": 71.1,
      "text": "Right?"
    },
    {
      "index": 18,
      "start_time": 71.3,
      "end_time": 74.1,
      "text": "──Princess of Gio Teogonia."
    },
    {
      "index": 19,
      "start_time": 77.0,
      "end_time": 79.7,
      "text": "Please pardon my chevalier's rudeness."
    },
    {
      "index": 20,
      "start_time": 84.5,
      "end_time": 87.6,
      "text": "Nice to meet you.\nPrincess of Gio Gehenna."
    },
    {
      "index": 21,
      "start_time": 88.5,
      "end_time": 89.5,
      "text": "And also..."
    },
    {
      "index": 22,
      "start_time": 90.2,
      "end_time": 94.0,
      "text": "It's been a while, Sir Knight, everyone."
    }
  ],
