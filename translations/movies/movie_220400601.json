  "subtitles": [
    {
      "index": 0,
      "start_time": 0.5,
      "end_time": 2.8,
      "text": "Piーgyuuuーー!"
    },
    {
      "index": 1,
      "start_time": 3.0,
      "end_time": 5.2,
      "text": "Pigyu pigyu pigyu pigyu pigyuー!"
    },
    {
      "index": 2,
      "start_time": 5.5,
      "end_time": 6.2,
      "text": "Hey!"
    },
    {
      "index": 3,
      "start_time": 7.2,
      "end_time": 11.3,
      "text": "Pigyu gyu gyu gyu pigyuu～!!"
    },
    {
      "index": 4,
      "start_time": 14.5,
      "end_time": 16.1,
      "text": "Pigyu, Pigyuーー"
    },
    {
      "index": 5,
      "start_time": 16.9,
      "end_time": 18.4,
      "text": "Pigyu~?"
    },
    {
      "index": 6,
      "start_time": 19.1,
      "end_time": 21.0,
      "text": "We're here!"
    },
    {
      "index": 7,
      "start_time": 30.1,
      "end_time": 31.8,
      "text": "How do I say this..."
    },
    {
      "index": 8,
      "start_time": 32.0,
      "end_time": 35.5,
      "text": "This atmosphere is neither Landosol nor 『Gio Teogonia』..."
    },
    {
      "index": 9,
      "start_time": 35.7,
      "end_time": 39.1,
      "text": "...What kind of delicious food is there in this world?"
    },
    {
      "index": 10,
      "start_time": 39.5,
      "end_time": 40.3,
      "text": "*Sniff*, *sniff*..."
    },
    {
      "index": 11,
      "start_time": 40.5,
      "end_time": 41.2,
      "text": "?"
    },
    {
      "index": 12,
      "start_time": 41.6,
      "end_time": 44.4,
      "text": "Precia-chan, did you smell any monsters nearby?"
    },
    {
      "index": 13,
      "start_time": 44.6,
      "end_time": 47.0,
      "text": "Mmm, many."
    },
    {
      "index": 14,
      "start_time": 47.3,
      "end_time": 49.0,
      "text": "Wh-Where are they coming from?"
    },
    {
      "index": 15,
      "start_time": 49.2,
      "end_time": 54.3,
      "text": "...Over there... and over here... and they smell strong"
    },
    {
      "index": 16,
      "start_time": 54.6,
      "end_time": 57.2,
      "text": "Also... burnt smell"
    },
    {
      "index": 17,
      "start_time": 60.6,
      "end_time": 61.3,
      "text": "Shaaaahー"
    },
    {
      "index": 18,
      "start_time": 61.5,
      "end_time": 63.3,
      "text": "Ahh?!"
    },
    {
      "index": 19,
      "start_time": 63.4,
      "end_time": 64.4,
      "text": "Piiiiiiii～!"
    },
    {
      "index": 20,
      "start_time": 65.1,
      "end_time": 66.1,
      "text": "Onigiri-chan!?"
    },
    {
      "index": 21,
      "start_time": 66.3,
      "end_time": 68.5,
      "text": "Don't you dare run off by yourself!"
    },
    {
      "index": 22,
      "start_time": 68.8,
      "end_time": 70.9,
      "text": "Pigyu~!"
    },
    {
      "index": 23,
      "start_time": 71.2,
      "end_time": 72.5,
      "text": "Please wait!"
    },
    {
      "index": 24,
