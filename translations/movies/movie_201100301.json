  "subtitles": [
    {
      "index": 0,
      "start_time": 6.1,
      "end_time": 6.9,
      "text": "*sigh*..."
    },
    {
      "index": 1,
      "start_time": 7.5,
      "end_time": 10.2,
      "text": "It seems she has no intention of letting us pass."
    },
    {
      "index": 2,
      "start_time": 10.6,
      "end_time": 12.3,
      "text": "As I have said all along."
    },
    {
      "index": 3,
      "start_time": 13.1,
      "end_time": 14.8,
      "text": "In that case, you leave us no choice."
    },
    {
      "index": 4,
      "start_time": 15.7,
      "end_time": 18.7,
      "text": "My lord! Lend me the strength of your ability!"
    },
    {
      "index": 5,
      "start_time": 19.4,
      "end_time": 20.8,
      "text": "We will bypass this foe with force!"
    },
    {
      "index": 6,
      "start_time": 21.0,
      "end_time": 22.9,
      "text": "I'm afraid that won't be possible."
    },
    {
      "index": 7,
      "start_time": 23.1,
      "end_time": 24.0,
      "text": "My lord!"
    },
    {
      "index": 8,
      "start_time": 26.8,
      "end_time": 27.2,
      "text": "...!"
    },
    {
      "index": 9,
      "start_time": 27.5,
      "end_time": 28.4,
      "text": "My lord!"
    },
    {
      "index": 10,
      "start_time": 28.8,
      "end_time": 31.1,
      "text": "Perhaps I should have severed his neck?"
    },
    {
      "index": 11,
      "start_time": 32.7,
      "end_time": 34.4,
      "text": "I really am too soft sometimes..."
    },
    {
      "index": 12,
      "start_time": 37.2,
      "end_time": 39.4,
      "text": "For this, I will never forgive you!"
    },
    {
      "index": 13,
      "start_time": 39.9,
      "end_time": 43.6,
      "text": "If you would strike down my lord, I must eliminate you myself!"
    },
    {
      "index": 14,
      "start_time": 44.1,
      "end_time": 45.3,
      "text": "You, defeat me?"
    },
    {
      "index": 15,
      "start_time": 45.7,
      "end_time": 46.7,
      "text": "Learn a little more respect"
    },
    {
      "index": 16,
      "start_time": 47.0,
      "end_time": 49.5,
      "text": "for the strength of Nightmare."
    }
  ],
