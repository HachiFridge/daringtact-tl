{
  "movie_id": 521700701,
  "subtitles": [
    {
      "index": 0,
      "start_time": 3.8,
      "end_time": 6.0,
      "text": "Please, do not let sadness envelop you~"
    },
    {
      "index": 1,
      "start_time": 6.2,
      "end_time": 9.1,
      "text": "Just as I've been saved by everyone..."
    },
    {
      "index": 2,
      "start_time": 9.3,
      "end_time": 11.5,
      "text": "We'll save you. Definitely...!"
    },
    {
      "index": 3,
      "start_time": 13.5,
      "end_time": 15.2,
      "text": "Aaaaahhh...!"
    },
    {
      "index": 4,
      "start_time": 21.0,
      "end_time": 22.0,
      "text": "...!"
    },
    {
      "index": 5,
      "start_time": 31.8,
      "end_time": 34.1,
      "text": "My days of adventuring with Nii-sama and the others..."
    },
    {
      "index": 6,
      "start_time": 34.4,
      "end_time": 37.5,
      "text": "They were an irreplaceable, brilliant time"
    },
    {
      "index": 7,
      "start_time": 38.1,
      "end_time": 42.4,
      "text": "No matter how difficult things get... that brilliance will never fade"
    },
    {
      "index": 8,
      "start_time": 43.5,
      "end_time": 44.4,
      "text": "So"
    },
    {
      "index": 9,
      "start_time": 44.7,
      "end_time": 48.5,
      "text": "It's okay. Everyone. Together――"
    },
    {
      "index": 10,
      "start_time": 49.4,
      "end_time": 50.9,
      "text": "LET'S GO HOME! RETURN HOME!"
    },
    {
      "index": 11,
      "start_time": 54.0,
      "end_time": 55.0,
      "text": "...!"
    },
    {
      "index": 12,
      "start_time": 60.6,
      "end_time": 65.2,
      "text": "HAAAAAAAAH...!!"
    }
  ],
