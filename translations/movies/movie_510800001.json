{
  "movie_id": 510800001,
  "subtitles": [
    {
      "index": 0,
      "start_time": 1.4,
      "end_time": 4.4,
      "text": "ふふ。きれいなものね"
    },
    {
      "index": 1,
      "start_time": 5.5,
      "end_time": 8.6,
      "text": "ええ。気が引き締まりますね"
    },
    {
      "index": 2,
      "start_time": 9.5,
      "end_time": 14.3,
      "text": "大人同士でお着替えするっていうのもなんだか楽しいな～♪"
    },
    {
      "index": 3,
      "start_time": 18.2,
      "end_time": 19.8,
      "text": "入ってきていいよー♪"
    },
    {
      "index": 4,
      "start_time": 21.1,
      "end_time": 22.2,
      "text": "失礼します"
    },
    {
      "index": 5,
      "start_time": 39.1,
      "end_time": 40.2,
      "text": "どう～？"
    },
    {
      "index": 6,
      "start_time": 40.6,
      "end_time": 42.6,
      "text": "３人ともよく似合ってるよ"
    },
    {
      "index": 7,
      "start_time": 43.2,
      "end_time": 44.5,
      "text": "うれしいな～"
    },
    {
      "index": 8,
      "start_time": 46.9,
      "end_time": 51.0,
      "text": "でも、３人一緒くたに褒めるのはね～？"
    },
    {
      "index": 9,
      "start_time": 52.2,
      "end_time": 53.4,
      "text": "……そうねぇ"
    },
    {
      "index": 10,
      "start_time": 54.5,
      "end_time": 59.7,
      "text": "もっと細かいところまで見てほしいのが、女心ってものよ？"
    },
    {
      "index": 11,
      "start_time": 61.3,
      "end_time": 62.5,
      "text": "あらあら……！"
    },
    {
      "index": 12,
      "start_time": 63.3,
      "end_time": 68.1,
      "text": "二人とも、彼にはまだそういうのは早いですからねっ"
    },
    {
      "index": 13,
      "start_time": 69.0,
      "end_time": 70.4,
      "text": "こっちにいらっしゃい"
    },
    {
      "index": 14,
      "start_time": 72.5,
      "end_time": 75.5,
      "text": "ちょっと、今細かいところの話をしてるんでしょ"
    },
    {
      "index": 15,
      "start_time": 75.7,
      "end_time": 77.3,
      "text": "も～ダメ"
    },
    {
      "index": 16,
      "start_time": 79.0,
      "end_time": 80.2,
      "text": "?!"
    },
    {
      "index": 17,
      "start_time": 80.6,
      "end_time": 81.6,
      "text": "さーて"
    },
    {
      "index": 18,
      "start_time": 82.0,
      "end_time": 86.0,
      "text": "いたいけな男の子をからかうのはここまでにしておこっか"
    },
    {
      "index": 19,
      "start_time": 86.5,
      "end_time": 89.3,
      "text": "そうね。続きはまた今度にしましょ"
    },
    {
      "index": 20,
      "start_time": 90.1,
      "end_time": 93.1,
      "text": "温泉旅館で働くなんて初めてだわ"
    },
    {
      "index": 21,
      "start_time": 93.3,
      "end_time": 95.5,
      "text": "なんだか楽しくなってきちゃった"
    }
  ],
