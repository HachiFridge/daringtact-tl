{
  "movie_id": 507400601,
  "subtitles": [
    {
      "index": 0,
      "start_time": 5.0,
      "end_time": 5.6,
      "text": "...!"
    },
    {
      "index": 1,
      "start_time": 6.2,
      "end_time": 8.0,
      "text": "そこにおったか小娘ぇ！"
    },
    {
      "index": 2,
      "start_time": 8.2,
      "end_time": 10.2,
      "text": "さあ院長さん、見てごらん！"
    },
    {
      "index": 3,
      "start_time": 10.5,
      "end_time": 13.3,
      "text": "これが最高の美というものだよ！"
    },
    {
      "index": 4,
      "start_time": 14.0,
      "end_time": 16.0,
      "text": "訳の分からんことを……"
    },
    {
      "index": 5,
      "start_time": 16.3,
      "end_time": 19.0,
      "text": "木っ端微塵にしてやる！"
    },
    {
      "index": 6,
      "start_time": 19.4,
      "end_time": 20.5,
      "text": "おっと"
    },
    {
      "index": 7,
      "start_time": 21.2,
      "end_time": 26.0,
      "text": "美しいボクを自らの手で壊すことで永遠に自分のものにしよう"
    },
    {
      "index": 8,
      "start_time": 26.2,
      "end_time": 27.3,
      "text": "ということかな？"
    },
    {
      "index": 9,
      "start_time": 28.0,
      "end_time": 32.0,
      "text": "悪いけどボクの美しさは世界的価値のあるものなんだ"
    },
    {
      "index": 10,
      "start_time": 32.3,
      "end_time": 34.5,
      "text": "キミだけにあげるわけにはいかないよ♪"
    },
    {
      "index": 11,
      "start_time": 35.1,
      "end_time": 38.8,
      "text": "……戯言も大概にしろぉ！"
    },
    {
      "index": 12,
      "start_time": 39.0,
      "end_time": 41.6,
      "text": "ねえ、まずは自分の姿を見てごらんよ"
    },
    {
      "index": 13,
      "start_time": 42.5,
      "end_time": 44.0,
      "text": "はい、鏡"
    },
    {
      "index": 14,
      "start_time": 44.5,
      "end_time": 45.3,
      "text": "Nuoh!?"
    },
    {
      "index": 15,
      "start_time": 48.1,
      "end_time": 50.0,
      "text": "くっ……小癪なまねを！"
    },
    {
      "index": 16,
      "start_time": 50.5,
      "end_time": 51.6,
      "text": "お疲れさま"
    },
    {
      "index": 17,
      "start_time": 52.6,
      "end_time": 55.6,
      "text": "あなた、思ったよりいい看護師だったわ"
    },
    {
      "index": 18,
      "start_time": 57.3,
      "end_time": 58.3,
      "text": "それじゃあ"
    },
    {
      "index": 19,
      "start_time": 59.6,
      "end_time": 61.3,
      "text": "オペをはじめましょうか"
    },
    {
      "index": 20,
      "start_time": 64.6,
      "end_time": 66.1,
      "text": "YOU BASTARD...!"
    },
    {
      "index": 21,
      "start_time": 66.6,
      "end_time": 68.3,
      "text": "はぁ～っ！！"
    },
    {
      "index": 22,
      "start_time": 69.0,
      "end_time": 70.0,
      "text": "...!"
    },
    {
      "index": 23,
      "start_time": 72.0,
      "end_time": 73.3,
      "text": "おのれぇ！"
    },
    {
      "index": 24,
      "start_time": 73.5,
      "end_time": 74.3,
      "text": "フッ！"
    },
    {
      "index": 25,
      "start_time": 76.2,
      "end_time": 77.2,
      "text": "?!"
    },
    {
      "index": 26,
      "start_time": 78.6,
      "end_time": 80.6,
      "text": "どこまでも癇に障るヤツだ……"
    },
    {
      "index": 27,
      "start_time": 81.3,
      "end_time": 82.5,
      "text": "だがワシには効かな……"
    },
    {
      "index": 28,
      "start_time": 83.0,
      "end_time": 83.6,
      "text": "え"
    },
    {
      "index": 29,
      "start_time": 84.0,
      "end_time": 85.5,
      "text": "な、なぜだ？"
    },
    {
      "index": 30,
      "start_time": 86.0,
      "end_time": 87.6,
      "text": "どうやら効いているみたいね"
    },
    {
      "index": 31,
      "start_time": 88.3,
      "end_time": 90.5,
      "text": "再生を抑制する薬"
    },
    {
      "index": 32,
      "start_time": 91.0,
      "end_time": 92.3,
      "text": "よ、抑制？"
    },
    {
      "index": 33,
      "start_time": 92.5,
      "end_time": 95.5,
      "text": "バカな、あんな短時間で作り上げたというのか！"
    },
    {
      "index": 34,
      "start_time": 96.0,
      "end_time": 98.0,
      "text": "ええ。言ったわよね？"
    },
    {
      "index": 35,
      "start_time": 98.3,
      "end_time": 100.2,
      "text": "私は優秀だって"
    },
    {
      "index": 36,
      "start_time": 101.0,
      "end_time": 104.2,
      "text": "くっ、だが再生能力がなくなったとはいえ"
    },
    {
      "index": 37,
      "start_time": 104.4,
      "end_time": 107.3,
      "text": "貴様らを捻り潰すだけなら十分──"
    },
    {
      "index": 38,
      "start_time": 107.5,
      "end_time": 108.2,
      "text": "Hah!"
    },
    {
      "index": 39,
      "start_time": 110.5,
      "end_time": 111.3,
      "text": "ぬぉっ！？"
    },
    {
      "index": 40,
      "start_time": 113.3,
      "end_time": 115.0,
      "text": "Ngh!"
    },
    {
      "index": 41,
      "start_time": 115.6,
      "end_time": 117.5,
      "text": "お薬、出しておいたわ"
    },
    {
      "index": 42,
      "start_time": 118.0,
      "end_time": 122.5,
      "text": "運動神経を麻痺させる薬、痛覚を数倍に高める薬"
    },
    {
      "index": 43,
      "start_time": 122.7,
      "end_time": 126.2,
      "text": "平衡感覚を狂わせる薬、その他色々ね"
    },
    {
      "index": 44,
      "start_time": 127.5,
      "end_time": 131.0,
      "text": "大人しくしていれば、楽に終わらせてあげるけど？"
    },
    {
      "index": 45,
      "start_time": 131.3,
      "end_time": 135.5,
      "text": "き、きき、貴様ごときにいぃ！"
    },
    {
      "index": 46,
      "start_time": 137.3,
      "end_time": 138.3,
      "text": "残念だけど"
    },
    {
      "index": 47,
      "start_time": 139.6,
      "end_time": 142.0,
      "text": "麻酔は持ち合わせてないのよ"
    },
    {
      "index": 48,
      "start_time": 145.3,
      "end_time": 146.5,
      "text": "執刀"
    },
    {
      "index": 49,
      "start_time": 147.0,
      "end_time": 147.8,
      "text": "開始！"
    },
    {
      "index": 50,
      "start_time": 149.8,
      "end_time": 151.0,
      "text": "～っっ！！"
    },
    {
      "index": 51,
      "start_time": 151.5,
      "end_time": 152.2,
      "text": "ぬおっ！"
    },
    {
      "index": 52,
      "start_time": 161.3,
      "end_time": 163.8,
      "text": "ぎゃあああああああ！"
    },
    {
      "index": 53,
      "start_time": 173.0,
      "end_time": 175.0,
      "text": "きゅ～……"
    },
    {
      "index": 54,
      "start_time": 177.0,
      "end_time": 178.3,
      "text": "どんな病も"
    },
    {
      "index": 55,
      "start_time": 178.6,
      "end_time": 181.6,
      "text": "私の隻眼からは逃れられないわ"
    }
  ],
