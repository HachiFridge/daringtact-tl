{
  "movie_id": 503300001,
  "subtitles": [
    {
      "index": 0,
      "start_time": 2.0,
      "end_time": 3.4,
      "text": "Hmmm..."
    },
    {
      "index": 1,
      "start_time": 3.5,
      "end_time": 6.1,
      "text": "I could've sworn it fell somewhere around here."
    },
    {
      "index": 2,
      "start_time": 6.8,
      "end_time": 8.8,
      "text": "Maybe you imagined it?"
    },
    {
      "index": 3,
      "start_time": 9.6,
      "end_time": 11.0,
      "text": "Hello...! Anyone...?!"
    },
    {
      "index": 4,
      "start_time": 13.0,
      "end_time": 15.0,
      "text": "Did you hear that?"
    },
    {
      "index": 5,
      "start_time": 16.0,
      "end_time": 18.2,
      "text": "Somebody, please help me!"
    },
    {
      "index": 6,
      "start_time": 19.2,
      "end_time": 22.4,
      "text": "Yes, it sounds like someone's calling us..."
    },
    {
      "index": 7,
      "start_time": 37.6,
      "end_time": 40.0,
      "text": "Phew! My hero!"
    },
    {
      "index": 8,
      "start_time": 40.9,
      "end_time": 43.0,
      "text": "What the dickens is this yellow thing?"
    },
    {
      "index": 9,
      "start_time": 43.1,
      "end_time": 45.4,
      "text": "I think it's... a rabbit?"
    },
    {
      "index": 10,
      "start_time": 45.8,
      "end_time": 46.2,
      "text": "!"
    },
    {
      "index": 11,
      "start_time": 57.2,
      "end_time": 58.0,
      "text": "Yo!"
    },
    {
      "index": 12,
      "start_time": 58.1,
      "end_time": 59.3,
      "text": "I'm Mora!"
    },
    {
      "index": 13,
      "start_time": 59.6,
      "end_time": 63.0,
      "text": "I'm a mystic creature from the Kingdom of Magic!"
    },
    {
      "index": 14,
      "start_time": 63.8,
      "end_time": 67.8,
      "text": "The Kingdom of Magic... Hmmm. Never heard of it."
    },
    {
      "index": 15,
      "start_time": 68.0,
      "end_time": 71.0,
      "text": "Mystic animal...? Is it a monster?"
    },
    {
      "index": 16,
      "start_time": 72.6,
      "end_time": 74.2,
      "text": "(...How suspicious!)"
    },
    {
      "index": 17,
      "start_time": 75.6,
      "end_time": 76.6,
      "text": "Hold on, hold on!"
    },
    {
      "index": 18,
      "start_time": 76.8,
      "end_time": 78.8,
      "text": "I'm not up to anything shady!"
    },
    {
      "index": 19,
      "start_time": 79.0,
      "end_time": 82.0,
      "text": "I'm actually here to ask you both a favor!"
    },
    {
      "index": 20,
      "start_time": 82.5,
      "end_time": 83.6,
      "text": "A favor?"
    },
    {
      "index": 21,
      "start_time": 84.0,
      "end_time": 87.0,
      "text": "I want you to become magical girls..."
    },
    {
      "index": 22,
      "start_time": 87.2,
      "end_time": 89.4,
      "text": "and save Landosol!"
    }
  ],
