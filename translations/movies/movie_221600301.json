{
  "movie_id": 221600301,
  "subtitles": [
    {
      "index": 0,
      "start_time": 3.1,
      "end_time": 7.2,
      "text": "I will not forgive you! NEVER! YOU...!"
    },
    {
      "index": 1,
      "start_time": 7.7,
      "end_time": 9.0,
      "text": "YOU ARE UNFORGIVABLEEEEE!!!"
    },
    {
      "index": 2,
      "start_time": 9.2,
      "end_time": 10.3,
      "text": "DAAAAHHHHHHH!!"
    },
    {
      "index": 3,
      "start_time": 10.6,
      "end_time": 11.6,
      "text": "Haaaaaahhhh!!"
    },
    {
      "index": 4,
      "start_time": 12.9,
      "end_time": 16.1,
      "text": "ALWAYS... TAKING ALL YOU WANT FROM US!"
    },
    {
      "index": 5,
      "start_time": 20.1,
      "end_time": 24.1,
      "text": "I will not take anything from anyone anymore!"
    },
    {
      "index": 6,
      "start_time": 24.3,
      "end_time": 25.8,
      "text": "YOU BASTARD!!!!"
    },
    {
      "index": 7,
      "start_time": 36.6,
      "end_time": 38.3,
      "text": "UWAAAAAHHHHH!!"
    },
    {
      "index": 8,
      "start_time": 44.0,
      "end_time": 45.9,
      "text": "Haaaahhhh!! DAAAAAAAGH!"
    },
    {
      "index": 9,
      "start_time": 52.2,
      "end_time": 56.3,
      "text": "So you've finally shown your true face, Faceless..."
    },
    {
      "index": 10,
      "start_time": 61.9,
      "end_time": 62.9,
      "text": "Hmph!"
    },
    {
      "index": 11,
      "start_time": 66.1,
      "end_time": 68.7,
      "text": "I knew it, this guy's something else...!"
    },
    {
      "index": 12,
      "start_time": 71.3,
      "end_time": 73.1,
      "text": "Temporary truce! Got it?!"
    },
    {
      "index": 13,
      "start_time": 73.4,
      "end_time": 74.0,
      "text": "Ahh..."
    },
    {
      "index": 14,
      "start_time": 74.2,
      "end_time": 76.1,
      "text": "Impressive as always, Roland"
    },
    {
      "index": 15,
      "start_time": 76.7,
      "end_time": 79.2,
      "text": "Senior agent!? Where are you――"
    },
    {
      "index": 16,
      "start_time": 80.0,
      "end_time": 81.8,
      "text": "GUH...!? Ghhhhh...!?"
    },
    {
      "index": 17,
      "start_time": 84.0,
      "end_time": 86.0,
      "text": "...?!"
    },
    {
      "index": 18,
      "start_time": 87.0,
      "end_time": 88.6,
      "text": "My..."
    },
    {
      "index": 19,
      "start_time": 89.1,
      "end_time": 93.8,
      "text": "Even with such an immense strain, you still won't kneel"
    },
    {
      "index": 20,
      "start_time": 94.3,
      "end_time": 95.9,
      "text": "Wonderful!"
    },
    {
      "index": 21,
      "start_time": 96.1,
      "end_time": 97.2,
      "text": "Ngh..."
    },
    {
      "index": 22,
      "start_time": 97.9,
      "end_time": 103.7,
      "text": "However... it's about time for a game change, Agent Roland"
    },
    {
      "index": 23,
      "start_time": 114.0,
      "end_time": 115.1,
      "text": "That is...!"
    },
    {
      "index": 24,
      "start_time": 116.0,
      "end_time": 118.9,
      "text": "K-Kukukuu~"
    },
    {
      "index": 25,
      "start_time": 119.1,
      "end_time": 122.0,
      "text": "MIROKU?! And...!"
    },
    {
      "index": 26,
      "start_time": 125.1,
      "end_time": 126.1,
      "text": "...!"
    },
    {
      "index": 27,
      "start_time": 129.1,
      "end_time": 131.7,
      "text": "Your... Majesty...?!"
    }
