{
  "movie_id": 504000001,
  "subtitles": [
    {
      "index": 0,
      "start_time": 16.4,
      "end_time": 17.4,
      "text": "My word."
    },
    {
      "index": 1,
      "start_time": 17.8,
      "end_time": 21.3,
      "text": "Crammin' that many cows in has really done a number on my back."
    },
    {
      "index": 2,
      "start_time": 21.5,
      "end_time": 22.8,
      "text": "Wahahahah!"
    },
    {
      "index": 3,
      "start_time": 23.0,
      "end_time": 27.0,
      "text": "That's 'cause ya were told to bring back all the cows,"
    },
    {
      "index": 4,
      "start_time": 27.2,
      "end_time": 29.6,
      "text": "so ya left that ranch totally empty."
    },
    {
      "index": 5,
      "start_time": 30.2,
      "end_time": 32.0,
      "text": "Ranch? Empty?"
    },
    {
      "index": 6,
      "start_time": 32.2,
      "end_time": 34.0,
      "text": "Wh-what? What's going on?!"
    },
    {
      "index": 7,
      "start_time": 34.8,
      "end_time": 36.8,
      "text": "I could've sworn I was napping in the forest,"
    },
    {
      "index": 8,
      "start_time": 37.0,
      "end_time": 39.4,
      "text": "so what the heck am I doing in this wagon?!"
    },
    {
      "index": 9,
      "start_time": 40.4,
      "end_time": 42.0,
      "text": "By the way, did ya see that thing?"
    },
    {
      "index": 10,
      "start_time": 42.2,
      "end_time": 44.2,
      "text": "The one wearin' that impressive armor?"
    },
    {
      "index": 11,
      "start_time": 44.6,
      "end_time": 46.8,
      "text": "Are they talking about me?"
    },
    {
      "index": 12,
      "start_time": 47.0,
      "end_time": 48.6,
      "text": "Hey, what do you mean, \"thing\"?!"
    },
    {
      "index": 13,
      "start_time": 48.8,
      "end_time": 50.2,
      "text": "Oh, that heifer?"
    },
    {
      "index": 14,
      "start_time": 50.4,
      "end_time": 53.8,
      "text": "Its massive body was so heavy I could barely pile it on the wagon."
    },
    {
      "index": 15,
      "start_time": 54.0,
      "end_time": 58.2,
      "text": "It must be nice, always sleepin' while the people are workin'."
    },
    {
      "index": 16,
      "start_time": 58.6,
      "end_time": 60.4,
      "text": "What did you say?!"
    },
    {
      "index": 17,
      "start_time": 61.0,
      "end_time": 63.8,
      "text": "Stop this wagon right now! I'm not a cow!"
    },
    {
      "index": 18,
      "start_time": 64.8,
      "end_time": 67.0,
      "text": "Did ya hear a woman's voice just now?"
    },
    {
      "index": 19,
      "start_time": 67.5,
      "end_time": 68.5,
      "text": "As if that could happen."
    },
    {
      "index": 20,
      "start_time": 68.8,
      "end_time": 71.0,
      "text": "There are only cows here."
    },
    {
      "index": 21,
      "start_time": 71.3,
      "end_time": 73.0,
      "text": "Gahahaa!"
    },
    {
      "index": 22,
      "start_time": 73.4,
      "end_time": 74.2,
      "text": "I told you!"
    },
    {
      "index": 23,
      "start_time": 74.4,
      "end_time": 78.0,
      "text": "I'm definitely not a cow!"
    }
  ],
