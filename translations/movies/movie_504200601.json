{
  "movie_id": 504200601,
  "subtitles": [
    {
      "index": 0,
      "start_time": 5.0,
      "end_time": 7.0,
      "text": "GRRRRAAAAGHHH!"
    },
    {
      "index": 1,
      "start_time": 8.0,
      "end_time": 11.4,
      "text": "Now, everyone! Reveal the hope hidden within your hearts!"
    },
    {
      "index": 2,
      "start_time": 11.6,
      "end_time": 13.4,
      "text": "Entrust it to us!"
    },
    {
      "index": 3,
      "start_time": 13.8,
      "end_time": 18.0,
      "text": "I want to help people in need even more!"
    },
    {
      "index": 4,
      "start_time": 18.6,
      "end_time": 23.0,
      "text": "I-I want to be able to see Senpai head-on!"
    },
    {
      "index": 5,
      "start_time": 23.8,
      "end_time": 28.2,
      "text": "I want to do what I believe is fun even more"
    },
    {
      "index": 6,
      "start_time": 28.6,
      "end_time": 32.0,
      "text": "I'll become the Boss over that woman right beside me!!"
    },
    {
      "index": 7,
      "start_time": 36.0,
      "end_time": 40.4,
      "text": "Amazing! The power within me is growing stronger and stronger..."
    },
    {
      "index": 8,
      "start_time": 41.0,
      "end_time": 42.0,
      "text": "With this!"
    },
    {
      "index": 9,
      "start_time": 42.6,
      "end_time": 45.0,
      "text": "GOOOOOOOOOOO!!"
    },
    {
      "index": 10,
      "start_time": 47.0,
      "end_time": 48.4,
      "text": "GRRRRAAAAGHHH!"
    },
    {
      "index": 11,
      "start_time": 55.0,
      "end_time": 57.0,
      "text": "The darkness...is disappearing..."
    },
    {
      "index": 12,
      "start_time": 57.8,
      "end_time": 59.6,
      "text": "O-Over there! Take a look!"
    },
    {
      "index": 13,
      "start_time": 60.0,
      "end_time": 62.8,
      "text": "Now that the darkness is gone, isn't this our chance?"
    },
    {
      "index": 14,
      "start_time": 64.4,
      "end_time": 68.0,
      "text": "Alright, then I'll go first!"
    },
    {
      "index": 15,
      "start_time": 71.4,
      "end_time": 72.8,
      "text": "Here and... TAKE!"
    },
    {
      "index": 16,
      "start_time": 73.4,
      "end_time": 75.4,
      "text": "Leave this to me!!"
    },
    {
      "index": 17,
      "start_time": 78.8,
      "end_time": 80.4,
      "text": "Lago, you're up!"
    },
    {
      "index": 18,
      "start_time": 85.6,
      "end_time": 87.6,
      "text": "GGYYYAAARRGHH!"
    },
    {
      "index": 19,
      "start_time": 88.0,
      "end_time": 89.8,
      "text": "I'll end it with this...!"
    },
    {
      "index": 20,
      "start_time": 90.2,
      "end_time": 91.8,
      "text": "Rino-chan, watch out!!"
    },
    {
      "index": 21,
      "start_time": 92.0,
      "end_time": 92.8,
      "text": "Eh?"
    },
    {
      "index": 22,
      "start_time": 93.0,
      "end_time": 94.0,
      "text": "EEEK!"
    },
    {
      "index": 23,
      "start_time": 94.4,
      "end_time": 96.0,
      "text": "Stop hurting Rino-san!"
    },
    {
      "index": 24,
      "start_time": 96.9,
      "end_time": 98.0,
      "text": "Hahh!"
    },
    {
      "index": 25,
      "start_time": 103.2,
      "end_time": 104.8,
      "text": "R-Rino-san! Now!"
    },
    {
      "index": 26,
      "start_time": 105.2,
      "end_time": 107.0,
      "text": "Thank you, Ayumi-san!"
    },
    {
      "index": 27,
      "start_time": 113.0,
      "end_time": 114.0,
      "text": "TAKE THIS!!"
    },
    {
      "index": 28,
      "start_time": 116.2,
      "end_time": 118.6,
      "text": "GGYYYAAARRGHH!"
    }
