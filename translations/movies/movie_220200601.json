      "text": "My Lord, please!"
    },
    {
      "index": 1,
      "start_time": 8.6,
      "end_time": 10.5,
      "text": "Haaaaah!"
    },
    {
      "index": 2,
      "start_time": 16.5,
      "end_time": 17.3,
      "text": "Pigyu!"
    },
    {
      "index": 3,
      "start_time": 19.1,
      "end_time": 21.4,
      "text": "Pigyupigyupigyupigyu"
    },
    {
      "index": 4,
      "start_time": 21.6,
      "end_time": 22.6,
      "text": "Pigyuu!"
    },
    {
      "index": 5,
      "start_time": 23.4,
      "end_time": 25.4,
      "text": "Pigyuuu!!"
    },
    {
      "index": 6,
      "start_time": 25.6,
      "end_time": 26.5,
      "text": "So fast!?"
    },
    {
      "index": 7,
      "start_time": 30.3,
      "end_time": 31.0,
      "text": "Huh?"
    },
    {
      "index": 8,
      "start_time": 31.1,
      "end_time": 33.4,
      "text": "Hey! What are you doing running ahead of them like that, you idiot?!"
    },
    {
      "index": 9,
      "start_time": 33.6,
      "end_time": 34.4,
      "text": "Hah!"
    },
    {
      "index": 10,
      "start_time": 34.6,
      "end_time": 38.1,
      "text": "You've got some nerve to show me your ass like that."
    },
    {
      "index": 11,
      "start_time": 38.5,
      "end_time": 40.6,
      "text": "As a reward, I'll give you a beating!"
    },
    {
      "index": 12,
      "start_time": 41.2,
      "end_time": 43.0,
      "text": "A beating~"
    },
    {
      "index": 13,
      "start_time": 43.3,
      "end_time": 44.3,
      "text": "Click"
    },
    {
      "index": 14,
      "start_time": 53.1,
      "end_time": 54.3,
      "text": "Wreck 'em!"
    },
    {
      "index": 15,
      "start_time": 54.5,
      "end_time": 55.3,
      "text": "Not good!"
    },
    {
      "index": 16,
      "start_time": 55.6,
      "end_time": 58.1,
      "text": "Royal Equipment, full power!!"
    },
    {
      "index": 17,
      "start_time": 69.0,
      "end_time": 70.3,
      "text": "Die! ♪"
    },
    {
      "index": 18,
      "start_time": 73.6,
      "end_time": 74.5,
      "text": "Huh?"
    },
    {
      "index": 19,
      "start_time": 77.7,
      "end_time": 79.6,
      "text": "Waahhh!"
    },
    {
      "index": 20,
      "start_time": 87.1,
      "end_time": 90.4,
      "text": "Hoorah! I'll finish you off this time!"
    },
    {
      "index": 21,
      "start_time": 93.5,
      "end_time": 95.9,
      "text": "Pigyu~~"
    },
    {
      "index": 22,
      "start_time": 96.1,
      "end_time": 97.4,
      "text": "No! It fainted!"
    },
    {
      "index": 23,
      "start_time": 100.0,
      "end_time": 101.1,
      "text": "Prepare yourself!"
    },
    {
      "index": 24,
      "start_time": 101.3,
      "end_time": 103.1,
      "text": "Everyone! Now!"
    },
    {
      "index": 25,
      "start_time": 103.6,
      "end_time": 105.0,
      "text": "Indeed!"
    },
    {
      "index": 26,
      "start_time": 106.6,
      "end_time": 107.5,
      "text": "Ahh!"
    },
    {
      "index": 27,
      "start_time": 111.4,
      "end_time": 112.2,
      "text": "EEEK!"
    },
    {
      "index": 28,
      "start_time": 113.1,
      "end_time": 114.3,
      "text": "We're stuck!"
    },
    {
      "index": 29,
      "start_time": 116.1,
      "end_time": 118.1,
      "text": "Tch! Don’t underestimate me!"
    },
    {
      "index": 30,
      "start_time": 118.3,
      "end_time": 120.2,
      "text": "I'll rip this thing to shreds!"
    },
    {
      "index": 31,
      "start_time": 121.1,
      "end_time": 122.2,
      "text": "Teeeeeeee!"
    },
    {
      "index": 32,
      "start_time": 132.3,
      "end_time": 134.4,
      "text": "Ahhhh, I’m so sick of this! So sick of it!"
    },
    {
      "index": 33,
      "start_time": 139.2,
      "end_time": 140.3,
      "text": "I won't let you!"
    },
    {
      "index": 34,
      "start_time": 142.5,
      "end_time": 143.4,
      "text": "Karyl!"
    },
    {
      "index": 35,
      "start_time": 144.2,
      "end_time": 146.0,
      "text": "Die!!"
    },
    {
      "index": 36,
      "start_time": 149.8,
      "end_time": 151.6,
      "text": "Damn iiiiiit!! Kyaaaah?! Byahhhh!!"
    },
    {
      "index": 37,
      "start_time": 171.2,
      "end_time": 171.9,
      "text": "Hmm?"
    },
    {
      "index": 38,
      "start_time": 172.1,
      "end_time": 173.5,
      "text": "That would be..."
    },
    {
      "index": 39,
      "start_time": 179.2,
      "end_time": 182.1,
      "text": "So the tires were monsters...?!"
    },
    {
      "index": 40,
      "start_time": 183.0,
      "end_time": 184.1,
      "text": "They're not done yet?!"
    }
