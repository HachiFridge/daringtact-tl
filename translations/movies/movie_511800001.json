  "subtitles": [
    {
      "index": 0,
      "start_time": 13.6,
      "end_time": 16.1,
      "text": "Welcome! How about it?"
    },
    {
      "index": 1,
      "start_time": 16.4,
      "end_time": 18.4,
      "text": "If you like what you see, please take a look!"
    },
    {
      "index": 2,
      "start_time": 19.5,
      "end_time": 22.5,
      "text": "Ehehe♪ That was a good purchase~♪"
    },
    {
      "index": 3,
      "start_time": 23.1,
      "end_time": 24.3,
      "text": "It was a true bargain"
    },
    {
      "index": 4,
      "start_time": 25.2,
      "end_time": 25.9,
      "text": "Hey!"
    },
    {
      "index": 5,
      "start_time": 26.1,
      "end_time": 29.3,
      "text": "I didn't think I'd find something this amazing"
    },
    {
      "index": 6,
      "start_time": 29.9,
      "end_time": 32.5,
      "text": "Let's keep going and visit all kinds of stores!"
    },
    {
      "index": 7,
      "start_time": 33.1,
      "end_time": 33.9,
      "text": "Yeah..."
    },
    {
      "index": 8,
      "start_time": 34.2,
      "end_time": 35.4,
      "text": "Then, next is..."
    },
    {
      "index": 9,
      "start_time": 35.6,
      "end_time": 38.6,
      "text": "Hey, hey, you there, smiling boy and girl! You look like you're having fun!"
    },
    {
      "index": 10,
      "start_time": 39.5,
      "end_time": 40.1,
      "text": "Eh?"
    },
    {
      "index": 11,
      "start_time": 49.0,
      "end_time": 50.6,
      "text": "Hiii♪ I'm Vicky!"
    },
    {
      "index": 12,
      "start_time": 53.0,
      "end_time": 54.0,
      "text": "Hiii♪"
    },
    {
      "index": 13,
      "start_time": 54.6,
      "end_time": 56.5,
      "text": "Hi...hii♪"
    },
    {
      "index": 14,
      "start_time": 57.2,
      "end_time": 59.3,
      "text": "Haha! Thank you for your friendly reply"
    },
    {
      "index": 15,
      "start_time": 59.6,
      "end_time": 62.3,
      "text": "Well then, let us shake hands!"
    },
    {
      "index": 16,
      "start_time": 63.1,
      "end_time": 65.5,
      "text": "To celebrate this meeting, shaking hands is good fortune!"
    },
    {
      "index": 17,
      "start_time": 69.6,
      "end_time": 71.6,
      "text": "It's fate that we met here!"
    },
    {
      "index": 18,
      "start_time": 72.3,
      "end_time": 74.4,
      "text": "By all means, take a look at my store"
    },
    {
      "index": 19,
      "start_time": 75.3,
      "end_time": 76.6,
      "text": "Huh...? Oh, wait!"
    },
    {
      "index": 20,
      "start_time": 77.6,
      "end_time": 79.0,
      "text": "♪～"
    },
    {
      "index": 21,
      "start_time": 79.4,
      "end_time": 81.5,
      "text": "Whoa... Wait, what?"
    },
    {
      "index": 22,
      "start_time": 87.3,
      "end_time": 89.4,
      "text": "Um, what's this...?"
    },
    {
      "index": 23,
      "start_time": 89.6,
      "end_time": 91.6,
      "text": "As you can see, I sell rat ears!"
    },
    {
      "index": 24,
      "start_time": 92.2,
      "end_time": 93.7,
      "text": "It's my trademark after all♪"
    },
    {
      "index": 25,
      "start_time": 96.1,
      "end_time": 100.1,
      "text": "Right now, the price is only three rupees! Isn't that a bargain?"
    },
    {
      "index": 26,
      "start_time": 100.6,
      "end_time": 101.9,
      "text": "Haha!"
    }
